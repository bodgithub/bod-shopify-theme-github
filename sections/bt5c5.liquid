{%- liquid
  assign shadow_class = 'has-shadow--' | append: settings.block_shadows
  assign protocol = settings.bcd_protocol_product
  assign free_shipping_minimum = settings.free_shipping_minimum | default: '0' | times: 100
  assign empty_url = settings.bcd_empty_url | default: routes.all_products_collection_url
-%}
<div data-chunk="5">
    "b_heading": {{ settings.bcd_b_heading | default: 'YOUR FIRST ORDER' | json }},
    "b_heading_oneoff": {{ settings.bcd_b_heading_oneoff | default: 'YOUR ORDER' | json }},
    "b_save_pill": {{ settings.bcd_b_save_pill | default: 'You save {amount}' | json }},
    "b_coupon_text": {{ settings.bcd_b_coupon_text | default: '{percent}% off applied' | json }},
    "checkout_text": {{ settings.bcd_checkout_text | default: 'Secure checkout · {total}' | json }},
    "checkout_text_b": {{ settings.bcd_checkout_text_b | default: 'Checkout' | json }},
    "checkout_text_c": {{ settings.bcd_checkout_text_c | default: 'Checkout securely' | json }},
    "trust": {{ settings.bcd_trust | json }},
    "trust_1": {{ settings.bcd_trust_1 | default: '3rd-party tested' | json }},
</div>