{%- comment -%}
  BODOLOGY · LP top banner
  Mirrors the ARMRA landing-page header: a slim full-width promo ribbon
  (one line of uppercase text + optional code pill, optional terms popup)
  above a minimal sticky header with just the logo and a cart icon.
  Optional: hide the store header / announcement bar on this template so
  the page has no navigation (distraction-free paid-traffic page).
  Everything is an editor setting; mobile-first.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign ribbon_text = s.ribbon_text | strip
  assign has_ribbon = false
  if s.show_ribbon and ribbon_text != blank
    assign has_ribbon = true
  endif
  assign logo = s.logo
  if logo == blank
    assign logo = settings.logo
  endif
-%}

<style>
  {%- if s.hide_theme_header -%}
  #shopify-section-header,
  #shopify-section-announcement-bar,
  #shopify-section-promo-bar,
  [id$="__promo-bar"].shopify-section,
  #shopify-section-header-secondary-menu,
  #shopify-section-header-mobile-navigation,
  .header--sticky { display: none !important; }
  {%- endif -%}

  #shopify-section-{{ sid }} { font-family: "tenon", -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif; }

  /* Ribbon */
  #shopify-section-{{ sid }} .lptb__ribbon {
    display: flex; align-items: center; justify-content: center; gap: 8px; flex-wrap: wrap;
    min-height: 36px; padding: 7px 16px;
    background: {{ s.ribbon_bg }}; color: {{ s.ribbon_text_color }};
    text-decoration: none; text-align: center;
    font-size: {{ s.ribbon_size_mobile }}px; font-weight: 700; letter-spacing: 0.04em; line-height: 1.35;
    {% if s.ribbon_uppercase %}text-transform: uppercase;{% endif %}
  }
  #shopify-section-{{ sid }} a.lptb__ribbon:hover { opacity: .92; }
  #shopify-section-{{ sid }} .lptb__code {
    display: inline-block; padding: 1px 7px; border-radius: 4px;
    background: {{ s.code_bg }}; color: {{ s.code_text_color }}; font-weight: 700; white-space: nowrap;
  }
  #shopify-section-{{ sid }} .lptb__terms-btn {
    appearance: none; background: none; border: 0; padding: 0 2px; margin: 0; cursor: pointer;
    color: inherit; font: inherit; font-weight: 500; text-decoration: underline; text-underline-offset: 2px;
  }

  /* Header */
  #shopify-section-{{ sid }} .lptb__header {
    position: {% if s.sticky %}sticky{% else %}relative{% endif %}; top: 0; z-index: 90;
    background: {{ s.header_bg }}; border-bottom: 1px solid {{ s.header_border }};
    transition: box-shadow .2s ease;
  }
  #shopify-section-{{ sid }} .lptb__header.is-scrolled { box-shadow: 0 2px 14px rgba(16, 24, 72, .08); }
  #shopify-section-{{ sid }} .lptb__inner {
    max-width: {{ s.page_width }}px; margin: 0 auto; padding: 10px 16px;
    display: grid; grid-template-columns: 44px 1fr 44px; align-items: center; min-height: 56px;
  }
  #shopify-section-{{ sid }} .lptb__logo { grid-column: 2; display: flex; align-items: center; justify-content: {% if s.logo_align_mobile == 'left' %}flex-start{% else %}center{% endif %}; }
  #shopify-section-{{ sid }} .lptb__logo img { display: block; height: {{ s.logo_height_mobile }}px; width: auto; max-width: 60vw; }
  #shopify-section-{{ sid }} .lptb__logo .lptb__logo-text { font-size: 20px; font-weight: 600; letter-spacing: .02em; color: {{ s.header_icon_color }}; text-decoration: none; }
  #shopify-section-{{ sid }} .lptb__cart {
    grid-column: 3; justify-self: end; position: relative;
    display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px;
    border: 0; background: none; padding: 0; cursor: pointer; color: {{ s.header_icon_color }};
  }
  #shopify-section-{{ sid }} .lptb__cart svg { width: 24px; height: 24px; display: block; }
  #shopify-section-{{ sid }} .lptb__cart svg * { stroke: currentColor; }
  #shopify-section-{{ sid }} .lptb__count {
    position: absolute; top: 4px; right: 2px; min-width: 18px; height: 18px; padding: 0 5px;
    border-radius: 999px; background: {{ s.count_bg }}; color: {{ s.count_text_color }};
    font-size: 11px; font-weight: 700; line-height: 18px; text-align: center;
  }
  #shopify-section-{{ sid }} .lptb__count[data-count="0"] { display: none; }

  /* Terms popup */
  #shopify-section-{{ sid }} .lptb__pop { position: fixed; inset: 0; z-index: 10050; display: none; align-items: center; justify-content: center; padding: 16px; }
  #shopify-section-{{ sid }} .lptb__pop[open] { display: flex; }
  #shopify-section-{{ sid }} .lptb__pop-under { position: absolute; inset: 0; background: rgba(26, 40, 116, .55); }
  #shopify-section-{{ sid }} .lptb__pop-box {
    position: relative; width: 100%; max-width: 520px; max-height: 80vh; overflow: auto;
    background: #fff; color: {{ s.pop_text_color }}; border-radius: 14px; padding: 26px 22px 22px;
    font-size: 14px; line-height: 1.5;
  }
  #shopify-section-{{ sid }} .lptb__pop-title { font-size: 17px; font-weight: 600; margin: 0 28px 10px 0; }
  #shopify-section-{{ sid }} .lptb__pop-box p { margin: 0 0 10px; }
  #shopify-section-{{ sid }} .lptb__pop-box a { color: inherit; }
  #shopify-section-{{ sid }} .lptb__pop-close {
    position: absolute; top: 10px; right: 10px; width: 36px; height: 36px; border: 0; border-radius: 50%;
    background: #f2eeea; color: inherit; cursor: pointer; font-size: 20px; line-height: 36px;
  }

  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .lptb__ribbon { font-size: {{ s.ribbon_size }}px; padding: 8px 20px; }
    #shopify-section-{{ sid }} .lptb__inner { padding: 12px 24px; grid-template-columns: 1fr auto 1fr; min-height: 64px; }
    #shopify-section-{{ sid }} .lptb__logo { justify-content: center; }
    #shopify-section-{{ sid }} .lptb__logo img { height: {{ s.logo_height }}px; max-width: none; }
    #shopify-section-{{ sid }} .lptb__cart { grid-column: 3; }
  }
</style>

<div class="lptb" data-lptb>
  {%- if has_ribbon -%}
    {%- if s.ribbon_link != blank -%}<a class="lptb__ribbon" href="{{ s.ribbon_link }}">{%- else -%}<div class="lptb__ribbon">{%- endif -%}
      <span>{{ ribbon_text }}</span>
      {%- if s.ribbon_code != blank -%}<span class="lptb__code">{{ s.ribbon_code }}</span>{%- endif -%}
    {%- if s.ribbon_link != blank -%}</a>{%- else -%}</div>{%- endif -%}
    {%- if s.terms_text != blank -%}
      <div class="lptb__ribbon" style="padding-top:0;min-height:0;background:{{ s.ribbon_bg }};" aria-hidden="false">
        <button type="button" class="lptb__terms-btn" data-lptb-open>{{ s.terms_label | default: 'Terms' }}</button>
      </div>
      <div class="lptb__pop" data-lptb-pop role="dialog" aria-modal="true" aria-labelledby="lptb-pop-title-{{ sid }}">
        <div class="lptb__pop-under" data-lptb-close></div>
        <div class="lptb__pop-box">
          <button type="button" class="lptb__pop-close" data-lptb-close aria-label="Close">&times;</button>
          <h2 class="lptb__pop-title" id="lptb-pop-title-{{ sid }}">{{ s.terms_title | default: 'Terms and conditions' }}</h2>
          <div>{{ s.terms_text }}</div>
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}

  <header class="lptb__header" data-lptb-header>
    <div class="lptb__inner">
      <div class="lptb__logo">
        <a href="{{ s.logo_link | default: routes.root_url }}" title="{{ shop.name | escape }}">
          {%- if logo != blank -%}
            {{ logo | image_url: width: 600 | image_tag: alt: shop.name, loading: 'eager', widths: '200, 300, 400, 600', sizes: '220px' }}
          {%- else -%}
            <span class="lptb__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </a>
      </div>
      {%- if s.show_cart -%}
        <a class="lptb__cart" href="{{ routes.cart_url }}" data-lptb-cart aria-label="Open your cart">
          {% render 'svg-icons' with 'cart' %}
          <span class="lptb__count" data-lptb-count data-count="{{ cart.item_count }}" aria-hidden="true">{{ cart.item_count }}</span>
        </a>
      {%- endif -%}
    </div>
  </header>
</div>

<script>
  (function () {
    var root = document.currentScript.closest('.shopify-section') || document;
    var header = root.querySelector('[data-lptb-header]');
    if (header) {
      var onScroll = function () { header.classList.toggle('is-scrolled', window.scrollY > 8); };
      window.addEventListener('scroll', onScroll, { passive: true }); onScroll();
    }
    /* Cart icon: open the theme's cart drawer when it exists, otherwise go to /cart */
    var cartBtn = root.querySelector('[data-lptb-cart]');
    if (cartBtn) {
      cartBtn.addEventListener('click', function (e) {
        var toggle = document.getElementById('cart-drawer-toggle');
        var drawer = document.getElementById('Cart-Drawer');
        if (toggle && drawer) { e.preventDefault(); toggle.click(); }
      });
      var count = root.querySelector('[data-lptb-count]');
      var refresh = function () {
        fetch((window.Shopify && Shopify.routes && Shopify.routes.root || '/') + 'cart.js', { headers: { 'Accept': 'application/json' } })
          .then(function (r) { return r.json(); })
          .then(function (c) { if (count) { count.textContent = c.item_count; count.setAttribute('data-count', c.item_count); } })
          .catch(function () {});
      };
      document.addEventListener('cart:refresh', refresh);
      document.addEventListener('cart-drawer:open', refresh);
      document.addEventListener('cart:updated', refresh);
    }
    /* Terms popup */
    var pop = root.querySelector('[data-lptb-pop]');
    if (pop) {
      var lastFocus = null;
      var open = function () { lastFocus = document.activeElement; pop.setAttribute('open', ''); pop.querySelector('.lptb__pop-close').focus(); document.body.style.overflow = 'hidden'; };
      var close = function () { pop.removeAttribute('open'); document.body.style.overflow = ''; if (lastFocus) { lastFocus.focus(); } };
      root.querySelectorAll('[data-lptb-open]').forEach(function (b) { b.addEventListener('click', open); });
      pop.querySelectorAll('[data-lptb-close]').forEach(function (b) { b.addEventListener('click', close); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && pop.hasAttribute('open')) { close(); } });
    }
  })();
</script>

{% schema %}
{
  "name": "LP · Top banner",
  "tag": "div",
  "class": "section-lp-top-banner",
  "disabled_on": { "groups": ["footer", "aside"] },
  "settings": [
    { "type": "header", "content": "Promo ribbon" },
    { "type": "checkbox", "id": "show_ribbon", "label": "Show ribbon", "default": true },
    { "type": "text", "id": "ribbon_text", "label": "Ribbon text", "default": "Free shipping on every order. 60-day money-back guarantee." },
    { "type": "text", "id": "ribbon_code", "label": "Code pill (optional)", "info": "Shown as a small pill after the text, e.g. the discount code for this campaign. Check the code's live value in Shopify before adding it." },
    { "type": "url", "id": "ribbon_link", "label": "Ribbon link", "info": "Usually the product section on this page. Use #shopify-section-main-product to scroll to it." },
    { "type": "checkbox", "id": "ribbon_uppercase", "label": "Uppercase", "default": true },
    { "type": "range", "id": "ribbon_size", "min": 11, "max": 18, "step": 1, "unit": "px", "label": "Text size (desktop)", "default": 14 },
    { "type": "range", "id": "ribbon_size_mobile", "min": 10, "max": 16, "step": 1, "unit": "px", "label": "Text size (mobile)", "default": 12 },
    { "type": "color", "id": "ribbon_bg", "label": "Ribbon background", "default": "#1b3def" },
    { "type": "color", "id": "ribbon_text_color", "label": "Ribbon text", "default": "#ffffff" },
    { "type": "color", "id": "code_bg", "label": "Code pill background", "default": "#ffffff" },
    { "type": "color", "id": "code_text_color", "label": "Code pill text", "default": "#1b3def" },
    { "type": "header", "content": "Terms popup (optional)" },
    { "type": "text", "id": "terms_label", "label": "Link label", "default": "Terms" },
    { "type": "text", "id": "terms_title", "label": "Popup title", "default": "Terms and conditions" },
    { "type": "richtext", "id": "terms_text", "label": "Popup text", "info": "Leave empty to hide the terms link." },
    { "type": "color", "id": "pop_text_color", "label": "Popup text colour", "default": "#1a2874" },
    { "type": "header", "content": "Header" },
    { "type": "checkbox", "id": "hide_theme_header", "label": "Hide the store header and announcement bar on this page", "default": true, "info": "Gives the page no navigation, like a paid-traffic landing page. Turn off to show the normal menu above this banner." },
    { "type": "checkbox", "id": "sticky", "label": "Stick header to the top on scroll", "default": true },
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Defaults to the theme logo." },
    { "type": "url", "id": "logo_link", "label": "Logo link", "info": "Defaults to the homepage." },
    { "type": "range", "id": "logo_height", "min": 20, "max": 80, "step": 2, "unit": "px", "label": "Logo height (desktop)", "default": 36 },
    { "type": "range", "id": "logo_height_mobile", "min": 16, "max": 60, "step": 2, "unit": "px", "label": "Logo height (mobile)", "default": 28 },
    { "type": "select", "id": "logo_align_mobile", "label": "Logo position (mobile)", "options": [ { "value": "center", "label": "Centre" }, { "value": "left", "label": "Left" } ], "default": "center" },
    { "type": "checkbox", "id": "show_cart", "label": "Show cart icon", "default": true },
    { "type": "range", "id": "page_width", "min": 1000, "max": 1600, "step": 20, "unit": "px", "label": "Content width", "default": 1300 },
    { "type": "color", "id": "header_bg", "label": "Header background", "default": "#ffffff" },
    { "type": "color", "id": "header_border", "label": "Header bottom line", "default": "#e9e5e2" },
    { "type": "color", "id": "header_icon_color", "label": "Cart icon colour", "default": "#1a2874" },
    { "type": "color", "id": "count_bg", "label": "Cart count background", "default": "#1b3def" },
    { "type": "color", "id": "count_text_color", "label": "Cart count text", "default": "#ffffff" }
  ],
  "presets": [ { "name": "LP · Top banner" } ]
}
{% endschema %}
