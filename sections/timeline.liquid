{%- comment -%}
  Bodology · Timeline — "What changes, week by week."
  One continuous scroll. A glowing spine runs down the centre and fills as you
  scroll. Phase blocks start a new week band; the review and video blocks that
  follow a phase hang off the spine (alternating sides on desktop, stacked on
  mobile). A fixed HUD reads out the current week. Ambient particle field
  behind everything. Sticky CTA appears once the timeline starts and hides at
  the closing CTA.

  Blocks are flat (Shopify limit) and grouped in order: add a "Phase" block,
  then the reviews / videos that belong to it, then the next "Phase". Review
  and video blocks placed before the first Phase are not rendered.
{%- endcomment -%}

{%- liquid
  assign uid = section.id
  assign s = section.settings
  assign cta_url = s.cta_link | default: '/products/myo-d-chiro-inositol-powder'
  assign phase_count = 0
  for b in section.blocks
    if b.type == 'phase'
      assign phase_count = phase_count | plus: 1
    endif
  endfor
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap">

<style>
{%- if s.hide_header_footer -%}
.shopify-section-group-header-group,.shopify-section-group-footer-group{display:none !important}
{%- endif -%}
body.template-page-timeline{background:{{ s.bg_deep }}}

#tl-{{ uid }}{
  --navy-deep:{{ s.bg_deep }};
  --navy-bright:{{ s.bg_bright }};
  --fg:{{ s.fg }};
  --fg-dim:{{ s.fg | color_modify: 'alpha', 0.74 }};
  --fg-faint:{{ s.fg | color_modify: 'alpha', 0.5 }};
  --glass:{{ s.fg | color_modify: 'alpha', 0.075 }};
  --glass-strong:{{ s.fg | color_modify: 'alpha', 0.12 }};
  --line:{{ s.fg | color_modify: 'alpha', 0.18 }};
  --signal:{{ s.signal }};
  --signal-55:{{ s.signal | color_modify: 'alpha', 0.55 }};
  --signal-18:{{ s.signal | color_modify: 'alpha', 0.18 }};
  --signal-20:{{ s.signal | color_modify: 'alpha', 0.2 }};
  --signal-75:{{ s.signal | color_modify: 'alpha', 0.75 }};
  --ink:{{ s.ink }};
  --f-display:"Instrument Serif","Times New Roman",Georgia,serif;
  --f-body:tenon,"DM Sans",-apple-system,"Segoe UI",Helvetica,Arial,sans-serif;
  --f-mono:"IBM Plex Mono",ui-monospace,Menlo,Consolas,monospace;
  --gutter:clamp(16px,4vw,40px);
  position:relative;
  color:var(--fg);font-family:var(--f-body);font-size:16px;line-height:1.55;
  background:var(--navy-deep);
  background-image:radial-gradient(140% 130% at 18% 8%,var(--navy-deep) 0%,var(--navy-bright) 100%);
  background-attachment:fixed;
  overflow-x:clip;
  padding-inline:var(--gutter);
  color-scheme:dark;
}
#tl-{{ uid }} *{box-sizing:border-box}
#tl-{{ uid }} a{color:inherit}
#tl-{{ uid }} em,#tl-{{ uid }} .serif{font-family:var(--f-display);font-style:italic;font-weight:400}
#tl-{{ uid }} .mono{font-family:var(--f-mono);letter-spacing:.08em;text-transform:uppercase;font-size:.72rem}
#tl-{{ uid }} .field{position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:0}
#tl-{{ uid }} .tl-main{position:relative;z-index:1}

/* HUD */
#tl-{{ uid }} .hud{
  position:fixed;left:0;right:0;top:0;z-index:20;
  padding:calc(env(safe-area-inset-top,0px) + 14px) var(--gutter) 14px;
  display:flex;align-items:center;justify-content:space-between;gap:16px;
  background:linear-gradient(to bottom,{{ s.ink | color_modify: 'alpha', 0.55 }},{{ s.ink | color_modify: 'alpha', 0 }});
  backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);
}
#tl-{{ uid }} .brand{display:flex;align-items:center;text-decoration:none;height:24px}
#tl-{{ uid }} .brand img{height:22px;width:auto;filter:brightness(0) invert(1)}
#tl-{{ uid }} .brand span{font-family:var(--f-display);font-size:1.5rem;letter-spacing:.01em}
#tl-{{ uid }} .readout{display:flex;align-items:center;gap:12px}
#tl-{{ uid }} .readout .lbl{color:var(--fg-faint)}
#tl-{{ uid }} .readout .wk{font-family:var(--f-mono);font-size:1.15rem;font-variant-numeric:tabular-nums;min-width:3.2ch;text-align:right}
#tl-{{ uid }} .readout .bar{width:72px;height:2px;background:var(--line);position:relative;overflow:hidden;border-radius:2px}
#tl-{{ uid }} .readout .bar i{position:absolute;inset:0;background:var(--signal);transform-origin:left;transform:scaleX(var(--p,0))}

/* Hero */
#tl-{{ uid }} .hero{max-width:880px;margin:0 auto;padding-block:calc(env(safe-area-inset-top,0px) + 140px) 56px;text-align:center;display:grid;gap:22px;justify-items:center}
#tl-{{ uid }} .hero .eyebrow{color:var(--signal)}
#tl-{{ uid }} .hero h1{font-family:var(--f-body);color:var(--fg);font-weight:500;font-size:clamp(2.4rem,7vw,5rem);line-height:1.02;margin:0;letter-spacing:-.02em;text-wrap:balance}
#tl-{{ uid }} .hero h1 em{display:block;font-size:1.12em;letter-spacing:-.01em}
#tl-{{ uid }} .hero p{margin:0;max-width:56ch;color:var(--fg-dim);font-size:1.08rem;text-wrap:balance}
#tl-{{ uid }} .hero p strong{color:var(--fg)}
#tl-{{ uid }} .spec{display:flex;flex-wrap:wrap;justify-content:center;gap:8px;margin-top:6px}
#tl-{{ uid }} .spec span{border:1px solid var(--line);border-radius:999px;padding:6px 12px;color:var(--fg-dim)}
#tl-{{ uid }} .cue{margin-top:26px;display:grid;justify-items:center;gap:10px;color:var(--fg-faint)}
#tl-{{ uid }} .cue i{width:1px;height:56px;background:linear-gradient(var(--signal),transparent);animation:tl-cue 2.2s ease-in-out infinite}
@keyframes tl-cue{0%{transform:scaleY(0);transform-origin:top}50%{transform:scaleY(1);transform-origin:top}51%{transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom}}

/* Timeline */
#tl-{{ uid }} .timeline{position:relative;max-width:1120px;margin:0 auto;padding-block:40px 80px}
#tl-{{ uid }} .spine{position:absolute;top:0;bottom:0;left:50%;width:2px;margin-left:-1px;background:var(--line);border-radius:2px}
#tl-{{ uid }} .spine .fill{position:absolute;inset:0;transform-origin:top;transform:scaleY(var(--p,0));
  background:linear-gradient(to bottom,var(--signal-20),var(--signal) 85%,#fff);
  box-shadow:0 0 18px var(--signal-55)}
#tl-{{ uid }} .spine .tip{position:absolute;left:50%;top:calc(var(--p,0)*100%);width:14px;height:14px;margin:-7px 0 0 -7px;border-radius:50%;
  background:#fff;box-shadow:0 0 0 6px var(--signal-18),0 0 28px 6px var(--signal-75)}

#tl-{{ uid }} .phase{position:relative;padding-block:72px 24px}
#tl-{{ uid }} .phase-head{position:relative;z-index:2;max-width:640px;margin:0 auto 56px;text-align:center;display:grid;gap:14px;justify-items:center;
  padding:28px 24px;border-radius:20px;background:{{ s.ink | color_modify: 'alpha', 0.5 }};border:1px solid var(--line);
  backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
#tl-{{ uid }} .chip{display:inline-flex;align-items:center;gap:10px;padding:8px 14px;border-radius:999px;background:var(--fg);color:var(--ink);font-weight:500}
#tl-{{ uid }} .chip b{font-family:var(--f-mono);font-weight:500;font-size:.8rem;letter-spacing:.06em}
#tl-{{ uid }} .phase-head h2{font-family:var(--f-body);color:var(--fg);margin:0;font-weight:500;font-size:clamp(1.6rem,3.6vw,2.4rem);line-height:1.12;letter-spacing:-.015em;text-wrap:balance}
#tl-{{ uid }} .phase-head h2 em{font-size:1.1em}
#tl-{{ uid }} .phase-head .note{margin:0;color:var(--fg-dim);max-width:46ch;text-wrap:balance}
#tl-{{ uid }} .phase-head .note .mono{color:var(--signal);display:block;margin-bottom:4px}

#tl-{{ uid }} .events{display:grid;gap:34px}
#tl-{{ uid }} .ev{display:grid;grid-template-columns:1fr 72px 1fr;align-items:center}
#tl-{{ uid }} .ev .slot{min-width:0;display:flex}
#tl-{{ uid }} .ev.L .slot.l{justify-content:flex-end}
#tl-{{ uid }} .ev.R .slot.r{justify-content:flex-start}
#tl-{{ uid }} .ev .node{position:relative;height:100%;display:flex;align-items:center;justify-content:center}
#tl-{{ uid }} .ev .node::before{content:"";width:10px;height:10px;border-radius:50%;background:var(--navy-deep);border:2px solid var(--signal);transition:background .4s,box-shadow .4s}
#tl-{{ uid }} .ev.in .node::before{background:var(--signal);box-shadow:0 0 14px var(--signal)}
#tl-{{ uid }} .ev .node::after{content:"";position:absolute;top:50%;height:1px;width:30px;background:var(--signal);opacity:.6;transform:scaleX(0);transition:transform .6s .1s cubic-bezier(.2,.7,.2,1)}
#tl-{{ uid }} .ev.L .node::after{right:50%;transform-origin:right;margin-right:6px}
#tl-{{ uid }} .ev.R .node::after{left:50%;transform-origin:left;margin-left:6px}
#tl-{{ uid }} .ev.in .node::after{transform:scaleX(1)}

/* Review card */
#tl-{{ uid }} .review{position:relative;width:100%;max-width:440px;padding:22px 22px 18px;border-radius:18px;background:var(--glass);border:1px solid var(--line);
  backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);overflow:hidden;display:grid;gap:14px}
#tl-{{ uid }} .review blockquote{margin:0;padding:0;border:0;font-size:1.02rem;line-height:1.55;color:var(--fg)}
#tl-{{ uid }} .review blockquote p{margin:0;color:inherit;font-size:inherit;line-height:inherit}
#tl-{{ uid }} .review blockquote::before{content:"\201C";font-family:var(--f-display);font-size:2.6rem;line-height:.6;display:block;color:var(--signal);margin-bottom:6px}
#tl-{{ uid }} .who{display:flex;align-items:center;gap:10px}
#tl-{{ uid }} .av{width:36px;height:36px;border-radius:50%;flex:none;overflow:hidden;background:var(--glass-strong);display:grid;place-items:center;font-family:var(--f-mono);font-size:.75rem;border:1px solid var(--line)}
#tl-{{ uid }} .av img{width:100%;height:100%;object-fit:cover;display:block}
#tl-{{ uid }} .who .n{font-weight:500;line-height:1.2;display:block}
#tl-{{ uid }} .who .v{color:var(--fg-faint);font-size:.82rem;display:flex;align-items:center;gap:6px}
#tl-{{ uid }} .who .v::before{content:"";width:6px;height:6px;border-radius:50%;background:#8EF0C0}
#tl-{{ uid }} .stars{margin-left:auto;letter-spacing:2px;color:var(--signal);font-size:.85rem}
#tl-{{ uid }} .review::after{content:"";position:absolute;inset:0;pointer-events:none;
  background:linear-gradient(105deg,transparent 30%,rgba(255,255,255,.22) 48%,transparent 66%);transform:translateX(-120%)}

/* Video card */
#tl-{{ uid }} .vcard{position:relative;width:min(240px,100%);aspect-ratio:9/16;border-radius:20px;overflow:hidden;border:1px solid rgba(255,255,255,.3);margin:0;
  background:radial-gradient(120% 90% at 20% 10%,var(--navy-bright),var(--ink));
  box-shadow:0 30px 60px -20px rgba(5,10,40,.7),0 0 0 1px var(--signal-18);
  transform:translate(var(--dx,0),var(--py,0)) rotate(var(--rot,0deg));cursor:pointer}
#tl-{{ uid }} .vcard video,#tl-{{ uid }} .vcard .poster{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:opacity .4s}
#tl-{{ uid }} .vcard .fallback{position:absolute;inset:0;padding:22px;display:grid;align-content:center;font-family:var(--f-display);font-style:italic;font-size:1.6rem;line-height:1.15;text-wrap:balance}
#tl-{{ uid }} .vcard .shade{position:absolute;inset:auto 0 0;padding:44px 16px 16px;background:linear-gradient(transparent,rgba(8,12,40,.88));display:grid;gap:4px;margin:0}
#tl-{{ uid }} .vcard .shade .n{font-weight:500}
#tl-{{ uid }} .vcard .shade .q{font-size:.86rem;color:var(--fg-dim);line-height:1.35}
#tl-{{ uid }} .vcard .tags{position:absolute;top:12px;left:12px;display:flex;gap:6px;flex-wrap:wrap}
#tl-{{ uid }} .vcard .tags span{font-family:var(--f-mono);font-size:.6rem;letter-spacing:.08em;padding:4px 8px;border-radius:999px;background:rgba(8,12,40,.55);border:1px solid var(--line)}
#tl-{{ uid }} .vcard .snd{position:absolute;top:12px;right:12px;font-family:var(--f-mono);font-size:.6rem;letter-spacing:.08em;padding:4px 8px;border-radius:999px;background:var(--fg);color:var(--ink)}
#tl-{{ uid }} .vcard .snd[hidden]{display:none}
#tl-{{ uid }} .vcard .rec{position:absolute;top:40px;right:14px;width:8px;height:8px;border-radius:50%;background:#FF6B8A;box-shadow:0 0 10px #FF6B8A;opacity:0}
#tl-{{ uid }} .vcard.playing .rec{opacity:1;animation:tl-blink 1.4s steps(2) infinite}
@keyframes tl-blink{50%{opacity:.2}}
#tl-{{ uid }} .vcard .scan{position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(255,255,255,.05) 0 1px,transparent 1px 3px);mix-blend-mode:overlay}
#tl-{{ uid }} .vcard:focus-visible,#tl-{{ uid }} .cta-btn:focus-visible,#tl-{{ uid }} .brand:focus-visible{outline:2px solid var(--signal);outline-offset:4px}

/* Reveal states (only when JS + motion allowed) */
#tl-{{ uid }}.js .ev .review{opacity:0;filter:blur(10px);transition:opacity .8s cubic-bezier(.2,.7,.2,1),transform .9s cubic-bezier(.2,.7,.2,1),filter .8s}
#tl-{{ uid }}.js .ev.L .review{transform:translateX(-48px) scale(.96)}
#tl-{{ uid }}.js .ev.R .review{transform:translateX(48px) scale(.96)}
#tl-{{ uid }}.js .ev.in .review{opacity:1;filter:none;transform:none}
#tl-{{ uid }}.js .ev.in .review::after{animation:tl-sweep 1.2s .35s ease-out forwards}
@keyframes tl-sweep{to{transform:translateX(120%)}}
#tl-{{ uid }}.js .ev .vcard{clip-path:inset(50% 0 50% 0);opacity:0;transition:clip-path .9s cubic-bezier(.7,0,.2,1),opacity .3s}
#tl-{{ uid }}.js .ev.in .vcard{clip-path:inset(0 0 0 0);opacity:1;animation:tl-glitch .5s .5s steps(3)}
@keyframes tl-glitch{0%{filter:hue-rotate(60deg) saturate(2)}33%{filter:none;translate:3px 0}66%{filter:hue-rotate(-40deg);translate:-2px 0}100%{filter:none;translate:0}}
#tl-{{ uid }}.js .phase-head{opacity:0;transform:translateY(30px);transition:opacity .9s,transform .9s cubic-bezier(.2,.7,.2,1)}
#tl-{{ uid }}.js .phase-head.in{opacity:1;transform:none}

/* CTA */
#tl-{{ uid }} .cta{position:relative;max-width:760px;margin:0 auto;padding-block:60px 120px;text-align:center;display:grid;gap:20px;justify-items:center}
#tl-{{ uid }} .cta .tub{width:180px;max-width:100%;height:auto;border-radius:24px;filter:drop-shadow(0 30px 40px rgba(5,10,40,.6))}
#tl-{{ uid }} .cta h2{font-family:var(--f-body);color:var(--fg);margin:0;font-weight:500;font-size:clamp(2rem,5.5vw,3.6rem);line-height:1.05;letter-spacing:-.02em;text-wrap:balance}
#tl-{{ uid }} .cta h2 em{font-size:1.1em}
#tl-{{ uid }} .cta p{margin:0;max-width:52ch;color:var(--fg-dim);text-wrap:balance}
#tl-{{ uid }} .cta p strong{color:var(--fg)}
#tl-{{ uid }} .cta .eyebrow{color:var(--signal)}
#tl-{{ uid }} .cta-btn{display:inline-flex;align-items:center;gap:12px;padding:18px 30px;border-radius:999px;background:var(--fg);color:var(--ink);text-decoration:none;font-weight:600;font-size:1.05rem;box-shadow:0 0 0 0 var(--signal-55);transition:transform .2s,box-shadow .3s}
#tl-{{ uid }} .cta-btn:hover{transform:translateY(-2px);box-shadow:0 0 0 8px var(--signal-18);color:var(--ink)}
#tl-{{ uid }} .terms{display:flex;flex-wrap:wrap;justify-content:center;gap:8px 18px;color:var(--fg-dim)}
#tl-{{ uid }} .fine{max-width:70ch;margin:24px auto 0;color:var(--fg-faint);font-size:.75rem;line-height:1.5;text-align:center;padding-bottom:110px}
#tl-{{ uid }} .fine p{margin:0;font-size:inherit;color:inherit;line-height:inherit}

#tl-{{ uid }} .sticky{position:fixed;left:50%;bottom:calc(env(safe-area-inset-bottom,0px) + 18px);z-index:20;transform:translate(-50%,140%);transition:transform .5s cubic-bezier(.2,.7,.2,1)}
#tl-{{ uid }} .sticky.show{transform:translate(-50%,0)}
#tl-{{ uid }} .sticky .cta-btn{padding:14px 24px;font-size:.95rem;box-shadow:0 14px 40px -10px rgba(5,10,40,.7)}

/* Mobile: spine to the left, everything stacks on the right */
@media (max-width:760px){
  #tl-{{ uid }} .spine{left:14px}
  #tl-{{ uid }} .phase-head{margin-left:34px;text-align:left;justify-items:start;padding:22px 18px}
  #tl-{{ uid }} .ev{grid-template-columns:28px 1fr}
  #tl-{{ uid }} .ev .node{grid-column:1;grid-row:1}
  #tl-{{ uid }} .ev .slot.l,#tl-{{ uid }} .ev .slot.r{grid-column:2;grid-row:1;justify-content:flex-start!important}
  #tl-{{ uid }} .ev .slot:empty{display:none}
  #tl-{{ uid }} .ev .node::after{left:50%!important;right:auto!important;transform-origin:left!important;margin:0 0 0 6px!important;width:12px}
  #tl-{{ uid }}.js .ev.L .review,#tl-{{ uid }}.js .ev.R .review{transform:translateX(36px) scale(.97)}
  #tl-{{ uid }} .vcard{width:min(220px,78%);--dx:0px!important}
  #tl-{{ uid }} .readout .lbl,#tl-{{ uid }} .readout .bar{display:none}
}
@media (prefers-reduced-motion:reduce){
  #tl-{{ uid }} .cue i{animation:none}
}
</style>

<div id="tl-{{ uid }}" class="tl-page" data-phases="{{ phase_count }}">
  <canvas class="field" aria-hidden="true"></canvas>

  {%- if s.show_hud -%}
  <header class="hud">
    <a class="brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
      {%- if s.logo != blank -%}
        {{ s.logo | image_url: width: 300 | image_tag: alt: shop.name, loading: 'eager', widths: '150, 300' }}
      {%- else -%}
        <span>{{ shop.name }}</span>
      {%- endif -%}
    </a>
    <div class="readout" aria-live="off">
      <span class="mono lbl">{{ s.hud_label }}</span>
      <span class="wk" data-wk>00</span>
      <span class="bar" data-wkbar><i></i></span>
    </div>
  </header>
  {%- endif -%}

  <main class="tl-main">
    <section class="hero">
      {%- if s.eyebrow != blank -%}<span class="mono eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
      <h1>{{ s.heading }}</h1>
      {%- if s.intro != blank -%}<p>{{ s.intro }}</p>{%- endif -%}
      {%- if s.spec_chips != blank -%}
      <div class="spec mono">
        {%- assign chips = s.spec_chips | split: '|' -%}
        {%- for c in chips -%}<span>{{ c | strip }}</span>{%- endfor -%}
      </div>
      {%- endif -%}
      {%- if s.cue_label != blank -%}<div class="cue"><span class="mono">{{ s.cue_label }}</span><i></i></div>{%- endif -%}
    </section>

    <section class="timeline" data-timeline>
      <div class="spine" aria-hidden="true"><div class="fill"></div><div class="tip"></div></div>
      <div class="phases">
        {%- assign side = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type != 'phase' -%}{%- continue -%}{%- endif -%}
          <div class="phase" data-start="{{ block.settings.week_start }}" data-end="{{ block.settings.week_end }}" {{ block.shopify_attributes }}>
            <header class="phase-head">
              {%- if block.settings.chip != blank -%}<span class="chip"><b>{{ block.settings.chip }}</b></span>{%- endif -%}
              <h2>{{ block.settings.heading }}</h2>
              {%- if block.settings.note != blank -%}
              <p class="note">{%- if block.settings.note_label != blank -%}<span class="mono">{{ block.settings.note_label }}</span>{%- endif -%}{{ block.settings.note }}</p>
              {%- endif -%}
            </header>
            <div class="events">
              {%- for ev in section.blocks offset: forloop.index -%}
                {%- if ev.type == 'phase' -%}{%- break -%}{%- endif -%}
                {%- assign sidecls = 'L' -%}
                {%- assign mod = side | modulo: 2 -%}
                {%- if mod == 1 -%}{%- assign sidecls = 'R' -%}{%- endif -%}
                {%- assign side = side | plus: 1 -%}
                {%- capture inner -%}
                  {%- if ev.type == 'review' -%}
                    <article class="review" {{ ev.shopify_attributes }}>
                      <blockquote>{{ ev.settings.quote }}</blockquote>
                      <div class="who">
                        <span class="av">
                          {%- if ev.settings.avatar != blank -%}
                            {{ ev.settings.avatar | image_url: width: 76 | image_tag: alt: '', loading: 'lazy', widths: '38, 76' }}
                          {%- else -%}
                            {{ ev.settings.name | truncate: 1, '' | upcase }}
                          {%- endif -%}
                        </span>
                        <span><span class="n">{{ ev.settings.name }}</span><span class="v">{{ s.verified_label }}</span></span>
                        <span class="stars" aria-label="5 stars">★★★★★</span>
                      </div>
                    </article>
                  {%- elsif ev.type == 'video' -%}
                    {%- liquid
                      assign v = ev.settings.video
                      assign src = ''
                      if v != blank
                        for source in v.sources
                          if source.format == 'mp4'
                            assign src = source.url
                            break
                          endif
                        endfor
                        if src == '' and v.sources.size > 0
                          assign src = v.sources.first.url
                        endif
                      elsif ev.settings.video_url != blank
                        assign src = ev.settings.video_url
                      endif
                      assign poster = ev.settings.poster
                      if poster == blank and v != blank
                        assign poster = v.preview_image
                      endif
                    -%}
                    <figure class="vcard" tabindex="0" role="button" aria-label="Play {{ ev.settings.name | escape }}'s story" {{ ev.shopify_attributes }}>
                      <div class="fallback">{{ ev.settings.quote }}</div>
                      {%- if poster != blank -%}{{ poster | image_url: width: 500 | image_tag: class: 'poster', alt: '', loading: 'lazy', widths: '250, 500' }}{%- endif -%}
                      {%- if src != '' -%}
                      <video muted loop playsinline preload="none" data-src="{{ src }}">
                        {%- if ev.settings.captions != blank -%}<track kind="captions" src="{{ ev.settings.captions }}" srclang="{{ ev.settings.captions_lang | default: 'en' }}" label="{{ ev.settings.captions_label | default: 'English' }}">{%- endif -%}
                      </video>
                      {%- endif -%}
                      <div class="scan"></div>
                      {%- if ev.settings.tags != blank -%}
                      <div class="tags">{%- assign tags = ev.settings.tags | split: ',' -%}{%- for t in tags -%}<span>{{ t | strip }}</span>{%- endfor -%}</div>
                      {%- endif -%}
                      <span class="snd" hidden>{{ s.sound_off_label }}</span><span class="rec"></span>
                      <figcaption class="shade"><span class="n">{{ ev.settings.name }}</span><span class="q">{{ ev.settings.quote }}</span></figcaption>
                    </figure>
                  {%- endif -%}
                {%- endcapture -%}
                <div class="ev {{ sidecls }}">
                  <div class="slot l">{% if sidecls == 'L' %}{{ inner }}{% endif %}</div>
                  <div class="node"></div>
                  <div class="slot r">{% if sidecls == 'R' %}{{ inner }}{% endif %}</div>
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </section>

    <section class="cta" id="start" data-cta>
      {%- if s.tub != blank -%}
        {{ s.tub | image_url: width: 600 | image_tag: class: 'tub', alt: s.tub.alt | default: 'Bodology Inositol tub', loading: 'lazy', widths: '180, 360, 600' }}
      {%- endif -%}
      {%- if s.cta_eyebrow != blank -%}<span class="mono eyebrow">{{ s.cta_eyebrow }}</span>{%- endif -%}
      <h2>{{ s.cta_heading }}</h2>
      {%- if s.cta_text != blank -%}<p>{{ s.cta_text }}</p>{%- endif -%}
      <a class="cta-btn" href="{{ cta_url }}">{{ s.cta_label }} <span aria-hidden="true">→</span></a>
      {%- if s.terms != blank -%}
      <div class="terms mono">{%- assign terms = s.terms | split: '|' -%}{%- for t in terms -%}<span>{{ t | strip }}</span>{%- endfor -%}</div>
      {%- endif -%}
    </section>
    {%- if s.fine_print != blank -%}<div class="fine">{{ s.fine_print }}</div>{%- endif -%}
  </main>

  {%- if s.show_sticky -%}
  <div class="sticky" data-sticky><a class="cta-btn" href="{{ cta_url }}">{{ s.cta_label }} <span aria-hidden="true">→</span></a></div>
  {%- endif -%}
</div>

<script>
(function(){
  var root = document.getElementById("tl-{{ uid }}");
  if(!root || root.dataset.init) return; root.dataset.init = "1";
  var reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  var inEditor = !!(window.Shopify && Shopify.designMode);
  if(!reduce) root.classList.add("js");

  // Deterministic "random" so video placement is stable between visits
  var seed = 7; function rnd(){ seed = (seed*16807) % 2147483647; return seed/2147483647; }
  var cards = [].slice.call(root.querySelectorAll(".vcard"));
  cards.forEach(function(c){
    var dx = Math.round((rnd()*2-1)*46)+"px", rot = ((rnd()*2-1)*4).toFixed(1)+"deg", par = (0.05+rnd()*0.08).toFixed(3);
    c.style.setProperty("--dx",dx); c.style.setProperty("--rot",rot); c.dataset.par = par;
  });

  // Reveal on scroll
  var targets = root.querySelectorAll(".ev,.phase-head");
  if(reduce || inEditor){ targets.forEach(function(el){ el.classList.add("in"); }); }
  else {
    var revealIO = new IntersectionObserver(function(es){
      es.forEach(function(en){ if(en.isIntersecting){ en.target.classList.add("in"); revealIO.unobserve(en.target);} });
    },{rootMargin:"0px 0px -12% 0px",threshold:.2});
    targets.forEach(function(el){ revealIO.observe(el); });
  }

  // Videos: load when near, play when visible, pause when gone
  var vidIO = new IntersectionObserver(function(es){
    es.forEach(function(en){
      var card = en.target, vid = card.querySelector("video"); if(!vid) return;
      if(en.isIntersecting){
        if(!vid.src){ vid.src = vid.dataset.src; }
        if(!reduce) vid.play().then(function(){ card.classList.add("playing"); card.querySelector(".snd").hidden = false; }).catch(function(){});
      } else { vid.pause(); card.classList.remove("playing"); }
    });
  },{threshold:.45});
  cards.forEach(function(card){
    var vid = card.querySelector("video"); if(!vid) return;
    vid.addEventListener("error",function(){ vid.remove(); },{once:true});
    vid.addEventListener("loadeddata",function(){ var p = card.querySelector(".poster"); if(p) p.style.opacity = 0; });
    vidIO.observe(card);
    var toggle = function(){
      if(!vid.isConnected) return;
      if(!vid.src) vid.src = vid.dataset.src;
      if(vid.paused){ vid.muted = false; vid.play().catch(function(){}); card.classList.add("playing"); }
      else if(vid.muted){ vid.muted = false; }
      else { vid.muted = true; }
      card.querySelector(".snd").textContent = vid.muted ? {{ s.sound_off_label | json }} : {{ s.sound_on_label | json }};
    };
    card.addEventListener("click",toggle);
    card.addEventListener("keydown",function(e){ if(e.key==="Enter"||e.key===" "){ e.preventDefault(); toggle(); } });
  });

  // Scroll-linked: spine fill, week readout, video parallax, sticky CTA
  var tl = root.querySelector("[data-timeline]"), wk = root.querySelector("[data-wk]"), wkbar = root.querySelector("[data-wkbar]");
  var phases = [].slice.call(root.querySelectorAll(".phase")), sticky = root.querySelector("[data-sticky]"), cta = root.querySelector("[data-cta]");
  var maxWeek = phases.reduce(function(m,ph){ return Math.max(m, parseFloat(ph.dataset.start)||0); }, 0);
  var ticking = false;
  function frame(){
    ticking = false;
    var vh = innerHeight, mid = vh*0.55;
    var r = tl.getBoundingClientRect();
    var p = Math.min(1,Math.max(0,(mid - r.top)/r.height));
    tl.style.setProperty("--p",p.toFixed(4));

    var week = 0;
    phases.forEach(function(ph){
      var b = ph.getBoundingClientRect(), a = parseFloat(ph.dataset.start)||0, z = parseFloat(ph.dataset.end)||a;
      if(b.top <= mid) week = a + Math.min(1,Math.max(0,(mid-b.top)/b.height))*(z-a);
    });
    if(wk) wk.textContent = (maxWeek > 0 && week >= maxWeek) ? maxWeek+"+" : String(Math.max(0,Math.ceil(week))).padStart(2,"0");
    if(wkbar) wkbar.style.setProperty("--p",Math.min(1,week/(maxWeek||12)).toFixed(3));

    if(!reduce) cards.forEach(function(c){
      var b = c.getBoundingClientRect(); if(b.bottom<-200||b.top>vh+200) return;
      c.style.setProperty("--py", (((b.top+b.height/2)-vh/2)*-parseFloat(c.dataset.par)).toFixed(1)+"px");
    });

    if(sticky){ var cr = cta.getBoundingClientRect(); sticky.classList.toggle("show", r.top < vh*0.2 && cr.top > vh*0.9); }
  }
  var onScroll = function(){ if(!ticking){ ticking = true; requestAnimationFrame(frame);} };
  addEventListener("scroll",onScroll,{passive:true}); addEventListener("resize",onScroll); frame();

  // Ambient particle field
  var cv = root.querySelector(".field"), ctx = cv.getContext("2d");
  var W,H,dpr,pts=[];
  function size(){ dpr=Math.min(2,devicePixelRatio||1); W=cv.width=innerWidth*dpr; H=cv.height=innerHeight*dpr;
    pts = Array.from({length: Math.round(Math.min(90, innerWidth/14))},function(){ return {x:Math.random()*W,y:Math.random()*H,r:(Math.random()*1.4+.4)*dpr,s:(Math.random()*.25+.05)*dpr,a:Math.random()*.45+.08}; }); }
  size(); addEventListener("resize",size);
  var lastY = scrollY, vel = 0;
  function draw(){
    ctx.clearRect(0,0,W,H);
    vel = vel*0.9 + (scrollY-lastY)*0.1; lastY = scrollY;
    for(var i=0;i<pts.length;i++){ var p = pts[i];
      p.y -= p.s + vel*0.15*dpr*(p.r/dpr);
      if(p.y < -10) p.y = H+10; if(p.y > H+10) p.y = -10;
      ctx.beginPath(); ctx.arc(p.x,p.y,p.r,0,6.283);
      ctx.fillStyle = "rgba(214,222,255,"+p.a+")"; ctx.fill();
    }
    if(!reduce) requestAnimationFrame(draw);
  }
  draw();
})();
</script>

