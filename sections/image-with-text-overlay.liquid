{{- 'image-with-text-overlay.css' | asset_url | stylesheet_tag -}}
{{- 'customer-reviews.css' | asset_url | stylesheet_tag -}}
{{- 'collapsible-content.css' | asset_url | stylesheet_tag -}}

{%- liquid
	assign full_width = section.settings.full_width
	assign image = section.settings.image
	assign mobile_image = section.settings.mobile_image
	assign image_parallax = section.settings.image_parallax
	assign desktop_height = section.settings.desktop_height
	assign mobile_height = section.settings.mobile_height

	assign content_width = section.settings.content_width
	assign content_position = section.settings.content_position
	assign text_alignment = section.settings.text_alignment

	assign text_color = section.settings.text_color
	assign overlay_color = section.settings.overlay_color
	assign overlay_opacity = section.settings.overlay_opacity

	assign disable_top_spacing = section.settings.disable_top_spacing
	assign disable_bottom_spacing = section.settings.disable_bottom_spacing

	comment
		"Fit the image": on phones the section takes the mobile image's own aspect ratio, so the whole
		photo shows at full width with no crop (the section only grows beyond that if the text needs it).
	endcomment
	assign hero_m_ratio = 0
	if mobile_image
		assign hero_m_ratio = mobile_image.aspect_ratio
	elsif image
		assign hero_m_ratio = image.aspect_ratio
	endif
	case mobile_height
		when 'mobile-height-fit'
			if hero_m_ratio > 0
				assign mobile_image_height = 900 | divided_by: hero_m_ratio | round
			else
				assign mobile_image_height = 900
			endif
		when 'mobile-height-350'
			assign mobile_image_height = 350
		when 'mobile-height-400'
			assign mobile_image_height = 400
		when 'mobile-height-450'
			assign mobile_image_height = 450
		when 'mobile-height-500'
			assign mobile_image_height = 500
		else
			assign mobile_image_height = 900
	endcase

	assign priority = false

	if section.index == 1
		assign priority = 'high'
	endif
-%}

<div class="row {% if full_width %}full-width-row-full{% endif %}">
	<div class="small-12 columns">
		<div class="image-with-text-overlay image-with-text-overlay--full-width-{{ full_width }} text-{{ text_alignment }} {{ mobile_height }} {{ desktop_height }} section-spacing{% if disable_top_spacing %} section-spacing--disable-top{% endif %}{% if disable_bottom_spacing %} section-spacing--disable-bottom{% endif %}" style=" --overlay-color-rgb: {{ overlay_color.rgb | replace: ' ' , ',' }}; --overlay-opacity: {{ overlay_opacity | divided_by: 100.0 }};{% if hero_m_ratio > 0 %} --hero-m-ratio: {{ hero_m_ratio }};{% endif %}">
			<div class="image-with-text-overlay--bg parallax--{{ image_parallax }}" >
				{% if image %}
					{%- liquid
						assign small_width = image.src.height | times: '375' | divided_by: image.src.width
						assign master_width = image.src.width | append: 'x' | append: image.src.height
						assign width = '375x' | append: small_width | append: ',' | append: master_width

						assign class = ''
						if image_parallax
							assign class = 'thb-parallax-image'
						endif

						if mobile_image
							assign class = class | append: ' image-with-text-overlay--desktop'
						endif
					-%}
					{%- render 'responsive-image', image: image, sizes: width, class: class, priority: priority -%}
				{% else %}
					{{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder_svg_tag' }}
				{% endif %}
				{%- if mobile_image -%}
					{%- liquid
						assign image = mobile_image
						assign master_width = image.src.width | append: 'x' | append: image.src.height
						assign width = '900x' | append: mobile_image_height | append: ',' | append: master_width

						assign class = ''
						if image_parallax
							assign class = 'thb-parallax-image'
						endif

						assign class = class | append: ' image-with-text-overlay--mobile'
						render 'responsive-image', image: image, sizes: width, class: class, priority: priority
					-%}
				{%- endif -%}
			</div>

			<div class="image-with-text-overlay--content content-{{ content_position }}">
				<div class="image-with-text-overlay--content-inner content-width-{{ content_width }}">
					{% for block in section.blocks %}
						{%- case block.type -%}
							{%- when 'text-button' -%}
								{% render 'text-button', url: block.settings.link, title: block.settings.link_label %}
							{%- when 'badge' -%}
								<div {{ block.shopify_attributes }}>
									<span class="inline-badge" style="--badge-bg: {{ block.settings.color_bg }};--badge-text: {{ block.settings.color_text }}">{{ block.settings.text }}</span>
								</div>
							{%- when 'subheading' -%}
								<div class="tagline{% if block.settings.pill_match %} tagline--match{% endif %}" style="color: {{ block.settings.text_color }};{% if block.settings.pill_match %} --pill-color: {{ block.settings.text_color }};{% endif %}" {{ block.shopify_attributes }}>
									{{ block.settings.text | replace: '&lt;i&gt;', '<i>' | replace: '&lt;/i&gt;', '</i>' }}
								</div>
							{%- when 'heading' -%}
								{%- liquid
									assign heading_html = block.settings.text | newline_to_br | replace: '&lt;i&gt;', '<i>' | replace: '&lt;/i&gt;', '</i>'
									if block.settings.show_star
										comment
											Small star top-right of the text: a fixed-size SVG slotted just inside the LAST closing tag
											(so it hugs the final word instead of dropping onto its own line), vertical-align top.
										endcomment
										capture star_html
											echo '<span class="hero-star" style="--star-size: ' | append: block.settings.star_size | append: 'px; --star-color: ' | append: block.settings.star_color | append: ';" aria-hidden="true">*</span>'
										endcapture
										assign star_parts = heading_html | split: '</'
										if star_parts.size > 1
											capture heading_html
												for part in star_parts
													if forloop.first
														echo part
													elsif forloop.last
														echo star_html | append: '</' | append: part
													else
														echo '</' | append: part
													endif
												endfor
											endcapture
										else
											assign heading_html = heading_html | append: star_html
										endif
									endif
								-%}
								<div class="{{ block.settings.heading_size }}" {{ block.shopify_attributes }} style="--text-color: {{ block.settings.heading_color }};{% if block.settings.heading_size_mobile > 0 %} --hero-h-m: {{ block.settings.heading_size_mobile }}px;{% endif %}{% if block.settings.heading_size_desktop > 0 %} --hero-h-d: {{ block.settings.heading_size_desktop }}px;{% endif %}{% if block.settings.pad_right_desktop > 0 %} --hero-h-pr: {{ block.settings.pad_right_desktop }}px;{% endif %}">{{ heading_html }}</div>
							{%- when 'text' -%}
  <div
  class="rte description-size--{{ block.settings.description_size }}"
  style="--description-color: {{ block.settings.description_color }}; --rte-pad-top: {{ block.settings.pad_top | default: 0 }}px; --rte-pad-right: {{ block.settings.pad_right | default: 0 }}px; --rte-pad-bottom: {{ block.settings.pad_bottom | default: 0 }}px; --rte-pad-left: {{ block.settings.pad_left | default: 0 }}px;"
  {{ block.shopify_attributes }}
>
  {{ block.settings.text }}
</div>

{%- when 'custom_html' -%}
  <div class="custom-html-block" {{ block.shopify_attributes }}>
    {{ block.settings.html }}
  </div>


								
							{%- when 'customer_reviews' -%}
								<div {{ block.shopify_attributes }} class="customer-reviews--block" >
									<div class="customer-reviews--content">
										{%- if block.settings.stars != blank -%}{%- render 'bod-stars', rating: block.settings.stars, count: 1, style: 'chunky', size: 19, gap: 2, color_on: '#ddbd6d', color_off: '#e6e6e6', show_label: false, link: false, margin_bottom: 0, uid: block.id -%}{%- endif -%}
										<a title="{{ block.settings.heading }}" class="text-button text-button--has-icon" role="link" style="font-size:{{ block.settings.font_size }}!important; margin-left:5px;" href="{{ block.settings.link }}" {% if block.settings.link == blank %}aria-disabled="true"{% endif %} >{{ block.settings.heading }}<span style="margin-left:6px;">{% render 'svg-icons' with 'thb-caret-right' %}</span></a>
										<p>{{ block.settings.text | newline_to_br }}</p>
									</div>
								</div>
							{%- when 'button' -%}
								{% if block.settings.button_text != blank %}
									<a class="button {{ block.settings.button_color }}{% if block.settings.button_icon == 'chevron' %} button--chevron{% endif %}{% if block.settings.center_mobile %} button--center-m{% endif %}" href="{{ block.settings.button_link }}" role="button" {{ block.shopify_attributes }}>{{ block.settings.button_text }}{% if block.settings.button_icon == 'chevron' %}<svg class="button__chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 3.5l4.5 4.5L6 12.5"/></svg>{% endif %}</a>
									{%- if block.settings.show_guarantee or block.settings.show_shipping -%}
									<div class="hero-notes"{% if block.settings.note_color != blank %} style="color: {{ block.settings.note_color }};"{% endif %}>
										{%- if block.settings.show_guarantee -%}
										<span class="hero-note"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg><span>{{ block.settings.guarantee_text | default: '60-day money-back guarantee' }}</span></span>
										{%- endif -%}
										{%- if block.settings.show_shipping -%}
										<span class="hero-note"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="1.8"/><circle cx="17.5" cy="18" r="1.8"/></svg><span>{{ block.settings.shipping_text | default: 'Free shipping' }}</span></span>
										{%- endif -%}
									</div>
									{%- endif -%}
								{% endif %}
							{%- when 'bod_stars' -%}
								{%- comment -%} same custom star rating as the buy box (Junip rating + "X.X Stars (Read Reviews)"), reads the page's product {%- endcomment -%}
								<div class="hero-stars" {{ block.shopify_attributes }}>
									{% render 'bod-stars',
										product: product,
										style: block.settings.star_style,
										size: block.settings.star_size,
										gap: block.settings.star_gap,
										round: block.settings.star_round,
										color_on: block.settings.color_on,
										color_off: block.settings.color_off,
										show_label: block.settings.show_label,
										label_text: block.settings.label_text,
										cta_text: block.settings.cta_text,
										hide_number: block.settings.hide_number,
										label_color: block.settings.label_color,
										label_size: block.settings.label_size,
										label_weight: block.settings.label_weight,
										label_gap: block.settings.label_gap,
										alignment: block.settings.alignment,
										margin_top: block.settings.margin_top,
										margin_bottom: block.settings.margin_bottom,
										link: true,
										uid: block.id %}
								</div>
							{%- when 'benefits' -%}
								<div class="benefits-block{% if block.settings.frosted %} benefits-block--frosted{% endif %}" style="--bn-icon-gap: {{ block.settings.icon_gap | default: 10 }}px; --bn-fs-m: {{ block.settings.text_size_mobile | default: 15 }}px; --bn-pad-m: {{ block.settings.item_padding_mobile | default: 8 }}px; --bn-tint: {{ block.settings.frosted_tint | default: 25 | divided_by: 100.0 }}; --bn-blur: {{ block.settings.frosted_blur | default: 10 }}px; --bn-radius: {{ block.settings.frosted_radius | default: 16 }}px;" {{ block.shopify_attributes }}>
									
									<div class="benefits-list">
										{% if block.settings.benefits-title != blank %}
										{%comment%}<div id="title"><strong>{{ block.settings.benefits-title }}</strong></div> {% endcomment %}
									{% endif %}
                          {% for i in (1..3) %}
											{%- assign benefit_key = "benefit_" | append: i -%}
											{%- assign icon_key = "icon_" | append: i -%}
											{% assign benefit = block.settings[benefit_key] %}
											{% assign icon = block.settings[icon_key] %}
											{% if benefit %}
												<div class="benefit-item" style="{% if benefit != blank %}color: {{ block.settings.text_color | default: block.settings.border_color }}; border-bottom: {{ block.settings.border_size }}px solid {{ block.settings.border_color }};{% else %} height:0px;margin:0px;padding:0px; {% endif %}">
													{% if icon %}
														<img src="{{ icon | image_url }}" style="width: {{ block.settings.icon_size }}px;" class="benefit-icon" alt=""/>
													{% else %}
														<svg class="benefit-icon benefit-icon--tick" style="width: {{ block.settings.icon_size }}px; height: {{ block.settings.icon_size }}px; color: {{ block.settings.text_color | default: '#1a2874' }};" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6.5 12.5l3.6 3.6L17.5 8"/></svg>
													{% endif %}
													<span>{{ benefit }}</span>
												</div>
											{% endif %}
										{% endfor %}
									</div>
								</div>
							{%- when 'roundel' -%}
								{%- comment -%} Roundel badge: sits on the right half of the banner, positioned separately for desktop and phones {%- endcomment -%}
								{%- if block.settings.text != blank -%}
								{%- liquid
									assign rd_link = block.settings.link_text | strip
									assign rd_tag = 'div'
									if rd_link != blank
										assign rd_tag = 'button'
									endif
								-%}
								<{{ rd_tag }}{% if rd_tag == 'button' %} type="button" data-hero-roundel-open="hero-modal-{{ block.id }}" aria-haspopup="dialog"{% endif %} class="hero-roundel hero-roundel--{{ block.settings.style | default: 'solid' }} hero-roundel--anchor-{{ block.settings.anchor | default: 'right-half' }}{% if rd_link != blank %} hero-roundel--link{% endif %}" {{ block.shopify_attributes }}
									style="--rd-text: {{ block.settings.text_color }}; --rd-bg: {% if block.settings.use_gradient and block.settings.bg_gradient != blank %}{{ block.settings.bg_gradient }}{% else %}{{ block.settings.bg_color }}{% endif %}; --rd-bg-solid: {{ block.settings.bg_color }}; --rd-border: {{ block.settings.border_color }}; --rd-bw: {{ block.settings.border_width }}px; --rd-pad: {{ block.settings.text_padding | default: 0 }}px; --rd-drop: {% if block.settings.shadow_color != blank and block.settings.shadow_color != 'rgba(0,0,0,0)' and block.settings.shadow_offset != 0 %}{{ block.settings.shadow_offset | default: 3 }}px {{ block.settings.shadow_offset | default: 3 }}px 2px 0 {{ block.settings.shadow_color }}{% else %}0 0 0 0 transparent{% endif %};
										--rd-size-d: {{ block.settings.size_desktop }}px; --rd-size-m: {{ block.settings.size_mobile }}px; --rd-fs-d: {{ block.settings.text_size_desktop }}px; --rd-fs-m: {{ block.settings.text_size_mobile }}px;
										--rd-x-d: {{ block.settings.x_desktop }}; --rd-y-d: {{ block.settings.y_desktop }}; --rd-x-m: {{ block.settings.x_mobile }}; --rd-y-m: {{ block.settings.y_mobile }}; --rd-xpx-d: {{ block.settings.x_desktop_px | default: 0 }}px; --rd-xpx-m: {{ block.settings.x_mobile_px | default: 0 }}px; --rd-rotate: {{ block.settings.rotate }}deg;">
									<span class="hero-roundel__text">{{ block.settings.text | newline_to_br }}{% if rd_link != blank %}<span class="hero-roundel__link">{{ rd_link }}</span>{% endif %}</span>
								</{{ rd_tag }}>
								{%- if rd_link != blank -%}
								{%- comment -%} pop-up (same look as the buy box pop-ups): friendly copy, then the study detail in small print {%- endcomment -%}
								<div class="hero-modal" id="hero-modal-{{ block.id }}" hidden>
									<div class="hero-modal__ov" data-hero-modal-close></div>
									<div class="hero-modal__box" role="dialog" aria-modal="true" aria-label="{{ block.settings.popup_title | default: 'The study' | escape }}">
										<button type="button" class="hero-modal__x" data-hero-modal-close aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
										{%- if block.settings.popup_title != blank -%}<h3 class="hero-modal__t">{{ block.settings.popup_title }}</h3>{%- endif -%}
										<div class="hero-modal__body">{{ block.settings.popup_text }}</div>
										{%- if block.settings.popup_small != blank -%}<p class="hero-modal__small">{{ block.settings.popup_small | newline_to_br }}</p>{%- endif -%}
										<div class="hero-modal__links"><button type="button" class="hero-modal__link" data-hero-modal-close>Close</button></div>
									</div>
								</div>
								<script>
								(function () {
									var btn = document.querySelector('[data-hero-roundel-open="hero-modal-{{ block.id }}"]'), modal = document.getElementById('hero-modal-{{ block.id }}');
									if (!btn || !modal || btn.dataset.bound) { return; } btn.dataset.bound = '1';
									function open() { modal.hidden = false; document.documentElement.style.overflow = 'hidden'; var x = modal.querySelector('.hero-modal__x'); if (x) { x.focus(); } }
									function close() { modal.hidden = true; document.documentElement.style.overflow = ''; btn.focus(); }
									btn.addEventListener('click', function (e) { e.preventDefault(); open(); });
									modal.querySelectorAll('[data-hero-modal-close]').forEach(function (b) { b.addEventListener('click', close); });
									document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !modal.hidden) { close(); } });
								})();
								</script>
								{%- endif -%}
								{%- endif -%}
							{% when 'space' %}
								<div style="height: {{ block.settings.height | append: 'px' }}" {{ block.shopify_attributes }}></div>
						{%- endcase -%}
					{% endfor %}
				</div>
			</div>
		</div>
	</div>
</div>

<script src="{{ 'image-with-text-overlay.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Image with text overlay",
  "class": "section-image-with-text-overlay",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "2800 x 650 .jpg recommended."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image (optional)",
      "info": "375 x 650 .jpg recommended."
    },
    {
      "type": "checkbox",
      "id": "image_parallax",
      "default": false,
      "label": "Enable parallax",
      "info": "Animations must be enabled in theme settings"
    },
    {
      "type": "select",
      "id": "desktop_height",
      "label": "Desktop height",
      "options": [
        {
          "value": "desktop-height-450",
          "label": "450px"
        },
        {
          "value": "desktop-height-550",
          "label": "550px"
        },
        {
          "value": "desktop-height-650",
          "label": "650px"
        },
        {
          "value": "desktop-height-750",
          "label": "750px"
        },
        {
          "value": "desktop-height-full",
          "label": "Full screen"
        }
      ],
      "default": "desktop-height-650"
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "Mobile height",
      "options": [
        {
          "value": "mobile-height-auto",
          "label": "Adapt to content"
        },
        {
          "value": "mobile-height-fit",
          "label": "Fit the image (no crop)"
        },
        {
          "value": "mobile-height-350",
          "label": "350px"
        },
        {
          "value": "mobile-height-400",
          "label": "400px"
        },
        {
          "value": "mobile-height-450",
          "label": "450px"
        },
        {
          "value": "mobile-height-500",
          "label": "500px"
        },
        {
          "value": "mobile-height-full",
          "label": "Full screen"
        }
      ],
      "default": "mobile-height-500"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make section full width",
      "default": true
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        {
          "value": "top-left",
          "label": "Top left"
        },
        {
          "value": "top-center",
          "label": "Top center"
        },
        {
          "value": "top-right",
          "label": "Top right"
        },
        {
          "value": "middle-left",
          "label": "Middle left"
        },
        {
          "value": "middle-center",
          "label": "Middle center"
        },
        {
          "value": "middle-right",
          "label": "Middle right"
        },
        {
          "value": "bottom-left",
          "label": "Bottom left"
        },
        {
          "value": "bottom-center",
          "label": "Bottom center"
        },
        {
          "value": "bottom-right",
          "label": "Bottom right"
        }
      ],
      "default": "bottom-center"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Content alignment"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Overlay",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "disable_top_spacing",
      "default": false,
      "label": "Remove top spacing"
    },
    {
      "type": "checkbox",
      "id": "disable_bottom_spacing",
      "default": false,
      "label": "Remove bottom spacing"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Badge heading"
        },
        {
          "type": "color",
          "id": "color_bg",
          "label": "Background",
          "default": "#3f72e5"
        },
        {
          "type": "color",
          "id": "color_text",
          "label": "Text",
          "default": "#ffffff"
        }
      ]
    },
    {
      "type": "subheading",
