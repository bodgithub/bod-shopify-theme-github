{%- comment -%}
  Bodology · Why Inositol
  Two-column card: left column built from blocks (text, accordions with
  capsule chips, small-print footer), right column a 2-up stat grid with
  cross hairlines and a pill CTA. "Contained" toggle wraps everything in
  a rounded card (background image inside the card); off = full width
  (image spans the section). Background image blur 0–80. Clinical
  palette on navy by default; every color and size editable.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign stat_count = 0
  for block in section.blocks
    if block.type == 'stat'
      assign stat_count = stat_count | plus: 1
    endif
  endfor
-%}

{% style %}
  #shopify-section-{{ section.id }} .wi {
    background: {{ s.page_bg }};
    padding: {{ s.pad_top }}px {% if s.contained %}20px{% else %}0{% endif %} {{ s.pad_bottom }}px;
    margin: {{ s.margin_top | default: 0 }}px 0 {{ s.margin_bottom | default: 0 }}px;
  }
  #shopify-section-{{ section.id }} .wi__card {
    position: relative;
    overflow: hidden;
    background: {{ s.card_bg }};
    color: {{ s.text_color }};
    {% if s.contained %}
    max-width: {{ s.max_width }}px;
    margin: 0 auto;
    border-radius: 24px;
    {% endif %}
  }
  {% if s.bg_image != blank %}
  #shopify-section-{{ section.id }} .wi__bg {
    position: absolute;
    inset: -{{ s.bg_blur | times: 0.5 | plus: 10 }}px;
    background-image: url('{{ s.bg_image | image_url: width: 2200 }}');
    background-size: cover;
    background-position: center;
    filter: blur({{ s.bg_blur | times: 0.4 }}px);
  }
  #shopify-section-{{ section.id }} .wi__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: {{ s.overlay_color }};
    opacity: {{ s.overlay_opacity | divided_by: 100.0 }};
  }
  {% endif %}
  #shopify-section-{{ section.id }} .wi__in {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    padding: 64px 56px;
    {% unless s.contained %}
    max-width: {{ s.max_width }}px;
    margin: 0 auto;
    {% endunless %}
  }
  #shopify-section-{{ section.id }} .wi__text { font-size: {{ s.body_size }}px; line-height: 1.55; }
  #shopify-section-{{ section.id }} .wi__text p { margin: 0 0 10px; font-size: inherit; line-height: inherit; color: inherit; }
  #shopify-section-{{ section.id }} .wi__text p:last-child { margin-bottom: 0; }
  #shopify-section-{{ section.id }} .wi__block { margin-bottom: 26px; }
  #shopify-section-{{ section.id }} .wi__block:last-child { margin-bottom: 0; }
  #shopify-section-{{ section.id }} .wi__acc {
    border-top: 1px solid {{ s.line_color }};
    border-bottom: 1px solid {{ s.line_color }};
  }
  #shopify-section-{{ section.id }} .wi__acc + .wi__acc { border-top: 0; margin-top: -26px; }
  #shopify-section-{{ section.id }} .wi__acc summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    cursor: pointer;
    padding: 16px 0;
    font-size: 13px;
    letter-spacing: 0.02em;
  }
  #shopify-section-{{ section.id }} .wi__acc summary::-webkit-details-marker { display: none; }
  #shopify-section-{{ section.id }} .wi__acc summary svg { width: 14px; height: 14px; flex: 0 0 auto; transition: transform .2s; }
  #shopify-section-{{ section.id }} .wi__acc[open] summary svg { transform: rotate(180deg); }
  #shopify-section-{{ section.id }} .wi__acc-body { padding: 2px 0 20px; }
  #shopify-section-{{ section.id }} .wi__chips { display: flex; flex-wrap: wrap; gap: 10px; }
  #shopify-section-{{ section.id }} .wi__chip {
    border: 1px solid {{ s.line_color }};
    border-radius: 8px;
    padding: 9px 14px;
    font-size: {{ s.body_size | times: 0.95 | round }}px;
    line-height: 1.3;
  }
  #shopify-section-{{ section.id }} .wi__acc-text { margin-top: 14px; font-size: {{ s.body_size }}px; line-height: 1.55; }
  #shopify-section-{{ section.id }} .wi__acc-text p { margin: 0 0 8px; font-size: inherit; color: inherit; }
  #shopify-section-{{ section.id }} .wi__acc-text p:last-child { margin-bottom: 0; }
  #shopify-section-{{ section.id }} .wi__foot { font-size: {{ s.body_size | times: 0.82 | round }}px; line-height: 1.55; opacity: .75; }
  #shopify-section-{{ section.id }} .wi__foot p { margin: 0; font-size: inherit; color: inherit; }
  /* "See the studies" link inside the footer + its pop-up (same look as the buy-box pop-ups) */
  #shopify-section-{{ section.id }} .wi__studies { appearance: none; background: none; border: 0; padding: 0; margin: 0; font: inherit; color: inherit; text-decoration: underline; text-underline-offset: 2px; cursor: pointer; }
  #shopify-section-{{ section.id }} .wi__studies:hover { opacity: .8; }
  #shopify-section-{{ section.id }} .wi-modal { position: fixed; inset: 0; z-index: 2147483000; display: flex; align-items: center; justify-content: center; padding: 18px; opacity: 1; }
  #shopify-section-{{ section.id }} .wi-modal[hidden] { display: none; }
  #shopify-section-{{ section.id }} .wi-modal__ov { position: absolute; inset: 0; background: rgba(242, 238, 234, 0.87); }
  #shopify-section-{{ section.id }} .wi-modal__box { position: relative; width: 100%; max-width: 480px; max-height: calc(100dvh - 36px); overflow: auto; background: #e3e7ff; border: 1px solid #3447af; border-radius: 16px; padding: 32px 24px; box-shadow: 0 24px 64px -18px rgba(0, 0, 0, 0.4); color: #14307c; text-align: center; font-size: 15px; line-height: 1.5; }
  #shopify-section-{{ section.id }} .wi-modal__x { position: absolute; top: 12px; right: 12px; width: 28px; height: 28px; display: grid; place-items: center; border: 0; background: transparent; color: #14307c; cursor: pointer; border-radius: 8px; padding: 0; }
  #shopify-section-{{ section.id }} .wi-modal__x svg { width: 16px; height: 16px; }
  #shopify-section-{{ section.id }} .wi-modal__t { font-size: 20px; font-weight: 400; line-height: 1.25; margin: 0 0 16px; color: #14307c; }
  #shopify-section-{{ section.id }} .wi-modal__body { color: #14307c; }
  #shopify-section-{{ section.id }} .wi-modal__body p { margin: 0 0 10px; font-size: inherit; color: inherit; }
  #shopify-section-{{ section.id }} .wi-modal__body :is(h2, h3, h4, h5, h6) { font-size: 17px; font-weight: 600; line-height: 1.3; margin: 18px 0 6px; color: #14307c; }
  #shopify-section-{{ section.id }} .wi-modal__body :is(h2, h3, h4, h5, h6) :is(strong, b, em) { color: inherit; }
  #shopify-section-{{ section.id }} .wi-modal__body :is(h2, h3, h4, h5, h6):first-child { margin-top: 0; }
  #shopify-section-{{ section.id }} .wi-modal__small { margin: 14px 0 0; padding-top: 12px; border-top: 1px solid rgba(26, 40, 116, 0.18); font-size: 11px; line-height: 1.5; color: #676b79; text-align: left; opacity: 1; }
  #shopify-section-{{ section.id }} .wi-modal__links { display: flex; justify-content: center; margin-top: 16px; }
  #shopify-section-{{ section.id }} .wi-modal__link { appearance: none; background: none; border: 0; padding: 0; font: inherit; font-size: 14px; color: #14307c; text-decoration: underline; cursor: pointer; }
  @media (min-width: 750px) { #shopify-section-{{ section.id }} .wi-modal__t { font-size: 36px; } #shopify-section-{{ section.id }} .wi-modal__box { font-size: 16px; } }
  #shopify-section-{{ section.id }} .wi__foot--right { margin-top: 22px; text-align: center; }
  #shopify-section-{{ section.id }} .wi__foot--full { grid-column: 1 / -1; text-align: center; }
  #shopify-section-{{ section.id }} .wi__stats-title {
    font-size: 13px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    margin: 0 0 18px;
    opacity: .85;
  }
  #shopify-section-{{ section.id }} .wi__stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  #shopify-section-{{ section.id }} .wi__stat { padding: 8px 26px 26px 0; }
  #shopify-section-{{ section.id }} .wi__stat:nth-child(2n) { padding-left: 26px; padding-right: 0; border-left: 1px solid {{ s.line_color }}; }
  {% if stat_count > 2 %}
  #shopify-section-{{ section.id }} .wi__stat:nth-child(-n+2) { border-bottom: 1px solid {{ s.line_color }}; }
  #shopify-section-{{ section.id }} .wi__stat:nth-child(n+3) { padding-top: 26px; padding-bottom: 8px; }
  {% endif %}
  #shopify-section-{{ section.id }} .wi__stat-v { font-size: {{ s.stat_size }}px; line-height: 1.1; font-weight: 400; margin: 0 0 10px; color: {{ s.stat_color }}; }
  #shopify-section-{{ section.id }} .wi__stat-t { font-size: {{ s.body_size | times: 0.95 | round }}px; line-height: 1.5; margin: 0; }
  #shopify-section-{{ section.id }} .wi__stat-t p { margin: 0; font-size: inherit; color: inherit; }
  #shopify-section-{{ section.id }} .wi__right-img { width: 100%; height: auto; border-radius: 16px; display: block; }
  #shopify-section-{{ section.id }} .wi__cta-row { text-align: center; margin-top: 34px; }
  #shopify-section-{{ section.id }} .wi__cta {
    display: inline-block;
    min-width: 240px;
    padding: 15px 40px;
    border-radius: 999px;
    background: {{ s.cta_bg }};
    color: {{ s.cta_text_color }};
    font-size: 13.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    text-decoration: none;
    transition: filter .15s, transform .12s;
  }
  #shopify-section-{{ section.id }} .wi__cta:hover { filter: brightness(1.08); transform: translateY(-1px); }
  @media screen and (max-width: 899px) {
    #shopify-section-{{ section.id }} .wi__in { grid-template-columns: 1fr; gap: 40px; padding: 40px 24px; }
  }
{% endstyle %}

<div class="wi">
  <div class="wi__card">
    {%- if s.bg_image != blank -%}<div class="wi__bg" aria-hidden="true"></div>{%- endif -%}
    <div class="wi__in">
      <div class="wi__left">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'text' -%}
              <div class="wi__block wi__text" {{ block.shopify_attributes }}{% if block.settings.size > 0 %} style="font-size: {{ block.settings.size }}px; line-height: 1.3;"{% endif %}>{{ block.settings.text }}</div>
            {%- when 'accordion' -%}
              <details class="wi__block wi__acc"{% if block.settings.open %} open{% endif %} {{ block.shopify_attributes }}>
                <summary>
                  <span>{{ block.settings.title }}</span>
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 8 11 13 6"></polyline></svg>
                </summary>
                <div class="wi__acc-body">
                  {%- if block.settings.chips != blank -%}
                    <div class="wi__chips">
                      {%- assign chip_lines = block.settings.chips | newline_to_br | split: '<br />' -%}
                      {%- for line in chip_lines -%}
                        {%- assign t = line | strip -%}
                        {%- if t != blank -%}<span class="wi__chip">{{ t }}</span>{%- endif -%}
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="wi__acc-text">{{ block.settings.text }}</div>
                  {%- endif -%}
                </div>
              </details>
            {%- when 'footer' -%}
              {%- assign fpos = block.settings.position | default: 'left' -%}
              {%- if fpos == 'left' -%}
              {%- capture wi_link -%}{%- if block.settings.studies_link_text != blank -%}<button type="button" class="wi__studies" data-wi-studies-open="wi-modal-{{ block.id }}">{{ block.settings.studies_link_text }}</button>{%- endif -%}{%- endcapture -%}<div class="wi__block wi__foot" {{ block.shopify_attributes }}>{{ block.settings.text | replace: '[studies]', wi_link }}</div>{%- if block.settings.studies_link_text != blank -%}<div class="wi-modal" id="wi-modal-{{ block.id }}" hidden><div class="wi-modal__ov" data-wi-modal-close></div><div class="wi-modal__box" role="dialog" aria-modal="true" aria-label="{{ block.settings.popup_title | default: 'The studies' | escape }}"><button type="button" class="wi-modal__x" data-wi-modal-close aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>{%- if block.settings.popup_title != blank -%}<h3 class="wi-modal__t">{{ block.settings.popup_title }}</h3>{%- endif -%}<div class="wi-modal__body">{{ block.settings.popup_text }}</div>{%- if block.settings.popup_small != blank -%}<p class="wi-modal__small">{{ block.settings.popup_small | newline_to_br }}</p>{%- endif -%}<div class="wi-modal__links"><button type="button" class="wi-modal__link" data-wi-modal-close>Close</button></div></div></div>{%- endif -%}
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
      <div class="wi__right">
        {%- if s.right_mode == 'image' and s.right_image != blank -%}
          <img class="wi__right-img" src="{{ s.right_image | image_url: width: 1200 }}" alt="{{ s.right_image.alt | escape }}" loading="lazy">
        {%- else -%}
        {%- if stat_count > 0 -%}
          {%- if s.stats_title != blank -%}<p class="wi__stats-title">{{ s.stats_title }}</p>{%- endif -%}
          <div class="wi__stats">
            {%- for block in section.blocks -%}
              {%- if block.type == 'stat' -%}
                <div class="wi__stat" {{ block.shopify_attributes }}>
                  <p class="wi__stat-v">{{ block.settings.value }}</p>
                  <div class="wi__stat-t">{{ block.settings.text }}</div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- endif -%}
        {%- if s.cta_label != blank -%}
          <div class="wi__cta-row">
            <a class="wi__cta" href="{{ s.cta_link | default: '#' }}">{{ s.cta_label }}</a>
          </div>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'footer' and block.settings.position == 'right' -%}
            {%- capture wi_link -%}{%- if block.settings.studies_link_text != blank -%}<button type="button" class="wi__studies" data-wi-studies-open="wi-modal-{{ block.id }}">{{ block.settings.studies_link_text }}</button>{%- endif -%}{%- endcapture -%}<div class="wi__foot wi__foot--right" {{ block.shopify_attributes }}>{{ block.settings.text | replace: '[studies]', wi_link }}</div>{%- if block.settings.studies_link_text != blank -%}<div class="wi-modal" id="wi-modal-{{ block.id }}" hidden><div class="wi-modal__ov" data-wi-modal-close></div><div class="wi-modal__box" role="dialog" aria-modal="true" aria-label="{{ block.settings.popup_title | default: 'The studies' | escape }}"><button type="button" class="wi-modal__x" data-wi-modal-close aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>{%- if block.settings.popup_title != blank -%}<h3 class="wi-modal__t">{{ block.settings.popup_title }}</h3>{%- endif -%}<div class="wi-modal__body">{{ block.settings.popup_text }}</div>{%- if block.settings.popup_small != blank -%}<p class="wi-modal__small">{{ block.settings.popup_small | newline_to_br }}</p>{%- endif -%}<div class="wi-modal__links"><button type="button" class="wi-modal__link" data-wi-modal-close>Close</button></div></div></div>{%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- for block in section.blocks -%}
        {%- if block.type == 'footer' and block.settings.position == 'full' -%}
          {%- capture wi_link -%}{%- if block.settings.studies_link_text != blank -%}<button type="button" class="wi__studies" data-wi-studies-open="wi-modal-{{ block.id }}">{{ block.settings.studies_link_text }}</button>{%- endif -%}{%- endcapture -%}<div class="wi__foot wi__foot--full" {{ block.shopify_attributes }}>{{ block.settings.text | replace: '[studies]', wi_link }}</div>{%- if block.settings.studies_link_text != blank -%}<div class="wi-modal" id="wi-modal-{{ block.id }}" hidden><div class="wi-modal__ov" data-wi-modal-close></div><div class="wi-modal__box" role="dialog" aria-modal="true" aria-label="{{ block.settings.popup_title | default: 'The studies' | escape }}"><button type="button" class="wi-modal__x" data-wi-modal-close aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>{%- if block.settings.popup_title != blank -%}<h3 class="wi-modal__t">{{ block.settings.popup_title }}</h3>{%- endif -%}<div class="wi-modal__body">{{ block.settings.popup_text }}</div>{%- if block.settings.popup_small != blank -%}<p class="wi-modal__small">{{ block.settings.popup_small | newline_to_br }}</p>{%- endif -%}<div class="wi-modal__links"><button type="button" class="wi-modal__link" data-wi-modal-close>Close</button></div></div></div>{%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
(function () {
  var sec = document.getElementById('shopify-section-{{ section.id }}'); if (!sec) { return; }
  sec.querySelectorAll('[data-wi-studies-open]').forEach(function (btn) {
    if (btn.dataset.bound) { return; } btn.dataset.bound = '1';
    var modal = document.getElementById(btn.getAttribute('data-wi-studies-open')); if (!modal) { return; }
    function open() { modal.hidden = false; document.documentElement.style.overflow = 'hidden'; var x = modal.querySelector('.wi-modal__x'); if (x) { x.focus(); } }
    function close() { modal.hidden = true; document.documentElement.style.overflow = ''; btn.focus(); }
    btn.addEventListener('click', function (e) { e.preventDefault(); open(); });
    modal.querySelectorAll('[data-wi-modal-close]').forEach(function (b) { b.addEventListener('click', close); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !modal.hidden) { close(); } });
  });
})();
</script>
{% schema %}
{
  "name": "Why Inositol",
  "settings": [
    {
      "type": "checkbox",
      "id": "contained",
      "label": "Contained card",
      "default": true,
      "info": "On: rounded card with the background (and image) inside it. Off: full width."
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 800,
      "max": 1440,
      "step": 20,
      "unit": "px",
      "default": 1240
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "page_bg",
      "label": "Section background",
      "default": "#f2eeea"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#1a2874"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "bg_blur",
      "label": "Image blur",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 40
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Image overlay",
      "default": "#1a2874"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "header",
      "content": "Right column"
    },
    {
      "type": "select",
      "id": "right_mode",
      "label": "Right column content",
      "options": [
        {
          "value": "stats",
          "label": "Stat grid"
        },
        {
          "value": "image",
          "label": "Image"
        }
      ],
      "default": "stats"
    },
    {
      "type": "text",
      "id": "stats_title",
      "label": "Title above stats",
      "default": "Inositol studies show:"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right image",
      "info": "Shown when the right column is set to Image."
    },
    {
      "type": "header",
      "content": "Colors and sizes"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Lines and chip borders",
      "default": "rgba(255,255,255,0.45)"
    },
    {
      "type": "color",
      "id": "stat_color",
      "label": "Stat numbers",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body text size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "stat_size",
      "label": "Stat number size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "cta_bg",
      "label": "Button",
      "default": "#1b3def"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Padding above",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "Inside the section background."
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Padding below",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin above",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "Outside the section background."
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin below",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
