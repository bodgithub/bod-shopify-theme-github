{%- comment -%}
  Product rating for structured data. Reads the live Junip rating (falls back to the
  Shopify reviews metafield), rounds to one decimal, and attaches it to the ProductGroup
  that Shopify already outputs via {{ product | structured_data }} in main-product.liquid,
  by sharing that node's @id. No second Product entity is created, so there is only one
  price source on the page. Google requires ratingCount for AggregateRating to be valid;
  it is machine-readable only and is never rendered on the page.
{%- endcomment -%}
{%- liquid
  assign seo_rating = ''
  assign seo_meta = product.metafields.junip.rating_average
  if seo_meta.value != blank
    assign seo_rating = seo_meta.value
  elsif seo_meta != blank
    assign seo_rating = seo_meta
  endif
  if seo_rating == blank
    assign seo_meta = product.metafields.reviews.rating
    if seo_meta.value.rating != blank
      assign seo_rating = seo_meta.value.rating
    elsif seo_meta.value != blank
      assign seo_rating = seo_meta.value
    endif
  endif

  assign seo_count = ''
  assign seo_meta = product.metafields.junip.rating_count
  if seo_meta.value != blank
    assign seo_count = seo_meta.value
  elsif seo_meta != blank
    assign seo_count = seo_meta
  endif
  if seo_count == blank
    assign seo_meta = product.metafields.reviews.rating_count
    if seo_meta.value != blank
      assign seo_count = seo_meta.value
    elsif seo_meta != blank
      assign seo_count = seo_meta
    endif
  endif

  assign seo_rating_f = seo_rating | plus: 0.0 | at_most: 5.0
  assign seo_count_i = seo_count | plus: 0
  assign seo_rating_display = seo_rating_f | times: 10 | round | divided_by: 10.0
-%}
{%- if product != blank and seo_rating_f > 0 and seo_count_i > 0 -%}
<script type="application/ld+json">
{
  "@context": "http://schema.org/",
  "@id": "/products/{{ product.handle }}#product",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "{{ seo_rating_display }}",
    "bestRating": "5",
    "ratingCount": "{{ seo_count_i }}"
  }
}
</script>
{%- endif -%}

