{%- comment -%}
  Bodology promo bar (header group). One line of campaign text with three live parts:
    - [code] renders as a pill; tapping it copies the code to the clipboard
    - [countdown] renders a live "Ends in 8 days" / "Ends in 5h 12m" chip (updates every 30s)
    - the whole bar hides itself once the end time has passed, so a stale offer never shows
  The end time is read in the chosen time zone (default Eastern), so "October 31, 11:59 pm"
  means 11:59 pm in New York whatever the visitor's clock says. Before JS runs, the chip
  shows the "Fallback end text" (e.g. "Ends October 31").
  Tokens use square brackets on purpose: Shopify's GitHub sync rejects Liquid files that
  carry curly-brace tokens inside quoted strings.
  Nothing here is hardcoded: code, percent, text, dates and colours are all section settings.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign bg = s.color_bg | default: settings.color_announcement_bar_bg | default: '#1b3def'
  assign fg = s.color_text | default: settings.color_announcement_bar_text | default: '#ffffff'
  assign code = s.code | strip
  assign percent = s.percent | strip
  assign text = s.text | replace: '[percent]', percent
  assign text_mobile = s.text_mobile | replace: '[percent]', percent
  if text_mobile == blank
    assign text_mobile = text
  endif
  assign code_html = '<button type="button" class="pbar__code" data-pbar-copy aria-label="Copy code ' | append: code | append: '"><span class="pbar__code-text">' | append: code | append: '</span><span class="pbar__code-copied" aria-hidden="true">' | append: s.copied_label | append: '</span></button>'
  assign count_html = '<span class="pbar__count" data-pbar-count>' | append: s.fallback_end_text | append: '</span>'
  assign text = text | replace: '[code]', code_html | replace: '[countdown]', count_html
  assign text_mobile = text_mobile | replace: '[code]', code_html | replace: '[countdown]', count_html

  comment
    New customers only: a logged-in customer with an order never sees the bar (Liquid, instant).
    Logged-out returning customers cannot be known server-side; the browser remembers them
    once they visit their account or an order page (localStorage flag set below), best effort.
  endcomment
  assign returning = false
  if customer and customer.orders_count > 0
    assign returning = true
  endif
  if template.directory == 'customers'
    if template.name == 'account' or template.name == 'order'
      assign returning = true
    endif
  endif
  assign show = true
  if s.new_customers_only and customer and customer.orders_count > 0
    assign show = false
  endif
-%}
{%- if s.new_customers_only and returning -%}
<script>try { localStorage.setItem('bod_returning', '1'); } catch (e) {}</script>
{%- endif -%}
{%- if s.enabled and text != blank and show -%}
<style>
  #shopify-section-{{ sid }} .pbar { background: {{ bg }}; color: {{ fg }}; font-size: {{ s.size }}px; line-height: 1.3; text-align: center; position: relative; z-index: 2; }
  #shopify-section-{{ sid }} .pbar[hidden] { display: none; }
  #shopify-section-{{ sid }} .pbar__inner { max-width: 1300px; margin: 0 auto; padding: 9px {% if s.dismissible %}44px{% else %}16px{% endif %} 9px 16px; display: flex; align-items: center; justify-content: center; gap: 8px 10px; flex-wrap: wrap; min-height: 40px; }
  #shopify-section-{{ sid }} .pbar__text { font-weight: 600; letter-spacing: {% if s.uppercase %}0.06em{% else %}0.01em{% endif %}; {% if s.uppercase %}text-transform: uppercase;{% endif %} display: inline-flex; align-items: center; flex-wrap: wrap; justify-content: center; gap: 6px 8px; color: inherit; text-decoration: none; }
  #shopify-section-{{ sid }} a.pbar__text:hover, #shopify-section-{{ sid }} button.pbar__text:hover { text-decoration: underline; }
  #shopify-section-{{ sid }} button.pbar__text { font: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  #shopify-section-{{ sid }} button.pbar__text:focus-visible { outline: 2px solid {{ fg }}; outline-offset: 3px; border-radius: 4px; }
  #shopify-section-{{ sid }} .pbar__text--mobile { display: none; }
  #shopify-section-{{ sid }} .pbar__code { font: inherit; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: {{ bg }}; background: {{ fg }}; border: 0; border-radius: 999px; padding: 3px 10px; cursor: pointer; position: relative; line-height: 1.2; }
  #shopify-section-{{ sid }} .pbar__code:focus-visible { outline: 2px solid {{ fg }}; outline-offset: 2px; }
  #shopify-section-{{ sid }} .pbar__code-copied { position: absolute; inset: 0; display: none; align-items: center; justify-content: center; border-radius: 999px; background: {{ fg }}; color: {{ bg }}; letter-spacing: 0.04em; text-transform: none; }
  #shopify-section-{{ sid }} .pbar__code.is-copied .pbar__code-copied { display: inline-flex; }
  #shopify-section-{{ sid }} .pbar__count { font-weight: 600; letter-spacing: 0.02em; text-transform: none; white-space: nowrap; padding: 3px 10px; border-radius: 999px; background: rgba(127,127,127,0.22); background: color-mix(in srgb, {{ fg }} 18%, transparent); font-variant-numeric: tabular-nums; }
  #shopify-section-{{ sid }} .pbar__count.is-urgent { background: rgba(127,127,127,0.34); background: color-mix(in srgb, {{ fg }} 30%, transparent); }
  #shopify-section-{{ sid }} .pbar__close { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); width: 32px; height: 32px; border: 0; background: transparent; color: inherit; cursor: pointer; font-size: 20px; line-height: 1; border-radius: 50%; }
  #shopify-section-{{ sid }} .pbar__close:hover { background: rgba(127,127,127,0.22); background: color-mix(in srgb, {{ fg }} 18%, transparent); }
  #shopify-section-{{ sid }} .pbar__close:focus-visible { outline: 2px solid {{ fg }}; outline-offset: 2px; }
  @media (max-width: 767px) {
    #shopify-section-{{ sid }} .pbar { font-size: {{ s.size_mobile }}px; }
    #shopify-section-{{ sid }} .pbar__inner { padding: 8px {% if s.dismissible %}40px{% else %}14px{% endif %} 8px 14px; min-height: 36px; }
    #shopify-section-{{ sid }} .pbar__text--desktop { display: none; }
    #shopify-section-{{ sid }} .pbar__text--mobile { display: inline-flex; }
  }
  @media (prefers-reduced-motion: no-preference) {
    #shopify-section-{{ sid }} .pbar__count.is-urgent { animation: pbar-pulse 2.4s ease-in-out infinite; }
    @keyframes pbar-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.72; } }
  }
</style>
<div class="pbar" data-pbar role="region" aria-label="Current offer"
     data-end-date="{{ s.end_date | strip }}" data-end-time="{{ s.end_time | strip | default: '23:59' }}" data-tz="{{ s.timezone }}"
     data-days="{{ s.days_label | escape }}" data-day="{{ s.day_label | escape }}" data-hours="{{ s.hours_label | escape }}" data-dismiss-key="pbar-{{ sid }}-{{ code | downcase }}" data-new-only="{{ s.new_customers_only }}">
  <div class="pbar__inner">
    {%- if s.click_action == 'klaviyo' and s.klaviyo_form_id != blank -%}
      <button type="button" class="pbar__text pbar__text--desktop" data-pbar-klaviyo="{{ s.klaviyo_form_id | strip | escape }}">{{ text }}</button><button type="button" class="pbar__text pbar__text--mobile" data-pbar-klaviyo="{{ s.klaviyo_form_id | strip | escape }}">{{ text_mobile }}</button>
    {%- elsif s.click_action == 'link' and s.link != blank -%}
      <a class="pbar__text pbar__text--desktop" href="{{ s.link }}">{{ text }}</a><a class="pbar__text pbar__text--mobile" href="{{ s.link }}">{{ text_mobile }}</a>
    {%- else -%}<span class="pbar__text pbar__text--desktop">{{ text }}</span><span class="pbar__text pbar__text--mobile">{{ text_mobile }}</span>{%- endif -%}
    {%- if s.dismissible -%}<button type="button" class="pbar__close" data-pbar-close aria-label="Hide this offer">&times;</button>{%- endif -%}
  </div>
</div>
<script>
(function () {
  var root = document.querySelector('#shopify-section-{{ sid }} [data-pbar]'); if (!root) { return; }
  var counts = root.querySelectorAll('[data-pbar-count]');
  var labels = { days: root.getAttribute('data-days') || 'Ends in [n] days', day: root.getAttribute('data-day') || 'Ends tomorrow', hours: root.getAttribute('data-hours') || 'Ends in [h]h [m]m' };

  /* the moment the offer ends, as a UTC instant, from a local date + time in the chosen zone */
  function endInstant() {
    var d = root.getAttribute('data-end-date'), t = root.getAttribute('data-end-time') || '23:59', tz = root.getAttribute('data-tz') || 'America/New_York';
    if (!/^\d{4}-\d{2}-\d{2}$/.test(d)) { return null; }
    var p = d.split('-').map(Number), q = t.split(':').map(Number);
    var wanted = Date.UTC(p[0], p[1] - 1, p[2], q[0], q[1] || 0, 59, 999);
    var guess = wanted;
    try {
      var fmt = new Intl.DateTimeFormat('en-US', { timeZone: tz, hourCycle: 'h23', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' });
      for (var i = 0; i < 2; i++) { /* two passes settle on the zone offset, DST included */
        var parts = {}; fmt.formatToParts(new Date(guess)).forEach(function (x) { parts[x.type] = x.value; });
        var asLocal = Date.UTC(+parts.year, +parts.month - 1, +parts.day, +parts.hour % 24, +parts.minute, 59, 999);
        guess += wanted - asLocal;
      }
    } catch (e) { /* no Intl zone support: treat the time as UTC */ }
    return guess;
  }
  var end = endInstant();
  var key = root.getAttribute('data-dismiss-key');
  function dismissed() {
    try {
      if (sessionStorage.getItem(key) === '1') { return true; }
      if (root.getAttribute('data-new-only') === 'true' && localStorage.getItem('bod_returning') === '1') { return true; } /* remembered returning customer */
    } catch (e) {}
    return false;
  }
  function hide() { root.hidden = true; }
  function tick() {
    if (end === null) { return; }
    var left = end - Date.now();
    if (left <= 0) { hide(); return; }
    var days = Math.floor(left / 86400000), hours = Math.floor(left / 3600000), mins = Math.floor((left % 3600000) / 60000);
    var text, urgent = false;
    if (days >= 2) { text = labels.days.replace(/\[n\]/g, days); }
    else if (days === 1) { text = labels.day; }
    else { text = labels.hours.replace(/\[h\]/g, hours).replace(/\[m\]/g, mins); urgent = true; }
    counts.forEach(function (c) { c.textContent = text; c.classList.toggle('is-urgent', urgent); });
  }
  if (dismissed()) { hide(); return; }
  tick();
  if (end !== null) { setInterval(tick, 30000); }

  root.querySelectorAll('[data-pbar-copy]').forEach(function (btn) {
    btn.addEventListener('click', function (e) {
      e.preventDefault(); e.stopPropagation();
      var code = btn.querySelector('.pbar__code-text').textContent.trim();
      function show() { btn.classList.add('is-copied'); setTimeout(function () { btn.classList.remove('is-copied'); }, 1800); }
      if (navigator.clipboard && navigator.clipboard.writeText) { navigator.clipboard.writeText(code).then(show, show); }
      else { var r = document.createRange(); r.selectNodeContents(btn.querySelector('.pbar__code-text')); var sel = window.getSelection(); sel.removeAllRanges(); sel.addRange(r); show(); }
    });
  });
  /* click opens the Klaviyo form (the queue works even before Klaviyo has loaded) */
  root.querySelectorAll('[data-pbar-klaviyo]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      window._klOnsite = window._klOnsite || [];
      window._klOnsite.push(['openForm', btn.getAttribute('data-pbar-klaviyo')]);
    });
  });
  var close = root.querySelector('[data-pbar-close]');
  if (close) { close.addEventListener('click', function () { try { sessionStorage.setItem(key, '1'); } catch (e) {} hide(); }); }
})();
</script>
{%- endif -%}
{% schema %}
{
  "name": "Promo bar (Bodology)",
  "class": "announcement-bar-section",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show the promo bar", "default": true },
    { "type": "header", "content": "Offer" },
    { "type": "text", "id": "code", "label": "Discount code", "default": "TRY20", "info": "Rendered as a pill wherever [code] appears in the text. Tapping it copies the code." },
    { "type": "text", "id": "percent", "label": "Percent off", "default": "20", "info": "Fills [percent] in the text. Check the live discount before changing." },
    { "type": "text", "id": "text", "label": "Text", "default": "[percent]% off your first order with code [code] [countdown]", "info": "Tokens: [code], [percent], [countdown]." },
    { "type": "text", "id": "text_mobile", "label": "Text on phones (optional)", "default": "[percent]% off with [code] [countdown]", "info": "Leave empty to use the text above." },
    { "type": "select", "id": "click_action", "label": "When the bar is clicked", "default": "klaviyo", "options": [
      { "value": "link", "label": "Go to the link" }, { "value": "klaviyo", "label": "Open a Klaviyo form" }, { "value": "none", "label": "Nothing" } ] },
    { "type": "url", "id": "link", "label": "Link", "info": "Used when the click action is \"Go to the link\". Usually the product page." },
    { "type": "text", "id": "klaviyo_form_id", "label": "Klaviyo form ID", "default": "Tmac3m", "info": "Used when the click action is \"Open a Klaviyo form\". The ID from the form's custom trigger snippet, e.g. Tmac3m." },
    { "type": "checkbox", "id": "new_customers_only", "label": "New customers only", "default": true, "info": "Hidden for logged-in customers who have ordered, and for browsers that have visited an account or order page. Pair with a customer-segment restriction on the discount itself; the storefront cannot recognise a logged-out returning customer." },
    { "type": "header", "content": "End time", "info": "The countdown reads this in the chosen time zone and the bar hides itself once it has passed." },
    { "type": "text", "id": "end_date", "label": "End date (YYYY-MM-DD)", "default": "2026-10-31" },
    { "type": "text", "id": "end_time", "label": "End time (24h, HH:MM)", "default": "23:59" },
    { "type": "select", "id": "timezone", "label": "Time zone", "default": "America/New_York", "options": [
      { "value": "America/New_York", "label": "Eastern" }, { "value": "America/Chicago", "label": "Central" }, { "value": "America/Denver", "label": "Mountain" }, { "value": "America/Los_Angeles", "label": "Pacific" }, { "value": "UTC", "label": "UTC" } ] },
    { "type": "text", "id": "fallback_end_text", "label": "Fallback end text", "default": "Ends October 31", "info": "Shown in the countdown chip until the live countdown takes over." },
    { "type": "text", "id": "days_label", "label": "Countdown, 2+ days left", "default": "Ends in [n] days" },
    { "type": "text", "id": "day_label", "label": "Countdown, 1 day left", "default": "Ends tomorrow" },
    { "type": "text", "id": "hours_label", "label": "Countdown, last day", "default": "Ends in [h]h [m]m" },
    { "type": "text", "id": "copied_label", "label": "Copied confirmation", "default": "Copied" },
    { "type": "header", "content": "Look" },
    { "type": "checkbox", "id": "uppercase", "label": "Uppercase text", "default": false },
    { "type": "checkbox", "id": "dismissible", "label": "Show a close button", "default": false, "info": "Hidden for the rest of the visit once closed." },
    { "type": "range", "id": "size", "min": 11, "max": 18, "step": 1, "unit": "px", "label": "Text size (desktop)", "default": 14 },
    { "type": "range", "id": "size_mobile", "min": 10, "max": 16, "step": 1, "unit": "px", "label": "Text size (phones)", "default": 12 },
    { "type": "color", "id": "color_bg", "label": "Background", "info": "Empty = the theme's announcement bar background." },
    { "type": "color", "id": "color_text", "label": "Text", "info": "Empty = the theme's announcement bar text colour." }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
