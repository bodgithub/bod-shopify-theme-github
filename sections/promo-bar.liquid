{%- comment -%}
  Bodology promo bar (header group). One line of campaign text with live parts:
    - [code] renders as a pill; tapping it copies the code to the clipboard
    - [countdown] renders a live countdown chip
    - the whole bar hides itself once the end time has passed, so a stale offer never shows
  SCHEDULE (blocks): add "Phase" blocks and the bar shows whichever phase covers today
  (start date to end date, inclusive, in the chosen time zone). Each phase has its own copy
  and countdown style: off / days-hours-minutes / hours-minutes-seconds. The countdown counts
  to the phase's own "count to" date (or its end date when empty) at the section's end time.
  Nothing shows between phases or after the last one. With no blocks, the single text + end
  date below behave as one phase (the original behaviour).
  Times are read in the chosen time zone (default Eastern), so "November 30, 11:59 pm" means
  11:59 pm in New York whatever the visitor's clock says. Before JS runs, the chip shows the
  "Fallback end text".
  Tokens use square brackets on purpose: Shopify's GitHub sync rejects Liquid files that
  carry curly-brace tokens inside quoted strings.
  Nothing here is hardcoded: code, percent, text, dates and colours are all settings.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign bg = s.color_bg | default: settings.color_announcement_bar_bg | default: '#1b3def'
  assign fg = s.color_text | default: settings.color_announcement_bar_text | default: '#ffffff'
  assign code = s.code | strip
  assign percent = s.percent | strip
  comment
    Alternate wording on listed templates (e.g. the Black Friday B view): same tokens, same phases/countdown, different line.
  endcomment
  assign on_alt = false
  if s.alt_templates != blank and s.alt_text != blank
    assign alt_list = s.alt_templates | downcase | replace: ' ', '' | split: ','
    assign alt_suffix = template.suffix | downcase
    assign alt_name = template.name | downcase
    assign alt_full = alt_name | append: '.' | append: alt_suffix
    if alt_suffix != blank and alt_list contains alt_suffix
      assign on_alt = true
    elsif alt_list contains alt_name
      assign on_alt = true
    elsif alt_list contains alt_full
      assign on_alt = true
    endif
  endif
  assign text = s.text | replace: '[percent]', percent
  assign text_mobile = s.text_mobile | replace: '[percent]', percent
  if on_alt
    assign text = s.alt_text | replace: '[percent]', percent
    assign text_mobile = s.alt_text_mobile | replace: '[percent]', percent
  endif
  if text_mobile == blank
    assign text_mobile = text
  endif
  assign code_html = '<button type="button" class="pbar__code" data-pbar-copy aria-label="Copy code ' | append: code | append: '"><span class="pbar__code-text">' | append: code | append: '</span><span class="pbar__code-copied" aria-hidden="true">' | append: s.copied_label | append: '</span></button>'
  assign count_html = '<span class="pbar__count" data-pbar-count>' | append: s.fallback_end_text | append: '</span>'
  assign text = text | replace: '[code]', code_html | replace: '[countdown]', count_html
  assign text_mobile = text_mobile | replace: '[code]', code_html | replace: '[countdown]', count_html
  assign today = 'now' | date: '%Y-%m-%d'
  assign has_phases = false
  if section.blocks.size > 0
    assign has_phases = true
  endif

  comment
    New customers only: a logged-in customer with an order never sees the bar (Liquid, instant).
    Logged-out returning customers cannot be known server-side; the browser remembers them
    once they visit their account or an order page (localStorage flag set below), best effort.
  endcomment
  assign returning = false
  if customer and customer.orders_count > 0
    assign returning = true
  endif
  if template.directory == 'customers'
    if template.name == 'account' or template.name == 'order'
      assign returning = true
    endif
  endif
  assign show = true
  if s.new_customers_only and customer and customer.orders_count > 0
    assign show = false
  endif

  comment
    Where it shows: every page, or only the templates listed in "Templates" (the ?view= name,
    matched the same way as the header's landing-page list; a page type such as index or cart,
    or product.black-friday, also matches).
  endcomment
  if s.show_on == 'listed'
    assign on_listed = false
    if s.show_templates != blank
      assign tpl_list = s.show_templates | downcase | replace: ' ', '' | split: ','
      assign tpl_suffix = template.suffix | downcase
      assign tpl_name = template.name | downcase
      assign tpl_full = tpl_name | append: '.' | append: tpl_suffix
      if tpl_suffix != blank and tpl_list contains tpl_suffix
        assign on_listed = true
      elsif tpl_list contains tpl_name
        assign on_listed = true
      elsif tpl_list contains tpl_full
        assign on_listed = true
      endif
    endif
    unless on_listed
      assign show = false
    endunless
  endif
-%}
{%- if s.new_customers_only and returning -%}
<script>try { localStorage.setItem('bod_returning', '1'); } catch (e) {}</script>
{%- endif -%}
{%- if has_phases -%}{%- assign text = 'phases' -%}{%- endif -%}
{%- if s.enabled and text != blank and show -%}
<style>
  #shopify-section-{{ sid }} .pbar { background: {{ bg }}; color: {{ fg }}; font-size: {{ s.size }}px; line-height: 1.3; text-align: center; position: relative; z-index: 2; overflow: hidden; }
  {%- if s.fade_width > 0 -%}
  /* edge fade, same recipe as the text carousel block: fade colour solid for the first part, then to transparent (drawn behind the text so it stays readable) */
  #shopify-section-{{ sid }} .pbar::before, #shopify-section-{{ sid }} .pbar::after { content: ""; position: absolute; top: 0; bottom: 0; width: {{ s.fade_width }}%; z-index: 0; pointer-events: none; }
  #shopify-section-{{ sid }} .pbar::before { left: 0; background: linear-gradient(to right, {{ s.fade_color }} 0%, {{ s.fade_color }} {{ s.fade_strength }}%, transparent 100%); }
  #shopify-section-{{ sid }} .pbar::after { right: 0; background: linear-gradient(to left, {{ s.fade_color }} 0%, {{ s.fade_color }} {{ s.fade_strength }}%, transparent 100%); }
  #shopify-section-{{ sid }} .pbar__inner, #shopify-section-{{ sid }} .pbar__close { position: relative; z-index: 1; }
  #shopify-section-{{ sid }} .pbar__close { position: absolute; }
  {%- endif -%}
  #shopify-section-{{ sid }} .pbar[hidden] { display: none; }
  {%- if s.sticky -%}
  /* sticky: the section wrapper pins to the top and the sticky header stacks under it (height kept in --pbar-h by the script) */
  #shopify-section-{{ sid }} { position: sticky; top: 0; z-index: 51; }
  .header.header-sticky--active { top: var(--pbar-h, 0px); }
  {%- endif -%}
  #shopify-section-{{ sid }} .pbar__inner { max-width: 1300px; margin: 0 auto; padding: 9px {% if s.dismissible %}44px{% else %}16px{% endif %} 9px 16px; display: flex; align-items: center; justify-content: center; gap: 8px 10px; flex-wrap: wrap; min-height: 40px; }
  #shopify-section-{{ sid }} .pbar__text { font-weight: 600; letter-spacing: {% if s.uppercase %}0.06em{% else %}0.01em{% endif %}; {% if s.uppercase %}text-transform: uppercase;{% endif %} display: inline-flex; align-items: center; flex-wrap: wrap; justify-content: center; gap: 6px 8px; color: inherit; text-decoration: none; }
  #shopify-section-{{ sid }} a.pbar__text:hover, #shopify-section-{{ sid }} button.pbar__text:hover { text-decoration: underline; }
  #shopify-section-{{ sid }} button.pbar__text { font: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  #shopify-section-{{ sid }} button.pbar__text:focus-visible { outline: 2px solid {{ fg }}; outline-offset: 3px; border-radius: 4px; }
  #shopify-section-{{ sid }} .pbar__phase { display: contents; }
  #shopify-section-{{ sid }} .pbar__phase[hidden] { display: none; }
  #shopify-section-{{ sid }} .pbar__text--mobile { display: none; }
  #shopify-section-{{ sid }} .pbar__code { font: inherit; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: {{ bg }}; background: {{ fg }}; border: 0; border-radius: 999px; padding: 3px 10px; cursor: pointer; position: relative; line-height: 1.2; }
  #shopify-section-{{ sid }} .pbar__code:focus-visible { outline: 2px solid {{ fg }}; outline-offset: 2px; }
  #shopify-section-{{ sid }} .pbar__code-copied { position: absolute; inset: 0; display: none; align-items: center; justify-content: center; border-radius: 999px; background: {{ fg }}; color: {{ bg }}; letter-spacing: 0.04em; text-transform: none; }
  #shopify-section-{{ sid }} .pbar__code.is-copied .pbar__code-copied { display: inline-flex; }
  #shopify-section-{{ sid }} .pbar__count { font-weight: 600; letter-spacing: 0.02em; text-transform: none; white-space: nowrap; padding: 3px 10px; border-radius: 999px; background: rgba(127,127,127,0.22); background: color-mix(in srgb, {{ fg }} 18%, transparent); font-variant-numeric: tabular-nums; }
  #shopify-section-{{ sid }} .pbar__count.is-urgent { background: rgba(127,127,127,0.34); background: color-mix(in srgb, {{ fg }} 30%, transparent); }
  #shopify-section-{{ sid }} .pbar__close { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); width: 32px; height: 32px; border: 0; background: transparent; color: inherit; cursor: pointer; font-size: 20px; line-height: 1; border-radius: 50%; }
  #shopify-section-{{ sid }} .pbar__close:hover { background: rgba(127,127,127,0.22); background: color-mix(in srgb, {{ fg }} 18%, transparent); }
  #shopify-section-{{ sid }} .pbar__close:focus-visible { outline: 2px solid {{ fg }}; outline-offset: 2px; }
  @media (max-width: 767px) {
    #shopify-section-{{ sid }} .pbar { font-size: {{ s.size_mobile }}px; }
    #shopify-section-{{ sid }} .pbar__inner { padding: 8px {% if s.dismissible %}40px{% else %}14px{% endif %} 8px 14px; min-height: 36px; }
    #shopify-section-{{ sid }} .pbar__text--desktop { display: none; }
    #shopify-section-{{ sid }} .pbar__text--mobile { display: inline-flex; }
  }
  @media (prefers-reduced-motion: no-preference) {
    #shopify-section-{{ sid }} .pbar__count.is-urgent { animation: pbar-pulse 2.4s ease-in-out infinite; }
    @keyframes pbar-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.72; } }
  }
</style>
<div class="pbar" data-pbar role="region" aria-label="Current offer"
     data-end-time="{{ s.end_time | strip | default: '23:59' }}" data-tz="{{ s.timezone }}"
     data-days="{{ s.days_label | escape }}" data-day="{{ s.day_label | escape }}" data-hours="{{ s.hours_label | escape }}" data-dhm="{{ s.dhm_label | escape }}" data-hms="{{ s.hms_label | escape }}"
     data-dismiss-key="pbar-{{ sid }}-{{ code | downcase }}" data-new-only="{{ s.new_customers_only }}" data-sticky="{{ s.sticky }}">
  <div class="pbar__inner">
    {%- if has_phases -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign ptext = b.text | replace: '[percent]', percent
          assign pmobile = b.text_mobile | replace: '[percent]', percent
          if on_alt
            assign ptext = s.alt_text | replace: '[percent]', percent
            assign pmobile = s.alt_text_mobile | replace: '[percent]', percent
          endif
          if pmobile == blank
            assign pmobile = ptext
          endif
          if b.countdown != 'off'
            unless ptext contains '[countdown]'
              assign ptext = ptext | append: ' [countdown]'
            endunless
            unless pmobile contains '[countdown]'
              assign pmobile = pmobile | append: ' [countdown]'
            endunless
          else
            assign ptext = ptext | replace: '[countdown]', ''
            assign pmobile = pmobile | replace: '[countdown]', ''
          endif
          assign ptext = ptext | replace: '[code]', code_html | replace: '[countdown]', count_html
          assign pmobile = pmobile | replace: '[code]', code_html | replace: '[countdown]', count_html
          assign pstart = b.start_date | strip
          assign pend = b.end_date | strip
          assign pcount = b.count_date | strip | default: pend
          assign active = false
          if pend != blank and today <= pend
            if pstart == blank or today >= pstart
              assign active = true
            endif
          endif
        -%}
        <span class="pbar__phase" data-pbar-phase data-start="{{ pstart }}" data-end="{{ pend }}" data-count-to="{{ pcount }}" data-mode="{{ b.countdown }}"{% unless active %} hidden{% endunless %} {{ block.shopify_attributes }}>
          {%- if s.click_action == 'klaviyo' and s.klaviyo_form_id != blank -%}
            <button type="button" class="pbar__text pbar__text--desktop" data-pbar-klaviyo="{{ s.klaviyo_form_id | strip | escape }}">{{ ptext }}</button><button type="button" class="pbar__text pbar__text--mobile" data-pbar-klaviyo="{{ s.klaviyo_form_id | strip | escape }}">{{ pmobile }}</button>
          {%- elsif s.click_action == 'link' and s.link != blank -%}
            <a class="pbar__text pbar__text--desktop" href="{{ s.link }}">{{ ptext }}</a><a class="pbar__text pbar__text--mobile" href="{{ s.link }}">{{ pmobile }}</a>
          {%- else -%}<span class="pbar__text pbar__text--desktop">{{ ptext }}</span><span class="pbar__text pbar__text--mobile">{{ pmobile }}</span>{%- endif -%}
        </span>
      {%- endfor -%}
    {%- else -%}
    <span class="pbar__phase" data-pbar-phase data-start="" data-end="{{ s.end_date | strip }}" data-count-to="{{ s.end_date | strip }}" data-mode="legacy">
    {%- if s.click_action == 'klaviyo' and s.klaviyo_form_id != blank -%}
      <button type="button" class="pbar__text pbar__text--desktop" data-pbar-klaviyo="{{ s.klaviyo_form_id | strip | escape }}">{{ text }}</button><button type="button" class="pbar__text pbar__text--mobile" data-pbar-klaviyo="{{ s.klaviyo_form_id | strip | escape }}">{{ text_mobile }}</button>
    {%- elsif s.click_action == 'link' and s.link != blank -%}
      <a class="pbar__text pbar__text--desktop" href="{{ s.link }}">{{ text }}</a><a class="pbar__text pbar__text--mobile" href="{{ s.link }}">{{ text_mobile }}</a>
    {%- else -%}<span class="pbar__text pbar__text--desktop">{{ text }}</span><span class="pbar__text pbar__text--mobile">{{ text_mobile }}</span>{%- endif -%}
    </span>
    {%- endif -%}
    {%- if s.dismissible -%}<button type="button" class="pbar__close" data-pbar-close aria-label="Hide this offer">&times;</button>{%- endif -%}
  </div>
</div>
<script>
(function () {
  var root = document.querySelector('#shopify-section-{{ sid }} [data-pbar]'); if (!root) { return; }
  var labels = { days: root.getAttribute('data-days') || 'Ends in [n] days', day: root.getAttribute('data-day') || 'Ends tomorrow', hours: root.getAttribute('data-hours') || 'Ends in [h]h [m]m', dhm: root.getAttribute('data-dhm') || 'Ends in [d]d [h]h [m]m', hms: root.getAttribute('data-hms') || 'Ends in [h]h [m]m [s]s' };
  var tz = root.getAttribute('data-tz') || 'America/New_York', endTime = root.getAttribute('data-end-time') || '23:59';

  /* a local date + time in the chosen zone, as a UTC instant (two passes settle the zone offset, DST included) */
  function instant(d, t) {
    if (!/^\d{4}-\d{2}-\d{2}$/.test(d || '')) { return null; }
    var p = d.split('-').map(Number), q = (t || '00:00').split(':').map(Number);
    var endOfMinute = t !== '00:00';
    var wanted = Date.UTC(p[0], p[1] - 1, p[2], q[0], q[1] || 0, endOfMinute ? 59 : 0, endOfMinute ? 999 : 0);
    var guess = wanted;
    try {
      var fmt = new Intl.DateTimeFormat('en-US', { timeZone: tz, hourCycle: 'h23', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' });
      for (var i = 0; i < 2; i++) {
        var parts = {}; fmt.formatToParts(new Date(guess)).forEach(function (x) { parts[x.type] = x.value; });
        var asLocal = Date.UTC(+parts.year, +parts.month - 1, +parts.day, +parts.hour % 24, +parts.minute, endOfMinute ? 59 : 0, endOfMinute ? 999 : 0);
        guess += wanted - asLocal;
      }
    } catch (e) { /* no Intl zone support: treat the time as UTC */ }
    return guess;
  }
  /* phases: each carries its own window (start 00:00 .. end at the end time) and countdown target */
  var phases = [].map.call(root.querySelectorAll('[data-pbar-phase]'), function (el) {
    return { el: el, start: instant(el.getAttribute('data-start'), '00:00'), end: instant(el.getAttribute('data-end'), endTime), countTo: instant(el.getAttribute('data-count-to') || el.getAttribute('data-end'), endTime), mode: el.getAttribute('data-mode') || 'legacy' };
  });
  var current = null;
  function pick() {
    var now = Date.now(), found = null;
    phases.forEach(function (ph) {
      if (found) { return; }
      var open = ph.start === null || now >= ph.start;
      var notOver = ph.end === null ? ph.mode === 'legacy' : now <= ph.end; /* legacy with no date never ends; a phase needs an end date */
      if (open && notOver) { found = ph; }
    });
    phases.forEach(function (ph) { ph.el.hidden = ph !== found; });
    current = found;
    return found;
  }
  var key = root.getAttribute('data-dismiss-key');
  function dismissed() {
    try {
      if (sessionStorage.getItem(key) === '1') { return true; }
      if (root.getAttribute('data-new-only') === 'true' && localStorage.getItem('bod_returning') === '1') { return true; } /* remembered returning customer */
    } catch (e) {}
    return false;
  }
  /* sticky bar: publish its height so the sticky header can sit below it (0 once hidden or dismissed) */
  var sticky = root.getAttribute('data-sticky') === 'true';
  function syncHeight() { if (!sticky) { return; } document.documentElement.style.setProperty('--pbar-h', (root.hidden ? 0 : root.offsetHeight) + 'px'); }
  if (sticky) { window.addEventListener('resize', syncHeight); }
  function hide() { root.hidden = true; syncHeight(); }
  function pad(n) { return n < 10 ? '0' + n : '' + n; }
  function tick() {
    var ph = pick();
    if (!ph) { hide(); return; }
    root.hidden = false;
    if (ph.mode === 'off' || ph.countTo === null) { return; }
    var left = ph.countTo - Date.now();
    if (left < 0) { left = 0; }
    var days = Math.floor(left / 86400000), hoursTotal = Math.floor(left / 3600000), hours = hoursTotal % 24, mins = Math.floor((left % 3600000) / 60000), secs = Math.floor((left % 60000) / 1000);
    var text, urgent = false;
    if (ph.mode === 'dhm') {
      text = labels.dhm.replace(/\[d\]d\s*/g, days > 0 ? days + 'd ' : '').replace(/\[h\]/g, hours).replace(/\[m\]/g, pad(mins)).replace(/\s+/g, ' ').trim();
    } else if (ph.mode === 'hms') {
      text = labels.hms.replace(/\[h\]/g, hoursTotal).replace(/\[m\]/g, pad(mins)).replace(/\[s\]/g, pad(secs)); urgent = true;
    } else {
      if (days >= 2) { text = labels.days.replace(/\[n\]/g, days); }
      else if (days === 1) { text = labels.day; }
      else { text = labels.hours.replace(/\[h\]/g, hoursTotal).replace(/\[m\]/g, mins); urgent = true; }
    }
    ph.el.querySelectorAll('[data-pbar-count]').forEach(function (c) { c.textContent = text; c.classList.toggle('is-urgent', urgent); });
  }
  if (dismissed()) { hide(); return; }
  tick(); syncHeight();
  var fast = phases.some(function (ph) { return ph.mode === 'hms'; });
  setInterval(tick, fast ? 1000 : 30000);

  root.querySelectorAll('[data-pbar-copy]').forEach(function (btn) {
    btn.addEventListener('click', function (e) {
      e.preventDefault(); e.stopPropagation();
      var code = btn.querySelector('.pbar__code-text').textContent.trim();
      function show() { btn.classList.add('is-copied'); setTimeout(function () { btn.classList.remove('is-copied'); }, 1800); }
      if (navigator.clipboard && navigator.clipboard.writeText) { navigator.clipboard.writeText(code).then(show, show); }
      else { var r = document.createRange(); r.selectNodeContents(btn.querySelector('.pbar__code-text')); var sel = window.getSelection(); sel.removeAllRanges(); sel.addRange(r); show(); }
    });
  });
  /* click opens the Klaviyo form (the queue works even before Klaviyo has loaded) */
  root.querySelectorAll('[data-pbar-klaviyo]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      window._klOnsite = window._klOnsite || [];
      window._klOnsite.push(['openForm', btn.getAttribute('data-pbar-klaviyo')]);
    });
  });
  var close = root.querySelector('[data-pbar-close]');
  if (close) { close.addEventListener('click', function () { try { sessionStorage.setItem(key, '1'); } catch (e) {} hide(); }); }
})();
</script>
{%- endif -%}
{% schema %}
{
  "name": "Promo bar (Bodology)",
  "class": "announcement-bar-section",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show the promo bar", "default": true },
    { "type": "select", "id": "show_on", "label": "Show on", "default": "all", "options": [
      { "value": "all", "label": "Every page" }, { "value": "listed", "label": "Listed templates only" } ] },
    { "type": "text", "id": "show_templates", "label": "Templates", "info": "For \"Listed templates only\": comma-separated template names, the part after ?view= (e.g. black-friday, over-40-black-friday). A page type such as index or cart also works. In the editor the bar only appears while you are viewing one of these templates." },
    { "type": "header", "content": "Offer" },
    { "type": "text", "id": "code", "label": "Discount code", "default": "TRY20", "info": "Rendered as a pill wherever [code] appears in the text. Tapping it copies the code." },
    { "type": "text", "id": "percent", "label": "Percent off", "default": "20", "info": "Fills [percent] in the text. Check the live discount before changing." },
    { "type": "text", "id": "text", "label": "Text", "default": "[percent]% off your first order with code [code] [countdown]", "info": "Tokens: [code], [percent], [countdown]." },
    { "type": "text", "id": "alt_templates", "label": "Alternate text: templates", "info": "Comma-separated ?view= names (e.g. black-friday-b). On these templates the two lines below replace the bar text in every phase; countdown and code tokens still work." },
    { "type": "text", "id": "alt_text", "label": "Alternate text" },
    { "type": "text", "id": "alt_text_mobile", "label": "Alternate text on phones (optional)" },
    { "type": "text", "id": "text_mobile", "label": "Text on phones (optional)", "default": "[percent]% off with [code] [countdown]", "info": "Leave empty to use the text above." },
    { "type": "select", "id": "click_action", "label": "When the bar is clicked", "default": "klaviyo", "options": [
      { "value": "link", "label": "Go to the link" }, { "value": "klaviyo", "label": "Open a Klaviyo form" }, { "value": "none", "label": "Nothing" } ] },
    { "type": "url", "id": "link", "label": "Link", "info": "Used when the click action is \"Go to the link\". Usually the product page." },
    { "type": "text", "id": "klaviyo_form_id", "label": "Klaviyo form ID", "default": "Tmac3m", "info": "Used when the click action is \"Open a Klaviyo form\". The ID from the form's custom trigger snippet, e.g. Tmac3m." },
    { "type": "checkbox", "id": "new_customers_only", "label": "New customers only", "default": true, "info": "Hidden for logged-in customers who have ordered, and for browsers that have visited an account or order page. Pair with a customer-segment restriction on the discount itself; the storefront cannot recognise a logged-out returning customer." },
    { "type": "header", "content": "End time", "info": "Without phases: the single end date below. With phases: only the end time and time zone are used (each phase has its own dates)." },
    { "type": "text", "id": "end_date", "label": "End date (YYYY-MM-DD)", "default": "2026-10-31" },
    { "type": "text", "id": "end_time", "label": "End time (24h, HH:MM)", "default": "23:59" },
    { "type": "select", "id": "timezone", "label": "Time zone", "default": "America/New_York", "options": [
