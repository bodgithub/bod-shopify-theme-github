{%- comment -%}
  BODOLOGY · Score Cards Slider
  Replica of dosedaily.co second "The Results" block:
  score cards with animated circular progress (SVG stroke-dasharray).
  Desktop (≥990px): 3-up row, no dots. Mobile: one-card scroll-snap
  slider with round dot pagination.
  Each card's pill button opens a native <dialog> lightbox: dark header
  bar, 45/55 stat/info split, disclaimer bar, X close (Esc / click
  outside also close).
{%- endcomment -%}

{%- liquid
  assign s = section.settings
-%}

{% style %}
  #shopify-section-{{ section.id }} .scs {
    width: 100%;
    background: {{ s.bg_color }};
    padding-top: {{ s.padding_top_mobile }}px;
    padding-bottom: {{ s.padding_bottom_mobile }}px;
    font-family: "tenon", sans-serif;
    color: {{ s.text_color }};
  }
  #shopify-section-{{ section.id }} .scs__inner { width: 100%; }
  #shopify-section-{{ section.id }} .scs__heading {
    text-align: center;
    font-size: 28px;
    font-weight: 400;
    line-height: 1.2;
    margin: 0 0 32px;
    padding: 10px 16px;
    color: inherit;
  }
  #shopify-section-{{ section.id }} .scs__pw {
    max-width: {{ s.page_width }}px;
    margin: 0 auto;
    padding: 0 16px;
  }
  #shopify-section-{{ section.id }} .scs__track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  #shopify-section-{{ section.id }} .scs__track::-webkit-scrollbar { display: none; }
  #shopify-section-{{ section.id }} .scs__slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    min-width: 0;
  }
  #shopify-section-{{ section.id }} .scs__card {
    width: 100%;
    height: 100%;
    padding: 24px 16px 32px;
    border-radius: 16px;
    border: 1px solid {{ s.accent_color }};
    overflow: hidden;
    text-align: center;
    transition: background-color .3s;
    display: flex;
    flex-direction: column;
  }
  #shopify-section-{{ section.id }} .scs__card:hover { background: {{ s.card_hover_bg }}; }
  #shopify-section-{{ section.id }} .scs__card-title {
    width: 100%;
    margin: 0;
    padding: 10px;
    font-size: 20px;
    font-weight: 400;
    line-height: 1.2;
    color: {{ s.text_color }};
    background: {{ s.card_hover_bg }};
    border-bottom: 1px solid {{ s.accent_color }};
  }
  #shopify-section-{{ section.id }} .scs__card-sub {
    display: block;
    width: 100%;
    font-size: 20px;
    color: {{ s.text_color }};
  }
  #shopify-section-{{ section.id }} .scs__circle {
    display: block;
    margin: 14px auto 0;
    max-width: 100%;
    max-height: 280px;
    width: 100%;
  }
  @keyframes scs-progress-{{ section.id | replace: '-', '' | slice: 0, 12 }} {
    0% { stroke-dasharray: 0 100; }
  }
  #shopify-section-{{ section.id }} .scs__circle .circle {
    animation: scs-progress-{{ section.id | replace: '-', '' | slice: 0, 12 }} 1s ease-out forwards;
  }
  #shopify-section-{{ section.id }} .scs__card-caption {
    width: 100%;
    padding: 0 14px;
    font-size: 18px;
    color: {{ s.text_color }};
    margin: 0;
  }
  #shopify-section-{{ section.id }} .scs__card-btn-wrap { margin: 6px 0 0; }
  #shopify-section-{{ section.id }} .scs__card-btn {
    transition: all .3s;
    cursor: pointer;
    padding: 10px 20px;
    display: inline-block;
    border: 1px solid {{ s.accent_color }};
    border-radius: 999px;
    background: {{ s.card_hover_bg }};
    color: {{ s.accent_color }};
    font-size: 18px;
    font-family: inherit;
    text-align: center;
    font-weight: 600;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .scs__card-btn:hover {
    background: {{ s.accent_color }};
    color: {{ s.bg_color }};
  }
  #shopify-section-{{ section.id }} .scs__card-btn em {
    border: 1px solid currentColor;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: inline-block;
    margin-left: 2px;
    line-height: 21px;
    text-align: center;
    font-style: normal;
    font-weight: 300;
    position: relative;
    top: 2px;
  }
  #shopify-section-{{ section.id }} .scs__dots {
    display: flex;
    justify-content: center;
    column-gap: 16px;
    list-style: none;
    margin: 24px 0 0;
    padding: 0 0 24px;
  }
  #shopify-section-{{ section.id }} .scs__dot {
    height: 18px;
    width: 18px;
    border: 1px solid {{ s.accent_color }};
    border-radius: 20px;
    background: transparent;
    padding: 0;
    cursor: pointer;
    font-size: 0;
  }
  #shopify-section-{{ section.id }} .scs__dot[aria-selected="true"] { background: {{ s.card_hover_bg }}; }

  #shopify-section-{{ section.id }} .scs__dialog {
    padding: 0;
    border: 1px solid {{ s.accent_color }};
    border-radius: 15px;
    overflow: hidden;
    background: {{ s.card_hover_bg }};
    max-width: 830px;
    width: 96%;
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    margin: 0;
    z-index: 2222;
    font-family: "tenon", sans-serif;
  }
  #shopify-section-{{ section.id }} .scs__dialog::backdrop { background: {{ s.overlay_color }}; }
  #shopify-section-{{ section.id }} .scs__dialog-title {
    background: {{ s.accent_color }};
    width: 100%;
    margin: 0;
    padding: 20px 40px;
    box-sizing: border-box;
    text-align: center;
    font-size: 26px;
    font-weight: 400;
    color: {{ s.bg_color }};
  }
  #shopify-section-{{ section.id }} .scs__dialog-body {
    width: 100%;
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid {{ s.accent_color }};
  }
  #shopify-section-{{ section.id }} .scs__dialog-stat,
  #shopify-section-{{ section.id }} .scs__dialog-info {
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 24px 20px;
  }
  #shopify-section-{{ section.id }} .scs__dialog-info { border-top: 1px solid {{ s.accent_color }}; }
  #shopify-section-{{ section.id }} .scs__dialog-stat-num {
    font-size: 60px;
    font-weight: 700;
    color: {{ s.accent_color }};
    line-height: 1;
    margin-bottom: 16px;
  }
  #shopify-section-{{ section.id }} .scs__dialog-stat p,
  #shopify-section-{{ section.id }} .scs__dialog-info p {
    font-size: 16px;
    line-height: 1.5;
    color: {{ s.text_color }};
    margin: 0;
  }
  #shopify-section-{{ section.id }} .scs__dialog-disclaimer {
    width: 100%;
    padding: 14px 16px;
    box-sizing: border-box;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .scs__dialog-disclaimer p {
    font-size: 14px;
    color: {{ s.text_color }};
    margin: 0;
  }
  #shopify-section-{{ section.id }} .scs__dialog-close {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 50;
    background: none;
    border: 0;
    cursor: pointer;
    color: {{ s.bg_color }};
    padding: 8px;
    line-height: 0;
    transition: transform .15s;
  }
  #shopify-section-{{ section.id }} .scs__dialog-close:active { transform: scale(.8); }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .scs {
      padding-top: {{ s.padding_top_desktop }}px;
      padding-bottom: {{ s.padding_bottom_desktop }}px;
    }
    #shopify-section-{{ section.id }} .scs__heading { font-size: 48px; }
    #shopify-section-{{ section.id }} .scs__card-title { background: transparent; border-bottom: 0; padding: 10px; font-size: 24px; }
    #shopify-section-{{ section.id }} .scs__card-sub { font-size: 20px; }
    #shopify-section-{{ section.id }} .scs__dialog-title { font-size: 36px; }
    #shopify-section-{{ section.id }} .scs__dialog-body { flex-direction: row; }
    #shopify-section-{{ section.id }} .scs__dialog-stat { width: 45%; padding: 70px 20px; }
    #shopify-section-{{ section.id }} .scs__dialog-info { width: 55%; padding: 70px 20px; border-top: 0; border-left: 1px solid {{ s.accent_color }}; }
    #shopify-section-{{ section.id }} .scs__dialog-info p { font-size: 18px; }
  }
  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .scs__track {
      overflow-x: visible;
      justify-content: center;
    }
    #shopify-section-{{ section.id }} .scs__slide { flex: 0 0 32.5%; }
    #shopify-section-{{ section.id }} .scs__card-title { font-size: 30px; }
    #shopify-section-{{ section.id }} .scs__card-sub { font-size: 18px; }
    #shopify-section-{{ section.id }} .scs__card-caption { font-size: 16px; padding: 0; min-height: 4.5rem; }
    #shopify-section-{{ section.id }} .scs__card-btn { font-size: 16px; }
    #shopify-section-{{ section.id }} .scs__dots { display: none; }
  }
{% endstyle %}

<div class="scs" data-scs>
  <div class="scs__inner">
    {%- if s.heading != blank -%}
      <h2 class="scs__heading">{{ s.heading }}</h2>
    {%- endif -%}
    <div class="scs__pw">
      <div class="scs__track" data-scs-track>
        {%- for block in section.blocks -%}
          {%- assign pct = block.settings.percentage -%}
          <div class="scs__slide" data-scs-slide {{ block.shopify_attributes }}>
            <div class="scs__card">
              <h3 class="scs__card-title">
                {{ block.settings.title }}
                {%- if block.settings.subtitle != blank -%}
                  <span class="scs__card-sub">{{ block.settings.subtitle }}</span>
                {%- endif -%}
              </h3>
              <svg viewBox="0 0 36 36" class="scs__circle" aria-hidden="true">
                <path
                  class="circle-bg"
                  fill="none"
                  stroke="{{ s.track_color }}"
                  stroke-width="1.8"
                  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                ></path>
                <path
                  class="circle"
                  fill="none"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-dasharray="{{ pct }}, 100"
                  stroke="{{ s.accent_color }}"
                  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                ></path>
                <text x="50%" y="60%" fill="{{ s.accent_color }}" font-size="0.625rem" text-anchor="middle" font-weight="500">{% if block.settings.value_label != blank %}{{ block.settings.value_label }}{% else %}{{ pct }}%{% endif %}</text>
              </svg>
              {%- if block.settings.caption != blank -%}
                <p class="scs__card-caption">{{ block.settings.caption }}</p>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <p class="scs__card-btn-wrap">
                  <button
                    type="button"
                    class="scs__card-btn"
                    aria-haspopup="dialog"
                    data-scs-open="scs-dialog-{{ block.id }}"
                  >
                    {{ block.settings.button_label }}
                    <em aria-hidden="true">+</em>
                  </button>
                </p>
              {%- endif -%}
            </div>

            <dialog
              class="scs__dialog"
              id="scs-dialog-{{ block.id }}"
              aria-labelledby="scs-dialog-title-{{ block.id }}"
            >
              <h2 id="scs-dialog-title-{{ block.id }}" class="scs__dialog-title">{{ block.settings.popup_heading | default: block.settings.title }}</h2>
              <div class="scs__dialog-body">
                <div class="scs__dialog-stat">
                  <span class="scs__dialog-stat-num">{{ block.settings.popup_stat | default: pct | append: '%' }}</span>
                  <p>{{ block.settings.popup_stat_text }}</p>
                </div>
                {%- if block.settings.popup_info_text != blank -%}
                  <div class="scs__dialog-info">
                    <p>{{ block.settings.popup_info_text }}</p>
                  </div>
                {%- endif -%}
              </div>
              {%- if s.disclaimer != blank -%}
                <div class="scs__dialog-disclaimer">
                  <p>{{ s.disclaimer }}</p>
                </div>
              {%- endif -%}
              <button type="button" class="scs__dialog-close" data-scs-close aria-label="Close dialog">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2L2 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M12 12L2 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </dialog>
          </div>
        {%- endfor -%}
      </div>

      {%- if section.blocks.size > 1 -%}
        <ol class="scs__dots" data-scs-dots>
          {%- for block in section.blocks -%}
            <li>
              <button
                type="button"
                class="scs__dot"
                aria-label="Slide {{ forloop.index }} of {{ section.blocks.size }}"
                data-scs-dot="{{ forloop.index0 }}"
                {% if forloop.first %}aria-selected="true"{% endif %}
              >{{ forloop.index }}</button>
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function () {
    function initSection() {
      var root = document.getElementById('shopify-section-{{ section.id }}');
      if (!root || root.dataset.scsInit === 'true') return;
      root.dataset.scsInit = 'true';

      root.querySelectorAll('[data-scs-open]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var dialog = document.getElementById(btn.getAttribute('data-scs-open'));
          if (dialog && typeof dialog.showModal === 'function') dialog.showModal();
        });
      });
      root.querySelectorAll('dialog.scs__dialog').forEach(function (dialog) {
        dialog.addEventListener('click', function (e) {
          if (e.target === dialog) dialog.close();
        });
        var closeBtn = dialog.querySelector('[data-scs-close]');
        if (closeBtn) closeBtn.addEventListener('click', function () { dialog.close(); });
      });

      var track = root.querySelector('[data-scs-track]');
      var dots = root.querySelectorAll('[data-scs-dot]');
      if (track && dots.length) {
        var slides = track.querySelectorAll('[data-scs-slide]');
        function setActive(i) {
          dots.forEach(function (d, j) {
            if (j === i) d.setAttribute('aria-selected', 'true');
            else d.removeAttribute('aria-selected');
          });
        }
        dots.forEach(function (dot) {
          dot.addEventListener('click', function () {
            var i = parseInt(dot.getAttribute('data-scs-dot'), 10);
            if (slides[i]) {
              track.scrollTo({ left: slides[i].offsetLeft - track.offsetLeft, behavior: 'smooth' });
            }
          });
        });
        var ticking = false;
        track.addEventListener('scroll', function () {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(function () {
            ticking = false;
            var w = slides[0] ? slides[0].offsetWidth + 16 : track.offsetWidth;
            var i = Math.round(track.scrollLeft / w);
            setActive(Math.min(i, dots.length - 1));
          });
        });
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSection);
    } else {
      initSection();
    }
    if (typeof window.Shopify !== 'undefined' && window.Shopify.designMode) {
      document.addEventListener('shopify:section:load', function (e) {
        if (e.detail && e.detail.sectionId === '{{ section.id }}') {
          var root = document.getElementById('shopify-section-{{ section.id }}');
          if (root) root.dataset.scsInit = '';
          initSection();
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Score cards slider",
  "tag": "section",
  "class": "section-score-cards-slider",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Results"
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Popup disclaimer",
      "default": "*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F2EEEA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1A2874"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (borders, progress, popup header)",
      "default": "#3447AF"
    },
    {
      "type": "color",
      "id": "card_hover_bg",
      "label": "Card hover / popup background",
      "default": "#e3e7ff"
    },
    {
      "type": "color",
      "id": "track_color",
      "label": "Progress track",
      "default": "#D9DFF0"
    },
    {
      "type": "color_background",
      "id": "overlay_color",
      "label": "Popup overlay",
      "default": "rgba(242, 238, 234, 0.87)"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "page_width",
      "label": "Max content width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1300
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "score_card",
      "name": "Score card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "[Marker] Levels"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "[Full marker name]"
        },
        {
          "type": "range",
          "id": "percentage",
          "label": "Percentage",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "text",
          "id": "value_label",
          "label": "Gauge label override",
          "info": "Optional. Text shown inside the circle instead of the percentage — e.g. \"−18.9%\". The gauge fill still uses the percentage above."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "of participants reported [outcome]*‡"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "What are [Marker] Levels"
        },
        {
          "type": "header",
          "content": "Popup"
        },
        {
          "type": "text",
          "id": "popup_heading",
          "label": "Popup heading",
          "info": "Defaults to the card title if empty."
        },
        {
          "type": "text",
          "id": "popup_stat",
          "label": "Popup stat value",
          "info": "Defaults to the percentage if empty."
        },
        {
          "type": "textarea",
          "id": "popup_stat_text",
          "label": "Popup stat text",
          "default": "of participants reported [outcome] after [duration] in our clinical study*‡"
        },
        {
          "type": "textarea",
          "id": "popup_info_text",
          "label": "Popup info text",
          "default": "[Placeholder — explain what this marker is and why it is measured.]"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Score cards slider",
      "blocks": [
        {
          "type": "score_card",
          "settings": {
            "percentage": 61
          }
        },
        {
          "type": "score_card",
          "settings": {
            "percentage": 76
          }
        },
        {
          "type": "score_card",
          "settings": {
            "percentage": 44
          }
        }
      ]
    }
  ]
}
{% endschema %}
