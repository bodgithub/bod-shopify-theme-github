{%- comment -%}
  BODOLOGY · LP reviews slider
  Mirrors ARMRA's "20,000+ Five-Star Reviews" slider: big number + label,
  then review cards (stars, title, quote, name, "Verified buyer") in a
  scroll-snap carousel with prev/next arrows and dots. Reviews are blocks.
  Mobile: one card with the next peeking. Desktop: three per view.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign n = section.blocks.size
-%}

<style>
  #shopify-section-{{ sid }} .lprv { background: {{ s.bg }}; color: {{ s.text_color }}; padding: {{ s.pad_top_mobile }}px 0 {{ s.pad_bottom_mobile }}px; font-family: "tenon", -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif; }
  #shopify-section-{{ sid }} .lprv__wrap { max-width: {{ s.page_width }}px; margin: 0 auto; padding: 0 16px; }
  #shopify-section-{{ sid }} .lprv__head { text-align: center; margin: 0 0 22px; }
  #shopify-section-{{ sid }} .lprv__big { display: block; font-size: {{ s.big_size_mobile }}px; line-height: 1; font-weight: 500; letter-spacing: -0.02em; color: {{ s.heading_color }}; }
  #shopify-section-{{ sid }} .lprv__sub { display: block; margin-top: 8px; font-size: 14px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: {{ s.accent }}; }
  #shopify-section-{{ sid }} .lprv__h { margin: 0 0 6px; font-size: {{ s.h_size_mobile }}px; line-height: 1.1; font-weight: 400; color: {{ s.heading_color }}; }
  #shopify-section-{{ sid }} .lprv__h em { font-style: italic; color: {{ s.accent }}; }
  #shopify-section-{{ sid }} .lprv__track { display: flex; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; margin: 0 -16px; padding: 2px 16px 6px; scrollbar-width: none; }
  #shopify-section-{{ sid }} .lprv__track::-webkit-scrollbar { display: none; }
  #shopify-section-{{ sid }} .lprv__card { flex: 0 0 84%; scroll-snap-align: start; background: {{ s.card_bg }}; border: 1px solid {{ s.card_border }}; border-radius: {{ s.card_radius }}px; padding: 20px 18px 18px; display: flex; flex-direction: column; min-height: 100%; }
  #shopify-section-{{ sid }} .lprv__stars { display: inline-flex; gap: 2px; margin: 0 0 10px; }
  #shopify-section-{{ sid }} .lprv__stars svg { width: 16px; height: 16px; display: block; }
  #shopify-section-{{ sid }} .lprv__t { margin: 0 0 8px; font-size: 17px; line-height: 1.3; font-weight: 600; color: {{ s.heading_color }}; }
  #shopify-section-{{ sid }} .lprv__q { margin: 0 0 14px; font-size: 15px; line-height: 1.5; flex: 1 1 auto; }
  #shopify-section-{{ sid }} .lprv__q p { margin: 0 0 6px; }
  #shopify-section-{{ sid }} .lprv__q strong { font-weight: 600; }
  #shopify-section-{{ sid }} .lprv__who { display: flex; align-items: center; gap: 10px; }
  #shopify-section-{{ sid }} .lprv__av { width: 36px; height: 36px; border-radius: 50%; overflow: hidden; background: #e3e7ff; flex: 0 0 auto; }
  #shopify-section-{{ sid }} .lprv__av img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ sid }} .lprv__name { font-size: 14px; font-weight: 600; display: block; }
  #shopify-section-{{ sid }} .lprv__role { font-size: 12px; opacity: .75; display: flex; align-items: center; gap: 4px; }
  #shopify-section-{{ sid }} .lprv__role svg { width: 12px; height: 12px; }
  #shopify-section-{{ sid }} .lprv__nav { display: flex; align-items: center; justify-content: center; gap: 14px; margin-top: 16px; }
  #shopify-section-{{ sid }} .lprv__btn { width: 40px; height: 40px; border-radius: 50%; border: 1.5px solid {{ s.arrow_color }}; background: transparent; color: {{ s.arrow_color }}; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
  #shopify-section-{{ sid }} .lprv__btn svg { width: 16px; height: 16px; }
  #shopify-section-{{ sid }} .lprv__btn:disabled { opacity: .35; cursor: default; }
  #shopify-section-{{ sid }} .lprv__dots { display: flex; gap: 6px; }
  #shopify-section-{{ sid }} .lprv__dot { width: 7px; height: 7px; border-radius: 50%; background: {{ s.arrow_color }}; opacity: .3; border: 0; padding: 0; cursor: pointer; }
  #shopify-section-{{ sid }} .lprv__dot[aria-current="true"] { opacity: 1; }
  #shopify-section-{{ sid }} .lprv__foot { margin: 18px auto 0; max-width: 60em; text-align: center; font-size: 12px; line-height: 1.5; opacity: .75; }
  #shopify-section-{{ sid }} .lprv__cta { display: inline-flex; align-items: center; justify-content: center; margin-top: 18px; min-height: 46px; padding: 12px 24px; border-radius: 40px; border: 1.5px solid {{ s.accent }}; color: {{ s.accent }}; font-size: 14px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; text-decoration: none; }

  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .lprv { padding: {{ s.pad_top }}px 0 {{ s.pad_bottom }}px; }
    #shopify-section-{{ sid }} .lprv__wrap { padding: 0 24px; }
    #shopify-section-{{ sid }} .lprv__head { margin-bottom: 32px; }
    #shopify-section-{{ sid }} .lprv__big { font-size: {{ s.big_size }}px; }
    #shopify-section-{{ sid }} .lprv__h { font-size: {{ s.h_size }}px; }
    #shopify-section-{{ sid }} .lprv__track { gap: 20px; margin: 0; padding: 2px 0 6px; }
    #shopify-section-{{ sid }} .lprv__card { flex: 0 0 calc((100% - 40px) / {{ s.per_view }}); padding: 26px 24px 22px; }
    #shopify-section-{{ sid }} .lprv__t { font-size: 18px; }
    #shopify-section-{{ sid }} .lprv__q { font-size: 16px; }
  }
</style>

<section class="lprv">
  <div class="lprv__wrap">
    <div class="lprv__head">
      {%- if s.heading != blank -%}<h2 class="lprv__h">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.big != blank -%}<span class="lprv__big">{{ s.big }}</span>{%- endif -%}
      {%- if s.sub != blank -%}<span class="lprv__sub">{{ s.sub }}</span>{%- endif -%}
    </div>

    {%- if n > 0 -%}
    <div class="lprv__track" data-lprv-track aria-roledescription="carousel" aria-label="{{ s.sub | default: 'Customer reviews' | escape }}">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <article class="lprv__card" {{ block.shopify_attributes }} aria-roledescription="slide" aria-label="{{ forloop.index }} of {{ n }}">
          <div class="lprv__stars" aria-label="{{ b.stars }} out of 5 stars">
            {%- for i in (1..5) -%}
              <svg viewBox="0 0 24 24" fill="{% if i <= b.stars %}{{ s.star_color }}{% else %}{{ s.star_off }}{% endif %}" aria-hidden="true"><path d="M12 2.5l2.9 6.2 6.8.8-5 4.7 1.3 6.7L12 17.6 5.9 20.9l1.3-6.7-5-4.7 6.8-.8z"/></svg>
            {%- endfor -%}
          </div>
          {%- if b.title != blank -%}<h3 class="lprv__t">{{ b.title }}</h3>{%- endif -%}
          {%- if b.text != blank -%}<div class="lprv__q">{{ b.text }}{% if b.sup != blank %}<sup>{{ b.sup }}</sup>{% endif %}</div>{%- endif -%}
          <div class="lprv__who">
            {%- if b.image != blank -%}<span class="lprv__av">{{ b.image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}</span>{%- endif -%}
            <span>
              {%- if b.name != blank -%}<span class="lprv__name">{{ b.name }}</span>{%- endif -%}
              {%- if b.role != blank -%}<span class="lprv__role"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5"/></svg>{{ b.role }}</span>{%- endif -%}
            </span>
          </div>
        </article>
      {%- endfor -%}
    </div>
    <div class="lprv__nav">
      <button type="button" class="lprv__btn" data-lprv-prev aria-label="Previous reviews"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg></button>
      <div class="lprv__dots" data-lprv-dots></div>
      <button type="button" class="lprv__btn" data-lprv-next aria-label="Next reviews"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg></button>
    </div>
    {%- endif -%}

    {%- if s.cta_label != blank -%}<div style="text-align:center;"><a class="lprv__cta" href="{{ s.cta_link | default: '#reviews' }}">{{ s.cta_label }}</a></div>{%- endif -%}
    {%- if s.footnote != blank -%}<div class="lprv__foot">{{ s.footnote }}</div>{%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.currentScript.closest('.shopify-section'); if (!root) { return; }
    var track = root.querySelector('[data-lprv-track]'); if (!track) { return; }
    var cards = Array.prototype.slice.call(track.children);
    var prev = root.querySelector('[data-lprv-prev]'), next = root.querySelector('[data-lprv-next]'), dots = root.querySelector('[data-lprv-dots]');
    var dotEls = cards.map(function (c, i) { var d = document.createElement('button'); d.type = 'button'; d.className = 'lprv__dot'; d.setAttribute('aria-label', 'Go to review ' + (i + 1)); d.addEventListener('click', function () { c.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' }); }); dots.appendChild(d); return d; });
    function step() { return cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : track.clientWidth; }
    function update() {
      var i = Math.round(track.scrollLeft / step()); i = Math.max(0, Math.min(cards.length - 1, i));
      dotEls.forEach(function (d, k) { if (k === i) { d.setAttribute('aria-current', 'true'); } else { d.removeAttribute('aria-current'); } });
      prev.disabled = track.scrollLeft <= 2; next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
    }
    prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
    next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
    track.addEventListener('scroll', function () { window.requestAnimationFrame(update); }, { passive: true });
    window.addEventListener('resize', update); update();
  })();
</script>

{% schema %}
{
  "name": "LP · Reviews slider",
  "tag": "div",
  "class": "section-lp-reviews-slider",
  "max_blocks": 12,
  "disabled_on": { "groups": ["header", "footer", "aside"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (optional)" },
    { "type": "text", "id": "big", "label": "Big line", "default": "4.8 stars", "info": "Keep in line with the live rating." },
    { "type": "text", "id": "sub", "label": "Label under the big line", "default": "From verified buyers" },
    { "type": "text", "id": "cta_label", "label": "Button label (optional)", "default": "Read all reviews" },
    { "type": "url", "id": "cta_link", "label": "Button link", "info": "Defaults to the #reviews anchor on this page." },
    { "type": "richtext", "id": "footnote", "label": "Footnote", "default": "<p>*Individual results vary. Reviews are from verified Bodology customers.</p>" },
    { "type": "range", "id": "per_view", "min": 2, "max": 4, "step": 1, "label": "Cards per view (desktop)", "default": 3 },
    { "type": "header", "content": "Style" },
    { "type": "range", "id": "page_width", "min": 1000, "max": 1600, "step": 20, "unit": "px", "label": "Content width", "default": 1240 },
    { "type": "range", "id": "big_size", "min": 36, "max": 96, "step": 2, "unit": "px", "label": "Big line size (desktop)", "default": 64 },
    { "type": "range", "id": "big_size_mobile", "min": 28, "max": 64, "step": 2, "unit": "px", "label": "Big line size (mobile)", "default": 44 },
    { "type": "range", "id": "h_size", "min": 24, "max": 56, "step": 2, "unit": "px", "label": "Heading size (desktop)", "default": 36 },
    { "type": "range", "id": "h_size_mobile", "min": 20, "max": 40, "step": 1, "unit": "px", "label": "Heading size (mobile)", "default": 26 },
    { "type": "range", "id": "card_radius", "min": 0, "max": 32, "step": 2, "unit": "px", "label": "Card corner radius", "default": 16 },
    { "type": "color", "id": "bg", "label": "Background", "default": "#fbfaf9" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "card_border", "label": "Card border", "default": "#e3e7ff" },
    { "type": "color", "id": "heading_color", "label": "Headings", "default": "#1a2874" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1a2874" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#1b3def" },
    { "type": "color", "id": "star_color", "label": "Stars", "default": "#ddbd6d" },
    { "type": "color", "id": "star_off", "label": "Empty stars", "default": "#e6e6e6" },
    { "type": "color", "id": "arrow_color", "label": "Arrows and dots", "default": "#1a2874" },
    { "type": "range", "id": "pad_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding (desktop)", "default": 88 },
    { "type": "range", "id": "pad_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding (desktop)", "default": 88 },
    { "type": "range", "id": "pad_top_mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding (mobile)", "default": 48 },
    { "type": "range", "id": "pad_bottom_mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding (mobile)", "default": 48 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "stars", "min": 1, "max": 5, "step": 1, "label": "Stars", "default": 5 },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "text", "label": "Review text", "default": "<p>Short, real customer quote.</p>" },
        { "type": "text", "id": "sup", "label": "Footnote mark", "default": "*" },
        { "type": "image_picker", "id": "image", "label": "Avatar (optional)" },
        { "type": "text", "id": "name", "label": "Name", "default": "First name L." },
        { "type": "text", "id": "role", "label": "Label", "default": "Verified buyer" }
      ]
    }
  ],
  "presets": [ { "name": "LP · Reviews slider", "blocks": [ { "type": "review" }, { "type": "review" }, { "type": "review" } ] } ]
}
{% endschema %}
