{%- comment -%}
  Bodology · Us vs them comparison table
  Heading with italic accent, then a comparison card: row labels left,
  raised brand column, one to three competitor columns. Row values are
  check / cross / short text; each row can carry an (i) hover tooltip so
  the table copy stays simple. Clinical palette + popup standard colors.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign comp_labels = ''
  if s.them1_label != blank
    assign comp_labels = comp_labels | append: '1'
  endif
  if s.them2_label != blank
    assign comp_labels = comp_labels | append: '2'
  endif
  if s.them3_label != blank
    assign comp_labels = comp_labels | append: '3'
  endif
  assign ncomp = comp_labels | size
  if ncomp == 0
    assign ncomp = 1
    assign comp_labels = '1'
  endif
-%}

{% style %}
  #shopify-section-{{ section.id }} .uvt {
    background: {{ s.bg }};
    color: {{ s.text_color }};
    padding: {{ s.padding_top }}px 0 {{ s.padding_bottom }}px;
    margin: {{ s.margin_top }}px 0 {{ s.margin_bottom }}px;
  }
  #shopify-section-{{ section.id }} .uvt__pw {
    max-width: 920px;
    margin: 0 auto;
    padding: 0 20px;
  }
  #shopify-section-{{ section.id }} .uvt__heading {
    text-align: center;
    color: {{ s.heading_color }};
    margin: 0 0 40px;
    {% if s.heading_size > 0 %}font-size: {{ s.heading_size }}px;{% endif %}
    line-height: 1.15;
    font-weight: 400;
  }
  #shopify-section-{{ section.id }} .uvt__heading em { color: {{ s.accent_color }}; }
  #shopify-section-{{ section.id }} .uvt__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 150px repeat({{ ncomp }}, 130px);
    align-items: stretch;
  }
  #shopify-section-{{ section.id }} .uvt__cell {
    display: flex;
    align-items: center;
    padding: 15px 16px;
    min-width: 0;
  }
  #shopify-section-{{ section.id }} .uvt__cell--label {
    background: {{ s.card_bg }};
    font-size: {{ s.label_size }}px;
    line-height: 1.4;
    gap: 8px;
    position: relative;
  }
  #shopify-section-{{ section.id }} .uvt__cell--them {
    background: {{ s.card_bg }};
    justify-content: center;
    font-weight: var(--font-body-bold-weight, 500);
    font-size: {{ s.label_size }}px;
  }
  #shopify-section-{{ section.id }} .uvt__cell--us {
    background: {{ s.us_color }};
    color: {{ s.us_text_color }};
    justify-content: center;
    font-weight: var(--font-body-bold-weight, 500);
    font-size: {{ s.label_size }}px;
  }
  #shopify-section-{{ section.id }} .uvt__row-line--label,
  #shopify-section-{{ section.id }} .uvt__row-line--them { border-top: 1px solid {{ s.line_color }}; }
  #shopify-section-{{ section.id }} .uvt__row-line--us { border-top: 1px solid rgba(255, 255, 255, 0.28); }
  #shopify-section-{{ section.id }} .uvt__corner--tl { border-top-left-radius: 14px; }
  #shopify-section-{{ section.id }} .uvt__corner--bl { border-bottom-left-radius: 14px; }
  #shopify-section-{{ section.id }} .uvt__corner--tr { border-top-right-radius: 14px; }
  #shopify-section-{{ section.id }} .uvt__corner--br { border-bottom-right-radius: 14px; }
  #shopify-section-{{ section.id }} .uvt__head { background: transparent; align-items: flex-end; }
  #shopify-section-{{ section.id }} .uvt__head--us {
    background: {{ s.us_color }};
    color: {{ s.us_text_color }};
    border-radius: 14px 14px 0 0;
    justify-content: center;
    padding: 18px 12px 14px;
    font-weight: var(--font-body-bold-weight, 500);
    font-size: 15px;
    flex-direction: column;
    gap: 8px;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .uvt__head--us img {
    max-width: 90px;
    max-height: 34px;
    object-fit: contain;
    display: block;
  }
  #shopify-section-{{ section.id }} .uvt__head--them {
    justify-content: center;
    text-align: center;
    font-size: 12.5px;
    line-height: 1.35;
    padding-bottom: 12px;
  }
  #shopify-section-{{ section.id }} .uvt__foot--us {
    background: {{ s.us_color }};
    border-radius: 0 0 14px 14px;
    height: 14px;
  }
  #shopify-section-{{ section.id }} .uvt__icon {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }
  #shopify-section-{{ section.id }} .uvt__icon svg { width: 12px; height: 12px; display: block; }
  #shopify-section-{{ section.id }} .uvt__icon--check { background: #ffffff; color: {{ s.us_color }}; }
  #shopify-section-{{ section.id }} .uvt__icon--cross { border: 1px solid currentColor; opacity: .55; }
  #shopify-section-{{ section.id }} .uvt__info {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 1px solid currentColor;
    background: none;
    color: inherit;
    opacity: .6;
    font-size: 10px;
    font-family: inherit;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    cursor: help;
    padding: 0;
  }
  #shopify-section-{{ section.id }} .uvt__info:hover, #shopify-section-{{ section.id }} .uvt__info:focus { opacity: 1; }
  #shopify-section-{{ section.id }} .uvt__tip {
    position: absolute;
    left: 12px;
    top: calc(100% - 6px);
    z-index: 12;
    width: min(280px, 72vw);
    background: #e3e7ff;
    border: 1px solid #3447af;
    border-radius: 10px;
    color: #1a2874;
    font-size: 12.5px;
    line-height: 1.55;
    font-weight: 400;
    padding: 12px 14px;
    box-shadow: 0 10px 26px rgba(26, 40, 116, 0.14);
    display: none;
    text-align: left;
  }
  #shopify-section-{{ section.id }} .uvt__info:hover + .uvt__tip,
  #shopify-section-{{ section.id }} .uvt__info:focus + .uvt__tip,
  #shopify-section-{{ section.id }} .uvt__tip:hover { display: block; }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .uvt__grid { grid-template-columns: minmax(0, 1fr) 78px repeat({{ ncomp }}, 70px); }
    #shopify-section-{{ section.id }} .uvt__cell { padding: 13px 10px; }
    #shopify-section-{{ section.id }} .uvt__cell--label { font-size: 13px; }
    #shopify-section-{{ section.id }} .uvt__cell--us, #shopify-section-{{ section.id }} .uvt__cell--them { font-size: 13px; }
    #shopify-section-{{ section.id }} .uvt__head--us { font-size: 13px; padding: 14px 8px 10px; }
    #shopify-section-{{ section.id }} .uvt__head--them { font-size: 11px; }
    #shopify-section-{{ section.id }} .uvt__icon { width: 21px; height: 21px; }
  }
{% endstyle %}

<div class="uvt">
  <div class="uvt__pw">
    {%- if s.heading != blank -%}
      <h2 class="uvt__heading{% if s.heading_size == 0 %} h1{% endif %}">{{ s.heading }}</h2>
    {%- endif -%}

    <div class="uvt__grid">
      {%- comment -%} header row {%- endcomment -%}
      <div class="uvt__cell uvt__head"></div>
      <div class="uvt__cell uvt__head--us">
        {%- if s.us_logo != blank -%}
          <img src="{{ s.us_logo | image_url: width: 180 }}" alt="{{ s.us_label | escape }}" loading="lazy">
        {%- else -%}
          <span>{{ s.us_label }}</span>
        {%- endif -%}
      </div>
      {%- for cix in (1..3) -%}
        {%- assign cs = cix | append: '' -%}
        {%- if comp_labels contains cs -%}
          {%- assign lk = 'them' | append: cix | append: '_label' -%}
          <div class="uvt__cell uvt__head uvt__head--them">{{ s[lk] | default: 'Them' }}</div>
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%} data rows {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- assign bs = block.settings -%}
        {%- assign first = forloop.first -%}
        {%- assign last = forloop.last -%}
        <div class="uvt__cell uvt__cell--label{% unless first %} uvt__row-line--label{% endunless %}{% if first %} uvt__corner--tl{% endif %}{% if last %} uvt__corner--bl{% endif %}" {{ block.shopify_attributes }}>
          <span>{{ bs.label }}</span>
          {%- if bs.info != blank -%}
            <button type="button" class="uvt__info" aria-label="More info">i</button>
            <span class="uvt__tip" role="tooltip">{{ bs.info }}</span>
          {%- endif -%}
        </div>
        <div class="uvt__cell uvt__cell--us{% unless first %} uvt__row-line--us{% endunless %}">
          {%- case bs.us_value -%}
            {%- when 'text' -%}
              <span>{{ bs.us_text }}</span>
            {%- when 'cross' -%}
              <span class="uvt__icon uvt__icon--cross"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><line x1="3" y1="3" x2="9" y2="9"></line><line x1="9" y1="3" x2="3" y2="9"></line></svg></span>
            {%- else -%}
              <span class="uvt__icon uvt__icon--check"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="2 6.5 5 9.5 10 3"></polyline></svg></span>
          {%- endcase -%}
        </div>
        {%- for cix in (1..3) -%}
          {%- assign cs = cix | append: '' -%}
          {%- if comp_labels contains cs -%}
            {%- assign vk = 'them' | append: cix | append: '_value' -%}
            {%- assign tk = 'them' | append: cix | append: '_text' -%}
            {%- assign is_last_col = false -%}
            {%- assign last_char = comp_labels | slice: -1, 1 -%}
            {%- if last_char == cs -%}{%- assign is_last_col = true -%}{%- endif -%}
            <div class="uvt__cell uvt__cell--them{% unless first %} uvt__row-line--them{% endunless %}{% if first and is_last_col %} uvt__corner--tr{% endif %}{% if last and is_last_col %} uvt__corner--br{% endif %}">
              {%- case bs[vk] -%}
                {%- when 'text' -%}
                  <span>{{ bs[tk] }}</span>
                {%- when 'check' -%}
                  <span class="uvt__icon uvt__icon--check" style="color: {{ s.text_color }};"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="2 6.5 5 9.5 10 3"></polyline></svg></span>
                {%- else -%}
                  <span class="uvt__icon uvt__icon--cross"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><line x1="3" y1="3" x2="9" y2="9"></line><line x1="9" y1="3" x2="3" y2="9"></line></svg></span>
              {%- endcase -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}

      {%- comment -%} bottom protrusion of the brand column {%- endcomment -%}
      <div></div>
      <div class="uvt__foot--us"></div>
      {%- for cix in (1..3) -%}
        {%- assign cs = cix | append: '' -%}
        {%- if comp_labels contains cs -%}<div></div>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Us vs them table",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Not your <em>average</em> inositol",
      "info": "Italics render in the Instrument serif and use the accent color."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 0,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme H1 size."
    },
    {
      "type": "header",
      "content": "Columns"
    },
    {
      "type": "text",
      "id": "us_label",
      "label": "Our column name",
      "default": "Bodology"
    },
    {
      "type": "image_picker",
      "id": "us_logo",
      "label": "Our column logo",
      "info": "Replaces the column name when set."
    },
    {
      "type": "text",
      "id": "them1_label",
      "label": "Competitor 1",
      "default": "Typical Amazon inositol"
    },
    {
      "type": "text",
      "id": "them2_label",
      "label": "Competitor 2",
      "info": "Leave empty to hide this column."
    },
    {
      "type": "text",
      "id": "them3_label",
      "label": "Competitor 3",
      "info": "Leave empty to hide this column."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#f2eeea"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Table background",
      "default": "#faf7f3"
    },
    {
      "type": "color",
      "id": "us_color",
      "label": "Our column",
      "default": "#1b3def"
    },
    {
      "type": "color",
      "id": "us_text_color",
      "label": "Our column text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1a2874"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#1a2874"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Heading accent (italics)",
      "default": "#1b3def"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Row lines",
      "default": "#e2dbd2"
    },
    {
      "type": "header",
      "content": "Sizes and spacing"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Row text size",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Full clinical daily dose"
        },
        {
          "type": "textarea",
          "id": "info",
          "label": "More info (hover tooltip)",
          "info": "Shown when the small i is hovered or tapped. Leave empty to hide the i."
        },
        {
          "type": "select",
          "id": "us_value",
          "label": "Our value",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "cross", "label": "Cross" },
            { "value": "text", "label": "Text" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "us_text",
          "label": "Our text value"
        },
        {
          "type": "select",
          "id": "them1_value",
          "label": "Competitor 1 value",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "cross", "label": "Cross" },
            { "value": "text", "label": "Text" }
          ],
          "default": "cross"
        },
        {
          "type": "text",
          "id": "them1_text",
          "label": "Competitor 1 text value"
        },
        {
          "type": "select",
          "id": "them2_value",
          "label": "Competitor 2 value",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "cross", "label": "Cross" },
            { "value": "text", "label": "Text" }
          ],
          "default": "cross"
        },
        {
          "type": "text",
          "id": "them2_text",
          "label": "Competitor 2 text value"
        },
        {
          "type": "select",
          "id": "them3_value",
          "label": "Competitor 3 value",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "cross", "label": "Cross" },
            { "value": "text", "label": "Text" }
          ],
          "default": "cross"
        },
        {
          "type": "text",
          "id": "them3_text",
          "label": "Competitor 3 text value"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Us vs them table",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "label": "Inositol per serving",
            "us_value": "text",
            "us_text": "4,100mg",
            "them1_value": "text",
            "them1_text": "~500mg",
            "info": "One Bodology serving is 2 scoops: 4,000mg myo-inositol + 100mg D-chiro-inositol — the full clinically studied daily dose. Typical capsule products hold about 500mg per capsule."
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "40:1 clinical ratio",
            "us_value": "check",
            "them1_value": "cross",
            "info": "Bodology uses the 40:1 myo- to D-chiro-inositol ratio used in clinical research. Many products skip D-chiro entirely or don't state a ratio at all."
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Full dose in one serving",
            "us_value": "check",
            "them1_value": "cross",
            "info": "Two small scoops, once a day. At 500mg per capsule, reaching a 4,100mg daily dose means swallowing 8 or more capsules every day."
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Dissolves clear, unflavored",
            "us_value": "check",
            "them1_value": "cross",
            "info": "A powder that mixes into water, coffee, or smoothies — no capsule shells, no fillers, no flavoring."
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Published lab report",
            "us_value": "check",
            "them1_value": "cross",
            "info": "Every batch is third-party tested and we publish the certificate of analysis. Most brands don't publish theirs."
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Carob-derived D-chiro",
            "us_value": "check",
            "them1_value": "cross",
            "info": "Our D-chiro-inositol is derived from carob grown in Spain. Most competitors derive theirs from corn."
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "60-day money-back guarantee",
            "us_value": "check",
            "them1_value": "cross",
            "info": "If your first order doesn't meet your expectations, email us within 60 days of receiving it and we'll make it right."
          }
        }
      ]
    }
  ]
}
{% endschema %}
