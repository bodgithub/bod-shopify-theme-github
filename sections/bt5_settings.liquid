    "b_coupon_text": {{ settings.bcd_b_coupon_text | default: '{percent}% off applied' | json }},
    "checkout_text": {{ settings.bcd_checkout_text | default: 'Secure checkout · {total}' | json }},
    "checkout_text_b": {{ settings.bcd_checkout_text_b | default: 'Checkout' | json }},
    "checkout_text_c": {{ settings.bcd_checkout_text_c | default: 'Checkout securely' | json }},
    "trust": {{ settings.bcd_trust | json }},
    "trust_1": {{ settings.bcd_trust_1 | default: '3rd-party tested' | json }},
    "trust_2": {{ settings.bcd_trust_2 | default: 'Free US shipping' | json }},
    "trust_3": {{ settings.bcd_trust_3 | default: 'Cancel anytime' | json }},
    "title": {{ settings.bcd_title | default: 'Your cart' | json }},
    "empty_text": {{ settings.bcd_empty_text | default: 'Your cart is currently empty.' | json }},
    "empty_cta": {{ settings.bcd_empty_cta | default: 'Start shopping' | json }},
    "empty_url": {{ empty_url | json }},
    "free_shipping": {{ settings.free_shipping | json }},
    "free_shipping_minimum": {{ free_shipping_minimum | json }},
    "terms_enabled": {{ settings.cart_terms_conditions_enable | json }},
    "terms_html": {% if settings.cart_terms_conditions_enable %}{% if settings.cart_terms_conditions_page != blank %}{{ 'sections.cart.terms_html' | t: url: settings.cart_terms_conditions_page.url | json }}{% else %}{{ 'sections.cart.terms' | t | json }}{% endif %}{% else %}null{% endif %},
    "terms_required_text": {{ 'sections.cart.terms_confirm' | t | json }}
  },
  "money_format": {{ shop.money_format | json }},
  "routes": {
    "root": {{ routes.root_url | json }},
    "cart": {{ routes.cart_url | json }}
  }
}
</div>