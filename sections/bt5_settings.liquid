    "plan_subtitle": {{ settings.bcd_plan_subtitle | default: 'Ships every {interval} · cancel anytime' | json }},
    "renewal_text": {{ settings.bcd_renewal_text | default: 'Renews every {interval} at {renewal_price} until you cancel. Skip or cancel anytime in your account.' | json }},
    "plan_intervals": {{ settings.bcd_plan_intervals | default: '6331924699: 4 weeks|5755961563: 6 weeks|7141621979: 3 months' | json }},
    "oneoff_subtitle": {{ settings.bcd_oneoff_subtitle | default: 'One-time purchase' | json }},
    "badge_text": {{ settings.bcd_badge_text | default: '{percent}% OFF' | json }},
    "qty_text": {{ settings.bcd_qty_text | default: 'Qty {qty}' | json }},
    "free_label": {{ settings.bcd_free_label | default: 'FREE' | json }},
    "protocol_value": {{ settings.bcd_protocol_value | default: '49.00' | json }},
    "protocol_variant": {{ settings.bcd_protocol_variant | json }},
    "protocol_line_free": {{ settings.bcd_protocol_line_free | default: 'Included with your subscription · emailed after purchase' | json }},
