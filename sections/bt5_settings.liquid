    "label_code_prefix": {{ settings.bcd_label_code_prefix | default: 'Code' | json }},
    "label_protocol_row": {{ settings.bcd_label_protocol_row | default: 'Free protocol with subscription' | json }},
    "label_shipping": {{ settings.bcd_label_shipping | default: 'Shipping' | json }},
    "label_total": {{ settings.bcd_label_total | default: 'Total today' | json }},
    "label_savings_heading": {{ settings.bcd_label_savings_heading | default: 'YOUR SAVINGS' | json }},
    "label_total_saved": {{ settings.bcd_label_total_saved | default: 'Total saved today' | json }},
    "savings_strip": {{ settings.bcd_savings_strip | json }},
