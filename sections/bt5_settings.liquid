    "protocol_nudge_button": {{ settings.bcd_protocol_nudge_button | default: 'Add' | json }},
    "shipping_unlocked": {{ settings.bcd_shipping_unlocked | default: 'Free shipping unlocked' | json }},
    "shipping_remaining": {{ settings.bcd_shipping_remaining | default: 'Spend {amount} more for free shipping' | json }},
    "protocol_unlocked": {{ settings.bcd_protocol_unlocked | default: 'Free protocol unlocked' | json }},
    "protocol_locked": {{ settings.bcd_protocol_locked | default: 'Subscribe to unlock the free protocol' | json }},
    "upsell": {{ settings.bcd_upsell | json }},
    "upsell_text": {{ settings.bcd_upsell_text | default: 'Switch to {target}: save {percent}%{protocol_text}' | json }},
    "upsell_protocol_text": {{ settings.bcd_upsell_protocol_text | default: ' and get the protocol free' | json }},
