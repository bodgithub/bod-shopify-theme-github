
{{- 'expert-slides.css' | asset_url | stylesheet_tag -}}

{%- liquid
  assign section_heading = section.settings.heading
  assign full_width = section.settings.full_width
  assign font_family = section.settings.font_family
  assign text_size = section.settings.text_size
  assign color_heading = section.settings.color_heading
  assign color_bg = section.settings.color_bg
  assign color_body_bg = settings.color_body_bg | downcase
  assign color_border_card = section.settings.color_border_card
  assign color_bg_card = section.settings.color_bg_card
  assign color_text = section.settings.color_text
  assign color_text2 = section.settings.color_text2
  assign disable_top_spacing = section.settings.disable_top_spacing
  assign disable_bottom_spacing = section.settings.disable_bottom_spacing
  assign has_bg = true
  if color_body_bg == color_bg or color_bg == 'transparent' or color_bg == 'rgba(0,0,0,0)'
    assign has_bg = false
  endif
-%}

{%- if disable_top_spacing or disable_bottom_spacing -%}
<style>
  #shopify-section-{{ section.id }} .testimonials-exert {
    {% if disable_top_spacing %}padding-top: 0;{% endif %}
    {% if disable_bottom_spacing %}padding-bottom: 0;{% endif %}
  }
  {% if disable_top_spacing %}
  #shopify-section-{{ section.id }} .testimonials-main-section { padding-top: 0; margin-top: 0; }
  #shopify-section-{{ section.id }} .testimonials--headings > :first-child { margin-top: 0; }
  {% endif %}
</style>
{%- endif -%}
<div class="testimonials-main-section {% if has_bg -%}collapsible-content--has-bg{% endif %} testimonials---full-width-{{ full_width }}" style=" --color-bg:{{ color_bg }};  --color-bg-card:{{ color_bg_card }}; --color-heading: {{ color_heading }}; --color-border-card:{{ color_border_card }}; --color-text2: {{ color_text2 }}; --color-text:{{ color_text }}; --bg-body-rgb: {{ color_bg.rgb | replace: ' ' , ',' }}">
  <div class="row{% if full_width %} full-width-row-full{% endif %}">
    <div class="small-12 columns">
      <div class="testimonials-exert">
        {%- if section_heading -%}
        <div class="testimonials--headings">
          <h1>{{ section_heading }}</h1>
          {% if section.settings.text != blank %}
            <p>{{ section.settings.text }}</p>
          {% endif %}
{% if section.settings.show_button %}
  {%- if section.settings.experts_popup -%}
  <button type="button" class="button desktop-only" data-tc-experts-open>{{ section.settings.button_text }}</button>
  {%- else -%}
  <a href="{{ section.settings.button_url }}" class="button desktop-only">
    {{ section.settings.button_text }}
  </a>
  {%- endif -%}
{% endif %}
          
        </div>
        {%- endif -%}

        <div class="testimonial-carousel">
          <div class="testimonial-wrapper">
            {% if section.settings.testimonial_source == 'blocks' %}
              {% assign slide_index = 0 %}
              {% for block in section.blocks %}
                {% if block.type != 'testimonial' %}{% continue %}{% endif %}
                <div class="testimonial-block" data-index="{{ slide_index }}">
                  {% assign slide_index = slide_index | plus: 1 %}
                  <div class="block-inner">
                    <div class="expert-image">
                      {% if block.settings.image %}
                        <img src="{{ block.settings.image | img_url: 'master' }}" alt="{{ block.settings.name }}">
                      {% endif %}
                    </div>
                    <div class="testi-content">
                      <h5>{{ block.settings.name }}</h5>
                      <h6>{{ block.settings.role }}</h6>
                    </div>
                    <div class="testi-bottom">
                      <p>{{ block.settings.quote }}</p>
                    </div>
                  </div>
                </div>
              {% endfor %}
            {% elsif section.settings.testimonial_source == 'metaobject' %}
              {% for expert in shop.metaobjects.experts.values %}
                <div class="testimonial-block" data-index="{{ forloop.index0 }}">
                  <div class="block-inner">
                    <div class="expert-image">
                      <img src="{{ expert.expert_photo | img_url: 'master' }}" alt="{{ expert.expert_name }}">
                    </div>
                    <div class="testi-content">
                      <h5>{{ expert.expert_name }}</h5>
                      <h6>{{ expert.expert_title }}</h6>
                    </div>
                    <div class="testi-bottom">
                      <p>{{ expert.expert_quote }}</p>
                    </div>
                  </div>
                </div>
              {% endfor %}
            {% endif %}
          </div>

          <div class="carousel-controls">
            <button class="prev">{% render 'svg-icons' with 'thb-caret-left' %}</button>
            <button class="next">{% render 'svg-icons' with 'thb-caret-right' %}</button>
          </div>
        </div>

        {% if section.settings.show_button %}
  {%- if section.settings.experts_popup -%}
  <button type="button" class="button mobile-only" data-tc-experts-open>{{ section.settings.button_text }}</button>
  {%- else -%}
  <a href="{{ section.settings.button_url }}" class="button mobile-only">
    {{ section.settings.button_text }}
  </a>
  {%- endif -%}
{% endif %}
      </div>
    </div>
  </div>
</div>

{%- if section.settings.experts_popup -%}
<style>
  #tc-exp-{{ section.id }} { position: fixed; inset: 0; z-index: 2147482998; display: none; }
  #tc-exp-{{ section.id }}.is-open { display: block; }
  #tc-exp-{{ section.id }} .tc-exp__overlay { position: absolute; inset: 0; background: rgba(242, 238, 234, 0.87); }
  #tc-exp-{{ section.id }} .tc-exp__box {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 2147483000;
    width: 96%;
    max-width: 700px;
    max-height: 85dvh;
    overflow-y: auto;
    background: #e3e7ff;
    border: 1px solid #3447af;
    border-radius: 16px;
    padding: 32px 24px;
    text-align: center;
    color: #1a2874;
    font-family: "tenon", sans-serif;
  }
  #tc-exp-{{ section.id }} .tc-exp__title { font-size: 20px; font-weight: 400; line-height: 1.2; margin: 0 0 20px; color: #1a2874; }
  #tc-exp-{{ section.id }} .tc-exp__name { font-size: 15px; font-weight: var(--font-body-bold-weight, 500); margin: 0 0 2px; color: #1a2874; }
  #tc-exp-{{ section.id }} .tc-exp__role { font-size: 12px; opacity: .8; margin: 0 0 8px; }
  #tc-exp-{{ section.id }} .tc-exp__blurb { font-size: 12px; line-height: 1.6; margin: 0; padding-bottom: 26px; }
  #tc-exp-{{ section.id }} .tc-exp__blurb p { margin: 0 0 8px; font-size: inherit; line-height: inherit; color: inherit; }
  #tc-exp-{{ section.id }} .tc-exp__blurb p:last-child { margin-bottom: 0; }
  #tc-exp-{{ section.id }} .tc-exp__item:last-of-type .tc-exp__blurb { padding-bottom: 0; }
  #tc-exp-{{ section.id }} .tc-exp__close {
    display: block;
    margin: 22px auto 0;
    color: #1a2874;
    font-size: 14px;
    text-decoration: underline;
    cursor: pointer;
    background: none;
    border: 0;
    padding: 0;
    font-family: inherit;
  }
  @media screen and (min-width: 750px) {
    #tc-exp-{{ section.id }} .tc-exp__box { padding: 32px; }
    #tc-exp-{{ section.id }} .tc-exp__title { font-size: 36px; }
    #tc-exp-{{ section.id }} .tc-exp__name { font-size: 18px; }
    #tc-exp-{{ section.id }} .tc-exp__role { font-size: 14px; }
    #tc-exp-{{ section.id }} .tc-exp__blurb { font-size: 18px; }
  }
</style>
<div id="tc-exp-{{ section.id }}" role="dialog" aria-modal="true" aria-label="{{ section.settings.experts_title | escape }}" hidden>
  <div class="tc-exp__overlay" data-tc-exp-close></div>
  <div class="tc-exp__box">
    {%- if section.settings.experts_title != blank -%}
      <h3 class="tc-exp__title">{{ section.settings.experts_title }}</h3>
    {%- endif -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'expert' -%}
        <div class="tc-exp__item" {{ block.shopify_attributes }}>
          {%- if block.settings.name != blank -%}<p class="tc-exp__name">{{ block.settings.name }}</p>{%- endif -%}
          {%- if block.settings.title != blank -%}<p class="tc-exp__role">{{ block.settings.title }}</p>{%- endif -%}
          {%- if block.settings.blurb != blank -%}<div class="tc-exp__blurb">{{ block.settings.blurb }}</div>{%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
    <button type="button" class="tc-exp__close" data-tc-exp-close>Close</button>
  </div>
</div>
<script>
(function(){
  var pop = document.getElementById('tc-exp-{{ section.id }}');
  var root = document.getElementById('shopify-section-{{ section.id }}');
  if(!pop || !root) return;
  function open(){ pop.hidden = false; pop.classList.add('is-open'); document.documentElement.style.overflow = 'hidden'; }
  function close(){ pop.classList.remove('is-open'); pop.hidden = true; document.documentElement.style.overflow = ''; }
  [].slice.call(root.querySelectorAll('[data-tc-experts-open]')).forEach(function(b){
    b.addEventListener('click', function(e){ e.preventDefault(); open(); });
  });
  [].slice.call(pop.querySelectorAll('[data-tc-exp-close]')).forEach(function(b){
    b.addEventListener('click', close);
  });
  document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && pop.classList.contains('is-open')) close(); });
})();
</script>
{%- endif -%}

{% schema %}
{
