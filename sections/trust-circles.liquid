{%- comment -%}
  BODOLOGY · Trust circles
  Circular-badge version of the trust strip: each icon sits in a
  bordered circle with a larger halo circle behind it (double-border
  look), title + sub-label in small type beneath. Optional info
  tooltip per badge opens a clinical-styled popup. Icons come from
  snippets/trust-strip-icon.liquid. Every color and size is a setting.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign inner = s.circle_size | minus: 16
  assign icon = inner | times: 0.5 | round
-%}

{% style %}
  #shopify-section-{{ section.id }} .tc {
    width: 100%;
    background: {{ s.section_bg }};
    margin: {{ s.margin_top }}px 0 {{ s.margin_bottom }}px;
    padding: {{ s.padding_top }}px 16px {{ s.padding_bottom }}px;
    font-family: "tenon", sans-serif;
  }
  #shopify-section-{{ section.id }} .tc__pw { max-width: {{ s.max_width }}px; margin: 0 auto; }
  #shopify-section-{{ section.id }} .tc__headline {
    text-align: center;
    font-size: {{ s.headline_size }}px;
    font-weight: 600;
    line-height: 1.2;
    color: {{ s.headline_color }};
    margin: 0 0 22px;
  }
  #shopify-section-{{ section.id }} .tc__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px 10px;
  }
  #shopify-section-{{ section.id }} .tc__item {
    flex: 0 0 calc(33.333% - 7px);
    max-width: 100px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .tc__outer {
    width: {{ s.circle_size }}px;
    height: {{ s.circle_size }}px;
    position: relative;
    border-radius: 50%;
    background: {{ s.outer_bg }};
    {% if s.outer_border != blank %}border: 1px solid {{ s.outer_border }};{% endif %}
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 10px;
  }
  #shopify-section-{{ section.id }} .tc__inner {
    width: {{ inner }}px;
    height: {{ inner }}px;
    border-radius: 50%;
    background: {{ s.circle_bg }};
    border: 1px solid {{ s.circle_border }};
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #shopify-section-{{ section.id }} .tc__inner svg {
    width: {{ icon }}px;
    height: {{ icon }}px;
    fill: none;
    stroke: {{ s.icon_color }};
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  #shopify-section-{{ section.id }} .tc__title {
    padding-bottom: 3px;
    font-size: {{ s.title_size }}px;
    font-weight: 600;
    line-height: 1.3;
    color: {{ s.title_color }};
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  #shopify-section-{{ section.id }} .tc__i {
    position: absolute; top: 5px; right: 10px; z-index: 2;
    width: 18px; height: 18px; border-radius: 50%;
    border: 1px solid {{ s.circle_border }};
    color: {{ s.circle_border }};
    background: {{ s.circle_bg }};
    font-size: 10px; font-weight: 600; line-height: 1;
    display: inline-grid; place-items: center;
    cursor: pointer; padding: 0; font-family: inherit;
  }
  #shopify-section-{{ section.id }} .tc__i:hover { background: {{ s.circle_border }}; color: #fff; }
  #shopify-section-{{ section.id }} .tc__sub {
    font-size: {{ s.sub_size }}px;
    line-height: 1.35;
    color: {{ s.sub_color }};
    margin-top: 2px;
  }
  #shopify-section-{{ section.id }} .tc-overlay {
    display: none; position: fixed; inset: 0; z-index: 2147482998;
    background: rgba(242, 238, 234, 0.87);
  }
  #shopify-section-{{ section.id }} .tc-popup {
    display: none; position: fixed; top: 50%; left: 50%;
    transform: translate(-50%, -50%); z-index: 2147483000;
    background: #e3e7ff; border: 1px solid #3447af; border-radius: 16px;
    overflow: hidden; max-height: 85dvh; overflow-y: auto; padding: 32px 24px; width: 96%; max-width: 700px;
    font-family: "tenon", sans-serif;
  }
  #shopify-section-{{ section.id }} .tc-overlay.is-open,
  #shopify-section-{{ section.id }} .tc-popup.is-open { display: block; }
  #shopify-section-{{ section.id }} .tc-popup__t {
    color: #1a2874; margin: 0 0 20px; text-align: center;
    font-size: 20px; font-weight: 400; line-height: 1.25;
  }
  #shopify-section-{{ section.id }} .tc-popup__b { color: #1a2874; text-align: center; font-size: 12px; line-height: 1.6; }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .tc-popup__t { font-size: 36px; }
    #shopify-section-{{ section.id }} .tc-popup__b { font-size: 18px; padding: 0 24px; }
  }
  #shopify-section-{{ section.id }} .tc-popup__b p { margin: 0 0 8px; }
  #shopify-section-{{ section.id }} .tc-popup__b h1,   #shopify-section-{{ section.id }} .tc-popup__b h2,   #shopify-section-{{ section.id }} .tc-popup__b h3,   #shopify-section-{{ section.id }} .tc-popup__b h4,   #shopify-section-{{ section.id }} .tc-popup__b h5,   #shopify-section-{{ section.id }} .tc-popup__b h6 { color: #1a2874; font-family: "tenon", sans-serif; }
  #shopify-section-{{ section.id }} .tc__coa {
    display: block; margin: 16px auto 0; color: {{ s.title_color }};
    font-size: 14px; text-decoration: underline; cursor: pointer;
    background: none; border: 0; padding: 0; font-family: inherit;
  }
  #shopify-section-{{ section.id }} .tc-popup__close {
    display: block; margin: 14px auto 0; color: #1a2874; font-size: 14px;
    text-decoration: underline; cursor: pointer; background: none; border: 0; padding: 0; font-family: inherit;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .tc__item--hm { display: none; }
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .tc__item { flex: 0 0 calc(25% - 8px); }
  }
{% endstyle %}

<div class="tc" data-tc>
  <div class="tc__pw">
    {%- if s.headline != blank -%}
      <h2 class="tc__headline">{{ s.headline }}</h2>
    {%- endif -%}
    <div class="tc__grid">
      {%- for block in section.blocks -%}
        <div class="tc__item{% if block.settings.hide_mobile %} tc__item--hm{% endif %}" {{ block.shopify_attributes }}>
          <span class="tc__outer">{% if block.settings.tip != blank %}<button type="button" class="tc__i" data-tc-open="{{ block.id }}" aria-label="More about {{ block.settings.title | escape }}">i</button>{% endif %}<span class="tc__inner">
            <svg viewBox="0 0 24 24" aria-hidden="true">{% render 'trust-strip-icon', icon: block.settings.icon %}</svg>
          </span></span>
          {%- if block.settings.title != blank -%}
            <span class="tc__title">{{ block.settings.title }}</span>
          {%- endif -%}
          {%- if block.settings.sub != blank -%}
            <span class="tc__sub">{{ block.settings.sub }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
  {%- if s.coa_enable -%}
  <button type="button" class="tc__coa" data-tc-open="coa">{{ s.coa_link_text | default: 'Read our COA' }}</button>
  {%- endif -%}
  <div class="tc-overlay" data-tc-overlay></div>
  {%- if s.coa_enable -%}
  <div class="tc-popup" data-tc-popup="coa" role="dialog" aria-modal="true" aria-label="Certificate of Analysis">
    <h3 class="tc-popup__t">Certificate of Analysis</h3>
    {% render 'coa-content' %}
    <button type="button" class="tc-popup__close" data-tc-close>Close</button>
  </div>
  {%- endif -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.tip != blank -%}
      <div class="tc-popup" data-tc-popup="{{ block.id }}" role="dialog" aria-modal="true">
        <h3 class="tc-popup__t">{{ block.settings.title }}</h3>
        <div class="tc-popup__b">{{ block.settings.tip }}</div>
        <button type="button" class="tc-popup__close" data-tc-close>Close</button>
      </div>
    {%- endif -%}
  {%- endfor -%}
</div>

<script>
  (function () {
    function init() {
      var root = document.getElementById('shopify-section-{{ section.id }}');
      if (!root || root.dataset.tcInit === 'true') return;
      root.dataset.tcInit = 'true';
      var overlay = root.querySelector('[data-tc-overlay]');
      var popups = root.querySelectorAll('[data-tc-popup]');
      function closeAll(){ if(overlay) overlay.classList.remove('is-open'); popups.forEach(function(p){ p.classList.remove('is-open'); }); }
      root.querySelectorAll('[data-tc-open]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var t = root.querySelector('[data-tc-popup="' + btn.getAttribute('data-tc-open') + '"]');
          if (t && overlay) { overlay.classList.add('is-open'); t.classList.add('is-open'); }
        });
      });
      if (overlay) overlay.addEventListener('click', closeAll);
      root.querySelectorAll('[data-tc-close]').forEach(function (b) { b.addEventListener('click', closeAll); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeAll(); });
    }
    if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', init); } else { init(); }
    if (typeof window.Shopify !== 'undefined' && window.Shopify.designMode) {
      document.addEventListener('shopify:section:load', function (e) {
        if (e.detail && e.detail.sectionId === '{{ section.id }}') { var r = document.getElementById('shopify-section-{{ section.id }}'); if (r) r.dataset.tcInit = ''; init(); }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Trust circles",
  "tag": "section",
  "class": "section-trust-circles",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
