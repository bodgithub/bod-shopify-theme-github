        {
          "type": "range",
          "id": "stars",
          "label": "Stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Offer spotlight",
      "blocks": [
        { "type": "item", "settings": { "text": "4,000mg myo + 100mg D-chiro — the full clinical daily dose" } },
        { "type": "item", "settings": { "text": "40:1 clinically studied ratio" } },
        { "type": "item", "settings": { "text": "90-day supply: two 45-day tubs" } },
        { "type": "item", "settings": { "text": "Unflavored powder — dissolves clear in water or coffee" } },
        { "type": "item", "settings": { "text": "Third-party tested, COA published" } },
        { "type": "item", "settings": { "text": "Subscription price on every delivery" } }
      ]
    }
  ]
}
{% endschema %}
