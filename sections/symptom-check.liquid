{%- comment -%}
  Bodology · Symptom check
  "Is this you?" tap-to-tick checklist in one or two groups. Counts the
  ticks and shows a result line that changes with the count, then a CTA.
  Each symptom is a block. Mobile first: one column, two from 750px.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign uid = section.id
  assign has_b = false
  for block in section.blocks
    if block.settings.group == 'b'
      assign has_b = true
    endif
  endfor
-%}

{% style %}
  #shopify-section-{{ uid }} .sc {
    background: {{ s.bg }};
    color: {{ s.text_color }};
    padding: {{ s.padding_top | times: 0.7 | round }}px 0 {{ s.padding_bottom | times: 0.7 | round }}px;
    margin: {{ s.margin_top }}px 0 {{ s.margin_bottom }}px;
  }
  #shopify-section-{{ uid }} .sc__pw { max-width: {{ s.max_width }}px; margin: 0 auto; padding: 0 16px; }
  #shopify-section-{{ uid }} .sc__eyebrow { text-align: center; margin: 0 0 10px; font-size: 13px; letter-spacing: .04em; text-transform: uppercase; color: {{ s.accent_color }}; font-weight: var(--font-body-bold-weight, 500); }
  #shopify-section-{{ uid }} .sc__heading { text-align: center; margin: 0; color: {{ s.heading_color }}; font-weight: 400; line-height: 1.15; {% if s.heading_size > 0 %}font-size: {{ s.heading_size | times: 0.8 | round }}px;{% endif %} }
  #shopify-section-{{ uid }} .sc__heading em { color: {{ s.accent_color }}; }
  #shopify-section-{{ uid }} .sc__sub { text-align: center; margin: 10px auto 0; max-width: 560px; font-size: 15px; line-height: 1.5; }
  #shopify-section-{{ uid }} .sc__groups { display: grid; grid-template-columns: 1fr; gap: 0; margin-top: 15px; }
  #shopify-section-{{ uid }} .sc__group { background: {{ s.card_bg }}; border: 0; border-radius: {{ s.card_radius }}px; padding: 18px 16px; }
  #shopify-section-{{ uid }} .sc__group-title { margin: 0 0 10px; text-align: center; font-size: 13px; letter-spacing: .05em; text-transform: uppercase; color: {{ s.accent_color }}; font-weight: var(--font-body-bold-weight, 500); }
  #shopify-section-{{ uid }} .sc__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  #shopify-section-{{ uid }} .sc__item {
    appearance: none; width: 100%; text-align: left; font: inherit; color: inherit; cursor: pointer;
    display: grid; grid-template-columns: 22px 1fr; gap: 12px; align-items: start;
    background: #ffffff; border: 1px solid {{ s.card_border }}; border-radius: {{ s.item_radius }}px; padding: 12px 14px;
    font-size: {{ s.item_size }}px; line-height: 1.4; transition: background .15s, border-color .15s;
  }
  #shopify-section-{{ uid }} .sc__item:hover { background: {{ s.checked_bg }}; border-color: {{ s.accent_color }}; }
  #shopify-section-{{ uid }} .sc__box {
    width: 22px; height: 22px; border-radius: 6px; border: 1.5px solid {{ s.accent_color }}; background: #fff; display: flex; align-items: center; justify-content: center; margin-top: 1px;
  }
  #shopify-section-{{ uid }} .sc__box svg { width: 14px; height: 14px; color: {{ s.check_text }}; opacity: 0; transform: scale(.6); transition: opacity .15s, transform .15s; }
  #shopify-section-{{ uid }} .sc__item[aria-pressed="true"] { background: {{ s.checked_bg }}; border-color: {{ s.accent_color }}; }
  #shopify-section-{{ uid }} .sc__item[aria-pressed="true"] .sc__box { background: {{ s.check_bg }}; border-color: {{ s.check_bg }}; }
  #shopify-section-{{ uid }} .sc__item[aria-pressed="true"] .sc__box svg { opacity: 1; transform: scale(1); }
  #shopify-section-{{ uid }} .sc__result {
    margin: 28px auto 0; max-width: 620px; text-align: center; background: transparent; border: 0;
    padding: 0; font-size: 15px; line-height: 1.5;
  }
  #shopify-section-{{ uid }} .sc__count { display: block; font-size: 13px; letter-spacing: .03em; opacity: .8; margin-bottom: 4px; }
  #shopify-section-{{ uid }} .sc__msg { margin: 0; }
  #shopify-section-{{ uid }} .sc__msg p { margin: 0; }
  #shopify-section-{{ uid }} .sc__msg strong { color: {{ s.accent_color }}; }
  #shopify-section-{{ uid }} .sc__btn {
    display: inline-flex; align-items: center; justify-content: center; margin-top: 16px; padding: 17px 30px; min-height: 50px; border-radius: {{ s.button_radius }}px;
    background: {{ s.button_bg }}; color: {{ s.button_text }}; text-decoration: none; font-size: inherit; font-weight: 500; letter-spacing: var(--button-letter-spacing, 0.02em); transition: background .15s, transform .14s;
  }
  #shopify-section-{{ uid }} .sc__btn:hover { background: {{ s.button_hover }}; color: {{ s.button_text }}; transform: translateY(-1px); }
  #shopify-section-{{ uid }} .sc__foot { margin: 14px auto 0; max-width: 620px; text-align: center; font-size: 12px; line-height: 1.5; opacity: .75; }
  #shopify-section-{{ uid }} .sc__foot p { margin: 0; }
  @media screen and (max-width: 749px) {
    /* a little more side room for the eyebrow, heading and subheading on phones (groups below keep the 16px gutter) */
    #shopify-section-{{ uid }} .sc__eyebrow, #shopify-section-{{ uid }} .sc__heading, #shopify-section-{{ uid }} .sc__sub { padding-left: 14px; padding-right: 14px; }
  }
  /* sticky bottom bar */
  #shopify-section-{{ uid }} .sc__bar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 60; background: {{ s.bar_bg }}; color: {{ s.text_color }};
    box-shadow: 0 -8px 28px rgba(26, 40, 116, 0.12); padding: 10px 16px calc(10px + env(safe-area-inset-bottom, 0px));
    transform: translateY(105%); transition: transform .32s cubic-bezier(.2,.7,.2,1);
  }
  #shopify-section-{{ uid }} .sc__bar[data-state="in"], #shopify-section-{{ uid }} .sc__bar[data-state="after"] { transform: translateY(0); }
  #shopify-section-{{ uid }} .sc__bar-inner { max-width: {{ s.max_width }}px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 14px; }
  #shopify-section-{{ uid }} .sc__bar-text { flex: 1 1 auto; min-width: 0; font-size: 14px; line-height: 1.35; }
  #shopify-section-{{ uid }} .sc__bar-count { display: block; font-size: 12px; letter-spacing: .03em; opacity: .75; }
  #shopify-section-{{ uid }} .sc__bar-count:empty { display: none; }
  #shopify-section-{{ uid }} .sc__bar-msg { display: block; }
  /* phones: while the section is in view the full message sits on top and the button goes full width underneath */
  @media screen and (max-width: 749px) {
    #shopify-section-{{ uid }} .sc__bar[data-state="in"] .sc__bar-inner { flex-wrap: wrap; gap: 10px 14px; }
    #shopify-section-{{ uid }} .sc__bar[data-state="in"] .sc__bar-text { flex-basis: 100%; }
    #shopify-section-{{ uid }} .sc__bar[data-state="in"]:not([data-count="0"]) .sc__bar-btn--in { width: 100%; }
  }
  #shopify-section-{{ uid }} .sc__bar-msg p { margin: 0; display: inline; }
  #shopify-section-{{ uid }} .sc__bar-msg strong { color: {{ s.accent_color }}; }
  #shopify-section-{{ uid }} .sc__bar-change { display: none; appearance: none; background: none; border: 0; padding: 0; margin-top: 2px; font: inherit; font-size: 13px; color: {{ s.accent_color }}; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  #shopify-section-{{ uid }} .sc__bar .sc__btn { margin-top: 0; flex: 0 0 auto; min-height: 44px; padding: 12px 18px; font-size: 14px; }
  #shopify-section-{{ uid }} .sc__bar .sc__bar-btn { display: none; }
  /* in view: message, button only once something is ticked */
  #shopify-section-{{ uid }} .sc__bar[data-state="in"]:not([data-count="0"]) .sc__bar-btn--in { display: inline-flex; }
  /* scrolled past: count + change link + shop button; the long message goes */
  #shopify-section-{{ uid }} .sc__bar[data-state="after"] .sc__bar-msg { display: none; }
  #shopify-section-{{ uid }} .sc__bar[data-state="after"] .sc__bar-change { display: inline; }
  #shopify-section-{{ uid }} .sc__bar[data-state="after"] .sc__bar-btn--after { display: inline-flex; }
  #shopify-section-{{ uid }} .sc__bar[data-state="after"][data-count="0"] .sc__bar-count { display: none; }
  /* when the page has a plan selector, the after-bar names the selected plan and adds it to the cart */
  #shopify-section-{{ uid }} .sc__bar-plan { display: none; font-size: 15px; line-height: 1.3; }
  #shopify-section-{{ uid }} .sc__bar-plan strong { font-weight: var(--font-body-bold-weight, 500); }
  #shopify-section-{{ uid }} .sc__bar-price { opacity: .8; margin-left: 6px; }
  #shopify-section-{{ uid }} .sc__bar[data-state="after"][data-plan] .sc__bar-plan { display: block; }
  #shopify-section-{{ uid }} .sc__bar[data-state="after"][data-plan] .sc__bar-count,
  #shopify-section-{{ uid }} .sc__bar[data-state="after"][data-plan] .sc__bar-change,
  #shopify-section-{{ uid }} .sc__bar[data-state="after"][data-plan] .sc__bar-btn--after { display: none; }
  #shopify-section-{{ uid }} .sc__bar[data-state="after"][data-plan] .sc__bar-btn--add { display: inline-flex; }
  #shopify-section-{{ uid }} .sc__bar .sc__bar-btn--add { appearance: none; border: 0; cursor: pointer; font: inherit; }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ uid }} .sc { padding: {{ s.padding_top }}px 0 {{ s.padding_bottom }}px; }
    #shopify-section-{{ uid }} .sc__pw { padding: 0 20px; }
    #shopify-section-{{ uid }} .sc__heading { {% if s.heading_size > 0 %}font-size: {{ s.heading_size }}px;{% endif %} }
    #shopify-section-{{ uid }} .sc__groups { grid-template-columns: {% if has_b %}1fr 1fr{% else %}minmax(0, 640px){% endif %}; justify-content: center; gap: 0; margin-top: 20px; }
    #shopify-section-{{ uid }} .sc__group { padding: 24px 22px; }
    #shopify-section-{{ uid }} .sc__bar { padding: 12px 24px calc(12px + env(safe-area-inset-bottom, 0px)); }
    #shopify-section-{{ uid }} .sc__bar-text { font-size: 15px; }
    #shopify-section-{{ uid }} .sc__bar-count { display: inline; margin-right: 8px; }
    #shopify-section-{{ uid }} .sc__bar .sc__btn { min-height: 48px; padding: 14px 26px; font-size: 15px; }
  }
{% endstyle %}

{% if s.anchor_id != blank %}<span id="{{ s.anchor_id }}" style="position:relative;top:-90px;display:block"></span>{% endif %}
<div class="sc" id="sc-{{ uid }}" data-sc data-threshold="{{ s.threshold }}">
  <div class="sc__pw">
    {%- if s.eyebrow != blank -%}<p class="sc__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="sc__heading{% if s.heading_size == 0 %} h1{% endif %}">{{ s.heading }}</h2>{%- endif -%}
    {%- if s.subheading != blank -%}<p class="sc__sub">{{ s.subheading }}</p>{%- endif -%}

    <div class="sc__groups">
      <div class="sc__group">
        {%- if s.group_a_title != blank -%}<p class="sc__group-title">{{ s.group_a_title }}</p>{%- endif -%}
        <ul class="sc__list">
          {%- for block in section.blocks -%}
            {%- if block.settings.group != 'b' -%}
              <li {{ block.shopify_attributes }}><button type="button" class="sc__item" aria-pressed="false" data-sc-item><span class="sc__box"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><polyline points="3 8.5 6.5 12 13 4.5" stroke-linecap="round" stroke-linejoin="round"></polyline></svg></span><span>{{ block.settings.text }}</span></button></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
      {%- if has_b -%}
        <div class="sc__group">
          {%- if s.group_b_title != blank -%}<p class="sc__group-title">{{ s.group_b_title }}</p>{%- endif -%}
          <ul class="sc__list">
            {%- for block in section.blocks -%}
              {%- if block.settings.group == 'b' -%}
                <li {{ block.shopify_attributes }}><button type="button" class="sc__item" aria-pressed="false" data-sc-item><span class="sc__box"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><polyline points="3 8.5 6.5 12 13 4.5" stroke-linecap="round" stroke-linejoin="round"></polyline></svg></span><span>{{ block.settings.text }}</span></button></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>

    {%- unless s.sticky_bar -%}
    <div class="sc__result" aria-live="polite">
      <span class="sc__count" data-sc-count></span>
      <div class="sc__msg" data-sc-msg>{{ s.msg_none }}</div>
      {%- if s.button_label != blank -%}<a class="sc__btn" href="{{ s.button_link | default: '#' }}">{{ s.button_label }}</a>{%- endif -%}
    </div>
    {%- endunless -%}
    {%- if s.footnote != blank -%}<div class="sc__foot">{{ s.footnote }}</div>{%- endif -%}
  </div>
</div>
{%- if s.sticky_bar -%}
<div class="sc__bar" data-sc-bar data-state="hidden" role="status" aria-live="polite">
  <div class="sc__bar-inner">
    <div class="sc__bar-text">
      <span class="sc__bar-count" data-sc-bar-count></span>
      <span class="sc__bar-msg" data-sc-bar-msg>{{ s.msg_none }}</span>
      <button type="button" class="sc__bar-change" data-sc-bar-change>{{ s.bar_change_label | default: 'Change selection' }}</button>
      <span class="sc__bar-plan" data-sc-bar-plan></span>
    </div>
    {%- if s.button_label != blank -%}<a class="sc__btn sc__bar-btn sc__bar-btn--in" href="{{ s.button_link | default: '#' }}">{{ s.button_label }}</a>{%- endif -%}
    <a class="sc__btn sc__bar-btn sc__bar-btn--after" href="{{ s.bar_shop_link | default: '#Product-Slider' }}">{{ s.bar_shop_label | default: 'Shop now' }}</a>
    <button type="button" class="sc__btn sc__bar-btn sc__bar-btn--add" data-sc-bar-add>{{ s.bar_add_label | default: 'Add to cart' }}</button>
  </div>
</div>
{%- endif -%}

<script>
(function(){
  var root = document.getElementById('sc-{{ uid }}');
  if(!root) return;
  var items = Array.prototype.slice.call(root.querySelectorAll('[data-sc-item]'));
  var countEl = root.querySelector('[data-sc-count]');
  var msgEl = root.querySelector('[data-sc-msg]');
  var threshold = parseInt(root.getAttribute('data-threshold'), 10) || 3;
  var tpl = {{ s.count_text | json }};
  var msgs = { none: {{ s.msg_none | json }}, low: {{ s.msg_low | json }}, high: {{ s.msg_high | json }} };
  var bar = root.parentNode.querySelector('[data-sc-bar]');
  var barCount = bar && bar.querySelector('[data-sc-bar-count]');
  var barMsg = bar && bar.querySelector('[data-sc-bar-msg]');
  var barChange = bar && bar.querySelector('[data-sc-bar-change]');
  var count = 0;
  function update(){
    var n = items.filter(function(b){ return b.getAttribute('aria-pressed') === 'true'; }).length;
    count = n;
    var countText = n ? tpl.replace('[count]', n).replace('[total]', items.length) : '';
    var msg = n === 0 ? msgs.none : (n >= threshold ? msgs.high : msgs.low);
    if(countEl){ countEl.textContent = countText; }
    if(msgEl){ msgEl.innerHTML = msg; }
    if(barCount){ barCount.textContent = countText; }
    if(barMsg){ barMsg.innerHTML = msg; }
    if(bar){ bar.setAttribute('data-count', n); }
    place();
  }
  /* bar states: hidden (section not reached) -> in (section on screen) -> after (scrolled past) */
  function place(){
    if(!bar) return;
    var r = root.getBoundingClientRect(), vh = window.innerHeight;
    var state = 'hidden';
    if(r.bottom <= vh * 0.35){ state = 'after'; }
    else if(r.top < vh * 0.85){ state = 'in'; }
    bar.setAttribute('data-state', state);
    /* Shopify's theme-preview bar sits over the bottom edge; lift ours above it */
    var pb = document.getElementById('PBarNextFrameWrapper') || document.getElementById('preview-bar-iframe');
    bar.style.bottom = pb && pb.offsetHeight ? pb.offsetHeight + 'px' : '';
  }
  items.forEach(function(b){ b.addEventListener('click', function(){ b.setAttribute('aria-pressed', b.getAttribute('aria-pressed') === 'true' ? 'false' : 'true'); update(); }); });
  if(barChange){ barChange.addEventListener('click', function(){ root.scrollIntoView({ behavior: 'smooth', block: 'start' }); }); }
  /* after scrolling past: mirror the buy box's plan selector (name + price) and add that plan through its own button */
  var ps = document.querySelector('[data-ps1c-root]');
  var planEl = bar && bar.querySelector('[data-sc-bar-plan]');
  var addBtn = bar && bar.querySelector('[data-sc-bar-add]');
  function esc(t){ return String(t).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
  function syncPlan(){
    if(!bar || !planEl) return;
    var c = ps && ps.querySelector('[data-ps1c-card].is-selected');
    if(!c){ bar.removeAttribute('data-plan'); return; }
    var name = c.getAttribute('data-ps1c-name') || '', price = c.getAttribute('data-ps1c-price') || '';
    planEl.innerHTML = '<strong>' + esc(name) + '</strong>' + (price ? ' <span class="sc__bar-price">' + esc(price) + '</span>' : '');
    bar.setAttribute('data-plan', '1');
  }
  document.addEventListener('ps1c:select', syncPlan);
  if(addBtn){ addBtn.addEventListener('click', function(){ var b = ps && ps.querySelector('[data-ps1c-submit]'); if(b){ b.click(); } }); }
  syncPlan();
  window.addEventListener('scroll', place, { passive: true });
  window.addEventListener('resize', place);
  update();
})();
</script>

{% schema %}
{
  "name": "Symptom check",
  "tag": "section",
  "class": "section-symptom-check",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Is this you?" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Tick what you <em>recognise</em>" },
    { "type": "range", "id": "heading_size", "label": "Heading size (px, 0 = theme H1)", "min": 0, "max": 64, "step": 2, "default": 0 },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "These are the signs women describe to us most. Tap any that sound familiar." },
    { "type": "text", "id": "group_a_title", "label": "Group A title", "default": "How you feel" },
    { "type": "text", "id": "group_b_title", "label": "Group B title", "default": "What you've been told" },
    { "type": "header", "content": "Result" },
    { "type": "text", "id": "count_text", "label": "Count line", "default": "You ticked [count] of [total]", "info": "[count] and [total] are replaced automatically." },
    { "type": "range", "id": "threshold", "label": "Ticks needed for the strong message", "min": 1, "max": 10, "step": 1, "default": 3 },
    { "type": "richtext", "id": "msg_none", "label": "Message with nothing ticked", "default": "<p>Tap anything that sounds like you.</p>" },
    { "type": "richtext", "id": "msg_low", "label": "Message below the threshold", "default": "<p>One or two of these on their own can mean a lot of things. Several together usually point at the same place: <strong>how your body is handling insulin.</strong></p>" },
    { "type": "richtext", "id": "msg_high", "label": "Message at or above the threshold", "default": "<p>These aren't separate problems. They're one problem showing up in several places: <strong>insulin that stopped working the way it used to.</strong></p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Show me what helps" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "richtext", "id": "footnote", "label": "Footnote" },
    { "type": "header", "content": "Sticky bottom bar" },
    { "type": "checkbox", "id": "sticky_bar", "label": "Show the message in a bar that slides up from the bottom", "info": "Appears when this section scrolls into view, with the button once something is ticked. After scrolling past, it turns into a small bar with the count, a change link and the shop button. Turn off to show the message inside the section instead.", "default": true },
    { "type": "color", "id": "bar_bg", "label": "Bar background", "default": "#ffffff" },
    { "type": "text", "id": "bar_shop_label", "label": "Shop button (after scrolling past)", "default": "Shop now" },
    { "type": "text", "id": "bar_shop_link", "label": "Shop button link", "default": "#Product-Slider" },
    { "type": "text", "id": "bar_change_label", "label": "Change link text", "default": "Change selection" },
    { "type": "text", "id": "bar_add_label", "label": "Add to cart button (when the page has a plan selector)", "default": "Add to cart" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#f2eeea" },
    { "type": "color", "id": "card_bg", "label": "Group card", "default": "#ffffff" },
    { "type": "color", "id": "card_border", "label": "Borders", "default": "#d9d2c9" },
    { "type": "color", "id": "checked_bg", "label": "Ticked item background", "default": "#e3e7ff" },
    { "type": "color", "id": "check_bg", "label": "Tick box", "default": "#1a2874" },
    { "type": "color", "id": "check_text", "label": "Tick mark", "default": "#B9C2F5" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1a2874" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#1a2874" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#4d61cf" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#1A2874" },
    { "type": "color", "id": "button_hover", "label": "Button hover", "default": "#3447af" },
    { "type": "color", "id": "button_text", "label": "Button text", "default": "#ffffff" },
    { "type": "header", "content": "Shape & spacing" },
    { "type": "range", "id": "max_width", "label": "Max width", "min": 600, "max": 1200, "step": 20, "default": 960 },
    { "type": "range", "id": "item_size", "label": "Item text size", "min": 13, "max": 18, "step": 1, "default": 15 },
    { "type": "range", "id": "card_radius", "label": "Card corner radius", "min": 0, "max": 28, "step": 1, "default": 16 },
    { "type": "range", "id": "item_radius", "label": "Item corner radius", "min": 0, "max": 20, "step": 1, "default": 10 },
    { "type": "range", "id": "button_radius", "label": "Button corner radius", "min": 0, "max": 40, "step": 2, "default": 6 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 64 },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": 0, "max": 120, "step": 4, "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": 0, "max": 120, "step": 4, "default": 0 },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID (for in-page links)" }
  ],
  "blocks": [
