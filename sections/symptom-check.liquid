{%- comment -%}
  Bodology · Symptom check
  "Is this you?" tap-to-tick checklist in one or two groups. Counts the
  ticks and shows a result line that changes with the count, then a CTA.
  Each symptom is a block. Mobile first: one column, two from 750px.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign uid = section.id
  assign has_b = false
  for block in section.blocks
    if block.settings.group == 'b'
      assign has_b = true
    endif
  endfor
-%}

{% style %}
  #shopify-section-{{ uid }} .sc {
    background: {{ s.bg }};
    color: {{ s.text_color }};
    padding: {{ s.padding_top | times: 0.7 | round }}px 0 {{ s.padding_bottom | times: 0.7 | round }}px;
    margin: {{ s.margin_top }}px 0 {{ s.margin_bottom }}px;
  }
  #shopify-section-{{ uid }} .sc__pw { max-width: {{ s.max_width }}px; margin: 0 auto; padding: 0 16px; }
  #shopify-section-{{ uid }} .sc__eyebrow { text-align: center; margin: 0 0 10px; font-size: 13px; letter-spacing: .04em; text-transform: uppercase; color: {{ s.accent_color }}; font-weight: var(--font-body-bold-weight, 500); }
  #shopify-section-{{ uid }} .sc__heading { text-align: center; margin: 0; color: {{ s.heading_color }}; font-weight: 400; line-height: 1.15; {% if s.heading_size > 0 %}font-size: {{ s.heading_size | times: 0.8 | round }}px;{% endif %} }
  #shopify-section-{{ uid }} .sc__heading p { margin: 0; font: inherit; color: inherit; }
  #shopify-section-{{ uid }} .sc__heading p + p { margin-top: 0.25em; }
  #shopify-section-{{ uid }} .sc__heading em { color: {{ s.accent_color }}; }
  #shopify-section-{{ uid }} .sc__sub p { margin: 0; font-size: inherit; line-height: inherit; color: inherit; }
  #shopify-section-{{ uid }} .sc__sub p + p { margin-top: 8px; }
  #shopify-section-{{ uid }} .sc__sub strong { color: {{ s.accent_color }}; }
  #shopify-section-{{ uid }} .sc__sub { text-align: center; margin: 10px auto 0; max-width: 560px; font-size: 15px; line-height: 1.5; }
  #shopify-section-{{ uid }} .sc__groups { display: grid; grid-template-columns: 1fr; gap: 0; margin-top: 15px; }
  #shopify-section-{{ uid }} .sc__group { background: {{ s.card_bg }}; border: 0; border-radius: {{ s.card_radius }}px; padding: 18px 16px; }
  #shopify-section-{{ uid }} .sc__group-title { margin: 0 0 10px; text-align: center; font-size: 13px; letter-spacing: .05em; text-transform: uppercase; color: {{ s.accent_color }}; font-weight: var(--font-body-bold-weight, 500); }
  #shopify-section-{{ uid }} .sc__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  #shopify-section-{{ uid }} .sc__item {
    appearance: none; width: 100%; text-align: left; font: inherit; color: inherit; cursor: pointer;
    display: grid; grid-template-columns: 22px 1fr; gap: 12px; align-items: start;
    background: #ffffff; border: 1px solid {{ s.card_border }}; border-radius: {{ s.item_radius }}px; padding: 12px 14px;
    font-size: {{ s.item_size }}px; line-height: 1.4; transition: background .15s, border-color .15s;
  }
  #shopify-section-{{ uid }} .sc__item:hover { background: {{ s.checked_bg }}; border-color: {{ s.accent_color }}; }
  #shopify-section-{{ uid }} .sc__box {
    width: 22px; height: 22px; border-radius: 6px; border: 1.5px solid {{ s.accent_color }}; background: #fff; display: flex; align-items: center; justify-content: center; margin-top: 1px;
  }
  #shopify-section-{{ uid }} .sc__box svg { width: 14px; height: 14px; color: {{ s.check_text }}; opacity: 0; transform: scale(.6); transition: opacity .15s, transform .15s; }
  #shopify-section-{{ uid }} .sc__item[aria-pressed="true"] { background: {{ s.checked_bg }}; border-color: {{ s.accent_color }}; }
  #shopify-section-{{ uid }} .sc__item[aria-pressed="true"] .sc__box { background: {{ s.check_bg }}; border-color: {{ s.check_bg }}; }
  #shopify-section-{{ uid }} .sc__item[aria-pressed="true"] .sc__box svg { opacity: 1; transform: scale(1); }
  #shopify-section-{{ uid }} .sc__result {
    margin: 28px auto 0; max-width: 620px; text-align: center; background: transparent; border: 0;
    padding: 0; font-size: 15px; line-height: 1.5;
  }
  #shopify-section-{{ uid }} .sc__count { display: block; font-size: 13px; letter-spacing: .03em; opacity: .8; margin-bottom: 4px; }
  #shopify-section-{{ uid }} .sc__msg { margin: 0; }
  #shopify-section-{{ uid }} .sc__msg p { margin: 0; }
  #shopify-section-{{ uid }} .sc__msg strong { color: {{ s.accent_color }}; }
  #shopify-section-{{ uid }} .sc__btn {
    display: inline-flex; align-items: center; justify-content: center; margin-top: 16px; padding: 17px 30px; min-height: 50px; border-radius: {{ s.button_radius }}px;
    background: {{ s.button_bg }}; color: {{ s.button_text }}; text-decoration: none; font-size: inherit; font-weight: 500; letter-spacing: var(--button-letter-spacing, 0.02em); transition: background .15s, transform .14s;
  }
  #shopify-section-{{ uid }} .sc__btn:hover { background: {{ s.button_hover }}; color: {{ s.button_text }}; transform: translateY(-1px); }
  #shopify-section-{{ uid }} .sc__foot { margin: 14px auto 0; max-width: 620px; text-align: center; font-size: 12px; line-height: 1.5; opacity: .75; }
  #shopify-section-{{ uid }} .sc__foot p { margin: 0; }
  @media screen and (max-width: 749px) {
    /* a little more side room for the eyebrow, heading and subheading on phones (groups below keep the 16px gutter) */
    #shopify-section-{{ uid }} .sc__eyebrow, #shopify-section-{{ uid }} .sc__heading, #shopify-section-{{ uid }} .sc__sub { padding-left: 14px; padding-right: 14px; }
  }
  /* sticky bottom bar */
  #shopify-section-{{ uid }} .sc__bar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 60; background: {{ s.bar_bg }}; color: {{ s.text_color }};
    box-shadow: 0 -8px 28px rgba(26, 40, 116, 0.12); padding: 10px 16px calc(10px + env(safe-area-inset-bottom, 0px));
    transform: translateY(105%); transition: transform .32s cubic-bezier(.2,.7,.2,1);
  }
  #shopify-section-{{ uid }} .sc__bar[data-state="in"], #shopify-section-{{ uid }} .sc__bar[data-state="after"] { transform: translateY(0); }
  #shopify-section-{{ uid }} .sc__bar-inner { max-width: {{ s.max_width }}px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 14px; }
  #shopify-section-{{ uid }} .sc__bar-text { flex: 1 1 auto; min-width: 0; font-size: 14px; line-height: 1.35; }
  /* tap-hand roundel beside the opening prompt, only before anything is ticked */
  #shopify-section-{{ uid }} .sc__bar-icon { display: none; flex: 0 0 auto; width: 36px; height: 36px; border-radius: 50%; background: {{ s.checked_bg }}; color: {{ s.text_color }}; align-items: center; justify-content: center; }
  #shopify-section-{{ uid }} .sc__bar-icon svg { width: 20px; height: 20px; }
  #shopify-section-{{ uid }} .sc__bar[data-state="in"][data-count="0"] .sc__bar-icon { display: inline-flex; }
  #shopify-section-{{ uid }} .sc__bar-count { display: block; font-size: 12px; letter-spacing: .03em; opacity: .75; }
  #shopify-section-{{ uid }} .sc__bar-count:empty { display: none; }
  #shopify-section-{{ uid }} .sc__bar-msg { display: block; }
  /* phones: while the section is in view the full message sits on top and the button goes full width underneath */
  @media screen and (max-width: 749px) {
    #shopify-section-{{ uid }} .sc__bar[data-state="in"] .sc__bar-inner { flex-wrap: wrap; gap: 10px 14px; }
    #shopify-section-{{ uid }} .sc__bar[data-state="in"]:not([data-count="0"]) .sc__bar-text { flex-basis: 100%; }
    #shopify-section-{{ uid }} .sc__bar[data-state="in"]:not([data-count="0"]) .sc__bar-btn--in { width: 100%; }
  }
  #shopify-section-{{ uid }} .sc__bar-msg p { margin: 0; display: inline; }
  #shopify-section-{{ uid }} .sc__bar-msg strong { color: {{ s.accent_color }}; }
  #shopify-section-{{ uid }} .sc__bar-change { display: none; appearance: none; background: none; border: 0; padding: 0; margin-top: 2px; font: inherit; font-size: 13px; color: {{ s.accent_color }}; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  #shopify-section-{{ uid }} .sc__bar .sc__btn { margin-top: 0; flex: 0 0 auto; min-height: 44px; padding: 12px 18px; font-size: 14px; }
  #shopify-section-{{ uid }} .sc__bar .sc__bar-btn { display: none; }
  /* in view: message, button only once something is ticked */
  #shopify-section-{{ uid }} .sc__bar[data-state="in"]:not([data-count="0"]) .sc__bar-btn--in { display: inline-flex; }
  /* scrolled past: count + change link + shop button; the long message goes */
  #shopify-section-{{ uid }} .sc__bar[data-state="after"] .sc__bar-msg { display: none; }
  #shopify-section-{{ uid }} .sc__bar[data-state="after"] .sc__bar-change { display: inline; }
  #shopify-section-{{ uid }} .sc__bar[data-state="after"] .sc__bar-btn--after { display: inline-flex; }
  #shopify-section-{{ uid }} .sc__bar[data-state="after"][data-count="0"] .sc__bar-count { display: none; }
  /* after scrolling past, with a plan selector on the page: product · supply dropdown · add to cart (price) */
  #shopify-section-{{ uid }} .sc__bar-inner--plan, #shopify-section-{{ uid }} .sc__bar-inner--bundle { display: none; }
  /* after scrolling past, on a page set up for the bundle: product image · bundle line · Get the bundle */
  #shopify-section-{{ uid }} .sc__bar[data-state="after"][data-bundle] .sc__bar-inner:not(.sc__bar-inner--bundle) { display: none; }
  #shopify-section-{{ uid }} .sc__bar[data-state="after"][data-bundle] .sc__bar-inner--bundle { display: flex; justify-content: space-between; gap: 12px; }
  #shopify-section-{{ uid }} .sc__bar-bundle { display: flex; align-items: center; gap: 10px; min-width: 0; flex: 1 1 auto; }
  #shopify-section-{{ uid }} .sc__bar-bundle-text { font-size: 14px; line-height: 1.3; font-weight: var(--font-body-bold-weight, 500); min-width: 0; }
  #shopify-section-{{ uid }} .sc__bar-bundle-text strong { color: {{ s.accent_color }}; }
  #shopify-section-{{ uid }} .sc__bar-err { display: none; flex-basis: 100%; margin: 0; font-size: 12.5px; color: #b42318; }
  #shopify-section-{{ uid }} .sc__bar-err.is-shown { display: block; }
  #shopify-section-{{ uid }} .sc__bar .sc__bar-btn--bundle { display: inline-flex; align-items: center; justify-content: center; gap: 7px; appearance: none; border: 0; cursor: pointer; font: inherit; white-space: nowrap; min-height: 48px; padding: 0 18px; border-radius: 10px; background: #3447af; color: #ffffff; font-weight: 600; }
  #shopify-section-{{ uid }} .sc__bar .sc__bar-btn--bundle:hover, #shopify-section-{{ uid }} .sc__bar .sc__bar-btn--bundle:focus-visible { background: #1a2874; color: #b9c2f5; }
  #shopify-section-{{ uid }} .sc__bar .sc__bar-btn--bundle.is-loading { opacity: .7; pointer-events: none; }
  #shopify-section-{{ uid }} .sc__bar[data-state="after"][data-plan] .sc__bar-inner:not(.sc__bar-inner--plan) { display: none; }
  #shopify-section-{{ uid }} .sc__bar[data-state="after"][data-plan] .sc__bar-inner--plan { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "prod prod" "sel add"; gap: 8px 10px; align-items: center; }
  #shopify-section-{{ uid }} .sc__bar-prod { grid-area: prod; display: flex; align-items: center; gap: 10px; min-width: 0; }
  #shopify-section-{{ uid }} .sc__bar-img { width: 40px; height: 40px; border-radius: 8px; object-fit: cover; flex: 0 0 auto; background: {{ s.card_bg }}; }
  #shopify-section-{{ uid }} .sc__bar-prodname { font-size: 14px; line-height: 1.25; font-weight: var(--font-body-bold-weight, 500); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #shopify-section-{{ uid }} .sc__bar-sel { grid-area: sel; min-width: 0; }
  /* dropdown box: plan title with the per-serving line underneath; the real <select> sits invisibly on top so the native picker still opens */
  #shopify-section-{{ uid }} .sc__bar-selwrap { position: relative; display: flex; align-items: center; min-height: 52px; background: #fff; border: 1px solid {{ s.card_border }}; border-radius: 10px; padding: 6px 34px 6px 12px; }
  #shopify-section-{{ uid }} .sc__bar-selface { display: flex; flex-direction: column; justify-content: center; gap: 1px; min-width: 0; }
  #shopify-section-{{ uid }} .sc__bar-seltitle { font-size: 14px; line-height: 1.25; font-weight: var(--font-body-bold-weight, 500); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  #shopify-section-{{ uid }} .sc__bar-per { font-size: 11.5px; line-height: 1.2; opacity: .75; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  #shopify-section-{{ uid }} .sc__bar-per:empty { display: none; }
  #shopify-section-{{ uid }} .sc__bar-chev { position: absolute; right: 12px; top: 50%; width: 14px; height: 14px; transform: translateY(-50%); pointer-events: none; color: {{ s.accent_color }}; }
  #shopify-section-{{ uid }} .sc__bar-select { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; font: inherit; }
  #shopify-section-{{ uid }} .sc__bar-select:focus-visible + .sc__bar-chev, #shopify-section-{{ uid }} .sc__bar-selwrap:focus-within { outline: 2px solid {{ s.accent_color }}; outline-offset: 2px; }
  /* add button styled like the buy box CTA (#3447af, hover navy) and the same height as the dropdown box */
  #shopify-section-{{ uid }} .sc__bar .sc__bar-btn--add { grid-area: add; display: inline-flex; align-items: center; justify-content: center; gap: 7px; appearance: none; border: 0; cursor: pointer; font: inherit; white-space: nowrap; min-height: 52px; padding: 0 18px; border-radius: 10px; background: #3447af; color: #ffffff; font-weight: 600; }
  #shopify-section-{{ uid }} .sc__bar .sc__bar-btn--add:hover, #shopify-section-{{ uid }} .sc__bar .sc__bar-btn--add:focus-visible { background: #1a2874; color: #b9c2f5; }
  #shopify-section-{{ uid }} .sc__bar-lock { width: 15px; height: 15px; flex: 0 0 auto; }
  #shopify-section-{{ uid }} .sc__bar-dash { opacity: .7; }
  #shopify-section-{{ uid }} .sc__bar-price:empty, #shopify-section-{{ uid }} .sc__bar-price:empty + .sc__bar-dash { display: none; }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ uid }} .sc { padding: {{ s.padding_top }}px 0 {{ s.padding_bottom }}px; }
    #shopify-section-{{ uid }} .sc__pw { padding: 0 20px; }
    #shopify-section-{{ uid }} .sc__heading { {% if s.heading_size > 0 %}font-size: {{ s.heading_size }}px;{% endif %} }
    #shopify-section-{{ uid }} .sc__groups { grid-template-columns: {% if has_b %}1fr 1fr{% else %}minmax(0, 640px){% endif %}; justify-content: center; gap: 0; margin-top: 20px; }
    #shopify-section-{{ uid }} .sc__group { padding: 24px 22px; }
    #shopify-section-{{ uid }} .sc__bar { padding: 12px 24px calc(12px + env(safe-area-inset-bottom, 0px)); }
    #shopify-section-{{ uid }} .sc__bar-text { font-size: 15px; }
    #shopify-section-{{ uid }} .sc__bar-count { display: inline; margin-right: 8px; }
    #shopify-section-{{ uid }} .sc__bar .sc__btn { min-height: 48px; padding: 14px 26px; font-size: 15px; }
    #shopify-section-{{ uid }} .sc__bar[data-state="after"][data-plan] .sc__bar-inner--plan { display: flex; justify-content: space-between; gap: 18px; }
    #shopify-section-{{ uid }} .sc__bar-prod { flex: 1 1 auto; }
    #shopify-section-{{ uid }} .sc__bar-img { width: 48px; height: 48px; }
    #shopify-section-{{ uid }} .sc__bar-prodname { font-size: 15px; white-space: normal; }
    #shopify-section-{{ uid }} .sc__bar-sel { flex: 0 0 auto; width: 280px; }
    #shopify-section-{{ uid }} .sc__bar-bundle-text { font-size: 15px; }
    #shopify-section-{{ uid }} .sc__bar .sc__bar-btn--bundle { min-height: 52px; padding: 0 24px; font-size: 15px; }
    #shopify-section-{{ uid }} .sc__bar-seltitle { font-size: 15px; }
    #shopify-section-{{ uid }} .sc__bar .sc__bar-btn--add { padding: 0 24px; font-size: 15px; }
  }
{% endstyle %}

{% if s.anchor_id != blank %}<span id="{{ s.anchor_id }}" style="position:relative;top:-90px;display:block"></span>{% endif %}
<div class="sc" id="sc-{{ uid }}" data-sc data-threshold="{{ s.threshold }}">
  <div class="sc__pw">
    {%- if s.eyebrow != blank -%}<p class="sc__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
    {%- if s.heading != blank -%}<div class="sc__heading{% if s.heading_size == 0 %} h1{% endif %}" role="heading" aria-level="2">{{ s.heading }}</div>{%- endif -%}
    {%- if s.subheading != blank -%}<div class="sc__sub">{{ s.subheading }}</div>{%- endif -%}

    <div class="sc__groups">
      <div class="sc__group">
        {%- if s.group_a_title != blank -%}<p class="sc__group-title">{{ s.group_a_title }}</p>{%- endif -%}
        <ul class="sc__list">
          {%- for block in section.blocks -%}
            {%- if block.settings.group != 'b' -%}
              <li {{ block.shopify_attributes }}><button type="button" class="sc__item" aria-pressed="false" data-sc-item><span class="sc__box"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><polyline points="3 8.5 6.5 12 13 4.5" stroke-linecap="round" stroke-linejoin="round"></polyline></svg></span><span>{{ block.settings.text }}</span></button></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
      {%- if has_b -%}
        <div class="sc__group">
          {%- if s.group_b_title != blank -%}<p class="sc__group-title">{{ s.group_b_title }}</p>{%- endif -%}
          <ul class="sc__list">
            {%- for block in section.blocks -%}
              {%- if block.settings.group == 'b' -%}
                <li {{ block.shopify_attributes }}><button type="button" class="sc__item" aria-pressed="false" data-sc-item><span class="sc__box"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><polyline points="3 8.5 6.5 12 13 4.5" stroke-linecap="round" stroke-linejoin="round"></polyline></svg></span><span>{{ block.settings.text }}</span></button></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>

    {%- unless s.sticky_bar -%}
    <div class="sc__result" aria-live="polite">
      <span class="sc__count" data-sc-count></span>
      <div class="sc__msg" data-sc-msg>{{ s.msg_none }}</div>
      {%- if s.button_label != blank -%}<a class="sc__btn" href="{{ s.button_link | default: '#' }}">{{ s.button_label }}</a>{%- endif -%}
    </div>
    {%- endunless -%}
    {%- if s.footnote != blank -%}<div class="sc__foot">{{ s.footnote }}</div>{%- endif -%}
  </div>
</div>
{%- if s.sticky_bar -%}
{%- assign bundle_variant = s.bar_bundle_variant | strip -%}
<div class="sc__bar" data-sc-bar data-state="hidden" role="status" aria-live="polite"{% if bundle_variant != blank %} data-bundle="{{ bundle_variant }}" data-bundle-qty="{{ s.bar_bundle_qty | default: 4 }}"{% endif %}>
  <div class="sc__bar-inner">
    <span class="sc__bar-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 12V5.3a1.6 1.6 0 0 1 3.2 0V11"/><path d="M12.7 10.6a1.6 1.6 0 0 1 3.2 0V12"/><path d="M15.9 11.6a1.6 1.6 0 0 1 3.2 0v3.2c0 3.6-2.9 6.4-6.4 6.4h-1c-1.7 0-3.3-.8-4.3-2.2l-3-4.1a1.5 1.5 0 0 1 2.3-1.9l2.8 2.9"/><path d="M6.6 5.2a4.6 4.6 0 0 1 2.1-2.4M14.9 2.6a4.6 4.6 0 0 1 2.3 2.2"/></svg></span>
    <div class="sc__bar-text">
      <span class="sc__bar-count" data-sc-bar-count></span>
      <span class="sc__bar-msg" data-sc-bar-msg>{{ s.msg_none }}</span>
      <button type="button" class="sc__bar-change" data-sc-bar-change>{{ s.bar_change_label | default: 'Change selection' }}</button>
    </div>
    {%- if s.button_label != blank -%}<a class="sc__btn sc__bar-btn sc__bar-btn--in" href="{{ s.button_link | default: '#' }}">{{ s.button_label }}</a>{%- endif -%}
    <a class="sc__btn sc__bar-btn sc__bar-btn--after" href="{{ s.bar_shop_link | default: '#Product-Slider' }}">{{ s.bar_shop_label | default: 'Shop now' }}</a>
  </div>
  {%- comment -%} after scrolling past, on a page with the plan selector: product · supply dropdown · add to cart {%- endcomment -%}
  <div class="sc__bar-inner sc__bar-inner--plan">
    <div class="sc__bar-prod">
      {%- if product and product.featured_image -%}<img class="sc__bar-img" src="{{ product.featured_image | image_url: width: 120 }}" alt="" width="48" height="48" loading="lazy">{%- endif -%}
      <span class="sc__bar-prodname">{{ product.title | default: shop.name }}</span>
    </div>
    <div class="sc__bar-sel">
      <span class="sc__bar-selwrap">
        <span class="sc__bar-selface" aria-hidden="true">
          <span class="sc__bar-seltitle" data-sc-bar-seltitle></span>
          <span class="sc__bar-per" data-sc-bar-per></span>
        </span>
        <svg class="sc__bar-chev" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6l4 4 4-4"/></svg>
        <select class="sc__bar-select" data-sc-bar-select aria-label="Supply"></select>
      </span>
    </div>
    <button type="button" class="sc__btn sc__bar-btn sc__bar-btn--add" data-sc-bar-add>
      <svg class="sc__bar-lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 018 0v4"/></svg>
      <span>{{ s.bar_add_label | default: 'Add to cart' }}</span><span class="sc__bar-dash" aria-hidden="true">&mdash;</span><span class="sc__bar-price" data-sc-bar-price></span>
    </button>
  </div>
  {%- if bundle_variant != blank -%}
  {%- comment -%} after scrolling past, bundle mode: adds the bundle variant x quantity straight to the cart (no discount logic here yet) {%- endcomment -%}
  <div class="sc__bar-inner sc__bar-inner--bundle">
    <div class="sc__bar-bundle">
      {%- if product and product.featured_image -%}<img class="sc__bar-img" src="{{ product.featured_image | image_url: width: 120 }}" alt="" width="48" height="48" loading="lazy">{%- endif -%}
      <span class="sc__bar-bundle-text">{{ s.bar_bundle_text }}</span>
    </div>
    <button type="button" class="sc__btn sc__bar-btn sc__bar-btn--bundle" data-sc-bar-bundle>
      <svg class="sc__bar-lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 018 0v4"/></svg>
      <span data-sc-bar-bundle-label>{{ s.bar_bundle_label | default: 'Get the bundle' }}</span>
    </button>
    <p class="sc__bar-err" data-sc-bar-err role="alert"></p>
  </div>
  {%- endif -%}
</div>
{%- endif -%}

<script>
(function(){
  var root = document.getElementById('sc-{{ uid }}');
  if(!root) return;
  var items = Array.prototype.slice.call(root.querySelectorAll('[data-sc-item]'));
  var countEl = root.querySelector('[data-sc-count]');
  var msgEl = root.querySelector('[data-sc-msg]');
  var threshold = parseInt(root.getAttribute('data-threshold'), 10) || 3;
  var tpl = {{ s.count_text | json }};
  var msgs = { none: {{ s.msg_none | json }}, low: {{ s.msg_low | json }}, high: {{ s.msg_high | json }} };
  var bar = root.parentNode.querySelector('[data-sc-bar]');
  var barCount = bar && bar.querySelector('[data-sc-bar-count]');
  var barMsg = bar && bar.querySelector('[data-sc-bar-msg]');
  var barChange = bar && bar.querySelector('[data-sc-bar-change]');
  var count = 0;
  function update(){
    var n = items.filter(function(b){ return b.getAttribute('aria-pressed') === 'true'; }).length;
    count = n;
    var countText = n ? tpl.replace('[count]', n).replace('[total]', items.length) : '';
    var msg = n === 0 ? msgs.none : (n >= threshold ? msgs.high : msgs.low);
    if(countEl){ countEl.textContent = countText; }
    if(msgEl){ msgEl.innerHTML = msg; }
    if(barCount){ barCount.textContent = countText; }
    if(barMsg){ barMsg.innerHTML = msg; }
    if(bar){ bar.setAttribute('data-count', n); }
    place();
  }
  /* bar states: hidden (section not reached) -> in (section on screen) -> after (scrolled past) */
  function place(){
    if(!bar) return;
    var r = root.getBoundingClientRect(), vh = window.innerHeight;
    var state = 'hidden';
    if(r.bottom <= vh * 0.35){ state = 'after'; }
    else if(r.top < vh * 0.85){ state = 'in'; }
    bar.setAttribute('data-state', state);
    if(state === 'after' && !bar.hasAttribute('data-bundle') && !bar.hasAttribute('data-plan')){ syncPlan(); }
    /* Shopify's theme-preview bar sits over the bottom edge; lift ours above it */
    var pb = document.getElementById('PBarNextFrameWrapper') || document.getElementById('preview-bar-iframe');
    bar.style.bottom = pb && pb.offsetHeight ? pb.offsetHeight + 'px' : '';
  }
  items.forEach(function(b){ b.addEventListener('click', function(){ b.setAttribute('aria-pressed', b.getAttribute('aria-pressed') === 'true' ? 'false' : 'true'); update(); }); });
  if(barChange){ barChange.addEventListener('click', function(){ root.scrollIntoView({ behavior: 'smooth', block: 'start' }); }); }
  /* after scrolling past: mirror the buy box's plan selector (name + price) and add that plan through its own button */
  var ps = null;
  function getPs(){ if(!ps){ ps = document.querySelector('[data-ps1c-root]'); } return ps; }
  var selEl = bar && bar.querySelector('[data-sc-bar-select]');
  var perEl = bar && bar.querySelector('[data-sc-bar-per]');
  var titleEl = bar && bar.querySelector('[data-sc-bar-seltitle]');
  var priceEl = bar && bar.querySelector('[data-sc-bar-price]');
  var addBtn = bar && bar.querySelector('[data-sc-bar-add]');
  var optsBuilt = false;
  function cardsOf(p){ return p ? [].slice.call(p.querySelectorAll('[data-ps1c-card]')) : []; }
  function buildOptions(p){
    if(!selEl || optsBuilt) return;
    var cs = cardsOf(p); if(!cs.length) return;
    selEl.innerHTML = '';
    cs.forEach(function(c){
      var o = document.createElement('option');
      o.value = c.getAttribute('data-ps1c-p') || '';
      var pill = c.getAttribute('data-ps1c-pill') || '';
      o.textContent = (c.getAttribute('data-ps1c-name') || '') + (pill ? ' (' + pill + ')' : '');
      selEl.appendChild(o);
    });
    optsBuilt = true;
  }
  function syncPlan(){
    if(!bar || bar.hasAttribute('data-bundle')) return;
    var p = getPs(); var c = p && p.querySelector('[data-ps1c-card].is-selected');
    if(!c){ bar.removeAttribute('data-plan'); return; }
    buildOptions(p);
    if(selEl){ selEl.value = c.getAttribute('data-ps1c-p') || ''; }
    if(perEl){ perEl.textContent = c.getAttribute('data-ps1c-serving') || ''; }
    if(titleEl){ var pill = c.getAttribute('data-ps1c-pill') || ''; titleEl.textContent = (c.getAttribute('data-ps1c-name') || '') + (pill ? ' (' + pill + ')' : ''); }
    if(priceEl){ priceEl.textContent = c.getAttribute('data-ps1c-price') || ''; }
    bar.setAttribute('data-plan', '1');
  }
  if(selEl){
    selEl.addEventListener('change', function(){
      var p = getPs(); var target = cardsOf(p).filter(function(c){ return c.getAttribute('data-ps1c-p') === selEl.value; })[0];
      if(target){ target.click(); }
    });
  }
  document.addEventListener('ps1c:select', syncPlan);
  if(addBtn){ addBtn.addEventListener('click', function(){ var p = getPs(); var b = p && p.querySelector('[data-ps1c-submit]'); if(b){ b.click(); } }); }
  /* bundle mode: add the configured variant x quantity to the cart and open the drawer (same calls the plan selector makes) */
  var bundleBtn = bar && bar.querySelector('[data-sc-bar-bundle]');
  if(bundleBtn){
    var bundleLabel = bundleBtn.querySelector('[data-sc-bar-bundle-label]'), bundleErr = bar.querySelector('[data-sc-bar-err]');
    var bundleText = bundleLabel ? bundleLabel.textContent : '';
    var rootUrl = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) ? window.Shopify.routes.root : '/';
    function bundleFail(m){ if(bundleErr){ bundleErr.textContent = m; bundleErr.classList.add('is-shown'); } }
    function openCart(response){
      try {
        [ { id:'Cart', section:'main-cart', selector:'.thb-cart-form' },
          { id:'Cart-Drawer', section:'cart-drawer', selector:'.cart-drawer' },
          { id:'cart-drawer-toggle', section:'cart-bubble', selector:'.thb-item-count' }
        ].forEach(function(sc){
          if(!document.getElementById(sc.id) || !response.sections || !response.sections[sc.section]) return;
          var host = document.getElementById(sc.id);
          var el = host.querySelector(sc.selector) || host;
          var frag = new DOMParser().parseFromString(response.sections[sc.section], 'text/html').querySelector(sc.selector);
          if(frag) el.innerHTML = frag.innerHTML;
          if(typeof CartDrawer !== 'undefined'){ try{ new CartDrawer(); }catch(e){} }
          if(typeof Cart !== 'undefined'){ try{ new Cart().renderContents(response); }catch(e){} }
        });
      } catch(e){}
      var drawer = document.getElementById('Cart-Drawer');
      if(drawer){ document.body.classList.add('open-cc'); drawer.classList.add('active'); document.dispatchEvent(new CustomEvent('cart-drawer:open')); }
      else { window.location = rootUrl + 'cart'; }
    }
    bundleBtn.addEventListener('click', function(){
      var id = bar.getAttribute('data-bundle'), qty = parseInt(bar.getAttribute('data-bundle-qty'), 10) || 1;
      if(!id){ bundleFail('This bundle needs a variant ID — set it in the theme editor.'); return; }
      if(bundleErr){ bundleErr.classList.remove('is-shown'); }
      bundleBtn.classList.add('is-loading'); if(bundleLabel){ bundleLabel.textContent = 'Adding…'; }
      var items = [{ id: id, quantity: qty, properties: { '_li': (Date.now().toString(36) + Math.random().toString(36).slice(2, 8)) } }];
      fetch(rootUrl + 'cart/add.js', { method:'POST', headers:{'Content-Type':'application/json','Accept':'application/json'}, body: JSON.stringify({ items: items, sections: ['main-cart','cart-drawer','cart-bubble'], sections_url: window.location.pathname }) })
      .then(function(r){ return r.json(); })
      .then(function(response){ if(response && response.status){ throw response; } bundleBtn.classList.remove('is-loading'); if(bundleLabel){ bundleLabel.textContent = bundleText; } openCart(response); })
      .catch(function(e){ bundleBtn.classList.remove('is-loading'); if(bundleLabel){ bundleLabel.textContent = bundleText; } bundleFail((e && (e.description || e.message)) || 'Could not add to cart'); });
    });
  }
  /* the buy box sits further down the page, so look again once the DOM is complete */
  syncPlan();
  if(document.readyState === 'loading'){ document.addEventListener('DOMContentLoaded', syncPlan); } else { setTimeout(syncPlan, 0); }
  window.addEventListener('scroll', place, { passive: true });
  window.addEventListener('resize', place);
  update();
})();
</script>

