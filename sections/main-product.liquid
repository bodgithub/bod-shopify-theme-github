{{- 'product.css' | asset_url | stylesheet_tag -}}
{%- liquid
	assign first_3d_model = product.media | where: "media_type", "model" | first
	assign thumbnail_position = section.settings.thumbnail_position
	assign media_aspect_ratio = section.settings.media_aspect_ratio

	assign image_index = -1

	assign display_captions = section.settings.display_captions
	assign hide_variants = section.settings.hide_variants
	assign featured_media = product.selected_or_first_available_variant.featured_media

	assign first_image = nil
	assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src'

	assign sizes = '345x345,610x610,1220x1220'
	if media_aspect_ratio == 'adapt'
		assign sizes = '345x0,610x0,1220x0'
	elsif media_aspect_ratio == 'portrait'
		assign sizes = '345x430,610x760,1220x1525'
	elsif media_aspect_ratio == 'landscape'
		assign sizes = '345x255,610x450,1220x900'
	endif

-%}
{%- if first_3d_model -%}
  <link id="ModelViewerStyle" rel="stylesheet" href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css" media="print" onload="this.media='all'">
  <link id="ModelViewerOverride" rel="stylesheet" href="{{ 'product-model-viewer-ui.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

{%- style -%}
  @media only screen and (min-width: 1068px) {
    #shopify-section-{{ section.id }} .product-grid-container {
      grid-template-columns: minmax(40%, 700px) {{ section.settings.desktop_info_width | default: 462 }}px !important;
    }
  }
{%- endstyle -%}
<div class="thb-product-detail product">
  <div class="row">
		<div class="small-12 columns">
			<div class="product-grid-container{% if section.settings.media_layout == 'stacked' %} product-media-layout--stacked{% endif %}">
				<div class="product-gallery-sticky">
			    <div class="product-gallery-container thumbnails-{{ thumbnail_position }}" id="MediaGallery-{{ section.id }}">
						<div class="product-image-container">
			        <product-slider id="Product-Slider" class="product-images static-dots{% if section.settings.carousel_arrow_style == 'semicircle' %} product-images--semicircle-arrows{% endif %}" data-captions="{{ display_captions }}" data-hide-variants="{{ hide_variants }}">
								{%- if featured_media != null -%}
		              {%- liquid
										assign image_index = image_index | plus: 1
										assign first_image = featured_media.preview_image
									-%}
		              {%- render 'product-media', product: product, section: section, forloop: false, media: featured_media, sizes: sizes, variant_images: variant_images, media_aspect_ratio: media_aspect_ratio, hide_variants: hide_variants, priority: 'high', display_captions: display_captions -%}
		            {%- endif -%}
			          {%- for media in product.media -%}
									{%- unless media.id == featured_media.id -%}
										{%- liquid
											if media.media_type == 'image'
												assign image_index = image_index | default: 0 | plus: 1
											endif

                      assign priority = false
											if image_index == 0
												assign first_image = media.preview_image
                        assign priority = 'high'
											endif
										-%}
                    {%- render 'product-media', product: product, section: section, forloop: forloop, media: media, sizes: sizes, variant_images: variant_images, media_aspect_ratio: media_aspect_ratio, hide_variants: hide_variants, priority: priority, display_captions: display_captions -%}
									{%- endunless -%}
			          {%- endfor -%}
								{%- if product.media.size > 1 -%}
								<div class="flickity-nav flickity-prev" tabindex="0">{%- if section.settings.carousel_arrow_style == 'semicircle' -%}{%- render 'svg-icons' with 'carousel-chevron-prev' -%}{%- else -%}{%- render 'svg-icons' with 'carousel-prev' -%}{%- endif -%}</div>
								<div class="flickity-nav flickity-next" tabindex="0">{%- if section.settings.carousel_arrow_style == 'semicircle' -%}{%- render 'svg-icons' with 'carousel-chevron-next' -%}{%- else -%}{%- render 'svg-icons' with 'carousel-next' -%}{%- endif -%}</div>
								{%- endif -%}
			        </product-slider>
							<scroll-shadow>
								<div id="Product-Thumbnails" class="product-thumbnail-container" data-hide-variants="{{ hide_variants }}">
									{%- if featured_media != null -%}
										{%- render 'product-thumbnail', product: product, media: featured_media, forloop: false, variant_images: variant_images, media_aspect_ratio: media_aspect_ratio, hide_variants: hide_variants, media_layout: section.settings.media_layout -%}
									{%- endif -%}
									{%- for media in product.media -%}
										{%- unless media.id == featured_media.id -%}
                    {%- render 'product-thumbnail', product: product, media: media, forloop: forloop, variant_images: variant_images, media_aspect_ratio: media_aspect_ratio, hide_variants: hide_variants, media_layout: section.settings.media_layout -%}
										{%- endunless -%}
									{%- endfor -%}
								</div>
							</scroll-shadow>
						</div>
			    </div>
					{%- assign info_boxes = section.blocks | where: "type", "info_box" -%}
					{%- if info_boxes.size > 0 -%}
					{{- 'info-box.css' | asset_url | stylesheet_tag -}}
					<div class="product--infobox-container">
						{%- for info_box in info_boxes %}
							<div class="product--infobox" style="--info-box-bg: {{ info_box.settings.info_box_bg }};--info-box-color: {{ info_box.settings.info_box_color }};">
								{% if info_box.settings.image %}
								<span class="product--infobox-image">
									{%- render 'responsive-image', image: info_box.settings.image, sizes: '24x24,48x48' -%}
								</span>
								{%- else -%}
								<span class="product--infobox-image">
									{% render 'svg-icons-inline', icon: info_box.settings.icon %}
								</span>
								{%- endif -%}
								<span>{{ info_box.settings.text }}</span>
								{% if info_box.settings.link %}
								<a href="{{ info_box.settings.link }}" class="product--infobox-link"></a>
								{%- endif -%}
							</div>
						{%- endfor -%}
					</div>
					{%- endif -%}
				</div>
		    <div class="product-information">
					<div id="ProductInfo-{{ section.id }}" class="product-information--inner">
						{%- render 'product-information', product: product, section: section, update_url: true, pickup: true, first_image: first_image, hide_variants: hide_variants -%}
					</div>
		    </div>
			</div>
		</div>
  </div>
</div>
<div class="side-panel side-availability" id="Pickup-Availability"></div>

{%- if section.settings.enable_top_sticky_bar -%}
	{%- render 'product-sticky-bar', product: product, section: section -%}
{%- endif -%}

{%- assign side_panels = section.blocks | where: "type", "side_panel" -%}
{%- if side_panels.size > 0 -%}
<div class="side-panel product-information-drawer" id="Product-Information-Drawer" tabindex="-1">
	<div class="side-panel-inner">
		<div class="side-panel-header">
			<div>
				<p>{{ 'products.product.product_information' | t }}</p>
				<side-panel-close class="side-panel-close">{%- render 'svg-icons' with 'close' -%}</side-panel-close>
			</div>
		</div>
		<div class="side-panel-content side-panel-content--has-tabs">
			{%- assign block = side_panels[0] -%}
			<side-panel-content-tabs class="side-panel-content--tabs">
				{%- if block.settings.side_panel_1_label != '' -%}
					<button class="tab-active">{{ block.settings.side_panel_1_label }}</button>
				{%- endif -%}
				{%- if block.settings.side_panel_2_label != '' -%}
					<button>{{ block.settings.side_panel_2_label }}</button>
				{%- endif -%}
				{%- if block.settings.side_panel_3_label != '' -%}
					<button>{{ block.settings.side_panel_3_label }}</button>
				{%- endif -%}
			</side-panel-content-tabs>
			<div class="side-panel-content--inner">
				{%- if block.settings.side_panel_1_label != '' -%}
				<div class="side-panel-content--tab-panel rte tab-active">
				  {{ block.settings.side_panel_1_page.content }}
				</div>
				{%- endif -%}
				{%- if block.settings.side_panel_2_label != '' -%}
				<div class="side-panel-content--tab-panel rte">
				  {{ block.settings.side_panel_2_page.content }}
				</div>
				{%- endif -%}
				{%- if block.settings.side_panel_3_label != '' -%}
				<div class="side-panel-content--tab-panel rte">
				  {{ block.settings.side_panel_3_page.content }}
				</div>
				{%- endif -%}
			</div>
		</div>
	</div>
</div>
{%- endif -%}
{%- if section.settings.lightbox != blank -%}
{% render 'photoswipe' %}
<link rel="stylesheet" href="{{ 'photoswipe.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

{%- if first_3d_model -%}
  <script type="application/json" id="ProductJSON-{{ product.id }}">
    {{ product.media | where: 'media_type', 'model' | json }}
  </script>

  <script src="{{ 'product-model.js' | asset_url }}" defer></script>
{%- endif -%}

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{%- if section.settings.media_layout == 'stacked' -%}
<script>
(function(){
  var section = document.getElementById('shopify-section-{{ section.id }}');
  if (!section) return;
  var gallery = section.querySelector('.product-gallery-sticky');
  if (!gallery) return;
  var mq = window.matchMedia('(min-width: 1068px)');
  function headerH(){
    var v = getComputedStyle(document.documentElement).getPropertyValue('--header-height');
    return parseInt(v, 10) || 0;
  }
  function update(){
    if (mq.matches) {
      var gh = gallery.offsetHeight, vh = window.innerHeight, top;
      if (gh + 40 <= vh) {
        top = headerH() + 20;      // gallery fits on screen -> pin at the top
      } else {
        top = vh - gh - 20;        // gallery taller than screen -> scroll through, then pin its bottom
      }
      gallery.style.position = 'sticky';
      gallery.style.top = top + 'px';
      gallery.style.bottom = 'auto';
    } else {
      gallery.style.position = '';
      gallery.style.top = '';
      gallery.style.bottom = '';
    }
  }
  update();
  window.addEventListener('resize', update);
  window.addEventListener('load', update);
  if (window.ResizeObserver) { new ResizeObserver(update).observe(gallery); }
})();
</script>
{%- endif -%}
{% schema %}
{
  "name": "Product information",
  "tag": "section",
  "class": "product-section",
	"settings": [
		{
			"type": "checkbox",
			"id": "enable_sticky_add_to_cart",
			"default": true,
			"label": "Show sticky add to cart"
		},
		{ "type": "header", "content": "Top sticky bar", "info": "A slim bar that drops down from under the menu once the main add-to-cart button has scrolled off the top of the screen. It hides again as soon as that button is back on screen." },
		{ "type": "checkbox", "id": "enable_top_sticky_bar", "label": "Show top sticky bar", "default": false },
		{ "type": "text", "id": "top_bar_title", "label": "Title", "info": "Leave blank to use the product title." },
		{ "type": "text", "id": "top_bar_button_label", "label": "Button label", "default": "Add to Cart" },
		{ "type": "checkbox", "id": "top_bar_show_price", "label": "Show price in the button", "default": true },
		{ "type": "checkbox", "id": "top_bar_show_badge", "label": "Show badge next to the title", "default": true },
		{ "type": "text", "id": "top_bar_badge_text", "label": "Badge text", "info": "e.g. a stock or dispatch line. Leave blank to hide the badge." },
		{ "type": "header", "content": "Top sticky bar — colours" },
		{ "type": "color", "id": "top_bar_bg", "label": "Bar background", "default": "#ffffff" },
		{ "type": "color", "id": "top_bar_text_color", "label": "Title colour", "default": "#16181a" },
		{ "type": "color", "id": "top_bar_border_color", "label": "Bottom border", "default": "#e3e5e8" },
		{ "type": "color", "id": "top_bar_button_bg", "label": "Button background", "default": "#16181a" },
		{ "type": "color", "id": "top_bar_button_text_color", "label": "Button text", "default": "#ffffff" },
		{ "type": "color", "id": "top_bar_badge_bg", "label": "Badge background", "default": "#eef7e6" },
		{ "type": "color", "id": "top_bar_badge_color", "label": "Badge text colour", "default": "#2f7a1f" },
		{ "type": "header", "content": "Top sticky bar — advanced" },
		{ "type": "text", "id": "top_bar_target", "label": "Button to watch (CSS selector)", "info": "Leave blank to auto-detect the main add-to-cart / plan-selector button. The bar's button clicks whatever this matches, so plan and subscription choices carry over." },
		{ "type": "text", "id": "top_bar_scope", "label": "Look inside (CSS selector)", "default": ".product-information", "info": "Limits the search above to the product information column." },
		{
			"type": "checkbox",
			"id": "show_taxes_included",
			"default": true,
			"label": "Show tax and shipping information",
			"info": "Tax and shipping information will be displayed if [taxes are included in the price](https://help.shopify.com/en/manual/taxes/location#include-taxes-in-product-prices) or [shipping policy](https://help.shopify.com/en/manual/checkout-settings/refund-privacy-tos#add-or-generate-store-policies) is added"
		},
		{
			"type": "header",
			"content": "Desktop layout"
		},
		{
			"type": "range",
			"id": "desktop_info_width",
			"label": "Description column width",
			"info": "Desktop only. Sets the width of the product information column; the photos fill the remaining space.",
			"min": 360,
			"max": 560,
			"step": 2,
			"unit": "px",
			"default": 462
		},
		{
			"type": "header",
			"content": "Media"
		},
		{
			"type": "paragraph",
			"content": "Learn more about [media types](https://help.shopify.com/en/manual/products/product-media)"
		},
		{
			"type": "select",
			"id": "media_layout",
			"label": "Media layout",
			"info": "Carousel: one image with thumbnails. Stacked: a large hero image with a grid of the remaining images below (no carousel). Thumbnail position only applies to Carousel.",
			"default": "carousel",
			"options": [
				{ "value": "carousel", "label": "Carousel + thumbnails" },
				{ "value": "stacked", "label": "Stacked (large image + grid)" }
			]
		},
		{
			"type": "select",
			"id": "thumbnail_position",
			"options": [
				{
					"value": "left",
					"label": "Left"
				},
				{
					"value": "bottom",
					"label": "Bottom"
				}
			],
			"default": "left",
			"label": "Thumbnail position"
		},
		{
			"type": "select",
			"id": "media_aspect_ratio",
			"options": [
				{
					"value": "adapt",
					"label": "Adapt to image"
				},
				{
					"value": "square",
					"label": "Square"
				},
				{
					"value": "portrait",
					"label": "Portrait"
				},
				{
					"value": "landscape",
					"label": "Landscape"
				}
			],
			"default": "adapt",
			"label": "Image ratio"
		},
		{
			"type": "select",
			"id": "carousel_arrow_style",
			"label": "Carousel arrow style",
			"info": "Semi-circle attaches rounded arrows to the left and right image edges; they turn blue on hover.",
			"default": "circle",
			"options": [
				{ "value": "circle", "label": "Circle (default)" },
				{ "value": "semicircle", "label": "Semi-circle on edges" }
			]
		},
		{
      "type": "checkbox",
      "id": "display_captions",
      "default": true,
      "label": "Display captions"
    },
		{
      "type": "checkbox",
      "id": "hide_variants",
      "default": false,
      "label": "Hide unselected variants’ media",
			"info": "Media for the unselected variants will be hidden."
    },
		{
			"type": "checkbox",
			"id": "lightbox",
			"default": true,
			"label": "Enable image zoom"
		},
		{
      "type": "checkbox",
      "id": "enable_video_looping",
      "default": false,
      "label": "Enable video looping"
    }
  ],
  "blocks": [
		{
			"type": "@app"
		},
		{
      "type": "trust_strip",
      "name": "Trust strip",
      "settings": [
        { "type": "header", "content": "Section headline" },
        { "type": "text", "id": "headline", "label": "Headline text", "default": "Every batch, independently verified" },
        { "type": "range", "id": "headline_size", "label": "Headline size", "min": 12, "max": 34, "step": 1, "unit": "px", "default": 21 },
        { "type": "select", "id": "headline_weight", "label": "Headline weight", "default": "600", "options": [
          { "value": "400", "label": "Regular" },
          { "value": "500", "label": "Medium" },
          { "value": "600", "label": "Semibold" },
          { "value": "700", "label": "Bold" }
        ] },
        { "type": "color", "id": "headline_color", "label": "Headline color", "info": "On the gradient-background style the headline is white by default.", "default": "#14307C" },

        { "type": "header", "content": "Design" },
        { "type": "select", "id": "style", "label": "Card style", "default": "white", "options": [
          { "value": "white", "label": "White box, gradient border" },
          { "value": "gradient", "label": "Gradient background" }
        ] },
        { "type": "checkbox", "id": "center_all", "label": "Center-align everything", "default": false },
        { "type": "checkbox", "id": "frame_flat", "label": "Remove frame padding & shadow", "info": "Drops the gradient border padding and the drop shadow.", "default": false },
        { "type": "color", "id": "title_color", "label": "Badge title color", "info": "On the gradient-background style badge titles are white.", "default": "#14307C" },
        { "type": "color", "id": "sub_color", "label": "Badge sub-label color", "default": "#42579E" },

        { "type": "header", "content": "Layout" },
        { "type": "range", "id": "max_width", "label": "Max width", "min": 480, "max": 1100, "step": 20, "unit": "px", "default": 720 },
        { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 16 },
        { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 16 },

        { "type": "header", "content": "Badge 1" },
        { "type": "checkbox", "id": "b1_enable", "label": "Show badge", "default": true },
        { "type": "select", "id": "b1_icon", "label": "Icon", "default": "expert", "options": [
          { "value": "expert", "label": "Expert (people check)" }, { "value": "flask", "label": "Lab flask" }, { "value": "fingerprint", "label": "Fingerprint" }, { "value": "chart", "label": "Potency chart" }, { "value": "shield", "label": "Shield check" }, { "value": "microbe", "label": "Microbe" }, { "value": "ratio", "label": "Ratio bars" }, { "value": "pin", "label": "Location pin" }, { "value": "leaf", "label": "Leaf" }, { "value": "check", "label": "Check circle" }, { "value": "beaker", "label": "Beaker" }, { "value": "droplet", "label": "Droplet" }, { "value": "star", "label": "Star" }, { "value": "lock", "label": "Lock" }, { "value": "globe", "label": "Globe" }, { "value": "award", "label": "Award medal" }
        ] },
        { "type": "text", "id": "b1_title", "label": "Title", "default": "Expert Reviewed" },
        { "type": "text", "id": "b1_sub", "label": "Sub-label", "default": "RD • MS • PhD" },
        { "type": "richtext", "id": "b1_tip", "label": "Info tooltip", "default": "<p>Bodology's formula and label are reviewed by qualified professionals — including a <strong>Registered Dietitian (RD)</strong> and advisors holding <strong>MS and PhD</strong> credentials — so the ingredients, doses, and claims are accurate and responsibly stated.</p>" },

        { "type": "header", "content": "Badge 2" },
        { "type": "checkbox", "id": "b2_enable", "label": "Show badge", "default": true },
        { "type": "select", "id": "b2_icon", "label": "Icon", "default": "flask", "options": [
          { "value": "expert", "label": "Expert (people check)" }, { "value": "flask", "label": "Lab flask" }, { "value": "fingerprint", "label": "Fingerprint" }, { "value": "chart", "label": "Potency chart" }, { "value": "shield", "label": "Shield check" }, { "value": "microbe", "label": "Microbe" }, { "value": "ratio", "label": "Ratio bars" }, { "value": "pin", "label": "Location pin" }, { "value": "leaf", "label": "Leaf" }, { "value": "check", "label": "Check circle" }, { "value": "beaker", "label": "Beaker" }, { "value": "droplet", "label": "Droplet" }, { "value": "star", "label": "Star" }, { "value": "lock", "label": "Lock" }, { "value": "globe", "label": "Globe" }, { "value": "award", "label": "Award medal" }
        ] },
        { "type": "text", "id": "b2_title", "label": "Title", "default": "Third Party Tested" },
        { "type": "text", "id": "b2_sub", "label": "Sub-label", "default": "ISO/IEC 17025 Accredited Labs" },
        { "type": "richtext", "id": "b2_tip", "label": "Info tooltip", "default": "<p>Bodology is tested independently — we don't grade our own work. Every production batch is sent to <strong>Certified Laboratories</strong>, an ISO/IEC 17025-accredited testing lab, and analyzed against written specifications before it can be sold. ISO/IEC 17025 is the international standard for laboratory competence and data integrity.</p>" },

        { "type": "header", "content": "Badge 3" },
        { "type": "checkbox", "id": "b3_enable", "label": "Show badge", "default": true },
        { "type": "select", "id": "b3_icon", "label": "Icon", "default": "fingerprint", "options": [
          { "value": "expert", "label": "Expert (people check)" }, { "value": "flask", "label": "Lab flask" }, { "value": "fingerprint", "label": "Fingerprint" }, { "value": "chart", "label": "Potency chart" }, { "value": "shield", "label": "Shield check" }, { "value": "microbe", "label": "Microbe" }, { "value": "ratio", "label": "Ratio bars" }, { "value": "pin", "label": "Location pin" }, { "value": "leaf", "label": "Leaf" }, { "value": "check", "label": "Check circle" }, { "value": "beaker", "label": "Beaker" }, { "value": "droplet", "label": "Droplet" }, { "value": "star", "label": "Star" }, { "value": "lock", "label": "Lock" }, { "value": "globe", "label": "Globe" }, { "value": "award", "label": "Award medal" }
        ] },
        { "type": "text", "id": "b3_title", "label": "Title", "default": "Identity Verified" },
        { "type": "text", "id": "b3_sub", "label": "Sub-label", "default": "HPLC Analytical Testing" },
        { "type": "richtext", "id": "b3_tip", "label": "Info tooltip", "default": "<p>We use <strong>HPLC analytical testing</strong> to confirm the identity of each active — verifying that what's in the tub is genuinely myo-inositol and D-chiro-inositol, not a substitute or mislabeled material.</p>" },

