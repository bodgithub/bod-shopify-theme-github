{%- comment -%}
  BODOLOGY · LP hero
  Mirrors the ARMRA landing hero: headline, subhead, CTA button, then a
  review strip (stars + rating line + one short customer quote) on the
  left, large image on the right. Mobile: image on top, text below, CTA
  full width. Image falls back to the product's featured image when this
  section sits on a product template and no image is picked.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign img = s.image
  if img == blank and product != blank
    assign img = product.featured_image
  endif
  assign img_m = s.image_mobile | default: img
  assign cta_link = s.cta_link
  if cta_link == blank
    assign cta_link = '#shopify-section-main-product'
  endif
-%}

<style>
  #shopify-section-{{ sid }} .lph { background: {{ s.bg }}; color: {{ s.text_color }}; font-family: "tenon", -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif; }
  #shopify-section-{{ sid }} .lph__wrap { max-width: {{ s.page_width }}px; margin: 0 auto; padding: 0 0 28px; display: flex; flex-direction: column; }
  #shopify-section-{{ sid }} .lph__media { order: {% if s.mobile_image_first %}0{% else %}1{% endif %}; position: relative; overflow: hidden; background: #e9e5e2; }
  #shopify-section-{{ sid }} .lph__media img { width: 100%; height: 100%; object-fit: cover; display: block; aspect-ratio: {{ s.mobile_ratio }}; }
  #shopify-section-{{ sid }} .lph__content { order: {% if s.mobile_image_first %}1{% else %}0{% endif %}; padding: 22px 16px 0; }
  #shopify-section-{{ sid }} .lph__eyebrow { margin: 0 0 10px; font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: {{ s.accent }}; }
  #shopify-section-{{ sid }} .lph__h { margin: 0 0 12px; font-size: {{ s.h_size_mobile }}px; line-height: 1.08; font-weight: {{ s.h_weight }}; letter-spacing: -0.015em; color: {{ s.heading_color }}; }
  #shopify-section-{{ sid }} .lph__h em { font-style: italic; color: {{ s.accent }}; }
  #shopify-section-{{ sid }} .lph__sub { margin: 0 0 18px; font-size: 16px; line-height: 1.5; max-width: 34em; }
  #shopify-section-{{ sid }} .lph__sub p { margin: 0 0 8px; }
  #shopify-section-{{ sid }} .lph__cta {
    display: inline-flex; align-items: center; justify-content: center; width: 100%; min-height: 52px; padding: 14px 26px;
    border-radius: {{ s.cta_radius }}px; background: {{ s.cta_bg }}; color: {{ s.cta_text_color }}; border: 2px solid {{ s.cta_bg }};
    font-size: 15px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; text-decoration: none; transition: transform .15s ease, opacity .15s ease;
  }
  #shopify-section-{{ sid }} .lph__cta:hover { opacity: .92; transform: translateY(-1px); }
  #shopify-section-{{ sid }} .lph__note { margin: 10px 0 0; font-size: 13px; opacity: .8; }
  #shopify-section-{{ sid }} .lph__review { margin-top: 22px; padding-top: 18px; border-top: 1px solid {{ s.divider }}; }
  #shopify-section-{{ sid }} .lph__stars { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  #shopify-section-{{ sid }} .lph__stars svg { width: 18px; height: 18px; display: block; }
  #shopify-section-{{ sid }} .lph__starrow { display: inline-flex; gap: 2px; }
  #shopify-section-{{ sid }} .lph__rating { font-size: 13px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  #shopify-section-{{ sid }} .lph__quote { margin: 10px 0 0; font-size: 15px; line-height: 1.5; }
  #shopify-section-{{ sid }} .lph__quote p { margin: 0; display: inline; }
  #shopify-section-{{ sid }} .lph__name { margin: 6px 0 0; font-size: 13px; font-weight: 600; opacity: .85; }

  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .lph__wrap { flex-direction: row; align-items: stretch; padding: 0 24px; gap: 40px; min-height: {{ s.min_height }}px; }
    #shopify-section-{{ sid }} .lph__content { order: 0; flex: 0 0 46%; padding: 56px 0 56px; display: flex; flex-direction: column; justify-content: center; }
    #shopify-section-{{ sid }} .lph__media { order: 1; flex: 1 1 auto; border-radius: {{ s.image_radius }}px; margin: 24px 0; }
    #shopify-section-{{ sid }} .lph__media img { aspect-ratio: auto; position: absolute; inset: 0; }
    #shopify-section-{{ sid }} .lph__h { font-size: {{ s.h_size }}px; }
    #shopify-section-{{ sid }} .lph__sub { font-size: 18px; }
    #shopify-section-{{ sid }} .lph__cta { width: auto; min-width: 260px; }
  }
</style>

<section class="lph">
  <div class="lph__wrap">
    <div class="lph__content">
      {%- if s.eyebrow != blank -%}<p class="lph__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h1 class="lph__h">{{ s.heading }}</h1>{%- endif -%}
      {%- if s.subheading != blank -%}<div class="lph__sub">{{ s.subheading }}</div>{%- endif -%}
      {%- if s.cta_label != blank -%}<a class="lph__cta" href="{{ cta_link }}">{{ s.cta_label }}</a>{%- endif -%}
      {%- if s.cta_note != blank -%}<p class="lph__note">{{ s.cta_note }}</p>{%- endif -%}

      {%- if s.show_review -%}
        <div class="lph__review">
          <div class="lph__stars" aria-label="{{ s.rating_text | escape }}">
            <span class="lph__starrow" aria-hidden="true">
              {%- for i in (1..5) -%}
                <svg viewBox="0 0 24 24" fill="{{ s.star_color }}"><path d="M12 2.5l2.9 6.2 6.8.8-5 4.7 1.3 6.7L12 17.6 5.9 20.9l1.3-6.7-5-4.7 6.8-.8z"/></svg>
              {%- endfor -%}
            </span>
            {%- if s.rating_text != blank -%}<span class="lph__rating">{{ s.rating_text }}</span>{%- endif -%}
          </div>
          {%- if s.quote != blank -%}
            <blockquote class="lph__quote">&ldquo;{{ s.quote }}&rdquo;{% if s.quote_sup != blank %}<sup>{{ s.quote_sup }}</sup>{% endif %}</blockquote>
          {%- endif -%}
          {%- if s.quote_name != blank -%}<p class="lph__name">&ndash; {{ s.quote_name }}{% if s.quote_role != blank %}, {{ s.quote_role }}{% endif %}</p>{%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="lph__media">
      {%- if img != blank -%}
        <picture>
          {%- if img_m != img -%}<source media="(max-width: 899px)" srcset="{{ img_m | image_url: width: 900 }} 900w, {{ img_m | image_url: width: 1400 }} 1400w" sizes="100vw">{%- endif -%}
          {%- assign img_alt = s.image_alt | default: product.title | default: shop.name -%}
          {{ img | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1600, 1800', sizes: '(min-width: 900px) 54vw, 100vw', alt: img_alt }}
        </picture>
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'lph__placeholder' }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LP · Hero",
  "tag": "div",
  "class": "section-lp-hero",
  "disabled_on": { "groups": ["header", "footer", "aside"] },
  "settings": [
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (optional)" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "5 reasons your symptoms were never random" },
    { "type": "richtext", "id": "subheading", "label": "Subheadline", "default": "<p>Cravings, mood dips, irregular cycles and afternoon crashes share one metabolic root. Bodology Myo + D-Chiro Inositol gives you the full clinical daily dose, unflavored, with nothing else in the tub.</p>" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "See the offer" },
    { "type": "url", "id": "cta_link", "label": "Button link", "info": "Leave empty to scroll to the product section on this page." },
    { "type": "text", "id": "cta_note", "label": "Small text under the button", "default": "60-day money-back guarantee" },
    { "type": "header", "content": "Review strip" },
    { "type": "checkbox", "id": "show_review", "label": "Show review strip", "default": true },
    { "type": "text", "id": "rating_text", "label": "Rating line", "default": "Rated 4.8 stars by customers", "info": "Keep this in line with the live rating on the product page." },
    { "type": "textarea", "id": "quote", "label": "Customer quote" , "default": "Food noise has gone down, less afternoon crashes, period is back." },
    { "type": "text", "id": "quote_sup", "label": "Footnote mark after the quote", "default": "*" },
    { "type": "text", "id": "quote_name", "label": "Name", "default": "Lilianna" },
    { "type": "text", "id": "quote_role", "label": "Role", "default": "Verified buyer" },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Falls back to the product's featured image." },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image (optional)" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "select", "id": "mobile_ratio", "label": "Mobile image shape", "options": [ { "value": "1 / 1", "label": "Square" }, { "value": "4 / 3", "label": "Landscape 4:3" }, { "value": "4 / 5", "label": "Portrait 4:5" }, { "value": "16 / 9", "label": "Wide 16:9" } ], "default": "4 / 3" },
    { "type": "checkbox", "id": "mobile_image_first", "label": "Image above text on mobile", "default": true },
    { "type": "range", "id": "image_radius", "min": 0, "max": 32, "step": 2, "unit": "px", "label": "Image corner radius (desktop)", "default": 16 },
    { "type": "range", "id": "min_height", "min": 420, "max": 820, "step": 20, "unit": "px", "label": "Minimum height (desktop)", "default": 600 },
    { "type": "header", "content": "Style" },
    { "type": "range", "id": "page_width", "min": 1000, "max": 1600, "step": 20, "unit": "px", "label": "Content width", "default": 1300 },
    { "type": "range", "id": "h_size", "min": 32, "max": 72, "step": 2, "unit": "px", "label": "Headline size (desktop)", "default": 52 },
    { "type": "range", "id": "h_size_mobile", "min": 24, "max": 48, "step": 1, "unit": "px", "label": "Headline size (mobile)", "default": 34 },
    { "type": "select", "id": "h_weight", "label": "Headline weight", "options": [ { "value": "300", "label": "Light" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semibold" } ], "default": "400" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#fbfaf9" },
    { "type": "color", "id": "heading_color", "label": "Headline", "default": "#1a2874" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1a2874" },
    { "type": "color", "id": "accent", "label": "Accent (italic word, eyebrow)", "default": "#1b3def" },
    { "type": "color", "id": "divider", "label": "Divider line", "default": "#d9d4cf" },
    { "type": "color", "id": "star_color", "label": "Stars", "default": "#ddbd6d" },
    { "type": "color", "id": "cta_bg", "label": "Button background", "default": "#1b3def" },
    { "type": "color", "id": "cta_text_color", "label": "Button text", "default": "#ffffff" },
    { "type": "range", "id": "cta_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Button corner radius", "default": 40 }
  ],
  "presets": [ { "name": "LP · Hero" } ]
}
{% endschema %}
