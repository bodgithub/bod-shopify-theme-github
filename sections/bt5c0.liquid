{%- liquid
  assign shadow_class = 'has-shadow--' | append: settings.block_shadows
  assign protocol = settings.bcd_protocol_product
  assign free_shipping_minimum = settings.free_shipping_minimum | default: '0' | times: 100
  assign empty_url = settings.bcd_empty_url | default: routes.all_products_collection_url
-%}
<div data-chunk="0">
    "design": {{ settings.bcd_design | default: 'a' | json }},
    "code_field": {{ settings.bcd_code_field | default: 'collapsed' | json }},
    "code_banner": {{ settings.bcd_code_banner | default: '{code} applied: {percent}% off your first order' | json }},
    "code_banner_mixed": {{ settings.bcd_code_banner_mixed | default: '{code} applied' | json }},
    "code_label": {{ settings.bcd_code_label | default: 'Discount code' | json }},
    "code_other_label": {{ settings.bcd_code_other_label | default: 'Have a different code?' | json }},
    "code_another_label": {{ settings.bcd_code_another_label | default: 'Got another code? Enter it here' | json }},
    "code_placeholder": {{ settings.bcd_code_placeholder | default: 'Enter code' | json }},
    "code_apply_label": {{ settings.bcd_code_apply_label | default: 'Apply' | json }},
</div>