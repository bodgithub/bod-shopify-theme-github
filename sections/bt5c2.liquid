{%- liquid
  assign shadow_class = 'has-shadow--' | append: settings.block_shadows
  assign protocol = settings.bcd_protocol_product
  assign free_shipping_minimum = settings.free_shipping_minimum | default: '0' | times: 100
  assign empty_url = settings.bcd_empty_url | default: routes.all_products_collection_url
-%}
<div data-chunk="2">
    "free_label": {{ settings.bcd_free_label | default: 'FREE' | json }},
    "protocol_value": {{ settings.bcd_protocol_value | default: '49.00' | json }},
    "protocol_variant": {{ settings.bcd_protocol_variant | json }},
    "protocol_line_free": {{ settings.bcd_protocol_line_free | default: 'Included with your subscription · emailed after purchase' | json }},
    "protocol_line_locked": {{ settings.bcd_protocol_line_locked | default: 'Free with any subscription · emailed after purchase' | json }},
    "protocol_nudge": {{ settings.bcd_protocol_nudge | json }},
    "protocol_nudge_text": {{ settings.bcd_protocol_nudge_text | default: 'Add your free {protocol} ({value} value)' | json }},
    "protocol_nudge_button": {{ settings.bcd_protocol_nudge_button | default: 'Add' | json }},
    "shipping_unlocked": {{ settings.bcd_shipping_unlocked | default: 'Free shipping unlocked' | json }},
</div>