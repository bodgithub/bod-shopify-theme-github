{%- comment -%}
  Bodology · When to expect results — image timeline.
  Desktop: serif heading, four image columns over a continuous hairline with
  a dot at the start of each column (and one closing dot), then stage label,
  uppercase tracked title and body text.
  Mobile: tab bar (first word / rest stacked, active tab underlined) above a
  swipe carousel with the next card peeking; tabs sync with scroll.
  Stages are blocks (image, label, title, text); colours, CTA and the FDA
  disclaimer are editor settings. Copy must stay structure/function only.
{%- endcomment -%}

{%- assign uid = section.id -%}
{%- assign n = section.blocks.size | at_least: 1 -%}
<style>
#rt-{{ uid }}{background:{% if section.settings.bg_grad_bottom != blank %}linear-gradient(180deg, {% if section.settings.bg_grad_top != blank %}{{ section.settings.bg_grad_top }}{% else %}rgba(0,0,0,0){% endif %} 0%, {{ section.settings.bg_grad_bottom }} 100%){% else %}{{ section.settings.bg_color }}{% endif %}; padding:{{ section.settings.pad_top }}px 20px {{ section.settings.pad_bottom }}px;}
#rt-{{ uid }} .rt-wrap{max-width:{{ section.settings.max_width }}px; margin:0 auto; font-family:"tenon", -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;}
#rt-{{ uid }} .rt-h{font-family:"tenon", -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif; font-size:clamp(26px,3.6vw,34px); font-weight:400; letter-spacing:-0.01em; line-height:1.25; color:{{ section.settings.heading_color }}; margin:0 0 28px; text-align:left;}
#rt-{{ uid }} .rt-h :is(h1,h2,h3,h4,h5,h6,p){margin:0; line-height:inherit; color:{{ section.settings.heading_color }} !important;}
#rt-{{ uid }} .rt-h p{font-size:inherit;}
#rt-{{ uid }} .rt-h em{color:{{ section.settings.heading_accent | default: '#1b3def' }} !important;}
#rt-{{ uid }} .rt-tabs{display:none;}
#rt-{{ uid }} .rt-track{display:grid; grid-template-columns:repeat({{ n }},1fr); column-gap:26px;}
#rt-{{ uid }} .rt-img{aspect-ratio:4/3; border-radius:8px; overflow:hidden; background:{{ section.settings.img_placeholder }}; position:relative;}
#rt-{{ uid }} .rt-img__ov{position:absolute; left:0; right:0; bottom:0; padding:42px 14px 12px; background:linear-gradient(180deg, rgba(0,0,0,0) 0%, var(--ov-grad) 100%);}
#rt-{{ uid }} .rt-img__ov .rt-label{color:var(--ov-text); margin:0 0 2px;}
#rt-{{ uid }} .rt-img__ov .rt-ovtext{font-size:13px; line-height:1.45; font-weight:600; color:var(--ov-text); margin:0;}
#rt-{{ uid }} .rt-img img{width:100%; height:100%; object-fit:cover; display:block;}
#rt-{{ uid }} .rt-seg{position:relative; height:7px; margin:16px 0 14px;}
#rt-{{ uid }} .rt-seg::before{content:''; position:absolute; top:3px; left:-13px; right:-13px; height:1px; background:{{ section.settings.line_color }};}
#rt-{{ uid }} .rt-stage:first-child .rt-seg::before{left:0;}
#rt-{{ uid }} .rt-stage:last-child .rt-seg::before{right:0;}
#rt-{{ uid }} .rt-seg::after{content:''; position:absolute; top:0; left:0; width:7px; height:7px; border-radius:50%; background:{{ section.settings.dot_color }}; transform:translateX(-50%);}
#rt-{{ uid }} .rt-stage:first-child .rt-seg::after{transform:none;}
#rt-{{ uid }} .rt-enddot{display:none;}
#rt-{{ uid }} .rt-stage:last-child .rt-enddot{display:block; position:absolute; top:0; right:0; width:7px; height:7px; border-radius:50%; background:{{ section.settings.dot_color }}; transform:translateX(50%);}
#rt-{{ uid }} .rt-label{font-size:17px; font-weight:600; color:{{ section.settings.label_color }}; margin:0 0 6px;}
#rt-{{ uid }} .rt-up{font-size:12.5px; font-weight:500; letter-spacing:0.09em; text-transform:uppercase; color:{{ section.settings.uptitle_color }}; margin:0 0 8px;}
#rt-{{ uid }} .rt-d--studies{font-weight:600;}
#rt-{{ uid }} .rt-sub{font-size:11.5px; font-weight:600; letter-spacing:0.08em; text-transform:uppercase; margin:14px 0 5px;}
#rt-{{ uid }} .rt-sub--studies{color:{{ section.settings.studies_title_color | default: '#1b3def' }};}
#rt-{{ uid }} .rt-sub--cust{color:{{ section.settings.customers_title_color | default: '#1b3def' }};}
#rt-{{ uid }} .rt-quote{display:flex; align-items:center; flex-wrap:wrap; gap:10px; margin-top:14px;}
#rt-{{ uid }} .rt-quote__stars{flex-basis:100%; display:flex;}
#rt-{{ uid }} .rt-quote__text{flex:1 1 160px; font-size:13px; line-height:1.55; margin:0; color:{{ section.settings.text_color }};}
#rt-{{ uid }} .rt-quote__text p{margin:0; font-size:inherit; line-height:inherit; color:inherit;}
#rt-{{ uid }} .rt-quote__text em{color:{{ section.settings.heading_accent | default: '#1b3def' }};}
#rt-{{ uid }} .rt-quote__who{display:flex; align-items:center; gap:8px; flex:0 0 auto; text-align:left;}
#rt-{{ uid }} .rt-quote__avatar{width:38px; height:38px; border-radius:50%; border:1px solid {{ section.settings.text_color }}; object-fit:cover; display:block;}
#rt-{{ uid }} .rt-quote__name{font-size:12.5px; font-weight:var(--font-body-bold-weight, 500); margin:0; color:{{ section.settings.text_color }};}
#rt-{{ uid }} .rt-quote__role{font-size:12px; margin:0; opacity:.85; color:{{ section.settings.text_color }};}
#rt-{{ uid }} .rt-d{font-size:14.5px; line-height:1.6; color:{{ section.settings.text_color }}; margin:0;}
#rt-{{ uid }} .rt-stage-btn{display:flex; align-items:center; justify-content:center; gap:10px; width:100%; border:0; cursor:pointer; border-radius:12px; padding:13px 18px; margin-top:16px; font-family:inherit; font-size:14px; font-weight:600; color:#fff; background:linear-gradient(140deg,#1B3DEF 0%,#3358FF 52%,#5C78FF 100%); box-shadow:0 10px 26px rgba(27,61,239,0.26); text-decoration:none; text-align:center; transition:filter .16s,transform .12s,box-shadow .14s;}
#rt-{{ uid }} .rt-stage-btn:hover{filter:brightness(1.06); transform:translateY(-1px); box-shadow:0 14px 32px rgba(27,61,239,0.34);}
#rt-{{ uid }} .rt-stage-btn:active{transform:translateY(1px);}
@media (max-width:749px){
#rt-{{ uid }} .rt-h{font-size:26px; margin-bottom:18px;}
#rt-{{ uid }} .rt-tabs{display:flex; gap:24px; margin-bottom:20px;}
#rt-{{ uid }} .rt-tab{background:none; border:0; padding:0 0 8px; cursor:pointer; font-family:inherit; text-align:center; font-size:14px; line-height:1.35; color:{{ section.settings.tab_inactive_color }}; border-bottom:2px solid transparent;}
#rt-{{ uid }} .rt-tab span{display:block;}
#rt-{{ uid }} .rt-tab.is-active{color:{{ section.settings.tab_active_color }}; border-bottom-color:{{ section.settings.tab_active_color }};}
#rt-{{ uid }} .rt-track{display:flex; overflow-x:auto; scroll-snap-type:x mandatory; gap:16px; -webkit-overflow-scrolling:touch; scrollbar-width:none;}
#rt-{{ uid }} .rt-track::-webkit-scrollbar{display:none;}
#rt-{{ uid }} .rt-stage{flex:0 0 80%; scroll-snap-align:start;}
#rt-{{ uid }} .rt-seg{display:none;}
#rt-{{ uid }} .rt-img{margin-bottom:18px;}
}
#rt-{{ uid }} .rt-cta-row{text-align:center; margin-top:36px;}
#rt-{{ uid }} .rt-cta{display:inline-block; border:0; cursor:pointer; border-radius:999px; padding:15px 34px; font-family:inherit; font-size:14.5px; font-weight:600; color:{{ section.settings.cta_text_color }}; background:{{ section.settings.cta_bg }}; text-decoration:none; transition:filter .15s,transform .12s;}
#rt-{{ uid }} .rt-cta:hover{filter:brightness(1.06);}
#rt-{{ uid }} .rt-note{font-size:12.5px; color:{{ section.settings.text_color }}; text-align:center; margin:14px 0 0;}
#rt-{{ uid }} .rt-disclaimer{font-size:10.5px; line-height:1.55; color:{{ section.settings.disclaimer_color }}; text-align:center; max-width:640px; margin:26px auto 0;}
</style>

<div id="rt-{{ uid }}">
  <div class="rt-wrap">
    {%- if section.settings.heading != blank -%}<div class="rt-h">{{ section.settings.heading }}</div>{%- endif -%}

    <div class="rt-tabs" data-rt-tabs aria-hidden="false">
      {%- for block in section.blocks -%}
        {%- assign chip_words = block.settings.chip | split: ' ' -%}
        {%- assign chip_first = chip_words | first -%}
        {%- assign chip_rest = block.settings.chip | remove_first: chip_first | strip -%}
        <button type="button" class="rt-tab{% if forloop.first %} is-active{% endif %}" data-rt-tab="{{ forloop.index0 }}"><span>{{ chip_first }}</span><span>{{ chip_rest }}</span></button>
      {%- endfor -%}
    </div>

    <div class="rt-track" data-rt-track>
      {%- for block in section.blocks -%}
      <div class="rt-stage" data-rt-stage {{ block.shopify_attributes }}>
        <div class="rt-img">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.title | escape }}
          {%- endif -%}
          {%- if section.settings.overlay_mode -%}
            <div class="rt-img__ov" style="--ov-grad: {{ block.settings.overlay_grad | default: '#1a2874' | color_modify: 'alpha', 0.85 }}; --ov-text: {{ block.settings.overlay_text | default: '#ffffff' }};">
              {%- if block.settings.chip != blank -%}<p class="rt-label">{{ block.settings.chip }}</p>{%- endif -%}
              {%- if block.settings.studies_text != blank -%}<p class="rt-ovtext">{{ block.settings.studies_text }}</p>{%- endif -%}
            </div>
          {%- endif -%}
        </div>
        <div class="rt-seg" aria-hidden="true"><span class="rt-enddot"></span></div>
        {%- unless section.settings.overlay_mode -%}{%- if block.settings.chip != blank -%}<p class="rt-label">{{ block.settings.chip }}</p>{%- endif -%}{%- endunless -%}
        {%- if block.settings.title != blank -%}<h3 class="rt-up">{{ block.settings.title }}</h3>{%- endif -%}
        {%- if block.settings.text != blank -%}<p class="rt-d">{{ block.settings.text }}</p>{%- endif -%}
        {%- if block.settings.studies_text != blank and section.settings.overlay_mode != true -%}
          {%- if block.settings.studies_label != blank -%}<p class="rt-sub rt-sub--studies">{{ block.settings.studies_label }}</p>{%- endif -%}
          <p class="rt-d rt-d--studies">{{ block.settings.studies_text }}</p>
        {%- endif -%}
        {%- if block.settings.customers_text != blank -%}
          {%- if block.settings.customers_label != blank -%}<p class="rt-sub rt-sub--cust">{{ block.settings.customers_label }}</p>{%- endif -%}
          <p class="rt-d">{{ block.settings.customers_text }}</p>
        {%- endif -%}
        {%- assign quote_suffixes = ',_2,_3' | split: ',' -%}
        {%- for suf in quote_suffixes -%}
          {%- assign qt_key = 'quote_text' | append: suf -%}
          {%- if block.settings[qt_key] != blank -%}
            {%- assign qs_key = 'quote_stars' | append: suf -%}
            {%- assign qi_key = 'quote_image' | append: suf -%}
            {%- assign qn_key = 'quote_name' | append: suf -%}
            {%- assign qr_key = 'quote_role' | append: suf -%}
            <div class="rt-quote">
              {%- if block.settings[qs_key] > 0 -%}
                <div class="rt-quote__stars">{% render 'bod-stars', rating: block.settings[qs_key], count: 1, link: false, show_label: false, style: 'chunky', size: 13, gap: 2, round: 0, color_on: '#ddbd6d', color_off: '#e6e6e6', margin_top: 0, margin_bottom: 0, alignment: 'left', uid: block.id %}</div>
              {%- endif -%}
              <div class="rt-quote__text">&ldquo;{{ block.settings[qt_key] | remove: '<p>' | remove: '</p>' }}&rdquo;</div>
              {%- if block.settings[qn_key] != blank or block.settings[qi_key] != blank -%}
                <div class="rt-quote__who">
                  {%- if block.settings[qi_key] != blank -%}
                    <img class="rt-quote__avatar" src="{{ block.settings[qi_key] | image_url: width: 76 }}" alt="{{ block.settings[qn_key] | escape }}" width="38" height="38" loading="lazy">
                  {%- endif -%}
                  <div>
                    {%- if block.settings[qn_key] != blank -%}<p class="rt-quote__name">{{ block.settings[qn_key] }}</p>{%- endif -%}
                    {%- if block.settings[qr_key] != blank -%}<p class="rt-quote__role">{{ block.settings[qr_key] }}</p>{%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
        {%- if block.settings.btn_label != blank and block.settings.btn_link != blank -%}<a class="rt-stage-btn" href="{{ block.settings.btn_link }}">{{ block.settings.btn_label }}</a>{%- endif -%}
      </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
    <div class="rt-cta-row">
      <a class="rt-cta" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
      {%- if section.settings.cta_note != blank -%}<p class="rt-note">{{ section.settings.cta_note }}</p>{%- endif -%}
    </div>
    {%- endif -%}

    {%- if section.settings.disclaimer != blank -%}
    <p class="rt-disclaimer">{{ section.settings.disclaimer }}</p>
    {%- endif -%}
  </div>
</div>

<script>
(function(){
  var root = document.getElementById('rt-{{ uid }}');
  if(!root || root.dataset.rtBound) return;
  root.dataset.rtBound = '1';
  var track = root.querySelector('[data-rt-track]');
  var tabs = [].slice.call(root.querySelectorAll('[data-rt-tab]'));
  var stages = [].slice.call(root.querySelectorAll('[data-rt-stage]'));
  if(!track || !tabs.length || !stages.length) return;
  function setActive(i){
    tabs.forEach(function(t, k){ t.classList.toggle('is-active', k === i); });
  }
  tabs.forEach(function(t){
    t.addEventListener('click', function(){
      var i = parseInt(t.getAttribute('data-rt-tab'), 10) || 0;
      var target = stages[i];
      if(target){ track.scrollTo({ left: target.offsetLeft - track.offsetLeft, behavior: 'smooth' }); }
      setActive(i);
    });
  });
  var ticking = false;
  track.addEventListener('scroll', function(){
    if(ticking) return;
    ticking = true;
    requestAnimationFrame(function(){
      ticking = false;
      var x = track.scrollLeft; var best = 0; var bestDist = Infinity;
      stages.forEach(function(s, i){
        var d = Math.abs((s.offsetLeft - track.offsetLeft) - x);
        if(d < bestDist){ bestDist = d; best = i; }
      });
      setActive(best);
    });
  }, { passive: true });
})();
</script>

