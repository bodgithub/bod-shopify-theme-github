  ],
  "blocks": [
    {
      "type": "item",
      "name": "Proof point",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "check", "label": "Check circle" },
            { "value": "star", "label": "Star" },
            { "value": "user", "label": "Person" },
            { "value": "badge", "label": "Certified badge" },
            { "value": "shield", "label": "Shield" },
            { "value": "flask", "label": "Flask (lab)" },
            { "value": "leaf", "label": "Leaf (plant)" },
            { "value": "scoop", "label": "Scoop" },
            { "value": "flag", "label": "Flag" },
            { "value": "truck", "label": "Truck (delivery)" },
            { "value": "refresh", "label": "Refresh (guarantee)" },
            { "value": "document", "label": "Document (report)" }
          ],
          "default": "check"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom icon (optional)",
          "info": "Overrides the icon above. 48 x 48 px PNG/SVG."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "40:1 Myo to D-Chiro ratio"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust banner",
      "blocks": [
        { "type": "item", "settings": { "icon": "star", "text": "4.8/5 star rating" } },
        { "type": "item", "settings": { "icon": "scoop", "text": "40:1 Myo to D-Chiro ratio" } },
        { "type": "item", "settings": { "icon": "leaf", "text": "D-Chiro from carob, not corn" } },
        { "type": "item", "settings": { "icon": "document", "text": "Third-party tested. Lab report published" } },
        { "type": "item", "settings": { "icon": "flag", "text": "Made in the USA, GMP and FDA-compliant facility" } },
        { "type": "item", "settings": { "icon": "refresh", "text": "60-day money-back guarantee" } },
        { "type": "item", "settings": { "icon": "badge", "text": "Vegan, gluten-free, non-GMO" } }
      ]
    }
  ]
}
{% endschema %}
