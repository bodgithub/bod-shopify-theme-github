      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#FBFAF9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FBFAF9"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Icons",
      "default": "#B4C0FF"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider line",
      "default": "#3447AF"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "page_width",
      "min": 900,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Max width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
