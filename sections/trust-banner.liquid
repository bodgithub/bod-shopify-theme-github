{%- comment -%}
  BODOLOGY · Trust banner
  Rounded dark panel: logo mark + two-line headline on the left, short
  blurb on the right, thin divider, then a strip of icon + text proof
  points. The strip is an auto carousel: it slides one item to the left
  every N seconds (default 3.5s), loops seamlessly, pauses on hover /
  focus / hidden tab, and stops entirely for prefers-reduced-motion
  (the strip becomes a normal horizontal scroller instead).
  Available on every template (pages, product pages, home, etc).
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign interval_ms = s.slide_interval | times: 1000 | round
-%}

{% style %}
  #shopify-section-{{ sid }} .tb {
    padding: {{ s.padding_top_mobile }}px 0 {{ s.padding_bottom_mobile }}px;
    font-family: "tenon", sans-serif;
  }
  #shopify-section-{{ sid }} .tb__pw {
    max-width: {{ s.page_width }}px;
    margin: 0 auto;
    padding: 0 16px;
  }
  #shopify-section-{{ sid }} .tb__panel {
    background: {{ s.bg_color }};
    color: {{ s.text_color }};
    border-radius: {{ s.radius }}px;
    overflow: hidden;
  }
  #shopify-section-{{ sid }} .tb__top {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 28px 22px 26px;
  }
  #shopify-section-{{ sid }} .tb__brand {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }
  #shopify-section-{{ sid }} .tb__logo {
    flex: 0 0 auto;
    height: {{ s.logo_height_mobile }}px;
    width: auto;
    display: block;
    margin-top: 0.35em;
  }
  #shopify-section-{{ sid }} .tb__logo img,
  #shopify-section-{{ sid }} .tb__logo svg {
    height: 100%;
    width: auto;
    display: block;
  }
  #shopify-section-{{ sid }} .tb__heading {
    margin: 0;
    color: {{ s.heading_color }};
    font-family: inherit;
    font-weight: {{ s.heading_weight }};
    font-size: {{ s.heading_size_mobile }}px;
    line-height: 1.08;
    letter-spacing: -0.01em;
    white-space: pre-line;
  }
  #shopify-section-{{ sid }} .tb__blurb {
    margin: 0;
    font-size: 16px;
    line-height: 1.45;
    max-width: 44ch;
  }
  #shopify-section-{{ sid }} .tb__blurb p { margin: 0; }
  #shopify-section-{{ sid }} .tb__blurb p + p { margin-top: 0.25em; }
  #shopify-section-{{ sid }} .tb__blurb strong { font-weight: 500; }

  /* ---------- proof strip / carousel ---------- */
  #shopify-section-{{ sid }} .tb__strip {
    border-top: 1px solid {{ s.divider_color }};
    padding: 18px 0;
  }
  #shopify-section-{{ sid }} .tb__viewport {
    overflow: hidden;
    padding: 0 22px;
  }
  #shopify-section-{{ sid }} .tb__track {
    display: flex;
    align-items: center;
    gap: {{ s.item_gap }}px;
    width: max-content;
    will-change: transform;
  }
  #shopify-section-{{ sid }} .tb__track.is-animating {
    transition: transform {{ s.slide_speed }}ms cubic-bezier(.45, 0, .2, 1);
  }
  #shopify-section-{{ sid }} .tb__item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex: 0 0 auto;
    white-space: nowrap;
    font-size: {{ s.item_size }}px;
    line-height: 1.2;
    color: {{ s.text_color }};
    text-decoration: none;
  }
  #shopify-section-{{ sid }} a.tb__item:hover { text-decoration: underline; text-underline-offset: 3px; }
  #shopify-section-{{ sid }} .tb__icon {
    flex: 0 0 auto;
    width: 24px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: {{ s.accent_color }};
  }
  #shopify-section-{{ sid }} .tb__icon svg { width: 100%; height: 100%; display: block; }
  #shopify-section-{{ sid }} .tb__icon img { width: 100%; height: 100%; object-fit: contain; display: block; }

  /* Reduced motion: no auto-slide, just a swipeable strip. */
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .tb__viewport {
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    #shopify-section-{{ sid }} .tb__viewport::-webkit-scrollbar { display: none; }
    #shopify-section-{{ sid }} .tb__track.is-animating { transition: none; }
  }

  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .tb__top {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 40px;
      padding: 40px 36px 36px;
    }
    #shopify-section-{{ sid }} .tb__logo { height: {{ s.logo_height }}px; }
    #shopify-section-{{ sid }} .tb__heading { font-size: {{ s.heading_size }}px; }
    #shopify-section-{{ sid }} .tb__blurb { font-size: 17px; }
    #shopify-section-{{ sid }} .tb__strip { padding: 22px 0; }
    #shopify-section-{{ sid }} .tb__viewport { padding: 0 36px; }
  }
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .tb {
      padding: {{ s.padding_top_desktop }}px 0 {{ s.padding_bottom_desktop }}px;
    }
    #shopify-section-{{ sid }} .tb__pw { padding: 0 20px; }
    #shopify-section-{{ sid }} .tb__top { padding: 48px 44px 44px; }
    #shopify-section-{{ sid }} .tb__viewport { padding: 0 44px; }
  }
{% endstyle %}

<div class="tb">
  <div class="tb__pw">
    <div class="tb__panel">

      <div class="tb__top">
        <div class="tb__brand">
          {%- if s.logo != blank -%}
            {%- assign logo_alt = s.logo.alt | default: shop.name -%}
            <div class="tb__logo">
              {{ s.logo | image_url: width: 600 | image_tag: loading: 'lazy', alt: logo_alt }}
            </div>
          {%- endif -%}
          {%- if s.heading != blank -%}
            <h2 class="tb__heading">{{ s.heading | escape }}</h2>
          {%- endif -%}
        </div>
        {%- if s.blurb != blank -%}
          <div class="tb__blurb">{{ s.blurb }}</div>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="tb__strip">
          <div class="tb__viewport" data-tb-viewport>
            <div class="tb__track" data-tb-track>
              {%- for block in section.blocks -%}
                {%- liquid
                  assign b = block.settings
                  assign tag = 'div'
                  if b.link != blank
                    assign tag = 'a'
                  endif
                -%}
                <{{ tag }} class="tb__item"{% if tag == 'a' %} href="{{ b.link }}"{% endif %} {{ block.shopify_attributes }}>
                  <span class="tb__icon" aria-hidden="true">
                    {%- if b.custom_icon != blank -%}
                      {{ b.custom_icon | image_url: width: 96 | image_tag: loading: 'lazy', alt: '' }}
                    {%- else -%}
                      {%- case b.icon -%}
                        {%- when 'star' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M12 3.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L12 16.9l-5.3 2.8 1.1-5.9-4.3-4.1 5.9-.8z"/></svg>
                        {%- when 'user' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9.25"/><circle cx="12" cy="10" r="3"/><path d="M6.5 18.2c1.2-2.2 3.2-3.3 5.5-3.3s4.3 1.1 5.5 3.3" stroke-linecap="round"/></svg>
                        {%- when 'badge' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M12 2.8l2 1.6 2.5-.4 1 2.4 2.4 1-.4 2.5 1.6 2-1.6 2 .4 2.5-2.4 1-1 2.4-2.5-.4-2 1.6-2-1.6-2.5.4-1-2.4-2.4-1 .4-2.5-1.6-2 1.6-2-.4-2.5 2.4-1 1-2.4 2.5.4z"/><path d="M8.5 12.2l2.3 2.3 4.7-4.8" stroke-linecap="round"/></svg>
                        {%- when 'shield' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M12 2.8l7.5 3v6c0 4.6-3.2 8.2-7.5 9.4-4.3-1.2-7.5-4.8-7.5-9.4v-6z"/><path d="M8.7 12.1l2.2 2.2 4.5-4.6" stroke-linecap="round"/></svg>
                        {%- when 'flask' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"><path d="M9 3h6M10 3v6.2L4.8 18.3A1.5 1.5 0 0 0 6.1 20.5h11.8a1.5 1.5 0 0 0 1.3-2.2L14 9.2V3"/><path d="M7.5 15.5h9"/></svg>
                        {%- when 'leaf' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"><path d="M4.5 19.5C4.5 10 10 5 20 4.5c-.5 10-5.5 15.5-15.5 15z"/><path d="M4.5 19.5C8 14 11.5 11 16 8.5"/></svg>
                        {%- when 'scoop' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"><path d="M9.5 10.5A4.5 4.5 0 1 0 13 14"/><path d="M9.5 10.5l10.2-6.4M12.4 13.6l4.6-3.1"/><path d="M5 20l3-3"/></svg>
                        {%- when 'flag' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"><path d="M5 21V4"/><path d="M5 4.5c2.5-1.5 4.8-1.5 7 0s4.5 1.5 7 0v9c-2.5 1.5-4.8 1.5-7 0s-4.5-1.5-7 0"/></svg>
                        {%- when 'truck' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"><path d="M3 6.5h11v9H3zM14 9.5h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
                        {%- when 'refresh' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"><path d="M20 12a8 8 0 0 1-13.7 5.6M4 12a8 8 0 0 1 13.7-5.6"/><path d="M17.5 3v4h-4M6.5 21v-4h4"/></svg>
                        {%- when 'document' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"><path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4M9.5 12h5M9.5 15.5h5"/></svg>
                        {%- else -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"><circle cx="12" cy="12" r="9.25"/><path d="M8 12.3l2.6 2.6L16.2 9.5"/></svg>
                      {%- endcase -%}
                    {%- endif -%}
                  </span>
                  <span class="tb__label">{{ b.text | escape }}</span>
                </{{ tag }}>
              {%- endfor -%}
            </div>
          </div>
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ sid }}');
    if (!root) return;
    var viewport = root.querySelector('[data-tb-viewport]');
    var track = root.querySelector('[data-tb-track]');
    if (!viewport || !track) return;

    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return;

    var INTERVAL = {{ interval_ms }};
    var originals = Array.prototype.slice.call(track.children);
    if (originals.length < 2) return;

    // Clone the set until the track is comfortably wider than the viewport,
    // so there is always something waiting off-screen to the right.
    function fill() {
      var guard = 0;
      while (track.scrollWidth < viewport.clientWidth * 2 + 400 && guard < 12) {
        originals.forEach(function (el) {
          var c = el.cloneNode(true);
          c.removeAttribute('data-shopify-editor-block');
          c.setAttribute('aria-hidden', 'true');
          if (c.tagName === 'A') c.setAttribute('tabindex', '-1');
          track.appendChild(c);
        });
        guard++;
      }
    }
    fill();

    var gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 0;
    var timer = null;
    var paused = false;
    var busy = false;

    function step() {
      if (busy || paused || document.hidden) return;
      var first = track.firstElementChild;
      if (!first) return;
      busy = true;
      var distance = first.getBoundingClientRect().width + gap;
      track.classList.add('is-animating');
      track.style.transform = 'translateX(' + (-distance) + 'px)';

      var done = false;
      function finish(e) {
        if (done) return;
        if (e && e.target && e.target !== track) return;
        done = true;
        track.removeEventListener('transitionend', finish);
        track.classList.remove('is-animating');
        track.style.transform = 'translateX(0)';
        track.appendChild(first);
        // force reflow so the next transition starts from 0
        void track.offsetWidth;
        busy = false;
      }
      track.addEventListener('transitionend', finish);
      setTimeout(finish, {{ s.slide_speed }} + 100);
    }

    function start() {
      if (timer) return;
      timer = setInterval(step, INTERVAL);
    }
    function stop() {
      if (timer) { clearInterval(timer); timer = null; }
    }

    viewport.addEventListener('mouseenter', function () { paused = true; });
    viewport.addEventListener('mouseleave', function () { paused = false; });
    viewport.addEventListener('focusin', function () { paused = true; });
    viewport.addEventListener('focusout', function () { paused = false; });
    document.addEventListener('visibilitychange', function () {
      if (document.hidden) stop(); else start();
    });

    var resizeT;
    window.addEventListener('resize', function () {
      clearTimeout(resizeT);
      resizeT = setTimeout(function () {
        gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 0;
        fill();
      }, 150);
    });

    if (document.addEventListener) {
      document.addEventListener('shopify:section:unload', function (e) {
        if (e.detail && e.detail.sectionId === '{{ sid }}') stop();
      });
    }

    start();
  })();
</script>

{% schema %}
{
  "name": "Trust banner",
  "class": "section-trust-banner",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Top row"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo mark",
      "info": "Use a light version of the logo so it shows on the dark panel. PNG or SVG with a transparent background."
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 20,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Logo height (desktop)",
      "default": 44
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Logo height (mobile)",
      "default": 30
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "info": "Press Enter to force a line break.",
      "default": "Inositol,\nwith nothing hidden."
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 28,
      "max": 96,
      "step": 2,
      "unit": "px",
      "label": "Heading size (desktop)",
      "default": 64
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 22,
      "max": 56,
      "step": 2,
      "unit": "px",
      "label": "Heading size (mobile)",
      "default": 36
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" }
      ],
      "default": "300"
    },
    {
      "type": "richtext",
      "id": "blurb",
      "label": "Right-side text",
      "default": "<p>No fillers. No flavoring. No mystery sourcing.</p><p>Just 4,000mg Myo + 100mg D-Chiro inositol per serving, at 40:1, from carob.</p>"
    },
    {
      "type": "header",
      "content": "Proof strip carousel"
    },
    {
      "type": "range",
      "id": "slide_interval",
      "min": 2,
      "max": 8,
      "step": 0.5,
      "unit": "s",
      "label": "Seconds between slides",
      "default": 3.5
    },
    {
      "type": "range",
      "id": "slide_speed",
      "min": 300,
      "max": 1200,
      "step": 100,
      "unit": "ms",
      "label": "Slide animation duration",
      "default": 600
    },
    {
      "type": "range",
      "id": "item_size",
      "min": 13,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Item text size",
      "default": 17
    },
    {
      "type": "range",
      "id": "item_gap",
      "min": 20,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Space between items",
      "default": 48
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Panel background",
      "default": "#1A2874"
