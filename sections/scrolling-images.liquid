{{- 'scrolling-images.css' | asset_url | stylesheet_tag -}}
{%- liquid
  assign speed = section.settings.speed
  assign direction = section.settings.direction
  assign column_spacing = section.settings.column_spacing
  assign image_alignment = section.settings.image_alignment
  assign image_ratio = section.settings.image_ratio
  assign disable_top_spacing = section.settings.disable_top_spacing
  assign disable_bottom_spacing = section.settings.disable_bottom_spacing
  assign size = section.blocks.size | plus: 0
  assign static_mode = section.settings.static_mode
-%}
<div class="scrolling-images section-spacing{% if disable_top_spacing %} section-spacing--disable-top{% endif %}{% if disable_bottom_spacing %} section-spacing--disable-bottom{% endif %}" id="scrolling-images-{{ section.id }}">

  <!-- Scoped fixes: make text wrap and standardize image frame -->
  <style>
    /* Keep marquee behavior */
    #scrolling-images-{{ section.id }} .scrolling-images--inner {
      white-space: nowrap;
    }

    /* Each item becomes a small column; allow wrapping INSIDE the item */
    #scrolling-images-{{ section.id }} .scrolling-images--item {
      display: inline-flex;
      flex-direction: column;
      vertical-align: top;
      min-width: 260px;          /* allow children to shrink */
      max-width: 260px;      /* cap so text wraps; adjust to taste (240–320px) */
      white-space: normal !important; /* break nowrap inheritance */
    }

    /* Ensure link wrappers don't force single-line width */
    #scrolling-images-{{ section.id }} .scrolling-images--link {
      display: block;
      max-width: 100%;
    }

    /* Text wrapping for metafields */
    #scrolling-images-{{ section.id }} .scrolling-images--content,
    #scrolling-images-{{ section.id }} .scrolling-images--content *,
    #scrolling-images-{{ section.id }} h6,
    #scrolling-images-{{ section.id }} p {
      white-space: normal !important;
      overflow-wrap: anywhere;
      word-break: break-word;
      max-width: 100%;
      display: block;
    }
    #scrolling-images-{{ section.id }} .scrolling-images--heading { margin: 6px 0 4px; }
    #scrolling-images-{{ section.id }} .scrolling-images--desc p { margin: 0; }

    /* Image fill rules */
    #scrolling-images-{{ section.id }} .scrolling-images--image {
      width: 100% !important;
      height: auto !important; /* height from aspect-ratio wrapper */
    }
    #scrolling-images-{{ section.id }} .scrolling-images--image img {
      width: 100% !important;
      height: 100% !important;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    /* Make all images visually consistent when the setting is "Adapt" */
    #scrolling-images-{{ section.id }} .scrolling-images--image.aspect-ratio.aspect-ratio--adapt {
      --ratio-percent: 100% !important; /* 1:1 square frame */
    }
    /* If you prefer a different shape, change the line above to:
       66.666% (3:2), 75% (4:3), 56.25% (16:9), etc. */

    /* Edge fades: above the track (track is z-index 10) */
    #scrolling-images-{{ section.id }} .si-fade {
      position: absolute;
      top: 0;
      bottom: 0;
      width: 150px;
      pointer-events: none;
      z-index: 20;
    }
    #scrolling-images-{{ section.id }} .si-fade--r {
      right: 0;
      background: linear-gradient(to left, rgb({{ section.settings.static_fade.rgb | replace: ' ', ',' }}), rgba({{ section.settings.static_fade.rgb | replace: ' ', ',' }}, 0));
    }
    #scrolling-images-{{ section.id }} .si-fade--l {
      left: 0;
      background: linear-gradient(to right, rgb({{ section.settings.static_fade.rgb | replace: ' ', ',' }}), rgba({{ section.settings.static_fade.rgb | replace: ' ', ',' }}, 0));
    }
    @media screen and (max-width: 749px) {
      #scrolling-images-{{ section.id }} .si-fade { width: 80px; }
    }

    {%- if static_mode -%}
    /* Static row mode: manual scroll, rounded cards, edge fade + arrow */
    #scrolling-images-{{ section.id }} { position: relative; }
    #scrolling-images-{{ section.id }} .scrolling-images--inner {
      animation: none !important;
      overflow-x: auto;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    #scrolling-images-{{ section.id }} .scrolling-images--inner::-webkit-scrollbar { display: none; }
    #scrolling-images-{{ section.id }} .scrolling-images--inner > div {
      animation: none !important;
      gap: {{ section.settings.static_gap }}px;
      align-items: flex-start;
    }
    #scrolling-images-{{ section.id }} .scrolling-images--item {
      margin: 0 !important;
      min-width: {{ section.settings.static_card_width }}px !important;
      max-width: {{ section.settings.static_card_width }}px !important;
    }
    #scrolling-images-{{ section.id }} .scrolling-images--image { border-radius: 14px; overflow: hidden; }
    #scrolling-images-{{ section.id }} .scrolling-images--content { margin-top: 14px; }
    #scrolling-images-{{ section.id }} .scrolling-images--heading {
      font-size: 17px !important;
      font-weight: var(--font-body-bold-weight, 500) !important;
      line-height: 1.35;
      letter-spacing: 0;
      text-transform: none;
      color: {{ section.settings.static_heading_color }} !important;
      margin: 0 0 5px !important;
    }
    #scrolling-images-{{ section.id }} .scrolling-images--desc,
    #scrolling-images-{{ section.id }} .scrolling-images--desc p {
      font-size: 14px;
      line-height: 1.5;
      color: {{ section.settings.static_text_color }};
      margin: 0;
    }
    #scrolling-images-{{ section.id }} .si-arrow {
      position: absolute;
      right: 18px;
      top: 50%;
      transform: translateY(-50%);
      z-index: 21;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 1px solid {{ section.settings.static_arrow_color }};
      color: {{ section.settings.static_arrow_color }};
      background: transparent;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      transition: opacity .2s;
    }
    #scrolling-images-{{ section.id }} .si-arrow svg { width: 18px; height: 18px; display: block; }
    #scrolling-images-{{ section.id }} .si-arrow.is-done { opacity: 0; pointer-events: none; }
    @media screen and (max-width: 749px) {
      #scrolling-images-{{ section.id }} .scrolling-images--item {
        min-width: {{ section.settings.static_card_width | times: 0.78 | round }}px !important;
        max-width: {{ section.settings.static_card_width | times: 0.78 | round }}px !important;
      }
      #scrolling-images-{{ section.id }} .si-arrow { width: 38px; height: 38px; right: 10px; }
    }
    {%- endif -%}
  </style>

  <div class="scrolling-images--inner scrolling-images--{{ image_alignment }} direction-{{ direction }} scrolling-images--spacing-{{ column_spacing }}" style="--marquee-speed: {{ speed }}">
    {% capture scrolling_text %}
      <div>
        {%- for i in (1..size) -%}
          {% assign index = i | minus: 1 %}
          <div class="scrolling-images--item" {{ section.blocks[index].shopify_attributes }}>
            {%- if section.blocks[index].settings.link -%}
              <a href="{{ section.blocks[index].settings.link }}" target="_blank" class="scrolling-images--link">
            {%- endif -%}
            {%- liquid
              assign image = section.blocks[index].settings.image
              assign ratio = 1
              if image_ratio == 'adapt' and image
                assign ratio = image.aspect_ratio
              endif

              assign width = '300'
              assign sizes = '300x'
              if image
                assign sizes = image.src.width | append: 'x' | append: image.src.height
                assign width = image.width | divided_by: 2
              endif
            -%}

            <!-- IMPORTANT: removed the inline "width: {{ width }}px" so CSS can size it -->
            <div class="scrolling-images--image aspect-ratio aspect-ratio--{{ image_ratio }}" style="--ratio-percent:{{ 1.0 | divided_by: ratio | times: 100.0 }}%;">
              {%- if image -%}
                {%- render 'responsive-image', image: image, sizes: sizes, retina: 1 -%}
              {%- else -%}
              <div class="thb-placeholder">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
              {%- endif -%}
            </div>

            {%- if section.blocks[index].settings.link -%}
              </a>
            {%- endif -%}

            {%- if section.blocks[index].settings.heading or section.blocks[index].settings.text -%}
            <div class="scrolling-images--content">
              {%- if section.blocks[index].settings.heading -%}
                <h6 class="scrolling-images--heading">{{ section.blocks[index].settings.heading }}</h6>
              {%- endif -%}
              {%- if section.blocks[index].settings.text -%}
                <div class="scrolling-images--desc">{{ section.blocks[index].settings.text }}</div>
              {%- endif -%}
            </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {% endcapture %}
    {{ scrolling_text }}{% unless static_mode %}{{ scrolling_text }}{% endunless %}
  </div>
  {%- if static_mode == false and section.settings.edge_fade -%}
    <div class="si-fade si-fade--l" aria-hidden="true"></div>
    <div class="si-fade si-fade--r" aria-hidden="true"></div>
  {%- endif -%}
  {%- if static_mode -%}
    <div class="si-fade si-fade--r" aria-hidden="true"></div>
    <button type="button" class="si-arrow" aria-label="Scroll right">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="12" x2="19" y2="12"></line><polyline points="13 6 19 12 13 18"></polyline></svg>
    </button>
    <script>
    (function(){
      var root = document.getElementById('scrolling-images-{{ section.id }}');
      if(!root) return;
      var inner = root.querySelector('.scrolling-images--inner');
      var arrow = root.querySelector('.si-arrow');
      if(!inner || !arrow) return;
      function step(){
        var item = inner.querySelector('.scrolling-images--item');
        return item ? item.getBoundingClientRect().width + 24 : 300;
      }
      arrow.addEventListener('click', function(){ inner.scrollBy({ left: step(), behavior: 'smooth' }); });
      function check(){
        var done = inner.scrollLeft + inner.clientWidth >= inner.scrollWidth - 10;
        arrow.classList.toggle('is-done', done);
      }
      inner.addEventListener('scroll', check, { passive: true });
      window.addEventListener('resize', check);
      check();
    })();
    </script>
  {%- endif -%}
</div>

{% schema %}
  {
    "name": "Scrolling images",
    "class": "section-scrolling-images",
    "settings": [
      {
        "type": "select",
        "id": "image_ratio",
        "options": [
          { "value": "adapt", "label": "Adapt to image" },
          { "value": "portrait", "label": "Portrait" },
          { "value": "landscape", "label": "Landscape" },
          { "value": "square", "label": "Square" }
        ],
        "default": "adapt",
        "label": "Image ratio"
      },
      {
        "type": "select",
        "id": "column_spacing",
        "options": [
          { "value": "none", "label": "None" },
          { "value": "small", "label": "Small" },
          { "value": "medium", "label": "Medium" },
          { "value": "large", "label": "Large" }
        ],
        "default": "small",
        "label": "Column spacing"
      },
      {
        "type": "select",
        "id": "image_alignment",
        "options": [
          { "value": "top", "label": "Top" },
          { "value": "center", "label": "Center" },
          { "value": "bottom", "label": "Bottom" }
        ],
        "default": "top",
        "label": "Vertical alignment"
      },
      {
        "type": "select",
        "id": "direction",
        "options": [
          { "value": "left", "label": "Left" },
          { "value": "right", "label": "Right" }
        ],
        "default": "left",
        "label": "Direction"
      },
      {
        "type": "select",
        "id": "speed",
        "options": [
          { "value": "10s", "label": "Fast" },
          { "value": "20s", "label": "Normal" },
          { "value": "30s", "label": "Slow" },
          { "value": "50s", "label": "Very slow" }
        ],
        "default": "20s",
        "label": "Speed"
      },
      { "type": "header", "content": "Edge fades" },
      { "type": "color", "id": "static_fade", "label": "Fade color", "default": "#f2eeea", "info": "Match the section background. Used in both modes." },
      { "type": "checkbox", "id": "edge_fade", "default": false, "label": "Fades on auto-scroll (both sides)" },
      { "type": "header", "content": "Static row mode" },
      { "type": "checkbox", "id": "static_mode", "default": false, "label": "Static row (no auto-scroll)", "info": "Rounded cards scrolled by swipe or the arrow, with a right edge fade." },
      { "type": "range", "id": "static_card_width", "label": "Card width", "min": 200, "max": 360, "step": 10, "unit": "px", "default": 280 },
      { "type": "range", "id": "static_gap", "label": "Card spacing", "min": 12, "max": 48, "step": 2, "unit": "px", "default": 28 },
      { "type": "color", "id": "static_arrow_color", "label": "Arrow color", "default": "#1b3def" },
      { "type": "color", "id": "static_heading_color", "label": "Card heading color", "default": "#1a2874" },
      { "type": "color", "id": "static_text_color", "label": "Card text color", "default": "#1a2874" },
      { "type": "header", "content": "Spacing" },
      { "type": "checkbox", "id": "disable_top_spacing", "default": false, "label": "Remove top spacing" },
      { "type": "checkbox", "id": "disable_bottom_spacing", "default": false, "label": "Remove bottom spacing" }
    ],
    "blocks": [
      {
        "type": "image",
        "name": "Image",
        "settings": [
          { "type": "image_picker", "id": "image", "label": "Image" },
          { "id": "link", "type": "url", "label": "Image link" },
          { "type": "text", "id": "heading", "label": "Heading", "default": "Heading" },
          { "type": "richtext", "id": "text", "label": "Description", "default": "<p>Add description text here.</p>" }
        ]
      }
    ],
    "presets": [
      { "name": "Scrolling images", "blocks": [ { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" } ] }
    ]
  }
{% endschema %}
