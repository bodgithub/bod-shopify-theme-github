{%- comment -%}
  BODOLOGY · Clinical Columns
  Full-width row of up to five rounded cards (Always / Never style):
  each card has a centered title flanked by optional glyphs (check,
  cross, or a custom image) and a centered list of items that can flow
  into 1–3 internal columns. Styled to match the clinical pages; every
  color and size is a setting. Cards inherit the section card style,
  with an optional per-card background override.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign cols = section.blocks.size
  if cols > 5
    assign cols = 5
  endif
-%}

{% style %}
  #shopify-section-{{ section.id }} .clc {
    width: 100%;
    background: {{ s.section_bg }};
    padding-top: {{ s.padding_top_mobile }}px;
    padding-bottom: {{ s.padding_bottom_mobile }}px;
    font-family: "tenon", sans-serif;
    color: {{ s.text_color }};
  }
  #shopify-section-{{ section.id }} .clc__pw {
    max-width: {{ s.page_width }}px;
    margin: 0 auto;
    padding: 0 16px;
  }
  #shopify-section-{{ section.id }} .clc__heading {
    text-align: center;
    font-size: {{ s.heading_size }}px;
    font-weight: 400;
    line-height: 1.2;
    margin: 0 0 24px;
    padding: 10px 16px;
    color: {{ s.title_color }};
  }
  #shopify-section-{{ section.id }} .clc__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }
  #shopify-section-{{ section.id }} .clc__card {
    background: var(--clc-card-bg, {{ s.card_bg }});
    {% if s.card_border != blank %}border: 1px solid {{ s.card_border }};{% endif %}
    border-radius: {{ s.card_radius }}px;
    padding: 28px 22px 30px;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .clc__topicon {
    width: {{ s.top_icon_size }}px;
    height: {{ s.top_icon_size }}px;
    margin: 0 auto 12px;
  }
  #shopify-section-{{ section.id }} .clc__topicon { color: {{ s.icon_color }}; }
  #shopify-section-{{ section.id }} .clc__topicon img { width: 100%; height: 100%; object-fit: contain; display: block; }
  #shopify-section-{{ section.id }} .clc__topicon svg { width: 100%; height: 100%; display: block; }
  #shopify-section-{{ section.id }} .clc__topicon svg [stroke]:not([stroke="none"]) { stroke: currentColor; }
  #shopify-section-{{ section.id }} .clc__topicon svg [fill]:not([fill="none"]) { fill: currentColor; }
  #shopify-section-{{ section.id }} .clc__glyph svg [stroke]:not([stroke="none"]) { stroke: currentColor; }
  #shopify-section-{{ section.id }} .clc__glyph svg [fill]:not([fill="none"]) { fill: currentColor; }
  #shopify-section-{{ section.id }} .clc__bottom {
    margin-top: 14px;
    font-size: {{ s.text_size | times: 0.93 | round }}px;
    line-height: 1.5;
    color: {{ s.text_color }};
  }
  #shopify-section-{{ section.id }} .clc__title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-size: {{ s.title_size }}px;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.2;
    color: {{ s.title_color }};
    margin: 0 0 18px;
  }
  #shopify-section-{{ section.id }} .clc__glyph {
    display: inline-flex;
    flex: 0 0 auto;
    width: 0.75em;
    height: 0.75em;
  }
  #shopify-section-{{ section.id }} .clc__glyph svg { width: 100%; height: 100%; display: block; }
  #shopify-section-{{ section.id }} .clc__glyph img { width: 100%; height: 100%; object-fit: contain; display: block; }
  #shopify-section-{{ section.id }} .clc__items {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    column-gap: 28px;
    font-size: {{ s.text_size }}px;
    line-height: 1.9;
    color: {{ s.text_color }};
    max-width: 92%;
  }
  #shopify-section-{{ section.id }} .clc__items li { break-inside: avoid; line-height: 1em; padding: 0.45em 0; }
  #shopify-section-{{ section.id }} .clc__footer {
    text-align: center;
    font-size: {{ s.footer_size }}px;
    line-height: 1.6;
    color: {{ s.text_color }};
    margin-top: 22px;
  }
  #shopify-section-{{ section.id }} .clc__footer p { margin: 0 0 6px; }
  #shopify-section-{{ section.id }} .clc__footer p:last-child { margin-bottom: 0; }
  #shopify-section-{{ section.id }} .clc__footer a { color: inherit; text-decoration: underline; }
  {%- if s.hover_bg != blank -%}
  #shopify-section-{{ section.id }} .clc__card { transition: background .18s, transform .15s; }
  #shopify-section-{{ section.id }} .clc__card:hover { background: {{ s.hover_bg }}; }
  {%- endif -%}
  {%- if s.hover_title_color != blank -%}
  #shopify-section-{{ section.id }} .clc__card:hover .clc__title { color: {{ s.hover_title_color }}; }
  {%- endif -%}
  {%- if s.hover_text_color != blank -%}
  #shopify-section-{{ section.id }} .clc__card:hover .clc__items,
  #shopify-section-{{ section.id }} .clc__card:hover .clc__bottom { color: {{ s.hover_text_color }}; }
  {%- endif -%}
  {%- if s.hover_icon_color != blank -%}
  #shopify-section-{{ section.id }} .clc__card:hover .clc__topicon { color: {{ s.hover_icon_color }}; }
  {%- endif -%}
  {%- if s.enable_lightbox -%}
  #shopify-section-{{ section.id }} .clc__card--clickable { cursor: pointer; transition: background .18s, transform .15s; }
  #shopify-section-{{ section.id }} .clc__card--clickable:hover { transform: translateY(-2px); }
  {%- endif -%}
  #shopify-section-{{ section.id }} .clc-overlay { display: none; position: fixed; inset: 0; z-index: 21; background: rgba(242, 238, 234, 0.87); }
  #shopify-section-{{ section.id }} .clc-popup { display: none; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 2222; background: #e3e7ff; border: 1px solid #3447af; border-radius: 16px; overflow: hidden; padding: 32px 24px; width: 96%; max-width: 700px; max-height: 85dvh; overflow-y: auto; font-family: "tenon", sans-serif; }
  #shopify-section-{{ section.id }} .clc-overlay.is-open, #shopify-section-{{ section.id }} .clc-popup.is-open { display: block; }
  #shopify-section-{{ section.id }} .clc-popup__t { color: #1a2874; margin: 0 0 20px; text-align: center; font-size: 20px; font-weight: 400; line-height: 1.25; }
  #shopify-section-{{ section.id }} .clc-popup__b { color: {{ s.text_color }}; font-size: 12px; line-height: 1.6; text-align: center; }
  #shopify-section-{{ section.id }} .clc-popup__b h1,
  #shopify-section-{{ section.id }} .clc-popup__b h2,
  #shopify-section-{{ section.id }} .clc-popup__b h3,
  #shopify-section-{{ section.id }} .clc-popup__b h4,
  #shopify-section-{{ section.id }} .clc-popup__b h5,
  #shopify-section-{{ section.id }} .clc-popup__b h6 { color: {{ s.text_color }}; font-family: "tenon", sans-serif; margin: 0 0 10px; }
  #shopify-section-{{ section.id }} .clc-popup__b p,
  #shopify-section-{{ section.id }} .clc-popup__b li { color: {{ s.text_color }}; }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .clc-popup__t { font-size: 36px; }
    #shopify-section-{{ section.id }} .clc-popup__b { font-size: 18px; padding: 0 24px; }
  }
  #shopify-section-{{ section.id }} .clc-popup__b p { margin: 0; padding-bottom: 6px; }
  #shopify-section-{{ section.id }} .clc-popup__close { display: block; margin: 14px auto 0; color: #1a2874; font-size: 14px; text-decoration: underline; cursor: pointer; background: none; border: 0; padding: 0; font-family: inherit; }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .clc {
      padding-top: {{ s.padding_top_desktop }}px;
      padding-bottom: {{ s.padding_bottom_desktop }}px;
    }
    #shopify-section-{{ section.id }} .clc__footer { padding: {{ s.footer_pad }}% {{ s.footer_pad }}% 0; }
    #shopify-section-{{ section.id }} .clc__grid { grid-template-columns: repeat({% if cols > 1 %}2{% else %}1{% endif %}, 1fr); }
  }
  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .clc__grid { grid-template-columns: repeat({% if s.columns_desktop > 0 %}{{ s.columns_desktop }}{% else %}{{ cols | at_least: 1 }}{% endif %}, 1fr); }
  }
{% endstyle %}

<div class="clc">
  <div class="clc__pw">
    {%- if s.heading != blank -%}
      <h2 class="clc__heading">{{ s.heading }}</h2>
    {%- endif -%}
    <div class="clc__grid">
      {%- for block in section.blocks limit: 5 -%}
        {%- liquid
          assign bs = block.settings
          assign glyph = bs.icon | default: 'none'
        -%}
        <div class="clc__card{% if s.enable_lightbox and bs.lightbox_text != blank %} clc__card--clickable{% endif %}" {% if bs.card_bg != blank %}style="--clc-card-bg: {{ bs.card_bg }};"{% endif %}{% if s.enable_lightbox and bs.lightbox_text != blank %} data-clc-open="{{ block.id }}" role="button" tabindex="0"{% endif %} {{ block.shopify_attributes }}>
          {%- if bs.top_icon_svg != blank -%}
            <div class="clc__topicon" aria-hidden="true">{{ bs.top_icon_svg }}</div>
          {%- elsif bs.top_icon != blank -%}
            <div class="clc__topicon">{{ bs.top_icon | image_url: width: 128 | image_tag: alt: '', loading: 'lazy' }}</div>
          {%- endif -%}
          {%- if bs.title != blank -%}
            <h3 class="clc__title">
              {%- capture glyph_html -%}
                {%- if glyph == 'check' -%}
                  <span class="clc__glyph"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5l5.5 5.5L20 6.5"/></svg></span>
                {%- elsif glyph == 'cross' -%}
                  <span class="clc__glyph"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></span>
                {%- elsif glyph == 'image' and bs.icon_image != blank -%}
                  <span class="clc__glyph">{{ bs.icon_image | image_url: width: 64 | image_tag: alt: '', loading: 'lazy' }}</span>
                {%- elsif glyph == 'svg' and bs.icon_svg != blank -%}
                  <span class="clc__glyph" aria-hidden="true">{{ bs.icon_svg }}</span>
                {%- endif -%}
              {%- endcapture -%}
              {{ glyph_html }}<span>{{ bs.title }}</span>{{ glyph_html }}
            </h3>
          {%- endif -%}
          {%- assign items = bs.items | newline_to_br | split: '<br />' -%}
          {%- assign has_items = false -%}
          {%- for it in items -%}{%- assign t = it | strip -%}{%- if t != blank -%}{%- assign has_items = true -%}{%- endif -%}{%- endfor -%}
          {%- if has_items -%}
            <ul class="clc__items" {% if bs.item_columns > 1 %}style="column-count: {{ bs.item_columns }};"{% endif %}>
              {%- for it in items -%}
                {%- assign t = it | strip -%}
                {%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
          {%- if bs.bottom_text != blank -%}
            <div class="clc__bottom">{{ bs.bottom_text }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if s.footer_text != blank -%}
      <div class="clc__footer">{{ s.footer_text }}</div>
    {%- endif -%}
  </div>
  {%- if s.enable_lightbox -%}
  <div class="clc-overlay" data-clc-overlay></div>
  {%- for block in section.blocks limit: 5 -%}
    {%- if block.settings.lightbox_text != blank -%}
      <div class="clc-popup" data-clc-popup="{{ block.id }}" role="dialog" aria-modal="true" aria-label="{{ block.settings.title | escape }}">
        <div class="clc-popup__b">{{ block.settings.lightbox_text }}</div>
        <button type="button" class="clc-popup__close" data-clc-close>Close</button>
      </div>
    {%- endif -%}
  {%- endfor -%}
  {%- endif -%}
</div>

{%- if s.enable_lightbox -%}
<script>
  (function () {
    function init() {
      var root = document.getElementById('shopify-section-{{ section.id }}');
      if (!root || root.dataset.clcInit === 'true') return;
      root.dataset.clcInit = 'true';
      var overlay = root.querySelector('[data-clc-overlay]');
      var popups = root.querySelectorAll('[data-clc-popup]');
      function closeAll(){ if(overlay) overlay.classList.remove('is-open'); popups.forEach(function(p){ p.classList.remove('is-open'); }); }
      root.querySelectorAll('[data-clc-open]').forEach(function (card) {
        function open(){ var t = root.querySelector('[data-clc-popup="' + card.getAttribute('data-clc-open') + '"]'); if (t && overlay) { overlay.classList.add('is-open'); t.classList.add('is-open'); } }
        card.addEventListener('click', open);
        card.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); } });
      });
      if (overlay) overlay.addEventListener('click', closeAll);
      root.querySelectorAll('[data-clc-close]').forEach(function (b) { b.addEventListener('click', closeAll); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeAll(); });
    }
    if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', init); } else { init(); }
    if (typeof window.Shopify !== 'undefined' && window.Shopify.designMode) {
      document.addEventListener('shopify:section:load', function (e) {
        if (e.detail && e.detail.sectionId === '{{ section.id }}') { var r = document.getElementById('shopify-section-{{ section.id }}'); if (r) r.dataset.clcInit = ''; init(); }
      });
    }
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Clinical columns",
  "tag": "section",
  "class": "section-clinical-columns",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  },
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "info": "Optional — leave blank to hide."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Section heading size",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "checkbox",
      "id": "enable_lightbox",
      "label": "Open a lightbox when a module is clicked",
      "default": false,
      "info": "Modules with lightbox text become clickable and open a popup."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#f2eeea"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Module background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Module border",
      "info": "Leave unset for no border."
    },
    {
      "type": "color",
      "id": "hover_bg",
      "label": "Module hover color",
      "info": "Leave unset for no hover color."
    },
    {
      "type": "color",
      "id": "hover_title_color",
      "label": "Title hover color",
      "info": "Leave unset for no change on hover."
    },
    {
      "type": "color",
      "id": "hover_text_color",
      "label": "Text hover color",
      "info": "Leave unset for no change on hover."
    },
    {
      "type": "color",
      "id": "hover_icon_color",
      "label": "Icon hover color",
      "info": "Applies to pasted SVG icons. Leave unset for no change."
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title & icons",
      "default": "#1b3def"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Top icons (SVG)",
      "default": "#1b3def"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "List text",
      "default": "#1a2874"
    },
    {
      "type": "header",
      "content": "Sizes"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Module title size",
      "min": 14,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "List text size",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "top_icon_size",
      "label": "Top icon size",
      "min": 24,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Module corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Text below the modules"
    },
    {
      "type": "richtext",
      "id": "footer_text",
      "label": "Text",
      "info": "Shown centered under the modules. Italics render in the Instrument serif."
    },
    {
      "type": "range",
      "id": "footer_size",
      "label": "Text size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "footer_pad",
      "label": "Padding top & sides (desktop)",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "%",
      "default": 0,
      "info": "One value applied to the top and evenly to both sides, desktop only."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 0,
      "info": "0 = one column per module. Set a number to wrap extra modules onto new rows."
    },
    {
      "type": "range",
      "id": "page_width",
      "label": "Max content width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1300
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "top_icon",
          "label": "Icon above the title",
          "info": "Transparent PNG or SVG, ~128 × 128px."
        },
        {
          "type": "textarea",
          "id": "top_icon_svg",
          "label": "Or paste SVG code for the top icon",
          "info": "Inline <svg> markup; recolorable via the icon color settings. Takes priority over the image."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Always"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icons beside the title",
          "default": "none",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "check",
              "label": "Check"
            },
            {
              "value": "cross",
              "label": "Cross"
            },
            {
              "value": "image",
              "label": "Custom image"
            },
            {
              "value": "svg",
              "label": "Custom SVG (paste below)"
            }
          ]
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom icon image"
        },
        {
          "type": "textarea",
          "id": "icon_svg",
          "label": "Custom SVG for title glyphs",
          "info": "Used when Icons beside the title is set to Custom SVG."
        },
        {
          "type": "textarea",
          "id": "items",
          "label": "List items (one per line)"
        },
        {
          "type": "range",
          "id": "item_columns",
          "label": "List columns inside the module",
          "min": 1,
          "max": 4,
          "step": 1,
          "default": 1
        },
        {
          "type": "inline_richtext",
          "id": "bottom_text",
          "label": "Bottom line",
          "info": "Small line under the list. Italics render in the Instrument serif."
        },
        {
          "type": "richtext",
          "id": "lightbox_text",
          "label": "Lightbox text",
          "info": "Shown in the popup when the module is clicked (needs the section's lightbox toggle on)."
        },
        {
          "type": "color",
          "id": "card_bg",
          "label": "Module background override",
          "info": "Leave unset to use the section's module background."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Clinical columns",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "title": "Always",
            "icon": "check",
            "items": "Vegan\nGluten-free\nNon-GMO\nThird-party tested\nMade in the USA\nUnflavored\n40:1 ratio",
            "item_columns": 2
          }
        },
        {
          "type": "column",
          "settings": {
            "title": "Never",
            "icon": "cross",
            "items": "Fillers\nFlavoring\nSweeteners\nCorn-derived D-chiro\nGMOs",
            "item_columns": 2
          }
        }
      ]
    }
  ]
}
{% endschema %}
