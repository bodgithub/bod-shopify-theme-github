      "info": "Columns with popup text become clickable and open the standard popup."
    },
    {
      "type": "header",
      "content": "Footer"
    },
    {
      "type": "richtext",
      "id": "footer_text",
      "label": "Footer text",
      "info": "Shown centered below the columns."
    },
    {
      "type": "range",
      "id": "footer_size",
      "label": "Footer text size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "footer_pad_top",
      "label": "Footer padding top (desktop)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "footer_pad",
      "label": "Footer padding sides (desktop)",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "%",
      "default": 0
    },
    {
      "type": "checkbox",
