{%- comment -%}
  Bodology · Category list grid
  Heading with italic accent, optional quote + avatar row, then a ruled
  grid of list columns (title, small count label, items) plus an optional
  tinted highlight cell with a pill link. Clinical palette by default.
  Items: one per line; start a line with ~ to render it dimmed.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign cols = s.columns_desktop | default: 3
-%}

{% style %}
  #shopify-section-{{ section.id }} .clg {
    background: {{ s.bg }};
    color: {{ s.text_color }};
    padding: {{ s.padding_top }}px 0 {{ s.padding_bottom }}px;
    margin: {{ s.margin_top }}px 0 {{ s.margin_bottom }}px;
  }
  #shopify-section-{{ section.id }} .clg__pw {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  #shopify-section-{{ section.id }} .clg__heading {
    text-align: center;
    color: {{ s.heading_color }};
    margin: 0;
    {% if s.heading_size > 0 %}font-size: {{ s.heading_size }}px;{% endif %}
    line-height: 1.15;
    font-weight: 400;
  }
  #shopify-section-{{ section.id }} .clg__heading em { color: {{ s.accent_color }}; }
  #shopify-section-{{ section.id }} .clg__quote {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 18px;
    max-width: 640px;
    margin: 26px auto 0;
  }
  #shopify-section-{{ section.id }} .clg__quote-text {
    flex: 1 1 260px;
    font-size: 13px;
    line-height: 1.55;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .clg__quote-who {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 0 0 auto;
    text-align: left;
  }
  #shopify-section-{{ section.id }} .clg__avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }
  #shopify-section-{{ section.id }} .clg__who-name { font-size: 13px; font-weight: var(--font-body-bold-weight, 500); margin: 0; }
  #shopify-section-{{ section.id }} .clg__who-role { font-size: 12.5px; margin: 0; opacity: .85; }
  #shopify-section-{{ section.id }} .clg__grid {
    display: grid;
    grid-template-columns: repeat({{ cols }}, 1fr);
    margin-top: 44px;
  }
  #shopify-section-{{ section.id }} .clg__cell {
    padding: 34px 30px 40px;
    border-top: 1px solid {{ s.line_color }};
    border-left: 1px solid {{ s.line_color }};
    min-width: 0;
  }
  #shopify-section-{{ section.id }} .clg__cell:nth-child({{ cols }}n + 1) { border-left: 0; }
  #shopify-section-{{ section.id }} .clg__title {
    margin: 0;
    font-size: {{ s.title_size }}px;
    line-height: 1.15;
    font-weight: 400;
    color: {{ s.text_color }};
  }
  #shopify-section-{{ section.id }} .clg__count {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 12px;
    font-size: 12px;
    letter-spacing: 0.02em;
    color: {{ s.accent_color }};
  }
  #shopify-section-{{ section.id }} .clg__count svg { width: 10px; height: 12px; display: block; }
  #shopify-section-{{ section.id }} .clg__items {
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
    font-size: {{ s.item_size }}px;
    line-height: 1.6;
  }
  #shopify-section-{{ section.id }} .clg__items li { padding: 3px 0; }
  #shopify-section-{{ section.id }} .clg__items li.is-dim { opacity: .45; }
  #shopify-section-{{ section.id }} .clg__hl-line {
    margin: 0 0 18px;
    font-size: {{ s.title_size | times: 0.86 | round }}px;
    line-height: 1.3;
    color: {{ s.accent_color }};
  }
  #shopify-section-{{ section.id }} .clg__btn {
    display: inline-block;
    margin-top: 10px;
    padding: 10px 22px;
    border: 1px solid {{ s.accent_color }};
    border-radius: 999px;
    color: {{ s.accent_color }};
    font-size: 13.5px;
    text-decoration: none;
    background: transparent;
    transition: background .15s, color .15s;
  }
  #shopify-section-{{ section.id }} .clg__btn:hover { background: {{ s.accent_color }}; color: #ffffff; }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .clg__grid { grid-template-columns: 1fr; }
    #shopify-section-{{ section.id }} .clg__cell { border-left: 0; padding: 28px 4px 32px; }
    #shopify-section-{{ section.id }} .clg__title { font-size: {{ s.title_size | times: 0.82 | round }}px; }
  }
{% endstyle %}

<div class="clg">
  <div class="clg__pw">
    {%- if s.heading != blank -%}
      <h2 class="clg__heading{% if s.heading_size == 0 %} h1{% endif %}">{{ s.heading }}</h2>
    {%- endif -%}

    {%- if s.quote_text != blank or s.quote_name != blank -%}
      <div class="clg__quote">
        {%- if s.quote_text != blank -%}
          <p class="clg__quote-text">&ldquo;{{ s.quote_text }}&rdquo;</p>
        {%- endif -%}
        {%- if s.quote_name != blank or s.quote_image != blank -%}
          <div class="clg__quote-who">
            {%- if s.quote_image != blank -%}
              <img class="clg__avatar" src="{{ s.quote_image | image_url: width: 88 }}" alt="{{ s.quote_name | escape }}" width="44" height="44" loading="lazy">
            {%- endif -%}
            <div>
              {%- if s.quote_name != blank -%}<p class="clg__who-name">{{ s.quote_name }}</p>{%- endif -%}
              {%- if s.quote_role != blank -%}<p class="clg__who-role">{{ s.quote_role }}</p>{%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="clg__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'column' -%}
            <div class="clg__cell" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <h3 class="clg__title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.count_text != blank -%}
                <div class="clg__count">
                  {%- if s.show_count_icon -%}
                    <svg viewBox="0 0 10 12" fill="currentColor" aria-hidden="true"><rect x="0" y="0" width="4" height="12" rx="1"></rect><rect x="6" y="0" width="4" height="12" rx="1"></rect></svg>
                  {%- endif -%}
                  <span>{{ block.settings.count_text }}</span>
                </div>
              {%- endif -%}
              {%- if block.settings.items != blank -%}
                <ul class="clg__items">
                  {%- assign lines = block.settings.items | newline_to_br | split: '<br />' -%}
                  {%- for line in lines -%}
                    {%- assign t = line | strip -%}
                    {%- if t != blank -%}
                      {%- if t contains '~' and t.first == '~' -%}
                        <li class="is-dim">{{ t | remove_first: '~' | strip }}</li>
                      {%- else -%}
                        <li>{{ t }}</li>
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- when 'highlight' -%}
            <div class="clg__cell" style="background: {{ block.settings.bg }};" {{ block.shopify_attributes }}>
              {%- if block.settings.line_1 != blank -%}<p class="clg__hl-line">{{ block.settings.line_1 }}</p>{%- endif -%}
              {%- if block.settings.line_2 != blank -%}<p class="clg__hl-line">{{ block.settings.line_2 }}</p>{%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <a class="clg__btn" href="{{ block.settings.button_link | default: '#' }}">{{ block.settings.button_label }}</a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Category list grid",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "160+ lab tests <em>chosen by top doctors</em>",
      "info": "Italics render in the Instrument serif and use the accent color."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 0,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme H1 size."
    },
    {
      "type": "header",
      "content": "Quote row"
    },
    {
      "type": "text",
      "id": "quote_text",
      "label": "Quote"
    },
    {
      "type": "image_picker",
      "id": "quote_image",
      "label": "Avatar"
    },
    {
      "type": "text",
      "id": "quote_name",
      "label": "Name"
    },
    {
      "type": "text",
      "id": "quote_role",
      "label": "Role"
    },
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_count_icon",
      "label": "Icon before count label",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#f2eeea"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1a2874"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#1b3def"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#1b3def",
      "info": "Italic heading text, count labels, highlight text, and the button."
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Grid lines",
      "default": "#3447af"
    },
    {
      "type": "header",
      "content": "Sizes and spacing"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Column title size",
      "min": 16,
      "max": 44,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "item_size",
      "label": "List text size",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "List column",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Title",
          "default": "Hormones &amp; thyroid"
        },
        {
          "type": "text",
          "id": "count_text",
          "label": "Count label",
          "default": "16 Biomarkers"
        },
        {
          "type": "textarea",
          "id": "items",
          "label": "Items",
          "info": "One per line. Start a line with ~ to dim it.",
          "default": "Thyroxine (T4) Free\nTestosterone, Total\nAnti-Mullerian Hormone\n~Thyroid-Stimulating Hormone (TSH)"
        }
      ]
    },
    {
      "type": "highlight",
      "name": "Highlight cell",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "line_1",
          "label": "Line 1",
          "default": "<em>+More</em>"
        },
        {
          "type": "inline_richtext",
          "id": "line_2",
          "label": "Line 2",
          "default": "<em>All-in-one lab testing</em>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "See all tests"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "color",
          "id": "bg",
          "label": "Cell background",
          "default": "#e3e7ff"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Category list grid",
      "blocks": [
        { "type": "column" },
        { "type": "column" },
        { "type": "column" }
      ]
    }
  ]
}
{% endschema %}
