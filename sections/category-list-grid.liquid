{%- comment -%}
  Bodology · Category list grid
  Heading with italic accent, optional quote + avatar row, then a ruled
  grid of list columns (title, small count label, items) plus an optional
  tinted highlight cell with a pill link. Clinical palette by default.
  Items: one per line; start a line with ~ to render it dimmed.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign cols = s.columns_desktop | default: 3
-%}

{% style %}
  #shopify-section-{{ section.id }} .clg {
    background: {{ s.bg }};
    color: {{ s.text_color }};
    padding: {{ s.padding_top }}px 0 {{ s.padding_bottom }}px;
    margin: {{ s.margin_top }}px 0 {{ s.margin_bottom }}px;
  }
  #shopify-section-{{ section.id }} .clg__pw {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  #shopify-section-{{ section.id }} .clg__heading {
    text-align: center;
    color: {{ s.heading_color }};
    margin: 0;
    {% if s.heading_size > 0 %}font-size: {{ s.heading_size }}px;{% endif %}
    line-height: 1.15;
    font-weight: 400;
  }
  #shopify-section-{{ section.id }} .clg__heading em { color: {{ s.accent_color }}; }
  #shopify-section-{{ section.id }} .clg__quote {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 18px;
    max-width: 640px;
    margin: 26px auto 0;
  }
  #shopify-section-{{ section.id }} .clg__quote-text {
    flex: 1 1 260px;
    font-size: 13px;
    line-height: 1.55;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .clg__quote-who {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 0 0 auto;
    text-align: left;
  }
  #shopify-section-{{ section.id }} .clg__avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }
  #shopify-section-{{ section.id }} .clg__who-name { font-size: 13px; font-weight: var(--font-body-bold-weight, 500); margin: 0; }
  #shopify-section-{{ section.id }} .clg__who-role { font-size: 12.5px; margin: 0; opacity: .85; }
  #shopify-section-{{ section.id }} .clg__grid {
    display: grid;
    grid-template-columns: repeat({{ cols }}, 1fr);
    margin-top: 44px;
  }
  #shopify-section-{{ section.id }} .clg__cell {
    padding: 34px 30px 40px;
    border-top: 1px solid {{ s.line_color }};
    border-left: 1px solid {{ s.line_color }};
    min-width: 0;
  }
  #shopify-section-{{ section.id }} .clg__cell:nth-child({{ cols }}n + 1) { border-left: 0; }
  #shopify-section-{{ section.id }} .clg__title {
    margin: 0;
    font-size: {{ s.title_size }}px;
    line-height: 1.15;
    font-weight: 400;
    color: {{ s.text_color }};
  }
  #shopify-section-{{ section.id }} .clg__count {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 20px;
    font-size: 12px;
    letter-spacing: 0.02em;
    color: {{ s.accent_color }};
  }
  #shopify-section-{{ section.id }} .clg__count svg { width: 13px; height: 13px; display: block; }
  #shopify-section-{{ section.id }} .clg__count img { width: 14px; height: 14px; object-fit: contain; display: block; }
  #shopify-section-{{ section.id }} .clg__items {
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
    font-size: {{ s.item_size }}px;
    line-height: 1.6;
  }
  #shopify-section-{{ section.id }} .clg__items li { padding: 3px 0; }
  #shopify-section-{{ section.id }} .clg__items li.is-dim { opacity: .45; }
  #shopify-section-{{ section.id }} .clg__hl-line {
    margin: 0 0 18px;
    font-size: {{ s.title_size | times: 0.86 | round }}px;
    line-height: 1.3;
    color: {{ s.accent_color }};
  }
  #shopify-section-{{ section.id }} .clg__btn {
    display: inline-block;
    margin-top: 10px;
    padding: 10px 22px;
    border: 1px solid {{ s.accent_color }};
    border-radius: 999px;
    color: {{ s.accent_color }};
    font-size: 13.5px;
    text-decoration: none;
    background: transparent;
    transition: background .15s, color .15s;
  }
  #shopify-section-{{ section.id }} .clg__btn:hover { background: {{ s.accent_color }}; color: #ffffff; }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .clg__grid { grid-template-columns: 1fr; }
    #shopify-section-{{ section.id }} .clg__cell { border-left: 0; padding: 28px 4px 32px; }
    #shopify-section-{{ section.id }} .clg__title { font-size: {{ s.title_size | times: 0.82 | round }}px; }
  }
  {%- if s.hover_bg != blank -%}
  #shopify-section-{{ section.id }} .clg__cell--col { transition: background .18s, transform .15s; }
  #shopify-section-{{ section.id }} .clg__cell--col:hover { background: {{ s.hover_bg | color_modify: 'alpha', 0.5 }}; }
  {%- if s.hover_text_color != blank -%}
  #shopify-section-{{ section.id }} .clg__cell--col:hover,
  #shopify-section-{{ section.id }} .clg__cell--col:hover .clg__title,
  #shopify-section-{{ section.id }} .clg__cell--col:hover .clg__count,
  #shopify-section-{{ section.id }} .clg__cell--col:hover .clg__items { color: {{ s.hover_text_color }} !important; }
  {%- endif -%}
  {%- endif -%}
  #shopify-section-{{ section.id }} .clg__cell--clickable { cursor: pointer; }
  #shopify-section-{{ section.id }} .clg__footer {
    text-align: center;
    font-size: {{ s.footer_size | default: 15 }}px;
    line-height: 1.6;
    color: {{ s.text_color }};
    margin-top: 22px;
  }
  #shopify-section-{{ section.id }} .clg__footer p { margin: 0 0 6px; }
  #shopify-section-{{ section.id }} .clg__footer p:last-child { margin-bottom: 0; }
  #shopify-section-{{ section.id }} .clg__footer a { color: inherit; text-decoration: underline; }
  {%- if s.footer_star -%}
  #shopify-section-{{ section.id }} .clg__footer p:last-child::after { content: '*'; font-size: 0.6em; vertical-align: super; line-height: 0; margin-left: 1px; }
  {%- endif -%}
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .clg__footer { padding: {{ s.footer_pad_top | default: 0 }}px {{ s.footer_pad | default: 0 }}% 0; }
  }
  {%- if s.enable_lightbox -%}
  #shopify-section-{{ section.id }} .clg-overlay { display: none; position: fixed; inset: 0; z-index: 2147482998; background: rgba(242, 238, 234, 0.87); }
  #shopify-section-{{ section.id }} .clg-popup { display: none; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 2147483000; background: #e3e7ff; border: 1px solid #3447af; border-radius: 16px; overflow: hidden; padding: 32px 24px; width: 96%; max-width: 700px; max-height: 85dvh; overflow-y: auto; font-family: "tenon", sans-serif; }
  #shopify-section-{{ section.id }} .clg-overlay.is-open, #shopify-section-{{ section.id }} .clg-popup.is-open { display: block; }
  #shopify-section-{{ section.id }} .clg-popup__b { color: {{ s.text_color }}; font-size: 12px; line-height: 1.6; text-align: center; }
  #shopify-section-{{ section.id }} .clg-popup__b :is(h1, h2, h3, h4, h5, h6) { color: {{ s.text_color }}; font-family: "tenon", sans-serif; margin: 0 0 10px; }
  #shopify-section-{{ section.id }} .clg-popup__b p, #shopify-section-{{ section.id }} .clg-popup__b li { color: {{ s.text_color }}; }
  #shopify-section-{{ section.id }} .clg-popup__b p { margin: 0; padding-bottom: 26px; }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .clg-popup__b { font-size: 18px; padding: 0 24px; }
  }
  #shopify-section-{{ section.id }} .clg-popup__close { display: block; margin: 14px auto 0; color: #1a2874; font-size: 14px; text-decoration: underline; cursor: pointer; background: none; border: 0; padding: 0; font-family: inherit; }
  {%- endif -%}
{% endstyle %}

<div class="clg">
  <div class="clg__pw">
    {%- if s.heading != blank -%}
      <h2 class="clg__heading{% if s.heading_size == 0 %} h1{% endif %}">{{ s.heading }}</h2>
    {%- endif -%}

    {%- if s.quote_text != blank or s.quote_name != blank -%}
      <div class="clg__quote">
        {%- if s.quote_text != blank -%}
          <p class="clg__quote-text">&ldquo;{{ s.quote_text }}&rdquo;</p>
        {%- endif -%}
        {%- if s.quote_name != blank or s.quote_image != blank -%}
          <div class="clg__quote-who">
            {%- if s.quote_image != blank -%}
              <img class="clg__avatar" src="{{ s.quote_image | image_url: width: 88 }}" alt="{{ s.quote_name | escape }}" width="44" height="44" loading="lazy">
            {%- endif -%}
            <div>
              {%- if s.quote_name != blank -%}<p class="clg__who-name">{{ s.quote_name }}</p>{%- endif -%}
              {%- if s.quote_role != blank -%}<p class="clg__who-role">{{ s.quote_role }}</p>{%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="clg__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'column' -%}
            <div class="clg__cell clg__cell--col{% if s.enable_lightbox and block.settings.lightbox_text != blank %} clg__cell--clickable{% endif %}"{% if s.enable_lightbox and block.settings.lightbox_text != blank %} data-clg-open="{{ block.id }}" role="button" tabindex="0"{% endif %} {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <h3 class="clg__title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.items != blank -%}
                <ul class="clg__items">
                  {%- assign lines = block.settings.items | newline_to_br | split: '<br />' -%}
                  {%- for line in lines -%}
                    {%- assign t = line | strip -%}
                    {%- if t != blank -%}
                      {%- if t contains '~' and t.first == '~' -%}
                        <li class="is-dim">{{ t | remove_first: '~' | strip }}</li>
                      {%- else -%}
                        <li>{{ t }}</li>
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              {%- if block.settings.count_text != blank -%}
                <div class="clg__count">
                  {%- if s.count_icon == 'arrow' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="12" x2="19" y2="12"></line><polyline points="13 6 19 12 13 18"></polyline></svg>
                  {%- elsif s.count_icon == 'image' and s.count_icon_image != blank -%}
                    <img src="{{ s.count_icon_image | image_url: width: 56 }}" alt="" loading="lazy">
                  {%- endif -%}
                  <span>{{ block.settings.count_text }}</span>
                </div>
              {%- endif -%}
            </div>
          {%- when 'highlight' -%}
            <div class="clg__cell" style="background: {{ block.settings.bg }};" {{ block.shopify_attributes }}>
              {%- if block.settings.line_1 != blank -%}<p class="clg__hl-line">{{ block.settings.line_1 }}</p>{%- endif -%}
              {%- if block.settings.line_2 != blank -%}<p class="clg__hl-line">{{ block.settings.line_2 }}</p>{%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <a class="clg__btn" href="{{ block.settings.button_link | default: '#' }}">{{ block.settings.button_label }}</a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
    {%- if s.footer_text != blank -%}
      <div class="clg__footer">{{ s.footer_text }}</div>
    {%- endif -%}
  </div>
  {%- if s.enable_lightbox -%}
  <div class="clg-overlay" data-clg-overlay></div>
  {%- for block in section.blocks -%}
    {%- if block.type == 'column' and block.settings.lightbox_text != blank -%}
      <div class="clg-popup" data-clg-popup="{{ block.id }}" role="dialog" aria-modal="true" aria-label="{{ block.settings.title | escape }}">
        <div class="clg-popup__b">{{ block.settings.lightbox_text }}</div>
        <button type="button" class="clg-popup__close" data-clg-close>Close</button>
      </div>
    {%- endif -%}
  {%- endfor -%}
  {%- endif -%}
</div>

{%- if s.enable_lightbox -%}
<script>
  (function () {
    function init() {
      var root = document.getElementById('shopify-section-{{ section.id }}');
      if (!root || root.dataset.clgInit === 'true') return;
      root.dataset.clgInit = 'true';
      var overlay = root.querySelector('[data-clg-overlay]');
      var popups = root.querySelectorAll('[data-clg-popup]');
      function closeAll(){ if(overlay) overlay.classList.remove('is-open'); popups.forEach(function(p){ p.classList.remove('is-open'); }); }
      root.querySelectorAll('[data-clg-open]').forEach(function (card) {
        function open(){ var t = root.querySelector('[data-clg-popup="' + card.getAttribute('data-clg-open') + '"]'); if (t && overlay) { overlay.classList.add('is-open'); t.classList.add('is-open'); } }
        card.addEventListener('click', open);
        card.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); } });
      });
      if (overlay) overlay.addEventListener('click', closeAll);
      root.querySelectorAll('[data-clg-close]').forEach(function (b) { b.addEventListener('click', closeAll); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeAll(); });
    }
    if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', init); } else { init(); }
    if (typeof window.Shopify !== 'undefined' && window.Shopify.designMode) {
      document.addEventListener('shopify:section:load', function (e) {
        if (e.detail && e.detail.sectionId === '{{ section.id }}') { var r = document.getElementById('shopify-section-{{ section.id }}'); if (r) r.dataset.clgInit = ''; init(); }
      });
    }
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Category list grid",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "160+ lab tests <em>chosen by top doctors</em>",
      "info": "Italics render in the Instrument serif and use the accent color."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 0,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme H1 size."
    },
    {
      "type": "header",
      "content": "Quote row"
    },
    {
      "type": "text",
      "id": "quote_text",
      "label": "Quote"
    },
    {
      "type": "image_picker",
      "id": "quote_image",
      "label": "Avatar"
    },
    {
      "type": "text",
      "id": "quote_name",
      "label": "Name"
    },
    {
      "type": "text",
      "id": "quote_role",
      "label": "Role"
    },
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "count_icon",
      "label": "Count label icon",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "arrow",
          "label": "Arrow"
        },
        {
          "value": "image",
          "label": "Uploaded image"
        }
      ],
      "default": "arrow"
    },
    {
      "type": "image_picker",
      "id": "count_icon_image",
      "label": "Count icon image",
      "info": "Used when the icon is set to Uploaded image."
    },
    {
      "type": "header",
      "content": "Hover and popup"
    },
    {
      "type": "color",
      "id": "hover_bg",
