      "default": "#f2eeea"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1a2874"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#1b3def"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#1b3def",
