{%- comment -%}
  BODOLOGY · LP closing CTA
  Mirrors ARMRA's "Ready To Feel The Difference?" anchor section: soft
  coloured band, heading, one line of text, a button that scrolls back to
  the product section, and the product image on the right. Image falls
  back to the product's featured image on product templates.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign img = s.image
  if img == blank and product != blank
    assign img = product.featured_image
  endif
-%}

<style>
  #shopify-section-{{ sid }} .lpc { background: {{ s.bg }}; color: {{ s.text_color }}; padding: {{ s.pad_top_mobile }}px 0 {{ s.pad_bottom_mobile }}px; font-family: "tenon", -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif; }
  #shopify-section-{{ sid }} .lpc__wrap { max-width: {{ s.page_width }}px; margin: 0 auto; padding: 0 16px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 22px; }
  #shopify-section-{{ sid }} .lpc__img { width: min(70%, 300px); aspect-ratio: 1 / 1; border-radius: {{ s.img_radius }}px; overflow: hidden; background: {{ s.img_bg }}; }
  #shopify-section-{{ sid }} .lpc__img img, #shopify-section-{{ sid }} .lpc__img svg { width: 100%; height: 100%; object-fit: {{ s.img_fit }}; display: block; }
  #shopify-section-{{ sid }} .lpc__eyebrow { margin: 0 0 10px; font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: {{ s.accent }}; }
  #shopify-section-{{ sid }} .lpc__h { margin: 0 0 12px; font-size: {{ s.h_size_mobile }}px; line-height: 1.1; font-weight: 400; letter-spacing: -0.01em; color: {{ s.heading_color }}; white-space: pre-line; }
  #shopify-section-{{ sid }} .lpc__h em { font-style: italic; color: {{ s.accent }}; }
  #shopify-section-{{ sid }} .lpc__p { margin: 0 auto 18px; max-width: 32em; font-size: 16px; line-height: 1.5; }
  #shopify-section-{{ sid }} .lpc__p p { margin: 0 0 6px; }
  #shopify-section-{{ sid }} .lpc__p strong { font-weight: 600; }
  #shopify-section-{{ sid }} .lpc__btn { display: inline-flex; align-items: center; justify-content: center; width: 100%; min-height: 52px; padding: 14px 28px; border-radius: {{ s.cta_radius }}px; background: {{ s.cta_bg }}; color: {{ s.cta_text_color }}; font-size: 15px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; text-decoration: none; transition: transform .15s ease, opacity .15s ease; }
  #shopify-section-{{ sid }} .lpc__btn:hover { opacity: .92; transform: translateY(-1px); }
  #shopify-section-{{ sid }} .lpc__note { margin: 10px 0 0; font-size: 13px; opacity: .8; }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .lpc { padding: {{ s.pad_top }}px 0 {{ s.pad_bottom }}px; }
    #shopify-section-{{ sid }} .lpc__wrap { flex-direction: {% if s.image_side == 'left' %}row-reverse{% else %}row{% endif %}; justify-content: space-between; text-align: left; gap: 48px; padding: 0 24px; }
    #shopify-section-{{ sid }} .lpc__content { flex: 1 1 auto; max-width: 40em; }
    #shopify-section-{{ sid }} .lpc__img { flex: 0 0 {{ s.img_size }}px; width: {{ s.img_size }}px; }
    #shopify-section-{{ sid }} .lpc__h { font-size: {{ s.h_size }}px; }
    #shopify-section-{{ sid }} .lpc__p { margin-left: 0; font-size: 18px; }
    #shopify-section-{{ sid }} .lpc__btn { width: auto; min-width: 260px; }
  }
</style>

<section class="lpc">
  <div class="lpc__wrap">
    <div class="lpc__content">
      {%- if s.eyebrow != blank -%}<p class="lpc__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="lpc__h">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<div class="lpc__p">{{ s.text }}</div>{%- endif -%}
      {%- if s.cta_label != blank -%}<a class="lpc__btn" href="{{ s.cta_link | default: '#shopify-section-main-product' }}">{{ s.cta_label }}</a>{%- endif -%}
      {%- if s.note != blank -%}<p class="lpc__note">{{ s.note }}</p>{%- endif -%}
    </div>
    {%- if img != blank or request.design_mode -%}
      <div class="lpc__img">
        {%- if img != blank -%}
          {%- assign img_alt = s.image_alt | default: product.title | default: '' -%}
          {{ img | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(min-width: 900px) 420px, 70vw', alt: img_alt }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "LP · Closing CTA",
  "tag": "div",
  "class": "section-lp-cta-anchor",
  "disabled_on": { "groups": ["header", "footer", "aside"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (optional)" },
    { "type": "textarea", "id": "heading", "label": "Heading", "info": "Press Enter to force a line break.", "default": "Ready to start?" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Two scoops a day. The full clinical dose. 60 days to decide.</p>" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Choose your supply" },
    { "type": "url", "id": "cta_link", "label": "Button link", "info": "Leave empty to scroll to the product section." },
    { "type": "text", "id": "note", "label": "Small text under the button", "default": "60-day money-back guarantee" },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Falls back to the product's featured image." },
    { "type": "text", "id": "image_alt", "label": "Alt text" },
    { "type": "select", "id": "image_side", "label": "Image position (desktop)", "options": [ { "value": "right", "label": "Right" }, { "value": "left", "label": "Left" } ], "default": "right" },
    { "type": "select", "id": "img_fit", "label": "Image fit", "options": [ { "value": "cover", "label": "Fill" }, { "value": "contain", "label": "Fit inside" } ], "default": "cover" },
    { "type": "range", "id": "img_size", "min": 220, "max": 520, "step": 20, "unit": "px", "label": "Image size (desktop)", "default": 400 },
    { "type": "range", "id": "img_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Image corner radius", "default": 18 },
    { "type": "color", "id": "img_bg", "label": "Image background", "default": "rgba(0,0,0,0)" },
    { "type": "header", "content": "Style" },
    { "type": "range", "id": "page_width", "min": 900, "max": 1500, "step": 20, "unit": "px", "label": "Content width", "default": 1160 },
    { "type": "range", "id": "h_size", "min": 28, "max": 64, "step": 2, "unit": "px", "label": "Heading size (desktop)", "default": 44 },
    { "type": "range", "id": "h_size_mobile", "min": 22, "max": 44, "step": 1, "unit": "px", "label": "Heading size (mobile)", "default": 30 },
    { "type": "color", "id": "bg", "label": "Background", "default": "#e3e7ff" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#1a2874" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1a2874" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#1b3def" },
    { "type": "color", "id": "cta_bg", "label": "Button background", "default": "#1b3def" },
    { "type": "color", "id": "cta_text_color", "label": "Button text", "default": "#ffffff" },
    { "type": "range", "id": "cta_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Button corner radius", "default": 40 },
    { "type": "range", "id": "pad_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding (desktop)", "default": 80 },
    { "type": "range", "id": "pad_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding (desktop)", "default": 80 },
    { "type": "range", "id": "pad_top_mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding (mobile)", "default": 48 },
    { "type": "range", "id": "pad_bottom_mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding (mobile)", "default": 48 }
  ],
  "presets": [ { "name": "LP · Closing CTA" } ]
}
{% endschema %}
