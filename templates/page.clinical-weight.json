            "popup_heading": "Diet Alone",
            "popup_stat": "−14%",
            "popup_stat_text": "fat mass (38.2% → 33.5% of body weight, p = 0.000) — while lean mass fell 6.2%*⁴",
            "popup_info_text": "Losing lean mass alongside fat lowers resting metabolism, which makes regaining weight more likely. This is the pattern the inositol groups avoided."
          }
        },
        "card_2": {
          "type": "score_card",
          "settings": {
            "title": "Diet + Myo",
            "subtitle": "Group 2 (n = 10)",
            "percentage": 17,
            "value_label": "−16.9%",
            "caption": "fat-mass reduction — and lean mass rose 7.1%*⁴",
