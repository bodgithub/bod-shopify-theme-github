    "link_2_inositol": {
      "type": "study-overview-table",
      "blocks": {
        "attr_insulin": {
          "type": "attribute",
          "settings": {
            "label": "−47% fasting insulin*",
            "popup_title": "Fasting Insulin, −47%",
            "popup_text": "Fasting insulin — the insulin in your blood after an overnight fast — roughly halved over the six months (20.19 → 10.74 μU/mL). The placebo group didn't change.*"
          }
        },
        "attr_postmeal": {
          "type": "attribute",
          "settings": {
            "label": "Post-meal insulin ↓*",
            "popup_title": "Post-Meal Insulin",
            "popup_text": "In a trial comparing seven inositol blends, insulin measured after meals improved significantly within three months (Nordio, 2019). After meals is exactly the 2–3 hour window where the hunger-driving crashes happen.*"
          }
        },
        "attr_homa": {
          "type": "attribute",
          "settings": {
            "label": "−42% HOMA index*",
            "popup_title": "HOMA Index, −42%",
            "popup_text": "HOMA is a standard score doctors use to estimate insulin resistance from a simple blood test. Lower is better. It fell 42% on average (3.38 → 1.97) — and didn't budge on placebo.*"
          }
        }
      },
      "block_order": [
        "attr_insulin",
