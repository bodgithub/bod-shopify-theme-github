          "type": "quote",
          "settings": {
            "image": "shopify://shop_images/Anita_-_White_-_logo.png",
            "stars": "",
            "quote": "<p>\"I use Inositol to support clients looking to maintain healthy cycles, manage metabolic wellness, and promote hormonal balance. It plays a helpful role in supporting glucose metabolism and overall vitality.\"</p>",
