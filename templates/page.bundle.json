        "quote_tina": {
          "type": "quote",
          "settings": {
            "image": "shopify://shop_images/Tina_-_white_-_logo_2.png",
            "stars": "",
            "quote": "<p>\"Bodology Inositol is an exceptional supplement. With it's research-backed 40:1 ratio for womens metabolic health. As a nutritionist, I not only highly recommend it but I also use it myself.\"</p>",
            "name": "Tina Kozman",
            "expert-title": "MEd, CNP, Metabolic Health Expert"
