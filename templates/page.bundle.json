        "bottom_glyph": "none",
        "title_size": 22,
        "text_size": 15,
        "top_icon_size": 40,
        "card_radius": 20,
        "footer_text": "<p>It wasn't that they didn't work. It's that they weren't working on the problem: <strong>insulin resistance.</strong></p>",
        "footer_star": true,
