      "settings": {
        "anchor": "study-2",
        "title": "Study 2 Overview — the meta-analysis",
        "show_image_mobile": false,
        "background_heading": "Study Background",
        "background_text": "A meta-analysis in BJOG pooling ten randomized trials of inositol for ovulation: 362 women on inositol, 179 on placebo, 60 on metformin. The authors are honest about the gap — evidence for pregnancy and live-birth rates is still lacking — and so are we (Pundir et al., 2018).‡",
        "attributes_heading": "Study Attributes",
        "card_bg": "#F2EEEA",
        "title_bg": "#E4E8F4",
        "border_color": "#3447AF",
        "text_color": "#1A2874",
        "chip_hover_text": "#D9DFF0",
        "overlay_color": "rgba(242, 238, 234, 0.87)"
      }
