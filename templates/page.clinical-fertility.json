    "study_2_results": {
      "type": "clinical-results-stats",
      "blocks": {
        "stat_1": {
          "type": "stat_card",
          "settings": {
            "value": "6.8×",
            "text": "more frequent periods on inositol than on placebo*‡"
          }
        },
        "stat_2": {
          "type": "stat_card",
          "settings": {
            "value": "10 / 10",
            "text": "trials pointed the same direction on cycle frequency — rare agreement in supplement research*‡"
          }
        },
        "info_1": {
          "type": "info_button",
          "settings": {
            "label": "What is relative risk",
            "popup_title": "Relative Risk (RR)",
            "popup_text": "<p>Relative risk compares how often something happens in one group versus another. Here: women on inositol were 2.3 times as likely to ovulate as women on placebo (95% CI 1.1–4.7), and periods came 6.8 times more frequently (95% CI 2.8–16.6).</p>"
          }
        },
        "info_2": {
          "type": "info_button",
          "settings": {
            "label": "What is heterogeneity",
            "popup_title": "Heterogeneity",
            "popup_text": "<p>Heterogeneity measures how much the trials in a pooled analysis disagree with each other. On cycle frequency it was zero — every one of the ten trials pointed the same way. That level of agreement is rare in supplement research.</p>"
          }
        }
      },
