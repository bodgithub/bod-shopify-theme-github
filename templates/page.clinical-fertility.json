      "settings": {
        "anchor": "study-1",
        "title": "Study 1 Overview",
        "show_image_mobile": true,
        "background_heading": "Study Background",
        "background_text": "An independent randomized, double-blind, placebo-controlled trial of myo-inositol in 42 women with PCOS — the strongest study design there is, applied directly to ovulation (Costantino et al., 2009).†",
        "attributes_heading": "Study Attributes",
        "card_bg": "#F2EEEA",
        "title_bg": "#E4E8F4",
        "border_color": "#3447AF",
        "text_color": "#1A2874",
        "chip_hover_text": "#D9DFF0",
        "overlay_color": "rgba(242, 238, 234, 0.87)"
      }
    },
    "study_1_results": {
      "type": "clinical-results-stats",
      "blocks": {
        "stat_1": {
          "type": "stat_card",
          "settings": {
            "value": "16 / 23",
            "text": "women taking myo-inositol ovulated during the study*†"
          }
        },
        "stat_2": {
          "type": "stat_card",
          "settings": {
            "value": "4 / 19",
            "text": "women taking placebo ovulated during the study*†"
          }
        },
        "info_1": {
          "type": "info_button",
          "settings": {
            "label": "What is myo-inositol",
            "popup_title": "Myo-Inositol",
            "popup_text": "<p>Myo-inositol is the most abundant inositol in the body and is highly concentrated in the ovary, where it acts as a second messenger in insulin and FSH signalling — the pathways that mature and release an egg.</p>"
          }
        },
        "info_2": {
          "type": "info_button",
          "settings": {
            "label": "Why insulin matters here",
            "popup_title": "Insulin and Ovulation",
            "popup_text": "<p>High circulating insulin pushes the ovary toward androgen production and disrupts follicle maturation. Improving how the body handles insulin is the mechanism by which inositol is thought to support ovulatory function. In this trial, insulin sensitivity also improved significantly alongside ovulation.</p>"
          }
        }
      },
      "block_order": [
        "stat_1",
        "stat_2",
        "info_1",
        "info_2"
      ],
