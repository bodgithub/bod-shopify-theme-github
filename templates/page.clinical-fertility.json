    "study_2_results": {
      "type": "clinical-results-stats",
      "blocks": {
        "stat_1": {
          "type": "stat_card",
          "settings": {
            "value": "6.8×",
            "text": "more frequent menstrual cycles versus placebo (RR 6.8; 95% CI 2.8–16.6)*‡"
          }
        },
        "stat_2": {
          "type": "stat_card",
          "settings": {
            "value": "10 / 10",
            "text": "trials pointed the same direction on cycle frequency — zero statistical heterogeneity, which is rare*‡"
          }
        },
        "info_1": {
          "type": "info_button",
          "settings": {
            "label": "What is relative risk",
            "popup_title": "Relative Risk (RR)",
            "popup_text": "<p>Relative risk compares how often something happens in one group versus another. RR 2.3 for ovulation means women on inositol were 2.3 times as likely to ovulate as women on placebo across the pooled trials.</p>"
          }
        },
        "info_2": {
          "type": "info_button",
          "settings": {
            "label": "What is heterogeneity",
            "popup_title": "Heterogeneity",
            "popup_text": "<p>Heterogeneity measures how much the trials in a meta-analysis disagree with each other. The menstrual-cycle result had zero heterogeneity — every one of the ten trials pointed the same way. That level of consistency is rare in supplement research.</p>"
          }
        }
      },
