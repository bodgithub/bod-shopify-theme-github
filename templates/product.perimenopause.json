            "text": "<p>improvement in whole-body insulin sensitivity*</p>"
          }
        },
        "stat_8HwQip": {
          "type": "stat",
          "settings": {
            "value": "2 in 5",
            "text": "<p>US adults have insulin resistance. Most don't know it*</p>"
