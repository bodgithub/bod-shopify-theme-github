    "inositol_science_86gMmR": {
      "type": "inositol-science",
      "blocks": {
        "column_fawpQF": {
          "type": "column",
          "settings": {
            "label": "With enough inositol",
            "steps": "insulin knocks\nthe message gets through\nyour cell opens its doors",
            "chip": "Sugar goes in. You get energy.",
            "chip_text": "#1b3def",
            "chip_border": "#3447af",
            "chip_bg": "#e3e7ff8c"
          }
        },
        "column_zkF9gA": {
          "type": "column",
          "settings": {
            "label": "When cells stop listening",
            "steps": "insulin knocks\n!the message fades\n~the doors stay closed",
            "chip": "Sugar stays in your blood. Insulin keeps rising.",
            "chip_text": "#1a2874",
            "chip_border": "#9aa0b5",
