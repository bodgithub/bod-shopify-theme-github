    "lp_reasons": {
      "type": "lp-numbered-reasons",
      "name": "LP · Numbered reasons",
      "blocks": {
        "r1": {
          "type": "reason",
          "settings": {
            "title": "It works on the cause, not the symptom",
            "text": "<p>Inositol works on insulin signalling: the message that tells your cells to take glucose in. High insulin is the driver behind cravings, afternoon crashes, irregular cycles and mood dips.*</p><p><strong>Metabolic health is hormone health.</strong></p>"
          }
        },
        "r2": {
          "type": "reason",
          "settings": {
            "title": "The full clinical dose, every day",
            "text": "<p>One serving is 2 scoops: 4,000mg myo-inositol and 100mg D-chiro-inositol. That is the 4.1g daily amount used in the studies, not a capsule-sized fraction.</p>"
          }
        },
        "r3": {
          "type": "reason",
          "settings": {
            "title": "The 40:1 ratio your body already keeps",
            "text": "<p>Your blood naturally holds about 40 parts myo-inositol to 1 part D-chiro-inositol. In a head-to-head of seven ratios, 40:1 came out on top for every hormone the researchers measured.*</p>"
          }
        },
        "r4": {
          "type": "reason",
          "settings": {
            "title": "D-chiro from carob, not corn",
            "text": "<p>Our D-chiro-inositol comes from carob pods, not corn. Nothing else is in the tub: no fillers, no flow agents, no flavoring, no added vitamins or herbs.</p>"
          }
        },
        "r5": {
          "type": "reason",
          "settings": {
            "title": "Tested by people who do not work for us",
            "text": "<p>Made in the USA in a GMP- and FDA-compliant facility. Every batch is third-party tested and we publish the lab report. Recommended by the dietitians and clinicians on our expert panel.</p>"
          }
        }
      },
      "block_order": [
        "r1",
        "r2",
        "r3",
        "r4",
        "r5"
      ],
      "settings": {
        "eyebrow": "",
        "heading": "5 reasons to start\nwith inositol",
        "show_numbers": true,
        "number_in_title": true,
        "mobile_layout": "swipe",
        "footnote": "<p>*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease. The ratio study did not use Bodology® Inositol specifically (Nordio et al., 2019).</p>",
