        "t1s4": {
          "type": "stat",
          "settings": {
            "value": "10 / 10",
            "text": "trials pointed the same direction on cycle frequency*¶"
          }
        },
        "t2": {
          "type": "tab",
          "settings": {
            "title": "Insulin",
            "description": "<p>Insulin sensitivity is how well your cells listen to insulin. The better they listen, the less insulin your body needs and the steadier your blood sugar. Fasting insulin and HOMA-IR are the tests that catch it early.</p>",
            "note": "<p>†Costantino et al., 2009. ‡46 women with PCOS, six months, 40:1 blend vs placebo (Benelli et al., 2016). Group averages; individual results vary. Independent studies, not of Bodology.</p>"
          }
        },
        "t2s1": {
          "type": "stat",
          "settings": {
            "value": "+80%",
            "text": "improvement in whole-body insulin sensitivity*†"
          }
        },
        "t2s2": {
          "type": "stat",
          "settings": {
            "value": "−47%",
            "text": "fasting insulin over six months on the 40:1 blend*‡"
          }
        },
        "t2s3": {
          "type": "stat",
          "settings": {
            "value": "−42%",
            "text": "HOMA index, the standard score for insulin resistance*‡"
          }
        },
        "t2s4": {
          "type": "stat",
          "settings": {
            "value": "−51%",
            "text": "average drop in triglycerides, the main fat in your blood*†"
          }
        },
        "t3": {
          "type": "tab",
          "settings": {
            "title": "Hormones",
            "description": "<p>40:1 is the balance your body naturally keeps the two inositols in. In a head-to-head of seven ratios over three months, the 40:1 blend moved every hormone the researchers measured the most.</p>",
            "note": "<p>†Costantino et al., 2009. §56 women with PCOS, seven ratios compared, three months (Nordio et al., 2019). Small groups. Independent studies, not of Bodology.</p>"
          }
        },
        "t3s1": {
          "type": "stat",
          "settings": {
            "value": "−65%",
            "text": "average reduction in total testosterone*†"
          }
        },
        "t3s2": {
          "type": "stat",
          "settings": {
            "value": "40:1",
            "text": "of the seven blends tested came out on top for every hormone measured*§"
