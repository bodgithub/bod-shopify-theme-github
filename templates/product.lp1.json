    "lp_steps": {
      "type": "lp-steps",
      "name": "LP · Steps",
      "blocks": {
        "s1": {
          "type": "step",
          "settings": {
            "title": "Measure two scoops",
            "text": "<p>That is one serving: 4,000mg myo-inositol and 100mg D-chiro-inositol. Each scoop is half a serving, so dose control is easy.</p>"
          }
        },
        "s2": {
          "type": "step",
          "settings": {
            "title": "Stir into anything",
            "text": "<p>Water, coffee or a smoothie. It dissolves clear, with no grit and no aftertaste. Some women take it straight off the scoop.</p>",
            "image": "shopify://shop_images/Stir-in.jpg"
          }
        },
        "s3": {
          "type": "step",
          "settings": {
            "title": "Give it 12 weeks",
            "text": "<p>Afternoon crashes usually shift first, often within two weeks. Cycles take longer. Most studies run 12 weeks because that is how long ovulation realistically needs.*</p>"
          }
        }
      },
      "block_order": [
        "s1",
        "s2",
        "s3"
      ],
      "settings": {
        "eyebrow": "[ HOW TO TAKE IT ]",
        "heading": "Two scoops a day.\nThat's the whole routine.",
