    "rich_text_home_footnote": {
      "type": "rich-text",
      "blocks": {
        "text_nJhEEa": {
          "type": "text",
          "settings": {
            "text": "<p>*Studies of myo-inositol, not of Bodology®. Genazzani et al. 2008 and Artini et al. 2013: overweight women with PCOS, 2g myo-inositol daily for 12 weeks; insulin and testosterone significantly reduced. Giordano et al. 2011: 80 postmenopausal women with metabolic syndrome, 4g myo-inositol daily plus diet for 6 months; HOMA-IR fell 75% in the myo-inositol group, significantly more than with diet alone. Results in studies may not reflect individual outcomes. These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease.</p>",
            "custom_liquid": "",
            "size": "text-size-regular"
          }
        }
      },
