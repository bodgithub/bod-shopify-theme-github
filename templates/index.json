        },
        "collapsible_tab_LHBcDr": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "How it tastes",
            "open": false,
            "content": "<p>Naturally and gently sweet, with no added flavors.</p><p>Bodology\u00ae Inositol dissolves easily into water, smoothies, or coffee without grit or aftertaste, making daily consistency simple.</p>",
