          "settings": {
            "label": "What is insulin sensitivity",
            "popup_title": "Insulin Sensitivity",
            "popup_text": "<p>Insulin sensitivity describes how efficiently your cells respond to insulin, the hormone that moves glucose out of your blood and into your cells. Higher sensitivity means your body needs less insulin to keep blood sugar steady. This study measured it with the composite whole-body insulin sensitivity index (ISI).</p>"
          }
        },
        "info_2": {
          "type": "info_button",
          "settings": {
            "label": "What are triglycerides",
            "popup_title": "Triglycerides",
            "popup_text": "<p>Triglycerides are the main form of fat circulating in your blood. A blood test measures them to assess metabolic health.</p>"
          }
        }
      },
