    "clinical_study_carousel_fert": {
      "type": "clinical-study-carousel",
      "blocks": {
        "study_1": {
          "type": "study",
          "settings": {
            "title": "Study 1 — Ovulation vs placebo",
            "badge_text": "MYO-INOSITOL VS PLACEBO",
            "big_stat": "70%",
            "big_stat_caption": "of women taking myo-inositol ovulated during the study — versus 21% on placebo*†",
            "stat2_value": "16 / 23",
            "stat2_text": "women on myo-inositol ovulated during the study, versus 4 / 19 on placebo*†",
            "background_text": "42 women with PCOS were randomly split. One group took myo-inositol, the other a placebo, and nobody knew who had which until the end (Costantino et al., 2009).†",
            "attributes": "42 women with PCOS, Double-blind, Placebo-controlled, Randomized",
            "study_url": "https://pubmed.ncbi.nlm.nih.gov/19499845/",
            "study_label": "Read the study",
            "page_url": "/pages/inositol-for-fertility-clinical-studies#study-1",
            "page_label": "See the full breakdown"
          }
        },
        "study_2": {
          "type": "study",
          "settings": {
            "title": "Study 2 — The BJOG meta-analysis",
            "badge_text": "TEN TRIALS, POOLED",
            "big_stat": "2.3×",
            "big_stat_caption": "the likelihood of ovulating on inositol versus placebo, pooled across all ten trials*‡",
            "stat2_value": "6.8×",
            "stat2_text": "more frequent periods on inositol than on placebo*‡",
            "background_text": "Researchers pooled ten separate trials, 601 women in total, to ask whether the ovulation results hold up across all of them. They do (Pundir et al., 2018).‡",
            "attributes": "10 randomized trials, 601 women, Published in BJOG, Meta-analysis",
            "study_url": "https://doi.org/10.1111/1471-0528.14754",
            "study_label": "Read the study",
            "page_url": "/pages/inositol-for-fertility-clinical-studies#study-2",
            "page_label": "See the full breakdown"
          }
        },
        "study_3": {
          "type": "study",
          "settings": {
            "title": "Study 3 — Egg quality & pregnancy",
            "badge_text": "MYO-INOSITOL IN ICSI",
            "big_stat": "62%",
            "big_stat_caption": "clinical pregnancy rate with inositol — versus 43% without it (p = 0.02)*§",
            "stat2_value": "50%",
            "stat2_text": "of women on inositol had good-to-excellent egg quality, versus 31% without it (p = 0.02)*§",
            "background_text": "149 women going through ICSI (a form of IVF) were randomly split: half added myo-inositol to their folic acid, half took folic acid alone (Brusco & Mariani, 2013).§",
            "attributes": "149 women in ICSI, Randomized, Open-label, Not PCOS-only",
            "study_url": "https://pubmed.ncbi.nlm.nih.gov/24302192/",
            "study_label": "Read the study",
            "page_url": "/pages/inositol-for-fertility-clinical-studies#study-3",
            "page_label": "See the full breakdown"
          }
        },
        "study_4": {
          "type": "study",
          "settings": {
            "title": "Study 4 — The 40:1 blend in IVF",
            "badge_text": "40:1 VS D-CHIRO ALONE",
            "big_stat": "40:1",
            "big_stat_caption": "Only the 40:1 blend improved egg quality, embryo quality, and pregnancy rates. D-chiro-inositol on its own did not*¶",
            "stat2_value": "",
            "stat2_text": "",
            "background_text": "Women with PCOS going through IVF were randomly given either the 40:1 blend or D-chiro-inositol on its own (Colazingari et al., 2013).¶",
            "attributes": "Women with PCOS in IVF, Randomized, 40:1 vs D-chiro alone",
            "study_url": "https://doi.org/10.1007/s00404-013-2855-3",
            "study_label": "Read the study",
            "page_url": "/pages/inositol-for-fertility-clinical-studies#study-4",
            "page_label": "See the full breakdown"
          }
        }
      },
      "block_order": [
        "study_1",
        "study_2",
        "study_3",
        "study_4"
      ],
      "settings": {
        "anchor": "",
        "eyebrow": "Ovulation is a metabolic event",
        "heading": "What the ovulation studies found",
        "subtext": "Published trials of inositol and ovulation, egg quality and pregnancy rates. The headline results are here. The full breakdown, with every caveat, is on our clinical studies page.*",
        "disclaimer": "<p>These are independent, published studies of inositol. They did not use Bodology® Inositol, and they are not a promise of what you'll experience. Inositol is not a fertility treatment. If you're trying to conceive, work with your clinician.</p><p>†Costantino et al., 2009 · ‡Pundir et al., 2018 · §Brusco &amp; Mariani, 2013 · ¶Colazingari et al., 2013. Full citations are on the clinical studies page.</p><p>*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease.</p>",
        "cta_label": "Read all four studies in full",
        "cta_url": "/pages/inositol-for-fertility-clinical-studies",
        "bg_color": "#f2eeea",
        "text_color": "#1a2874",
        "heading_color": "#3447af",
