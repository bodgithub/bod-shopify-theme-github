      "settings": {
        "anchor": "link-1",
        "title": "Link 1 — Metabolic health shapes mood",
        "show_image_mobile": true,
        "background_heading": "The Stanford-Led Study",
        "background_text": "Watson et al., 2021: Stanford researchers followed 601 adults with no history of depression or anxiety for nine years. Those who started with markers of insulin resistance were significantly more likely to develop depression — a high triglyceride-to-HDL ratio carried an 89% higher risk, and newly developing prediabetes carried 2.7 times the risk. Mood isn't separate from metabolism.¹",
        "attributes_heading": "Study Attributes",
        "card_bg": "#f2eeea",
        "title_bg": "#e4e8f4",
        "border_color": "#3447af",
        "text_color": "#1a2874",
        "chip_hover_text": "#d9dff0",
        "overlay_color": "rgba(242, 238, 234, 0.87)",
        "section_bg": "#f2eeea",
        "page_width": 1300,
