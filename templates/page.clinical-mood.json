      "settings": {
        "anchor": "link-1-pcos",
        "title": "Link 1 — The PCOS-specific study",
        "show_image_mobile": true,
        "background_heading": "The PCOS-Specific Study",
        "background_text": "Cooney et al., 2017, in Human Reproduction: a meta-analysis of 30 studies covering 3,050 women with PCOS and 3,858 without, across 10 countries. Women with PCOS had roughly four times the odds of moderate or severe depressive symptoms, and over six times the odds of moderate or severe anxiety symptoms. When women were matched for BMI, the elevated odds held. The authors recommend that clinicians screen women with PCOS for both.⁴",
        "attributes_heading": "Study Attributes",
        "card_bg": "#ffffff",
        "title_bg": "#e4e8f4",
        "border_color": "#3447af",
        "text_color": "#1a2874",
        "chip_hover_text": "#d9dff0",
        "overlay_color": "rgba(242, 238, 234, 0.87)",
        "section_bg": "#f2eeea",
        "page_width": 1300,
        "padding_top_desktop": 60,
        "padding_bottom_desktop": 60,
        "padding_top_mobile": 30,
        "padding_bottom_mobile": 30
      }
