        "attr_meta": {
          "type": "attribute",
          "settings": {
            "label": "Meta-analysis",
            "popup_title": "What a Meta-Analysis Is",
            "popup_text": "A meta-analysis pools the results of many independent trials into a single estimate — the strongest form of evidence for an overall effect. This one pooled every double-blind randomized inositol mood trial to 2013."
          }
        },
        "attr_honest": {
          "type": "attribute",
          "settings": {
            "label": "Mixed results",
            "popup_title": "What \"Mixed\" Means Here",
            "popup_text": "Pooled across all trials, inositol's effect on mood did not reach statistical significance. It showed marginally more responders than placebo (p = 0.06), with the strongest signal in premenstrual mood symptoms (p = 0.07). Early and promising in specific groups — not yet proven overall."
          }
        }
      },
