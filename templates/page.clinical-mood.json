    "link_2_inositol": {
      "type": "study-overview-table",
      "blocks": {
        "attr_insulin": {
          "type": "attribute",
          "settings": {
            "label": "−47% fasting insulin*",
            "popup_title": "Fasting Insulin, −47%",
            "popup_text": "In a randomized, placebo-controlled 6-month trial of the 40:1 blend in 46 women with PCOS, average fasting insulin fell from 20.19 to 10.74 μU/mL — with no significant change on placebo (Benelli et al., 2016).*"
          }
        },
        "attr_homa": {
          "type": "attribute",
          "settings": {
            "label": "−42% HOMA index*",
            "popup_title": "HOMA Index, −42%",
            "popup_text": "The HOMA index estimates insulin resistance from fasting glucose and insulin — the same kind of marker the Stanford-led study used to predict mood risk. In Benelli 2016 it fell 42% on average over 6 months on the 40:1 blend, with no significant change on placebo.*"
          }
        },
        "attr_serotonin": {
          "type": "attribute",
          "settings": {
            "label": "Serotonin second messenger",
            "popup_title": "The Brain Mechanism",
            "popup_text": "Inositol is part of the second-messenger system that serotonin receptors use to pass signals inside brain cells. That mechanism is why researchers began testing it for mood in the first place — the trials below took it from theory to placebo-controlled testing."
          }
        }
      },
      "block_order": [
        "attr_insulin",
        "attr_homa",
        "attr_serotonin"
      ],
      "settings": {
        "anchor": "link-2",
        "title": "Link 2 — Inositol supports insulin & serotonin signalling",
        "show_image_mobile": true,
        "background_heading": "The Evidence",
        "background_text": "Inositol sits on both sides of the mood–metabolism link. On the metabolic side, randomized trials show it improves insulin handling: fasting insulin fell 47% and the HOMA insulin-resistance index 42% over 6 months on the 40:1 blend (Benelli, 2016²), with post-meal insulin improving within 3 months (Nordio, 2019³). And in the brain, inositol is a second messenger in serotonin signalling — the pathway the direct mood trials below were built on.*",
        "attributes_heading": "The Numbers",
        "card_bg": "#f2eeea",
