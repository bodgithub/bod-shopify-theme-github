    "yes_no_offer": {
      "type": "yes-no",
      "blocks": {
        "qa_1": {
          "type": "qa",
          "settings": {
            "question": "Does insulin resistance get more common after 40?",
            "answer": "yes",
            "text": "<p>Estrogen helps cells respond to insulin. As it falls, more women tip into insulin resistance, often with normal glucose on their labs.</p>"
          }
        },
        "qa_2": {
          "type": "qa",
          "settings": {
            "question": "Can my blood sugar be normal and my insulin high?",
            "answer": "yes",
            "text": "<p>Fasting glucose stays in range while insulin climbs to hold it there. If you want the number, ask for fasting insulin or HOMA-IR.</p>"
          }
        },
        "qa_3": {
          "type": "qa",
          "settings": {
            "question": "Is inositol a hormone?",
            "answer": "no",
            "text": "<p>It’s a compound your body already makes and uses to pass on insulin’s signal. Two scoops top it up to the 4g used in studies.</p>"
          }
        },
        "qa_4": {
          "type": "qa",
          "settings": {
            "question": "Will two scoops fix everything overnight?",
            "answer": "no",
            "text": "<p>Most women notice cravings and energy first, within a few weeks. The postmenopausal study ran six months.</p>"
          }
        },
        "qa_5": {
          "type": "qa",
          "settings": {
            "question": "Do I have to give up coffee or carbs for it to work?",
            "answer": "no",
            "text": "<p>Stir it into your morning coffee. It’s unflavored, gently sweet on its own, and dissolves clear.</p>"
          }
        },
        "qa_6": {
          "type": "qa",
          "settings": {
            "question": "Is it risky to try?",
            "answer": "no",
            "text": "<p>You have 60 days. If it isn’t doing anything for you, email us and we’ll refund you.</p>"
          }
        },
        "qa_7": {
          "type": "qa",
          "settings": {
            "question": "Is the 90-day bundle a commitment?",
            "answer": "other",
            "text": "<p>It’s a subscription billed every 3 months at $98 for two 6-week tubs. Skip or cancel anytime in your account.</p>",
            "other_label": "Not really"
          }
        }
      },
