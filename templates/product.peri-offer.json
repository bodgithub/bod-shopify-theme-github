        "trust_circles_Ln9WVk": {
          "type": "trust_circles",
          "settings": {
            "headline": "Every batch, independently verified",
            "headline_size": 16,
            "coa_enable": true,
            "coa_link_text": "Read our COA",
            "section_bg": "",
            "headline_color": "#1a2874",
            "outer_bg": "#e3e7ff",
