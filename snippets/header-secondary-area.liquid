{% comment %} <!-- entire original liquid --!>
{%- liquid
	if customer
  	assign profile_link = routes.account_url
	else
  	assign profile_link = routes.account_login_url
	endif
-%}
<div class="thb-secondary-area thb-header-right">
	<a class="thb-secondary-area-item thb-quick-search" href="{{ routes.search_url }}" title="{{ 'sections.header.search' | t }}">{%- render 'svg-icons' with 'search' -%}</a>
	{%- if shop.customer_accounts_enabled -%}
    <a class="thb-secondary-area-item thb-secondary-myaccount" href="{{ profile_link | escape }}" title="{{ 'sections.header.my_account' | t }}">{%- render 'svg-icons' with 'myaccount' -%}</a>
  {%- endif -%}
	<a class="thb-secondary-area-item thb-secondary-cart" href="{{ routes.cart_url }}" id="cart-drawer-toggle"><div class="thb-secondary-item-icon">{% render 'svg-icons' with 'cart' %} <span class="thb-item-count">{%- if cart.item_count > 99 -%}{%- render 'svg-icons' with 'thb-asterisk' -%}{%- else -%}{{ cart.item_count }}{%- endif -%}</span></div></a>
</div>
<!-- end original start new --!> {% endcomment %}


{%- liquid
	if customer
  	assign profile_link = routes.account_url
	else
  	assign profile_link = routes.account_login_url
	endif
-%}
<div class="thb-secondary-area thb-header-right" style="display: flex; align-items: center;">
	{% comment %} Hide Quick Search {% endcomment %}
  


	<a class="thb-secondary-area-item thb-quick-search" href="{{ routes.search_url }}" style="display:none;" title="{{ 'sections.header.search' | t }}">
		{%- render 'svg-icons' with 'search' -%}
	</a>

  
	{%- if shop.customer_accounts_enabled -%}
		{% comment %} Account: blue outline person icon {% endcomment %}
    	<a class="thb-secondary-area-item thb-secondary-myaccount" href="{{ profile_link | escape }}" title="{{ 'sections.header.my_account' | t }}"  {% if request.path contains '/blog' or request.path contains '/pages/bodology' %} style="display:none;" {% endif %}>
      		<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1b3def" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="3.6"/><path d="M5.5 20c1.2-3.7 3.9-5.2 6.5-5.2s5.3 1.5 6.5 5.2"/></svg>
    	</a>
  	{%- endif -%}

  	{% comment %} Cart: blue outline basket icon + count bubble {% endcomment %}
<a class="thb-secondary-area-item thb-secondary-cart" href="{{ routes.cart_url }}" id="cart-drawer-toggle" title="{{ 'sections.header.cart' | t | default: 'Cart' }}" {% if request.path contains '/blog' or request.path contains '/pages/bodology' %} style="display:none;" {% endif %}><div class="thb-secondary-item-icon">
  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1b3def" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="5.5" y="9.5" width="13" height="11" rx="3"/><path d="M9 9.5V8.1c0-1.6 1.3-2.8 3-2.8s3 1.2 3 2.8v1.4"/></svg>
  <span class="thb-item-count">{%- if cart.item_count > 99 -%}{%- render 'svg-icons' with 'thb-asterisk' -%}{%- elsif cart.item_count > 0 -%}{{ cart.item_count }}{%- endif -%}</span></div></a>






{% comment %}Add the Button to the Right, styled like the plan selector CTA, visible only on desktop {% endcomment %}
<style>
.bod-nav-cta{background:linear-gradient(140deg,#1b3def 0%,#3358FF 52%,#5C78FF 100%) !important; color:#fff !important; border:none !important; border-radius:var(--button-border-radius, 40px) !important; font-family:"tenon","Tenon Local","Helvetica Neue",Arial,sans-serif; font-weight:var(--font-body-medium-weight, 400); letter-spacing:var(--button-letter-spacing, 0.02em); transition:filter .16s,transform .12s;}
.bod-nav-cta:hover{filter:brightness(1.06);}
.bod-nav-cta:active{transform:translateY(1px);}
.thb-header-right .thb-secondary-area-item.thb-secondary-myaccount{padding-right:3px;}
.thb-header-right .thb-secondary-area-item.thb-secondary-cart{padding-left:3px;}
.thb-secondary-area .thb-item-count:empty{display:none !important;}
</style>
<a class="button desktop-only bod-nav-cta" href="{{ section.settings.button_url | default: '/products/myo-d-chiro-inositol-powder' }}"
   role="button"
   title="{{ section.settings.button_text | default: 'Shop Now' }}">
  <span>{{ section.settings.button_text | default: 'Shop Now' }}</span>
</a>


</div>