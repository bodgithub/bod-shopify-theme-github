<style>
.insulin-works{position:relative;width:306px;height:197px;overflow:hidden;background:linear-gradient(180deg,#EDEFFF,#E2E6FF);font:10px/1 "Helvetica Neue",Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase;color:#3447AF;--t:6s;--tg:2.6s;--ga:.85;--gs:18px}
.insulin-works *{box-sizing:border-box;margin:0}
.insulin-works>*{position:absolute}
.insulin-works .band{left:0;top:99px;width:305px;height:97px;background:linear-gradient(90deg,rgba(255,255,255,.11),#FFF,rgba(255,255,255,.11))}
.insulin-works .bar{left:6px;width:14px;border-radius:3px;background:linear-gradient(180deg,rgba(52,71,175,.65),#3447AF,rgba(52,71,175,.65))}
.insulin-works .bar-w{background:transparent;border:.5px solid rgba(52,71,175,.35)}
.insulin-works .line{left:0;right:0;top:98px;height:1.5px;z-index:1;background:repeating-linear-gradient(90deg,rgba(52,71,175,.62) 0 4px,transparent 4px 8px)}
.insulin-works .lbl{position:absolute;line-height:1.2}
.insulin-works .sug{width:15px;height:15px;border-radius:50%;background:#FFF;border:1px solid #3447AF}
.insulin-works .ins{width:12px;height:12px;border-radius:50%;background:#2A3BB5}
.insulin-works .glut{width:26px;height:26px;border-radius:50%;background:rgba(120,140,230,.32);display:grid;place-items:center}
.insulin-works .glut .sug{width:13px;height:13px}
.insulin-works .gate{left:146px;top:80px;width:26px;height:36px;border-radius:9px;background:#F2F4FF;border:1px solid #3447AF;display:grid;place-items:center;z-index:3;animation:insulin-works-glow var(--tg) ease-out infinite}
.insulin-works .gate .core{width:11px;height:11px;border-radius:50%;background:#2A3BB5;animation:insulin-works-enter var(--t) ease-in-out infinite}
.insulin-works .gate .x{font-size:15px;color:rgba(52,71,175,.6);text-transform:none}
@keyframes insulin-works-glow{0%{box-shadow:0 0 0 0 rgba(111,191,139,var(--ga))}70%{box-shadow:0 0 0 var(--gs) rgba(111,191,139,0)}100%{box-shadow:0 0 0 0 rgba(111,191,139,0)}}
@keyframes insulin-works-enter{0%{transform:translateY(-44px);opacity:0}10%{opacity:1}20%{transform:translateY(-2px)}25%{transform:translateY(0)}92%{transform:translateY(0);opacity:1}100%{transform:translateY(0);opacity:0}}
.insulin-works .lift{animation:insulin-works-lift var(--t) cubic-bezier(.45,.05,.35,1) infinite}
@keyframes insulin-works-lift{0%,28%{transform:translateY(0)}44%{transform:translateY(-40px)}58%{transform:translateY(-40px)}72%,100%{transform:translateY(0)}}
.insulin-works .wait{z-index:2;animation:insulin-works-wait var(--t) cubic-bezier(.45,.05,.35,1) infinite}
@keyframes insulin-works-wait{0%{transform:translateY(0);opacity:0}4%,58%{transform:translateY(0);opacity:1}72%,96%{transform:translateY(40px);opacity:1}100%{transform:translateY(40px);opacity:0}}
@media (prefers-reduced-motion:reduce){.insulin-works .gate,.insulin-works .gate .core,.insulin-works .lift,.insulin-works .wait{animation:none}}
</style>
<div class="insulin-works" role="img" aria-label="Insulin binds to the receptor and GLUT4 carries glucose into the cell">
<div class="band"></div>
<div class="lbl" style="left:26px;top:36px;font-weight:700">In the<br>blood</div>
<div class="lbl" style="left:90px;top:64px;font-size:9px">Glucose</div>
<div class="lbl" style="left:216px;top:43px;font-size:9px">Insulin</div>
<div class="ins" style="left:216px;top:27px"></div>
<div class="bar bar-w" style="top:9px;height:80px"></div><div class="bar" style="top:107px;height:80px"></div>
<div class="line"></div>
<div class="lbl" style="left:178px;top:102px;font-size:9px">Insulin<br>receptor</div>
<div class="lbl" style="left:26px;top:134px;font-weight:700">Inside<br>the cell</div>
<div class="lbl" style="left:209px;top:156px;font-size:9px">Glut4</div>
<div class="gate"><div class="core"></div></div>
<div class="sug wait" style="left:92px;top:78px"></div>
<div class="glut lift" style="left:86px;top:112px"></div>
<div class="glut" style="left:112px;top:142px"><div class="sug"></div></div>
<div class="sug" style="left:160px;top:162px"></div>
<div class="glut" style="left:174px;top:154px"><div class="sug"></div></div>
<div class="glut" style="left:246px;top:156px"><div class="sug"></div></div>
<div class="sug" style="left:268px;top:132px"></div>
</div>