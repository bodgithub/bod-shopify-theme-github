<style>
.insulin-blocked{position:relative;width:306px;height:197px;overflow:hidden;background:transparent;font:10px/1 "Helvetica Neue",Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase;color:#3447AF;--tg:2.6s;--ga:.8;--gs:18px}
.insulin-blocked *{box-sizing:border-box;margin:0}
.insulin-blocked>*{position:absolute}
.insulin-blocked .band{left:0;top:99px;width:305px;height:97px;background:linear-gradient(90deg,rgba(255,255,255,.11),#FFF,rgba(255,255,255,.11))}
.insulin-blocked .bar{left:6px;width:14px;border-radius:3px;background:linear-gradient(180deg,rgba(52,71,175,.65),#3447AF,rgba(52,71,175,.65))}
.insulin-blocked .bar-w{background:transparent;border:.5px solid rgba(52,71,175,.35)}
.insulin-blocked .line{left:0;right:0;top:98px;height:1.5px;z-index:1;background:repeating-linear-gradient(90deg,rgba(52,71,175,.62) 0 4px,transparent 4px 8px)}
.insulin-blocked .lbl{position:absolute;line-height:1.2}
.insulin-blocked .sug{width:15px;height:15px;border-radius:50%;background:#FFF;border:1px solid #3447AF}
.insulin-blocked .ins{width:12px;height:12px;border-radius:50%;background:#2A3BB5}
.insulin-blocked .glut{width:26px;height:26px;border-radius:50%;background:rgba(120,140,230,.32);display:grid;place-items:center}
.insulin-blocked .gate{left:146px;top:80px;width:26px;height:36px;border-radius:9px;background:#F2F4FF;border:1px solid #3447AF;display:grid;place-items:center;z-index:3;animation:insulin-blocked-glow var(--tg) ease-out infinite}
.insulin-blocked .gate .core{width:11px;height:11px;border-radius:50%;background:#2A3BB5}
.insulin-blocked .gate .x{font-size:15px;color:rgba(52,71,175,.6);text-transform:none}
@keyframes insulin-blocked-glow{0%{box-shadow:0 0 0 0 rgba(208,86,74,var(--ga))}70%{box-shadow:0 0 0 var(--gs) rgba(208,86,74,0)}100%{box-shadow:0 0 0 0 rgba(208,86,74,0)}}
@media (prefers-reduced-motion:reduce){.insulin-blocked .gate{animation:none}}
</style>
