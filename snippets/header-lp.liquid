{%- comment -%}
  Bodology · Landing-page header
  Rendered by sections/header.liquid instead of the normal header style when the
  current template suffix is listed in the header's "Landing page templates" setting.
  Layout: two columns. Logo on the left in the button colour (links to the homepage)
  · optional cart icon + "Get the bundle" CTA on the right. No menu.
{%- endcomment -%}

{%- liquid
  assign cta_text = header_settings.lp_cta_text | default: 'Get the bundle'
  assign cta_link = header_settings.lp_cta_link | default: '#Product-Slider'
  assign logo = header_settings.logo
  assign logo_ratio = 3.48
  if logo and logo.height > 0
    assign logo_ratio = logo.width | times: 1.0 | divided_by: logo.height
  endif
-%}

{%- if logo -%}
  <a class="logolink lp-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}"
     style="--lp-logo: url('{{ logo | image_url: width: 800 }}'); --lp-logo-ratio: {{ logo_ratio }};"></a>
{%- else -%}
  <a class="logolink lp-logo text-logo" href="{{ routes.root_url }}">{{ shop.name }}</a>
{%- endif -%}

<div class="thb-secondary-area thb-header-right lp-header__right{% if header_settings.lp_reveal_on_scroll != false %} lp-header__right--reveal{% endif %}">
  {%- if header_settings.lp_show_cart -%}
    <a class="thb-secondary-area-item thb-secondary-cart lp-cart" href="{{ routes.cart_url }}" id="cart-drawer-toggle" title="{{ 'sections.header.cart' | t | default: 'Cart' }}">
      <div class="thb-secondary-item-icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="5.5" y="8.5" width="13" height="11" rx="2"/><path d="M9 8.5V7a3 3 0 0 1 6 0v1.5"/></svg>
        <span class="thb-item-count">{%- if cart.item_count > 99 -%}{%- render 'svg-icons' with 'thb-asterisk' -%}{%- elsif cart.item_count > 0 -%}{{ cart.item_count }}{%- endif -%}</span>
      </div>
    </a>
  {%- endif -%}
  <a class="button lp-cta" href="{{ cta_link }}" role="button" title="{{ cta_text | escape }}"><span>{{ cta_text }}</span></a>
</div>

{% style %}
  /* two columns: logo left, cart + CTA right */
  .header--lp .header--inner { grid-template-columns: auto 1fr; }
  /* logo: the PNG used as a mask so it takes the button colour exactly */
  .header--lp .lp-logo {
    display: block; justify-self: start; height: var(--logo-height-mobile, 35px); aspect-ratio: var(--lp-logo-ratio, 3.48);
    background: var(--solid-button-background, #1a2874);
    -webkit-mask: var(--lp-logo) left center / contain no-repeat; mask: var(--lp-logo) left center / contain no-repeat;
  }
  .header--lp .lp-logo.text-logo { justify-self: start; }
  @media only screen and (min-width: 768px) { .header--lp .lp-logo { height: var(--logo-height, 55px); } }
  /* right side: cart icon in the button colour + CTA that stays on one line */
  .header--lp .lp-header__right { display: flex; align-items: center; justify-content: flex-end; gap: 6px; }
  /* cart icon + CTA stay hidden at the top of the page and fade in once the visitor scrolls */
  .header--lp .lp-header__right--reveal { opacity: 0; visibility: hidden; transform: translateY(-4px); transition: opacity .2s ease, transform .2s ease, visibility 0s linear .2s; }
  .header--lp.lp-scrolled .lp-header__right--reveal { opacity: 1; visibility: visible; transform: none; transition: opacity .2s ease, transform .2s ease; }
  .header--lp .lp-cart { color: var(--solid-button-background, #1a2874); text-decoration: none; }
  .header--lp .lp-cart .thb-secondary-item-icon { position: relative; display: flex; align-items: center; justify-content: center; width: 22px; height: 22px; }
  .header--lp .lp-cart .thb-item-count:empty { display: none; }
  .header--lp .lp-cta { display: none; white-space: nowrap; height: 40px; padding: 0 16px; font-size: 14px; }
  .header--lp .lp-cta:hover, .header--lp .lp-cta:focus-visible { background: var(--solid-button-background-hover, #3447af); background-image: none; }
  @media only screen and (min-width: 768px) { .header--lp .lp-cta { display: inline-flex; height: 46px; padding: 0 24px; font-size: 15px; } }
{% endstyle %}
<script>
(function () {
  var h = document.getElementById('header'); if (!h || !h.querySelector('.lp-header__right--reveal')) { return; }
  function sync() { h.classList.toggle('lp-scrolled', window.scrollY > 40); }
  window.addEventListener('scroll', sync, { passive: true }); window.addEventListener('resize', sync); sync();
})();
</script>
