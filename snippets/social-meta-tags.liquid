{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: shop.url
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'collection'
    assign og_type = 'product.group'
  elsif request.page_type == 'password'
    assign og_url = shop.url
  endif
%}


{%- comment -%} Per-view SEO overrides for the concern product views (added 2026-11-03): keep og:/twitter: title and description in step with the <title>/meta-description overrides in layout/theme.liquid. {%- endcomment -%}
{%- liquid
  if request.page_type == 'product'
    case template.suffix
      when 'pcos'
        assign og_title = "Inositol for PCOS: 40:1 Myo & D-Chiro – Bodology®"
        assign og_description = "Pure, unflavored Myo & D-Chiro Inositol powder in the body's optimal 40:1 ratio, formulated to support hormones in PCOS, blood sugar and insulin function."
      when 'fertility'
        assign og_title = "Inositol for Fertility: 40:1 Myo & D-Chiro – Bodology®"
        assign og_description = "Pure, unflavored Myo & D-Chiro Inositol powder in the body's optimal 40:1 ratio, formulated to support conception, balanced hormones and ovarian health."
      when 'hormones'
        assign og_title = "Inositol for Hormones: 40:1 Myo & D-Chiro – Bodology®"
        assign og_description = "Pure, unflavored Myo & D-Chiro Inositol powder in the body's optimal 40:1 ratio, formulated to support hormone balance, cycles and ovarian health."
      when 'mood'
        assign og_title = "Inositol for Anxiety & Mood: 40:1 Myo & D-Chiro – Bodology®"
        assign og_description = "Pure, unflavored Myo & D-Chiro Inositol powder in the body's optimal 40:1 ratio, formulated to support a calmer mood, ease anxiety and restful sleep."
      when 'metabolism'
        assign og_title = "Inositol for Metabolism: 40:1 Myo & D-Chiro – Bodology®"
        assign og_description = "Pure, unflavored Myo & D-Chiro Inositol powder in the body's optimal 40:1 ratio, formulated to support metabolism, blood sugar and insulin function."
      when 'black-friday-40-plus'
        assign og_title = "Inositol for Women Over 40 — Black Friday | Bodology®"
        assign og_description = "Black Friday: Bodology's pure 40:1 Myo & D-Chiro Inositol powder supports insulin, metabolism and hormones after 40. Up to 55% off bundle plans, ends 30 Nov."
    endcase
  endif
-%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if page_image -%}
  <meta property="og:image" content="http:{{ page_image | image_url }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url }}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
