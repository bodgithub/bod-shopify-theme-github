{%- comment -%}
  Bodology · Plan Selector 4 (product-info BLOCK, type plan_selector_4)
  Classic subscription-widget layout: radio row "Subscribe & Save" with an
  off-pill badge, struck compare + price on the right, delivery line and
  circle-check benefits under the subscription (shown only while selected),
  hairline divider, "One time purchase" radio row, full-width pill ATC and
  a centred footnote. Two theme-editor colours drive the look: accent
  (badge, checks, radios, button) and ink (titles, prices).
  Params: s = block.settings, uid = block.id.
  Cart: /cart/add.js with variant (+ selling_plan for the subscription) and
  the standard unique _li property; opens the cart drawer.
{%- endcomment -%}

{%- assign acc = s.accent_color | default: '#5C6B5D' -%}
{%- assign ink = s.ink_color | default: '#1A1A14' -%}
{%- assign p4_default = s.default_option | default: 'sub' -%}

<style>
#ps4-{{ uid }} .bod-p4{font-family:var(--font-body-family, "Helvetica Neue", Arial, sans-serif); color:{{ ink }}; box-sizing:border-box; max-width:{{ s.max_width | default: 560 }}px; margin:0 auto;}
#ps4-{{ uid }} .bod-p4 *,#ps4-{{ uid }} .bod-p4 *::before,#ps4-{{ uid }} .bod-p4 *::after{box-sizing:border-box;}
#ps4-{{ uid }} .p4-opt{cursor:pointer; padding:14px 2px;}
#ps4-{{ uid }} .p4-opt:focus-visible{outline:2px solid {{ acc }}; outline-offset:2px; border-radius:8px;}
#ps4-{{ uid }} .p4-row{display:flex; align-items:center; gap:10px;}
#ps4-{{ uid }} .p4-radio{flex:0 0 auto; width:18px; height:18px; border-radius:50%; border:1.5px solid #B9B9B4; position:relative; transition:border-color .15s;}
#ps4-{{ uid }} .p4-opt.is-selected .p4-radio{border-color:{{ ink }};}
#ps4-{{ uid }} .p4-radio::after{content:''; position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:10px; height:10px; border-radius:50%; background:{{ ink }}; opacity:0; transition:opacity .15s;}
#ps4-{{ uid }} .p4-opt.is-selected .p4-radio::after{opacity:1;}
#ps4-{{ uid }} .p4-name{font-size:16px; font-weight:700; color:{{ ink }};}
#ps4-{{ uid }} .p4-badge{display:inline-flex; align-items:center; background:{{ acc }}; color:#fff; font-size:12px; font-weight:600; padding:3px 9px; border-radius:5px; white-space:nowrap;}
#ps4-{{ uid }} .p4-prices{margin-left:auto; display:flex; align-items:baseline; gap:8px; white-space:nowrap;}
#ps4-{{ uid }} .p4-was{font-size:13.5px; text-decoration:line-through; color:#9a9a94;}
#ps4-{{ uid }} .p4-price{font-size:16px; font-weight:700; color:{{ ink }};}
#ps4-{{ uid }} .p4-detail{display:none; padding:10px 0 0 28px;}
#ps4-{{ uid }} .p4-opt.is-selected .p4-detail{display:block;}
#ps4-{{ uid }} .p4-delivery{font-size:13.5px; color:{{ ink }}; margin:0 0 12px;}
#ps4-{{ uid }} .p4-delivery span{opacity:0.7; margin-right:10px;}
#ps4-{{ uid }} .p4-benes{list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:8px;}
#ps4-{{ uid }} .p4-benes li{display:flex; align-items:flex-start; gap:8px; font-size:13px; line-height:1.45; color:{{ ink }};}
#ps4-{{ uid }} .p4-benes svg{flex:0 0 auto; width:15px; height:15px; margin-top:2px;}
#ps4-{{ uid }} .p4-hr{border:0; border-top:1px solid #E4E2DC; margin:2px 0;}
#ps4-{{ uid }} .p4-cta{width:100%; display:flex; align-items:center; justify-content:center; gap:9px; border:0; cursor:pointer; border-radius:999px; padding:16px 24px; margin-top:18px; background:{{ acc }}; color:#fff; font-family:inherit; font-size:13.5px; font-weight:600; letter-spacing:0.12em; text-transform:uppercase; transition:filter .15s,transform .12s;}
#ps4-{{ uid }} .p4-cta:hover{filter:brightness(1.07);}
#ps4-{{ uid }} .p4-cta:active{transform:translateY(1px);}
#ps4-{{ uid }} .p4-cta.is-loading{pointer-events:none; opacity:0.75;}
#ps4-{{ uid }} .p4-cta svg{width:17px; height:17px; flex:0 0 auto;}
#ps4-{{ uid }} .p4-foot{font-size:12.5px; color:{{ ink }}; opacity:0.75; text-align:center; margin:12px 0 0;}
#ps4-{{ uid }} .p4-error{display:none; align-items:center; gap:8px; font-size:13px; color:#B42318; background:#FEF3F2; border:1px solid #FDA29B; border-radius:9px; padding:10px 13px; margin-top:10px;}
#ps4-{{ uid }} .p4-error.is-shown{display:flex;}
</style>

{%- capture p4_check -%}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="{{ acc }}"/><path d="M7 12.5l3 3 7-7" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endcapture -%}

<div id="ps4-{{ uid }}">
<div class="bod-p4" role="radiogroup" data-p4-root aria-label="{{ s.sub_title | default: 'Choose your plan' | escape }}">

  <div class="p4-opt{% if p4_default == 'sub' %} is-selected{% endif %}" role="radio" aria-checked="{% if p4_default == 'sub' %}true{% else %}false{% endif %}" tabindex="0"
       data-p4-opt data-p4-name="{{ s.sub_title | default: 'Subscribe & Save' | escape }}" data-p4-variant="{{ s.sub_variant }}" data-p4-qty="{{ s.sub_qty | default: 1 }}" data-p4-plan="{{ s.sub_plan }}" data-p4-requires-plan="1">
    <div class="p4-row">
      <span class="p4-radio"></span>
      <span class="p4-name">{{ s.sub_title | default: 'Subscribe & Save' }}</span>
      {%- if s.sub_badge != blank -%}<span class="p4-badge">{{ s.sub_badge }}</span>{%- endif -%}
      <span class="p4-prices">{%- if s.sub_compare != blank -%}<span class="p4-was">{{ s.sub_compare }}</span>{%- endif -%}<span class="p4-price">{{ s.sub_price }}</span></span>
    </div>
    <div class="p4-detail">
      {%- if s.delivery_value != blank -%}<p class="p4-delivery"><span>{{ s.delivery_label | default: 'Delivery' }}</span>{{ s.delivery_value }}</p>{%- endif -%}
      {%- assign p4_benes = s.sub_benefits | newline_to_br | split: '<br />' -%}
      <ul class="p4-benes">
        {%- for b in p4_benes -%}{%- assign t = b | strip -%}{%- if t != blank -%}<li>{{ p4_check }}<span>{{ t }}</span></li>{%- endif -%}{%- endfor -%}
      </ul>
    </div>
  </div>

  <hr class="p4-hr">

  <div class="p4-opt{% if p4_default == 'one' %} is-selected{% endif %}" role="radio" aria-checked="{% if p4_default == 'one' %}true{% else %}false{% endif %}" tabindex="0"
       data-p4-opt data-p4-name="{{ s.ot_title | default: 'One time purchase' | escape }}" data-p4-variant="{{ s.ot_variant }}" data-p4-qty="{{ s.ot_qty | default: 1 }}" data-p4-plan="">
    <div class="p4-row">
      <span class="p4-radio"></span>
      <span class="p4-name" style="font-weight:400;">{{ s.ot_title | default: 'One time purchase' }}</span>
      <span class="p4-prices"><span class="p4-price">{{ s.ot_price }}</span></span>
    </div>
  </div>

  <button type="button" class="p4-cta" data-p4-submit>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5.5" y="9.5" width="13" height="11" rx="3"/><path d="M9 9.5V8.1c0-1.6 1.3-2.8 3-2.8s3 1.2 3 2.8v1.4"/></svg>
    <span data-p4-label>{{ s.cta_label | default: 'Add to cart' }}</span>
  </button>

  <div class="p4-error" data-p4-error>
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#B42318" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16.5v.5"/></svg>
    <span>{{ s.error_text | default: 'Please choose a plan first' }}</span>
  </div>

  {%- if s.footnote != blank -%}<p class="p4-foot">{{ s.footnote }}</p>{%- endif -%}
</div>
</div>

<script>
(function(){
  var root = document.querySelector('#ps4-{{ uid }} [data-p4-root]');
  if(!root || root.dataset.p4Bound) return;
  root.dataset.p4Bound = '1';
  var opts = [].slice.call(root.querySelectorAll('[data-p4-opt]'));
  var err = root.querySelector('[data-p4-error]');
  var cta = root.querySelector('[data-p4-submit]');
  var label = root.querySelector('[data-p4-label]');
  var ctaText = label.textContent;
  var cartUrl = {{ routes.cart_url | json }};
  var addBase = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) ? window.Shopify.routes.root : '/';
  function selected(){ return root.querySelector('[data-p4-opt].is-selected'); }
  function showErr(msg){ var sp = err.querySelector('span'); if(sp && msg) sp.textContent = msg; err.classList.add('is-shown'); }
  function select(o){
    opts.forEach(function(x){ x.classList.remove('is-selected'); x.setAttribute('aria-checked','false'); });
    o.classList.add('is-selected'); o.setAttribute('aria-checked','true');
    err.classList.remove('is-shown');
  }
  opts.forEach(function(o){
    o.addEventListener('click', function(){ select(o); });
    o.addEventListener('keydown', function(e){ if(e.key===' '||e.key==='Enter'){ e.preventDefault(); select(o); } });
  });
  cta.addEventListener('click', function(){
    var o = selected();
    if(!o){ showErr(); return; }
    var variant = (o.getAttribute('data-p4-variant') || '').trim();
    var plan = (o.getAttribute('data-p4-plan') || '').trim();
    var qty = parseInt(o.getAttribute('data-p4-qty'), 10) || 1;
    if(!variant){ showErr('This plan needs a variant ID — add it in the theme editor.'); return; }
    if(o.hasAttribute('data-p4-requires-plan') && !plan){ showErr('This subscription needs its selling plan ID — set it in the theme editor.'); return; }
    err.classList.remove('is-shown');
    cta.classList.add('is-loading'); label.textContent = {{ s.adding_label | default: 'Adding…' | json }};
    var item = { id: variant, quantity: qty, properties: { '_li': (Date.now().toString(36) + Math.random().toString(36).slice(2, 8)) } };
    if(plan){ item.selling_plan = plan; }
    fetch(addBase + 'cart/add.js', { method:'POST', headers:{'Content-Type':'application/json','Accept':'application/json'}, body: JSON.stringify({ items: [item], sections: ['main-cart','cart-drawer','cart-bubble'], sections_url: window.location.pathname }) })
    .then(function(r){ return r.json(); })
    .then(function(response){
      if(response && response.status){ throw response; }
      cta.classList.remove('is-loading'); label.textContent = ctaText;
      try {
        [ { id:'Cart', section:'main-cart', selector:'.thb-cart-form' },
          { id:'Cart-Drawer', section:'cart-drawer', selector:'.cart-drawer' },
          { id:'cart-drawer-toggle', section:'cart-bubble', selector:'.thb-item-count' }
        ].forEach(function(sc){
          if(!document.getElementById(sc.id) || !response.sections || !response.sections[sc.section]) return;
          var host = document.getElementById(sc.id);
          var el = host.querySelector(sc.selector) || host;
          var frag = new DOMParser().parseFromString(response.sections[sc.section], 'text/html').querySelector(sc.selector);
          if(frag) el.innerHTML = frag.innerHTML;
          if(typeof CartDrawer !== 'undefined'){ try{ new CartDrawer(); }catch(e){} }
          if(typeof Cart !== 'undefined'){ try{ new Cart().renderContents(response); }catch(e){} }
        });
      } catch(e){}
      var drawer = document.getElementById('Cart-Drawer');
      if(drawer){ document.body.classList.add('open-cc'); drawer.classList.add('active'); document.dispatchEvent(new CustomEvent('cart-drawer:open')); }
      else { window.location = cartUrl; }
    })
    .catch(function(e){ cta.classList.remove('is-loading'); label.textContent = ctaText; showErr((e && (e.description || e.message)) || 'Could not add to cart'); });
  });
})();
</script>
