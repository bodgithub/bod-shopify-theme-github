{%- comment -%}
  Renders a single media item for the "stacked" product gallery layout
  (large hero image + grid). No Flickity / carousel wrapper.
  Accepts: media, sizes, priority, section, display_captions
{%- endcomment -%}
{%- liquid
  assign alt = media.preview_image.alt | split: '#' | first
-%}
{%- case media.media_type -%}
  {%- when 'external_video' -%}
    <div class="product-single__media-external-video" data-provider="{{ media.host }}" style="--aspect-ratio: {{ media.aspect_ratio }}">
      {{ media | external_video_tag: loading: "lazy", loop: section.settings.enable_video_looping, muted: 1 }}
    </div>
  {%- when 'video' -%}
    {{ media | video_tag: controls: true, loading: "lazy", loop: section.settings.enable_video_looping, image_size: '1200x' }}
  {%- else -%}
    {%- render 'responsive-image', image: media.preview_image, sizes: sizes, priority: priority -%}
    {%- if alt != blank and display_captions -%}<span class="figcaption">{{ alt }}</span>{%- endif -%}
{%- endcase -%}
