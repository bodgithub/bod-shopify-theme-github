{%- comment -%}
  Bodology cart drawer.
  Liquid emits one JSON blob (cart + per-line metafields + theme settings) and an
  empty root. assets/cart-drawer.js builds the cart state from it and renders the
  chosen design (A/B/C). Every price and % the drawer shows comes from the cart
  object Shopify returns - nothing is hardcoded here.

  The #Cart-Drawer element, .cart-drawer class and <side-panel-close> wrapper are
  relied on by the theme's CartDrawer class (assets/app.js), which refetches this
  section after add-to-cart and replaces #Cart-Drawer's children. The JS watches
  for that and re-renders from the fresh JSON.
{%- endcomment -%}
{%- if settings.cart_drawer -%}
{%- liquid
  assign shadow_class = 'has-shadow--' | append: settings.block_shadows
  assign protocol = settings.bcd_protocol_product
  assign free_shipping_minimum = settings.free_shipping_minimum | default: '0' | times: 100
  assign empty_url = settings.bcd_empty_url | default: routes.all_products_collection_url
-%}
<div class="side-panel cart-drawer bod-cart {{ shadow_class }}" id="Cart-Drawer" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="CartDrawerHeading" data-design="{{ settings.bcd_design | default: 'a' }}" style="--bcd-primary:{{ settings.bcd_color_primary | default: '#2238E6' }};--bcd-navy:{{ settings.bcd_color_navy | default: '#121A5C' }};--bcd-green:{{ settings.bcd_color_green | default: '#0B7A45' }};--bcd-green-bg:{{ settings.bcd_color_green_bg | default: '#E7F5EC' }};--bcd-text:{{ settings.bcd_color_text | default: '#12142B' }};--bcd-muted:{{ settings.bcd_color_muted | default: '#676B79' }};">
<script type="application/json" data-bod-cart-data>
{
  "cart": {{ cart | json }},
  "lines": [
  {%- for item in cart.items -%}
    {%- liquid
      assign is_protocol = false
      if protocol != blank and item.product.id == protocol.id
        assign is_protocol = true
      endif
      assign is_gift = false
      if item.properties['_gift'] != blank
        assign is_gift = true
      endif
      assign display_name = item.product.metafields.bodology.cart_display_name.value
      assign qualifies = item.product.metafields.bodology.qualifies_for_protocol.value
      assign hide_badge = item.product.metafields.bodology.hide_discount_badge.value
      assign upsell_plan = item.variant.metafields.bodology.upsell_selling_plan_id.value
      assign upsell_variant = item.variant.metafields.bodology.upsell_target_variant.value
    -%}
    {
      "key": {{ item.key | json }},
      "product_id": {{ item.product.id | json }},
      "variant_id": {{ item.variant.id | json }},
      "title": {{ item.product.title | json }},
      "variant_title": {{ item.variant.title | json }},
      "display_name": {{ display_name | json }},
      "url": {{ item.url | json }},
      "image": {% if item.image %}{{ item.image | image_url: width: 168 | json }}{% else %}null{% endif %},
      "image_alt": {{ item.image.alt | default: item.product.title | json }},
      "list_unit": {{ item.variant.price | json }},
      "compare_at_unit": {{ item.variant.compare_at_price | json }},
      "is_protocol": {{ is_protocol | json }},
      "is_gift": {{ is_gift | json }},
      "qualifies_for_protocol": {{ qualifies | json }},
      "hide_badge": {{ hide_badge | json }},
      "upsell_plan_id": {{ upsell_plan | json }},
      "upsell_variant_id": {% if upsell_variant != blank %}{{ upsell_variant.id | json }}{% else %}null{% endif %},
      "plan": {% if item.selling_plan_allocation %}{
        "id": {{ item.selling_plan_allocation.selling_plan.id | json }},
        "name": {{ item.selling_plan_allocation.selling_plan.name | json }},
        "price": {{ item.selling_plan_allocation.price | json }},
        "compare_at_price": {{ item.selling_plan_allocation.compare_at_price | json }},
        "per_delivery_price": {{ item.selling_plan_allocation.per_delivery_price | json }}
      }{% else %}null{% endif %},
      "plan_options": [
        {%- for alloc in item.variant.selling_plan_allocations -%}
        {
          "id": {{ alloc.selling_plan.id | json }},
          "name": {{ alloc.selling_plan.name | json }},
          "price": {{ alloc.price | json }},
          "compare_at_price": {{ alloc.compare_at_price | json }}
        }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
  ],
  "protocol": {% if protocol != blank %}{
    "id": {{ protocol.id | json }},
    "title": {{ protocol.title | json }},
    "url": {{ protocol.url | json }},
    "image": {% if protocol.featured_image %}{{ protocol.featured_image | image_url: width: 168 | json }}{% else %}null{% endif %},
    "variant_id": {{ protocol.selected_or_first_available_variant.id | json }},
    "variant_ids": {{ protocol.variants | map: 'id' | json }}
  }{% else %}null{% endif %},
  "settings": {
    "design": {{ settings.bcd_design | json }},
    "code_field": {{ settings.bcd_code_field | json }},
    "code_banner": {{ settings.bcd_code_banner | json }},
    "code_banner_mixed": {{ settings.bcd_code_banner_mixed | json }},
    "code_label": {{ settings.bcd_code_label | json }},
    "code_other_label": {{ settings.bcd_code_other_label | json }},
    "code_another_label": {{ settings.bcd_code_another_label | json }},
    "code_placeholder": {{ settings.bcd_code_placeholder | json }},
    "code_apply_label": {{ settings.bcd_code_apply_label | json }},
    "code_change_label": {{ settings.bcd_code_change_label | json }},
    "code_applied_line": {{ settings.bcd_code_applied_line | json }},
    "invalid_code_text": {{ settings.bcd_invalid_code_text | json }},
    "plan_subtitle": {{ settings.bcd_plan_subtitle | json }},
    "renewal_text": {{ settings.bcd_renewal_text | json }},
    "plan_intervals": {{ settings.bcd_plan_intervals | json }},
    "oneoff_subtitle": {{ settings.bcd_oneoff_subtitle | json }},
    "badge_text": {{ settings.bcd_badge_text | json }},
    "qty_text": {{ settings.bcd_qty_text | json }},
    "free_label": {{ settings.bcd_free_label | json }},
    "protocol_value": {{ settings.bcd_protocol_value | json }},
    "protocol_variant": {{ settings.bcd_protocol_variant | json }},
    "protocol_line_free": {{ settings.bcd_protocol_line_free | json }},
    "protocol_line_locked": {{ settings.bcd_protocol_line_locked | json }},
    "protocol_nudge": {{ settings.bcd_protocol_nudge | json }},
    "protocol_nudge_text": {{ settings.bcd_protocol_nudge_text | json }},
    "protocol_nudge_button": {{ settings.bcd_protocol_nudge_button | json }},
    "shipping_unlocked": {{ settings.bcd_shipping_unlocked | json }},
    "shipping_remaining": {{ settings.bcd_shipping_remaining | json }},
    "protocol_unlocked": {{ settings.bcd_protocol_unlocked | json }},
    "protocol_locked": {{ settings.bcd_protocol_locked | json }},
    "upsell": {{ settings.bcd_upsell | json }},
    "upsell_text": {{ settings.bcd_upsell_text | json }},
    "upsell_protocol_text": {{ settings.bcd_upsell_protocol_text | json }},
    "upsell_map": {{ settings.bcd_upsell_map | json }},
    "label_subtotal": {{ settings.bcd_label_subtotal | json }},
    "label_subscribe_save": {{ settings.bcd_label_subscribe_save | json }},
    "label_code_row": {{ settings.bcd_label_code_row | json }},
    "label_code_prefix": {{ settings.bcd_label_code_prefix | json }},
    "label_protocol_row": {{ settings.bcd_label_protocol_row | json }},
    "label_shipping": {{ settings.bcd_label_shipping | json }},
    "label_total": {{ settings.bcd_label_total | json }},
    "label_savings_heading": {{ settings.bcd_label_savings_heading | json }},
    "label_total_saved": {{ settings.bcd_label_total_saved | json }},
    "savings_strip": {{ settings.bcd_savings_strip | json }},
    "savings_text": {{ settings.bcd_savings_text | json }},
    "b_heading": {{ settings.bcd_b_heading | json }},
    "b_heading_oneoff": {{ settings.bcd_b_heading_oneoff | json }},
    "b_save_pill": {{ settings.bcd_b_save_pill | json }},
    "b_coupon_text": {{ settings.bcd_b_coupon_text | json }},
    "checkout_text": {{ settings.bcd_checkout_text | json }},
    "checkout_text_b": {{ settings.bcd_checkout_text_b | json }},
    "checkout_text_c": {{ settings.bcd_checkout_text_c | json }},
    "trust": {{ settings.bcd_trust | json }},
    "trust_1": {{ settings.bcd_trust_1 | json }},
    "trust_2": {{ settings.bcd_trust_2 | json }},
    "trust_3": {{ settings.bcd_trust_3 | json }},
    "title": {{ settings.bcd_title | json }},
    "empty_text": {{ settings.bcd_empty_text | json }},
    "empty_cta": {{ settings.bcd_empty_cta | json }},
    "empty_url": {{ empty_url | json }},
    "free_shipping": {{ settings.free_shipping | json }},
    "free_shipping_minimum": {{ free_shipping_minimum | json }},
    "terms_enabled": {{ settings.cart_terms_conditions_enable | json }},
    "terms_html": {% if settings.cart_terms_conditions_enable %}{% if settings.cart_terms_conditions_page != blank %}{{ 'sections.cart.terms_html' | t: url: settings.cart_terms_conditions_page.url | json }}{% else %}{{ 'sections.cart.terms' | t | json }}{% endif %}{% else %}null{% endif %},
    "terms_required_text": {{ 'sections.cart.terms_confirm' | t | json }}
  },
  "money_format": {{ shop.money_format | json }},
  "routes": {
    "root": {{ routes.root_url | json }},
    "cart": {{ routes.cart_url | json }}
  }
}
</script>
<div class="side-panel-inner bod-cart__root" data-bod-cart-root>
  <div class="side-panel-header"><div><h2 class="h6" id="CartDrawerHeading" tabindex="-1">{{ settings.bcd_title | default: 'Your cart' }}</h2>
  <side-panel-close class="side-panel-close"><button type="button" class="side-panel-close__button" aria-label="Close cart">{%- render 'svg-icons' with 'close' -%}</button></side-panel-close></div></div>
  <noscript><div class="bod-cart__noscript"><a class="button" href="{{ routes.cart_url }}">{{ 'general.cart_drawer.checkout' | t }}</a></div></noscript>
</div>
</div>
{%- endif -%}
