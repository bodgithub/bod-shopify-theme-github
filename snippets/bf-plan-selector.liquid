{%- comment -%}
  Bodology · Black Friday plan selector (cart-based bundles)
  Rendered by snippets/plan-selector-1c.liquid when the block's "Show Black Friday bundles"
  setting is on. Two tabs:
    - Black Friday bundles (default): a stepper over up to three bundles. Each bundle is the
      ONE-TIME tub (the 1c block's one-time variant) added to the cart at quantity 2 / 4 / 8
      with NO selling plan. The saving itself comes from automatic discounts in Shopify admin
      (minimum quantity 2 / 4 / 8); the "% off" entered on each bundle here is display only and
      must match those discounts. Prices shown = live variant price x tubs x (100 - %) / 100.
    - Subscribe: the block's existing subscription cards, passed in unchanged as subscribe_html.
  Params: s (block settings), uid (block id), product, base_variant (variant object of the
  one-time tub), subscribe_html (captured card markup).
  Fires "bfps:change" (bubbles) on its root on every change:
    detail = { mode: 'bundles', variantId, quantity, price, compare, pct, formatted, label }
           | { mode: 'subscribe' }
  The latest detail is also kept on the root element as _bfpsState for scripts that bind later.
{%- endcomment -%}

{%- liquid
  assign servings_per_tub = s.bf_servings_per_tub | default: 45
  assign price_line = s.bf_price_line | default: 'monthly'
  assign layout = s.bf_layout | default: 'cards'
  assign has_tier_foot = false
  assign show_tabs = true
  if s.bf_show_tabs == false
    assign show_tabs = false
  endif
  assign tub_cents = 0
  if base_variant
    assign tub_cents = base_variant.price
  endif
  comment
    Tub thumbnail: the block's image if one is picked, otherwise the transparent pack shot in Files.
  endcomment
  assign tub_img = 'https://cdn.shopify.com/s/files/1/0712/4166/2683/files/Bodology-Inositol-Pack-Shot_e0fc20ba-0c65-46f9-82ed-b2ab9fac55f5.png?v=1794332640'
  if s.bf_tub_image
    assign tub_img = s.bf_tub_image | image_url: width: 120
  endif
-%}

{%- capture tiers_json -%}
[
{%- assign printed = 0 -%}
{%- for i in (1..3) -%}
  {%- liquid
    assign k = 'bf_tier_' | append: i
    assign k_label = k | append: '_label'
    assign k_tubs = k | append: '_tubs'
    assign k_months = k | append: '_months'
    assign k_pct = k | append: '_pct'
    assign k_free = k | append: '_free_text'
    assign k_tubs_free = k | append: '_tubs_free_text'
    assign k_title = k | append: '_title'
    assign k_badge = k | append: '_badge'
    assign k_badge_style = k | append: '_badge_style'
    assign k_note = k | append: '_note'
    assign k_link_text = k | append: '_link_text'
    assign k_link_tier = k | append: '_link_tier'
    assign k_foot = k | append: '_footnote'
    assign k_study_title = k | append: '_study_title'
    assign k_study_text = k | append: '_study_text'
    assign tubs = s[k_tubs] | default: 0
    if s[k_foot] != blank
      assign has_tier_foot = true
    endif
    assign pct = s[k_pct] | default: 0
    assign compare = tub_cents | times: tubs
    assign keep = 100 | minus: pct
    assign price = compare | times: keep | divided_by: 100.0 | round
  -%}
  {%- if tubs > 0 and tub_cents > 0 -%}
    {%- if printed > 0 -%},{%- endif -%}
    { "quantity": {{ tubs }}, "price": {{ price }}, "compare": {{ compare }}, "pct": {{ pct }}, "label": {{ s[k_label] | json }}, "months": {{ s[k_months] | default: 1 }}, "freeText": {{ s[k_free] | json }}, "tubsFreeText": {{ s[k_tubs_free] | json }}, "title": {{ s[k_title] | json }}, "badge": {{ s[k_badge] | json }}, "badgeStyle": {{ s[k_badge_style] | default: 'navy' | json }}, "note": {{ s[k_note] | json }}, "linkText": {{ s[k_link_text] | json }}, "linkTier": {{ s[k_link_tier] | default: 0 | json }}, "footnote": {{ s[k_foot] | json }}, "studyTitle": {{ s[k_study_title] | json }}, "studyBody": {{ s[k_study_text] | json }} }
    {%- assign printed = printed | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}
]
{%- endcapture -%}

{%- if printed > 0 -%}
<div
  class="bfps"
  data-bfps
  data-variant="{{ base_variant.id }}"
  data-price-line="{{ price_line | escape }}"
  data-servings-per-tub="{{ servings_per_tub }}"
  data-default-tier="{{ s.bf_default_tier | default: 2 }}"
  data-layout="{{ layout }}"
  {%- if tub_img != blank %} data-tub-image="{{ tub_img }}"{% endif -%}
>
  <script type="application/json" data-bfps-tiers>{{ tiers_json | strip }}</script>

  {%- if s.bf_banner_text != blank -%}
    <div class="bfps__banner">
      <span>{{ s.bf_banner_text | escape }}</span>
      {%- if s.bf_end_text != blank -%}<span class="bfps__banner-end">{{ s.bf_end_text | escape }}</span>{%- endif -%}
    </div>
  {%- endif -%}

  {%- if show_tabs -%}
  <div class="bfps__tabs" role="tablist">
    <button type="button" class="bfps__tab is-active" role="tab" aria-selected="true" data-bfps-tab="bundles">
      Black Friday bundles<small data-bfps-max-saving></small>
    </button>
    <button type="button" class="bfps__tab" role="tab" aria-selected="false" data-bfps-tab="subscribe">
      Subscribe<small>{{ s.bf_subscribe_tab_note | default: 'Save up to 15%' | escape }}</small>
    </button>
  </div>
  {%- endif -%}

  <div class="bfps__panel" data-bfps-panel="bundles" role="tabpanel">
    {%- if layout == 'cards' -%}
    {%- comment -%} Cards layout: three tier cards, then a detail panel for the chosen tier {%- endcomment -%}
    <div class="bfc">
      <div class="bfc__tiers" role="radiogroup" aria-label="Bundle" data-bfc-tiers></div>
      <div class="bfc__panel">
        <div class="bfc__head">
          <span class="bfc__check" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3.2 3.2L13 5"/></svg></span>
          <span class="bfc__title" data-bfc-title></span>
          <span class="bfc__price"><s data-bfps-compare></s><strong data-bfps-price></strong></span>
        </div>
        <div class="bfc__note{% if s.bf_studies_in_note %} bfc__note--studies{% endif %}" data-bfc-note-wrap style="--bf-note-bg:{{ s.bf_note_bg | default: '#e3eaff' }};--bf-note-fg:{{ s.bf_note_color | default: '#1a2874' }}">
          <svg class="bfc__flask" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6"/><path d="M10 3v6.5L4.8 18.2A2 2 0 0 0 6.5 21h11a2 2 0 0 0 1.7-2.8L14 9.5V3"/><path d="M7.5 15h9"/></svg>
          <span data-bfc-note></span>
          {%- if s.bf_studies_in_note and has_tier_foot -%}<button type="button" class="bfc__note-studies" data-bfps-study-open><span>{{ s.bf_studies_label | default: '*See the studies' }}</span><svg class="bfps__foot-chev" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 4l4 4-4 4"/></svg></button>{%- endif -%}
        </div>
        <ul class="bfc__list">
          <li><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 5"/></svg><span data-bfps-ship-line></span></li>
          <li><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 5"/></svg><span>One-time payment, nothing renews</span></li>
          {%- if s.bf_end_text != blank -%}<li><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 5"/></svg><span>Black Friday price &middot; {{ s.bf_end_text | escape }}</span></li>{%- endif -%}
        </ul>
        <p class="bfc__line" data-bfc-line></p>
        <button type="button" class="bfc__swap" data-bfc-swap hidden></button>
      </div>
      <p class="bfps__free bfc__free-hidden" hidden><span data-bfps-free></span><span data-bfps-price-line></span></p>
      <span data-bfps-months hidden></span><span data-bfps-tubs hidden></span><span data-bfps-shelf hidden></span><span data-bfps-ladder hidden></span>
      <button type="button" data-bfps-minus hidden tabindex="-1"></button><button type="button" data-bfps-plus hidden tabindex="-1"></button>
    </div>
    {%- else -%}
    <div class="bfps__box">
      <div class="bfps__stepper">
        <button type="button" class="bfps__step bfps__step--minus" data-bfps-minus aria-label="Smaller bundle">&minus;</button>
        <div class="bfps__current">
          <div class="bfps__months" data-bfps-months></div>
          <div class="bfps__tubs" data-bfps-tubs></div>
        </div>
        <button type="button" class="bfps__step" data-bfps-plus aria-label="Bigger bundle">+</button>
      </div>

      <div class="bfps__shelf" data-bfps-shelf></div>

      <div class="bfps__ladder" data-bfps-ladder></div>

      <div class="bfps__price">
        <s data-bfps-compare></s><strong data-bfps-price></strong>
      </div>

      <ul class="bfps__details">
        <li data-bfps-ship-line></li>
        <li><strong>One-time payment, nothing renews</strong></li>
        {%- if s.bf_end_text != blank -%}<li>Black Friday price &middot; {{ s.bf_end_text | escape }}</li>{%- endif -%}
      </ul>

      <div class="bfps__free"><p class="bfps__free-main" data-bfps-free></p><p class="bfps__free-line" data-bfps-price-line></p></div>
    </div>
    {%- endif -%}
  </div>

  {%- if show_tabs -%}
  <div class="bfps__panel" data-bfps-panel="subscribe" role="tabpanel" hidden>
    {{ subscribe_html }}
  </div>
  {%- endif -%}
  {%- if s.bf_footnote != blank or has_tier_foot -%}
  <div class="bfps__foot" data-bfps-foot{% if s.bf_studies_in_note and layout == 'cards' %} data-bfps-foot-in-note{% endif %}>
    <button type="button" class="bfps__foot-btn" data-bfps-study-open><span>*See the studies</span><svg class="bfps__foot-chev" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 4l4 4-4 4"/></svg></button>
  </div>
  {%- comment -%} pop-up in the same style as the guarantee pop-up: friendly summary, then the study detail in small print {%- endcomment -%}
  <div class="ps-modal" data-bfps-study hidden>
    <div class="ps-modal__ov" data-bfps-study-close></div>
    <div class="ps-modal__box" role="dialog" aria-modal="true" aria-label="The studies behind this bundle">
      <button type="button" class="ps-modal__x" data-bfps-study-close aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
      <h3 class="ps-modal__t" data-bfps-study-title></h3>
      <div class="ps-modal__body" data-bfps-study-body></div>
      <div class="bfps__study-small" data-bfps-study-small></div>
      <div class="bfps__study-general" data-bfps-foot-general>{{ s.bf_footnote }}</div>
      <div class="ps-modal__links"><button type="button" class="ps-modal__link" data-bfps-study-close>Close</button></div>
    </div>
  </div>
  {%- endif -%}
</div>

<style>
  /* colours are the brand palette; type inherits the plan selector's font; corners match the flat cards */
  #ps1c-{{ uid }} .bfps{--bf-navy:#1a2874;--bf-blue:#3447af;--bf-light:#e3eaff;--bf-peri:#b9c2f5;--bf-cream:#f3eeea;color:var(--bf-navy);font-family:inherit}
  #ps1c-{{ uid }} .bfps *{box-sizing:border-box}
  #ps1c-{{ uid }} .bfps button{font-family:inherit}
  #ps1c-{{ uid }} .bfps button:focus-visible{outline:2px solid var(--bf-blue);outline-offset:2px}
  #ps1c-{{ uid }} .bfps__banner{display:flex;justify-content:space-between;gap:12px;background:var(--bf-navy);color:#fff;padding:10px 12px;font-size:14px;font-weight:700;border-radius:0;margin:0 0 12px}
  #ps1c-{{ uid }} .bfps__banner-end{font-weight:500;color:var(--bf-peri);white-space:nowrap}
  /* pill container: the rounding lives on the wrapper only, so the two tabs meet flat in the middle */
  #ps1c-{{ uid }} .bfps__tabs{display:flex;border:1px solid var(--bf-blue);border-radius:100px;overflow:hidden;margin:0 0 12px;isolation:isolate}
  #ps1c-{{ uid }} .bfps__tab{flex:1;appearance:none;border:0;border-radius:0;background:#fff;color:var(--bf-navy);padding:11px 8px;font-size:14px;font-weight:700;line-height:1.2;cursor:pointer;text-align:center}
  #ps1c-{{ uid }} .bfps__tab + .bfps__tab{border-left:1px solid var(--bf-blue)}
  #ps1c-{{ uid }} .bfps__tab small{display:block;font-size:11px;font-weight:500;color:var(--bf-blue);margin-top:2px}
  #ps1c-{{ uid }} .bfps__tab.is-active{background:var(--bf-navy);color:#fff}
  #ps1c-{{ uid }} .bfps__tab.is-active small{color:var(--bf-peri)}
  #ps1c-{{ uid }} .bfps__tab:focus-visible{outline-offset:-3px}
  #ps1c-{{ uid }} .bfps__panel[hidden]{display:none}
  #ps1c-{{ uid }} .bfps__box{background:#fff;border:1px solid var(--bf-blue);border-radius:5px;padding:16px;box-shadow:none}
  #ps1c-{{ uid }} .bfps__stepper{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:0 0 8px}
  #ps1c-{{ uid }} .bfps__step{appearance:none;flex:0 0 auto;width:44px;height:44px;border:0;border-radius:0;background:var(--bf-blue);color:#fff;font-size:22px;font-weight:700;line-height:1;cursor:pointer;transition:background .15s}
  #ps1c-{{ uid }} .bfps__step:hover{background:var(--bf-navy)}
  #ps1c-{{ uid }} .bfps__step--minus{background:#fff;color:var(--bf-navy);border:1px solid var(--bf-navy)}
  #ps1c-{{ uid }} .bfps__step--minus:hover{background:var(--bf-light)}
  #ps1c-{{ uid }} .bfps__step[disabled]{opacity:.35;cursor:default;pointer-events:none}
  #ps1c-{{ uid }} .bfps__current{flex:1 1 auto;min-width:0}
  #ps1c-{{ uid }} .bfps__months{font-size:30px;font-weight:800;line-height:1;text-align:center;letter-spacing:-0.02em;min-height:30px}
  #ps1c-{{ uid }} .bfps__tubs{font-size:13px;font-weight:500;color:var(--bf-blue);text-align:center;margin-top:4px;min-height:16px}
  /* 8 thumbnails + nothing else must fit on a 375px phone: width capped to an eighth of the row */
  #ps1c-{{ uid }} .bfps__shelf{display:flex;justify-content:center;align-items:flex-end;gap:6px;padding:8px 0 12px;min-height:70px}
  #ps1c-{{ uid }} .bfps__shelf img{height:50px;width:auto;max-width:calc(12.5% - 6px);object-fit:contain;display:block}
  #ps1c-{{ uid }} .bfps__shelf img.is-new{animation:bfps-pop-{{ uid }} .3s ease-out}
  #ps1c-{{ uid }} .bfps__more{appearance:none;height:50px;width:44px;flex:0 0 auto;border:1.5px dashed var(--bf-blue);border-radius:0;background:#fff;color:var(--bf-blue);font-size:16px;font-weight:800;cursor:pointer;padding:0}
  #ps1c-{{ uid }} .bfps__more:hover{background:var(--bf-light)}
  @keyframes bfps-pop-{{ uid }}{from{transform:translateY(8px) scale(.8);opacity:0}to{transform:none;opacity:1}}
  @media (prefers-reduced-motion:reduce){#ps1c-{{ uid }} .bfps__shelf img.is-new{animation:none}}
  #ps1c-{{ uid }} .bfps__ladder{display:grid;grid-auto-flow:column;grid-auto-columns:1fr;gap:4px;margin:0 0 14px}
  #ps1c-{{ uid }} .bfps__rung{appearance:none;border:0;border-radius:0;background:var(--bf-light);color:var(--bf-blue);font-size:13px;font-weight:700;padding:9px 0;cursor:pointer;transition:background .15s,color .15s}
  #ps1c-{{ uid }} .bfps__rung:hover{background:var(--bf-peri);color:var(--bf-navy)}
  #ps1c-{{ uid }} .bfps__rung.is-on{background:var(--bf-blue);color:#fff}
  #ps1c-{{ uid }} .bfps__price{padding-top:12px;border-top:1px solid var(--bf-light);line-height:1;min-height:33px}
  #ps1c-{{ uid }} .bfps__price s{font-size:15px;font-weight:500;color:var(--bf-blue);margin-right:8px}
  #ps1c-{{ uid }} .bfps__price s:empty{display:none}
  #ps1c-{{ uid }} .bfps__price strong{font-size:20px;font-weight:800;letter-spacing:-0.02em}
  #ps1c-{{ uid }} .bfps__details{list-style:none;margin:12px 0 0;padding:0}
  #ps1c-{{ uid }} .bfps__details li{font-size:13px;font-weight:500;margin:0 0 4px;padding-left:14px;position:relative;line-height:1.4}
  #ps1c-{{ uid }} .bfps__details li::before{content:"\2022";color:var(--bf-blue);position:absolute;left:0}
  /* highlighted box: same type size as the bullet list; the free-months part stays bold; the per-month line sits under it */
  #ps1c-{{ uid }} .bfps__free{font-size:13px;font-weight:500;background:var(--bf-light);padding:10px 12px;border-radius:5px;margin:12px 0 0;line-height:1.4}
  #ps1c-{{ uid }} .bfps__free p{margin:0;font-size:inherit;line-height:inherit;color:inherit}
  #ps1c-{{ uid }} .bfps__free p:empty{display:none}
  #ps1c-{{ uid }} .bfps__free-main strong{font-size:inherit;font-weight:800}
  /* the per-month line follows the free-months text on the same line (wraps naturally on narrow screens) */
  #ps1c-{{ uid }} .bfps__free-main,#ps1c-{{ uid }} .bfps__free-line{display:inline}
  #ps1c-{{ uid }} .bfps__free-line:not(:empty)::before{content:"\00b7";font-weight:800;margin:0 .4em 0 .25em}
  /* "*See the studies" line under the selector (bundles tab only) opens a pop-up with the study behind the selected bundle */
  #ps1c-{{ uid }} .bfps__foot{margin:10px 0 0;color:#676b79}
  #ps1c-{{ uid }} .bfps__foot[hidden]{display:none}
  #ps1c-{{ uid }} .bfps__foot-btn{appearance:none;background:none;border:0;padding:0;cursor:pointer;display:inline-flex;align-items:center;gap:4px;font-family:inherit;font-size:12px;line-height:1.3;color:#676b79;font-weight:500}
  #ps1c-{{ uid }} .bfps__foot-btn:hover{color:var(--bf-navy)}
  #ps1c-{{ uid }} .bfps__foot-btn:focus-visible{outline:2px solid var(--bf-blue);outline-offset:2px;border-radius:2px}
  #ps1c-{{ uid }} .bfps__foot-chev{width:10px;height:10px}
  #ps1c-{{ uid }} .bfps__study-small{margin-top:14px;padding-top:12px;border-top:1px solid rgba(26,40,116,.18);font-size:11px;line-height:1.5;color:#676b79;text-align:left}
  #ps1c-{{ uid }} .bfps__study-small:empty{display:none}
  #ps1c-{{ uid }} .bfps__study-general{margin-top:8px;font-size:11px;line-height:1.5;color:#676b79;text-align:left}
  #ps1c-{{ uid }} .bfps__study-general p{margin:0;font-size:inherit;line-height:inherit;color:inherit}
  #ps1c-{{ uid }} .bfps__study-general[hidden],#ps1c-{{ uid }} .bfps__study-general:empty{display:none}
  /* ---- cards layout ---- */
  #ps1c-{{ uid }} .bfc__tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:14px 0 14px}
  #ps1c-{{ uid }} .bfc__tier{position:relative;appearance:none;text-align:left;cursor:pointer;background:#fafafa;border:1px solid #c9d0f0;border-radius:5px;padding:30px 14px 18px;color:var(--bf-navy);font-family:inherit;transition:border-color .15s,background .15s}
  #ps1c-{{ uid }} .bfc__tier.is-on{background:#fff;border:2px solid var(--bf-blue);padding:29px 13px 17px}
  #ps1c-{{ uid }} .bfc__tier:hover{border-color:var(--bf-blue)}
  #ps1c-{{ uid }} .bfc__badge{position:absolute;top:-13px;left:10px;font-size:12px;font-weight:700;padding:5px 10px;border-radius:6px;white-space:nowrap;line-height:1.1}
  #ps1c-{{ uid }} .bfc__badge--navy{background:var(--bf-navy);color:#fff}
  #ps1c-{{ uid }} .bfc__badge--lavender{background:var(--bf-light);color:var(--bf-navy)}
  #ps1c-{{ uid }} .bfc__tier-label{display:block;font-size:22px;font-weight:800;line-height:1.1;letter-spacing:-0.02em;margin:0 0 10px}
  #ps1c-{{ uid }} .bfc__pct{display:inline-block;background:var(--bf-light);color:var(--bf-navy);font-size:14px;font-weight:700;padding:7px 10px;border-radius:5px;margin:0 0 10px}
  #ps1c-{{ uid }} .bfc__tier.is-on .bfc__pct{background:var(--bf-blue);color:#fff}
  #ps1c-{{ uid }} .bfc__tier-free{display:block;font-size:14px;font-weight:500;line-height:1.3}
  #ps1c-{{ uid }} .bfc__panel{background:#fff;border:2px solid var(--bf-blue);border-radius:5px;padding:18px 18px 16px}
  #ps1c-{{ uid }} .bfc__head{display:flex;align-items:center;gap:12px}
  #ps1c-{{ uid }} .bfc__check{flex:0 0 auto;width:22px;height:22px;border-radius:0;background:var(--bf-blue);color:#fff;display:inline-grid;place-items:center}
  #ps1c-{{ uid }} .bfc__check svg{width:13px;height:13px}
  #ps1c-{{ uid }} .bfc__title{flex:1 1 auto;min-width:0;font-size:24px;font-weight:800;letter-spacing:-0.02em;line-height:1.1}
  #ps1c-{{ uid }} .bfc__price{flex:0 0 auto;display:flex;align-items:baseline;gap:8px;white-space:nowrap}
  #ps1c-{{ uid }} .bfc__price s{font-size:16px;font-weight:500;color:#6b7280}
  #ps1c-{{ uid }} .bfc__price strong{font-size:24px;font-weight:800;letter-spacing:-0.02em}
  #ps1c-{{ uid }} .bfc__note{display:flex;align-items:flex-start;gap:10px;background:var(--bf-note-bg,var(--bf-light));color:var(--bf-note-fg,var(--bf-navy));border-radius:5px;padding:12px 14px;margin:14px 0 0;font-size:15px;font-weight:600;line-height:1.35}
  #ps1c-{{ uid }} .bfc__note[hidden]{display:none}
  #ps1c-{{ uid }} .bfc__flask{flex:0 0 auto;width:20px;height:20px;margin-top:1px;color:var(--bf-note-fg,var(--bf-navy))}
  /* "*See the studies" inside the note, to the right of the text (smaller, underlined); the standalone line under the selector is hidden then */
  #ps1c-{{ uid }} .bfc__note-studies{appearance:none;background:none;border:0;padding:0;margin-left:auto;align-self:center;flex:0 0 auto;cursor:pointer;display:inline-flex;align-items:center;gap:3px;font-family:inherit;font-size:12px;font-weight:500;line-height:1.3;color:inherit;opacity:.8;text-decoration:underline;text-underline-offset:2px;white-space:nowrap}
  #ps1c-{{ uid }} .bfc__note-studies:hover{opacity:1}
  #ps1c-{{ uid }} .bfc__note-studies:focus-visible{outline:2px solid var(--bf-blue);outline-offset:2px;border-radius:2px}
  #ps1c-{{ uid }} .bfps__foot[data-bfps-foot-in-note]{display:none}
  #ps1c-{{ uid }} .bfc__list{list-style:none;margin:14px 0 0;padding:0}
  #ps1c-{{ uid }} .bfc__list li{display:flex;align-items:flex-start;gap:10px;font-size:15px;font-weight:400;line-height:1.35;margin:0 0 8px}
  #ps1c-{{ uid }} .bfc__list svg{flex:0 0 auto;width:16px;height:16px;margin-top:3px;color:var(--bf-blue)}
  #ps1c-{{ uid }} .bfc__line{margin:12px 0 0;font-size:15px;font-weight:400;line-height:1.35}
  #ps1c-{{ uid }} .bfc__line strong{font-weight:600}
  #ps1c-{{ uid }} .bfc__line:empty{display:none}
  #ps1c-{{ uid }} .bfc__swap{appearance:none;background:none;border:0;padding:0;margin:12px 0 0;font-family:inherit;font-size:15px;font-weight:600;color:var(--bf-blue);text-decoration:underline;text-underline-offset:4px;cursor:pointer;text-align:left}
  #ps1c-{{ uid }} .bfc__swap[hidden]{display:none}
  #ps1c-{{ uid }} .bfc__swap:hover{color:var(--bf-navy)}
  #ps1c-{{ uid }} .bfc__free-hidden{display:none}
  @media (max-width:749px){
    #ps1c-{{ uid }} .bfc__tiers{gap:6px}
    #ps1c-{{ uid }} .bfc__tier{padding:24px 8px 12px}
    #ps1c-{{ uid }} .bfc__tier.is-on{padding:23px 7px 11px}
    #ps1c-{{ uid }} .bfc__badge{left:6px;font-size:10.5px;padding:4px 7px}
    #ps1c-{{ uid }} .bfc__tier-label{font-size:16px;margin-bottom:7px}
    #ps1c-{{ uid }} .bfc__pct{font-size:12px;padding:5px 7px;margin-bottom:7px}
    #ps1c-{{ uid }} .bfc__tier-free{font-size:12px}
    #ps1c-{{ uid }} .bfc__panel{padding:14px 14px 12px}
    #ps1c-{{ uid }} .bfc__title{font-size:19px}
    #ps1c-{{ uid }} .bfc__price strong{font-size:20px}
    #ps1c-{{ uid }} .bfc__price s{font-size:14px}
    #ps1c-{{ uid }} .bfc__note,#ps1c-{{ uid }} .bfc__list li,#ps1c-{{ uid }} .bfc__line,#ps1c-{{ uid }} .bfc__swap{font-size:14px}
  }
  @media (max-width:749px){
    #ps1c-{{ uid }} .bfps__months{font-size:26px}
    #ps1c-{{ uid }} .bfps__shelf img{height:44px}
    #ps1c-{{ uid }} .bfps__more{height:44px;width:40px}
  }
</style>

<script>
(function () {
  /* theme money formatter when present (vendor.min.js formatMoney + theme.settings), else a plain USD fallback; whole dollars drop the .00 */
  function money(cents) {
    var out = null;
    try {
      if (typeof formatMoney === 'function' && window.theme && theme.settings && theme.settings.money_with_currency_format) {
        out = formatMoney(cents, theme.settings.money_with_currency_format);
      }
    } catch (e) { out = null; }
    if (!out) { var v = cents / 100; out = '$' + (v % 1 === 0 ? v.toFixed(0) : v.toFixed(2)); }
    return String(out).replace(/\.00(?=\D|$)/, '').replace(/\s*USD$/, '');
  }

  function init(root) {
    if (root.dataset.bfpsReady) return;
    root.dataset.bfpsReady = '1';

    var tiers = JSON.parse(root.querySelector('[data-bfps-tiers]').textContent);
    if (!tiers.length) return;

    var variantId = root.dataset.variant || '';
    var servingsPerTub = parseInt(root.dataset.servingsPerTub, 10) || 45;
    var priceLine = root.dataset.priceLine || 'monthly';
    var tubImage = root.dataset.tubImage || '';
    var layout = root.dataset.layout || 'stepper';
    var index = Math.min(Math.max((parseInt(root.dataset.defaultTier, 10) || 1) - 1, 0), tiers.length - 1);
    var shownTubs = 0;
    var mode = 'bundles';

    var $ = function (sel) { return root.querySelector(sel); };

    var maxPct = Math.max.apply(null, tiers.map(function (t) { return t.pct; }));
    var maxSavingEl = $('[data-bfps-max-saving]'); /* absent when the tabs are switched off */
    if (maxSavingEl) { maxSavingEl.textContent = 'Save up to ' + maxPct + '%'; }

    /* study pop-up: friendly copy for the selected bundle, then the study detail in small print */
    var studyModal = root.querySelector('[data-bfps-study]');
    function syncFoot() {
      if (!studyModal) return;
      var t = tiers[index];
      var titleEl = studyModal.querySelector('[data-bfps-study-title]'), bodyEl = studyModal.querySelector('[data-bfps-study-body]');
      var smallEl = studyModal.querySelector('[data-bfps-study-small]'), genEl = studyModal.querySelector('[data-bfps-foot-general]');
      titleEl.textContent = t.studyTitle || ('The research behind ' + (t.label || 'this bundle'));
      bodyEl.innerHTML = fill(t.studyBody || '', t);
      smallEl.textContent = t.footnote || '';
      if (genEl) { genEl.hidden = !!t.footnote; }
    }
    function openStudy() { syncFoot(); studyModal.hidden = false; document.documentElement.style.overflow = 'hidden'; var x = studyModal.querySelector('.ps-modal__x'); if (x) { x.focus(); } }
    function closeStudy() { studyModal.hidden = true; document.documentElement.style.overflow = ''; }
    if (studyModal) {
      root.querySelectorAll('[data-bfps-study-open]').forEach(function (b) { b.addEventListener('click', function (e) { e.stopPropagation(); openStudy(); }); });
      studyModal.querySelectorAll('[data-bfps-study-close]').forEach(function (b) { b.addEventListener('click', function (e) { e.stopPropagation(); closeStudy(); }); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !studyModal.hidden) { closeStudy(); } });
    }
    function announce() {
      syncFoot();
      var t = tiers[index];
      var detail = mode === 'bundles'
        ? { mode: 'bundles', variantId: variantId, quantity: t.quantity, servings: t.quantity * servingsPerTub, months: t.months, price: t.price, compare: t.compare, pct: t.pct, formatted: money(t.price), label: t.label }
        : { mode: 'subscribe' };
      root._bfpsState = detail;
      root.dispatchEvent(new CustomEvent('bfps:change', { bubbles: true, detail: detail }));
    }

    /* tokens usable in the note and swap-link text, resolved against a tier */
    function fill(str, tier) {
      return String(str || '')
        .replace(/\[price\]/g, money(tier.price)).replace(/\[compare\]/g, money(tier.compare))
        .replace(/\[save\]/g, money(tier.compare - tier.price)).replace(/\[pct\]/g, tier.pct + '%').replace(/\[label\]/g, tier.label || '');
    }
    function renderCards() {
      var t = tiers[index];
      var wrap = $('[data-bfc-tiers]');
      if (!wrap.children.length) {
        tiers.forEach(function (tier, i) {
          var b = document.createElement('button');
          b.type = 'button'; b.className = 'bfc__tier'; b.setAttribute('role', 'radio');
          var html = '';
          if (tier.badge) { html += '<span class="bfc__badge bfc__badge--' + (tier.badgeStyle === 'lavender' ? 'lavender' : 'navy') + '">' + esc(tier.badge) + '</span>'; }
          html += '<span class="bfc__tier-label">' + esc(tier.label) + '</span>';
          html += '<span class="bfc__pct">' + tier.pct + '% off</span>';
          if (tier.freeText) { html += '<span class="bfc__tier-free">' + esc(tier.freeText) + '</span>'; }
          b.innerHTML = html;
          b.addEventListener('click', function () { go(i); });
          wrap.appendChild(b);
        });
      }
      [].forEach.call(wrap.children, function (b, i) { b.classList.toggle('is-on', i === index); b.setAttribute('aria-checked', i === index ? 'true' : 'false'); });
      $('[data-bfc-title]').textContent = t.title || (t.label + ' supply');
      $('[data-bfps-compare]').textContent = t.compare > t.price ? money(t.compare) : '';
      $('[data-bfps-price]').textContent = money(t.price);
      var noteWrap = $('[data-bfc-note-wrap]');
      if (t.note) { $('[data-bfc-note]').textContent = fill(t.note, t); noteWrap.hidden = false; } else { noteWrap.hidden = true; }
      $('[data-bfps-ship-line]').textContent = (t.quantity === 2 ? 'Both' : 'All ' + t.quantity) + ' tubs ship together, free';
      var saving = t.compare - t.price;
      var line = $('[data-bfc-line]'); line.innerHTML = '';
      if (priceLine === 'daily') {
        var sd = document.createElement('strong'); sd.textContent = money(Math.round(t.price / (t.quantity * servingsPerTub))) + ' a day';
        line.appendChild(sd);
      } else {
        line.appendChild(document.createTextNode('Works out at '));
        var sm = document.createElement('strong'); sm.textContent = money(Math.round(t.price / t.months)) + ' a month';
        line.appendChild(sm);
      }
      if (saving > 0) { line.appendChild(document.createTextNode(' \u00b7 you save ' + money(saving))); }
      var swap = $('[data-bfc-swap]');
      var target = tiers[(parseInt(t.linkTier, 10) || 0) - 1];
      if (t.linkText && target && target !== t) {
        swap.textContent = fill(t.linkText, target);
        swap.hidden = false;
        swap.onclick = function () { go(tiers.indexOf(target)); };
      } else { swap.hidden = true; swap.onclick = null; }
      announce();
    }
    function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

    function render() {
      if (layout === 'cards') { renderCards(); return; }
      var t = tiers[index];
      var next = tiers[index + 1];

      $('[data-bfps-months]').textContent = t.label;
      $('[data-bfps-tubs]').textContent = t.quantity + (t.quantity === 1 ? ' tub' : ' tubs') + ' · ' + (t.quantity * servingsPerTub) + ' servings';

      var shelf = $('[data-bfps-shelf]');
      shelf.innerHTML = '';
      if (tubImage) {
        for (var i = 0; i < t.quantity; i++) {
          var img = document.createElement('img');
          img.src = tubImage; img.alt = ''; img.loading = 'lazy'; img.width = 40; img.height = 50;
          if (i >= shownTubs) img.className = 'is-new';
          shelf.appendChild(img);
        }
      }
      if (next) {
        var more = document.createElement('button');
        more.type = 'button';
        more.className = 'bfps__more';
        more.textContent = '+' + (next.quantity - t.quantity);
        more.setAttribute('aria-label', 'Add ' + (next.quantity - t.quantity) + ' more tubs');
        more.addEventListener('click', function () { go(index + 1); });
        shelf.appendChild(more);
      }
      shownTubs = t.quantity;

      var ladder = $('[data-bfps-ladder]');
      ladder.innerHTML = '';
      tiers.forEach(function (tier, i) {
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'bfps__rung' + (i <= index ? ' is-on' : '');
        b.textContent = tier.pct + '% off';
        b.setAttribute('aria-label', tier.label + ', ' + tier.pct + '% off');
        b.setAttribute('aria-pressed', i === index ? 'true' : 'false');
        b.addEventListener('click', function () { go(i); });
        ladder.appendChild(b);
      });

      $('[data-bfps-compare]').textContent = t.compare > t.price ? money(t.compare) : '';
      $('[data-bfps-price]').textContent = money(t.price);

      var unit = priceLine === 'daily'
        ? money(Math.round(t.price / (t.quantity * servingsPerTub))) + ' a day'
        : 'Works out at ' + money(Math.round(t.price / t.months)) + ' a month';
      $('[data-bfps-price-line]').textContent = unit;

      $('[data-bfps-ship-line]').textContent = (t.quantity === 2 ? 'Both' : 'All ' + t.quantity) + ' tubs ship together, free';

      var free = $('[data-bfps-free]');
      free.innerHTML = '';
      if (t.freeText) {
        var strong = document.createElement('strong');
        strong.textContent = t.freeText;
        free.appendChild(strong);
        if (t.tubsFreeText) free.appendChild(document.createTextNode(' ' + t.tubsFreeText));
      }

      $('[data-bfps-minus]').disabled = index === 0;
      $('[data-bfps-plus]').disabled = index === tiers.length - 1;

      announce();
    }

    function go(i) {
      if (i < 0 || i > tiers.length - 1) return;
      index = i;
      render();
    }

    $('[data-bfps-minus]').addEventListener('click', function () { go(index - 1); });
    $('[data-bfps-plus]').addEventListener('click', function () { go(index + 1); });

    root.querySelectorAll('[data-bfps-tab]').forEach(function (tab) {
      tab.addEventListener('click', function () {
        mode = tab.dataset.bfpsTab;
        root.querySelectorAll('[data-bfps-tab]').forEach(function (x) {
          var on = x === tab;
          x.classList.toggle('is-active', on);
          x.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        root.querySelectorAll('[data-bfps-panel]').forEach(function (p) {
          p.hidden = p.dataset.bfpsPanel !== mode;
        });
        var foot = root.querySelector('[data-bfps-foot]'); if (foot) { foot.hidden = mode !== 'bundles'; }
        announce();
      });
    });

    render();
  }

  function boot() { document.querySelectorAll('[data-bfps]').forEach(init); }
  boot();
  document.addEventListener('shopify:section:load', boot);
})();
</script>
{%- else -%}
  {{ subscribe_html }}
  {%- if request.design_mode -%}<p style="font-size:12px;color:#b42318;margin:8px 0 0">Black Friday bundles: set the one-time variant ID on this block and at least one bundle with tubs &gt; 0.</p>{%- endif -%}
{%- endif -%}
