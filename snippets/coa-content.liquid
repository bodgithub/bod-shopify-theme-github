{%- comment -%}
  Bodology · COA popup content (rendered inside the trust-circles popup)
  Certificate of Analysis summary: header meta, three result tables
  (actives / microbiology / heavy metals), footnote. Sentence case,
  hairline row rules only, 3 columns max. Colors follow the popup
  standard (navy on #e3e7ff).
{%- endcomment -%}

<style>
  .coa { text-align: left; color: #1a2874; }
  .coa__eyebrow { text-align: center; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 6px; opacity: .8; }
  .coa__meta { text-align: center; font-size: 12px; line-height: 1.55; margin: 0 0 10px; }
  .coa__pass { text-align: center; font-size: 13px; font-weight: 600; margin: 0 0 18px; }
  .coa__h { font-size: 12px; font-weight: 600; margin: 18px 0 6px; }
  .coa table { width: 100%; border-collapse: collapse; border: 0; font-size: 12px; line-height: 1.4; }
  .coa table, .coa tr, .coa td { border-left: 0 !important; border-right: 0 !important; border-bottom: 0 !important; }
  .coa td { padding: 7px 8px 7px 0; border-top: 1px solid #1a2874 !important; vertical-align: top; background: none; }
  .coa td:last-child { text-align: right; font-weight: 600; white-space: nowrap; padding-right: 0; }
  .coa small { display: block; font-size: 11px; opacity: .75; font-weight: 400; }
  .coa__foot { font-size: 11px; line-height: 1.55; opacity: .8; margin: 18px 0 0; }
  @media (min-width: 750px) {
    .coa__meta { font-size: 13px; }
    .coa table { font-size: 13px; }
    .coa small { font-size: 12px; }
    .coa__foot { font-size: 12px; }
  }
</style>

